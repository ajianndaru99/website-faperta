                  badge: 'badge-online',
                  badgeLabel: d.format,
                  title: d.title,
                  subtitle: `${d.category} · ${d.meta}`,
                  desc: d.desc,
                  url: d.file
                });
              }
            });
          }

          // Pencarian FAQ
          if (activeFilter === 'all' || activeFilter === 'faq') {
            const faqs = [
              { q: 'Presensi minimal 75% syarat UAS', cat: 'Ujian', url: '/faq#tanya-jawab', keys: ['presensi', 'absen', 'kehadiran', '75', 'uas'] },
              { q: 'Prosedur Ujian Susulan', cat: 'Ujian', url: '/faq#tanya-jawab', keys: ['ujian susulan', 'ijin sakit', 'izin', 'dispensasi'] },
              { q: 'Syarat Pengajuan Skripsi & Pembimbing', cat: 'Skripsi', url: '/faq#tanya-jawab', keys: ['skripsi', 'pembimbing', 'proposal', 'ta'] },
              { q: 'Persyaratan Yudisium Kelulusan', cat: 'Yudisium', url: '/faq#tanya-jawab', keys: ['yudisium', 'kelulusan', 'wisuda', 'sarjana'] },
              { q: 'Batas Turnitin & Etika AI Skripsi', cat: 'Integritas', url: '/faq#tanya-jawab', keys: ['turnitin', 'ai', 'chatgpt', 'plagiat', 'similarity'] },
              { q: 'Kriteria Kelulusan Predikat Cumlaude', cat: 'Kelulusan', url: '/faq#tanya-jawab', keys: ['cumlaude', 'ipk 3.51', 'dengan pujian', 'lulus tepat waktu'] }
            ];
            faqs.forEach(f => {
              const score = calculateScore(raw, {
                title: f.q,
                subtitle: f.cat,
                category: f.cat,
                desc: 'Ketentuan dan regulasi akademik resmi FAPERTA INSTIPER',
                keywords: f.keys
              });
              if (score > 15) {
                pool.push({
                  score,
                  type: 'FAQ & Aturan',
                  badge: 'badge-hybrid',
                  badgeLabel: f.cat,
                  title: f.q,
                  subtitle: `Kategori: ${f.cat}`,
                  desc: 'Ketentuan dan regulasi akademik resmi FAPERTA INSTIPER',
                  url: f.url
                });
              }
            });
          }

          // Urutkan berdasarkan relevansi (score tertinggi di atas)
          pool.sort((a, b) => b.score - a.score);

          if (pool.length === 0) {
            dynamicResults?.classList.add('hidden');
            emptyState?.classList.remove('hidden');
          } else {
            emptyState?.classList.add('hidden');
            dynamicResults?.classList.remove('hidden');

            const topResult = pool[0];
            const hasTopRecommendation = topResult && topResult.score >= 70;

            dynamicResults.innerHTML = `
              ${hasTopRecommendation ? `
                <div class="p-3.5 mb-3 rounded-2xl bg-amber-50/80 border-2 border-amber-300 shadow-xs">
                  <div class="flex items-center justify-between gap-2">
                    <span class="inline-flex items-center gap-1.5 text-[11px] font-black text-amber-900 uppercase tracking-wide">
                      <span>🌟</span> Rekomendasi Paling Sesuai
                    </span>
                    <span class="text-[10px] font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full">Kesesuaian Tinggi</span>
                  </div>
                  <h4 class="text-sm font-extrabold text-[var(--leaf)] mt-1.5">${topResult.title}</h4>
                  <p class="text-xs text-[var(--ink)] mt-1 line-clamp-2">${topResult.desc}</p>
                  <div class="mt-3 flex items-center justify-between">
                    <span class="text-[11px] font-semibold text-[var(--muted)]">${topResult.subtitle}</span>
                    <a href="${topResult.url}" class="btn-cta text-xs py-1.5 px-3.5 inline-flex items-center gap-1 font-bold shadow-xs">
