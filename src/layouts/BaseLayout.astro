        // Indonesian Academic Synonyms & Typo Mapping
        const SYNONYMS = {
          'ijin': 'izin',
          'surat ijin': 'surat izin penelitian data',
          'surat izin': 'surat izin penelitian data',
          'transkrip': 'khs nilai kartu hasil studi',
          'cetak khs': 'khs',
          'sanggah': 'komplain nilai',
          'protes': 'komplain nilai',
          'ta': 'skripsi tugas akhir',
          'sidang': 'pendadaran skripsi ujian',
          'jadwal': 'kalender akademik perkuliahan',
          'peta': 'denah kampus instiper',
          'absen': 'presensi kuliah minimal 75',
          'hadir': 'presensi kuliah',
          'kehadiran': 'presensi kuliah',
          'remidi': 'ujian khusus',
          'remedial': 'ujian khusus',
          'perbaikan nilai': 'ujian khusus komplain nilai',
          'aktif': 'surat keterangan akademik aktif',
          'masih kuliah': 'surat keterangan akademik aktif',
          'ruang': 'peminjaman ruang fasilitas aula',
          'kelas': 'peminjaman ruang aula',
          'aula': 'peminjaman ruang fasilitas',
          'lab': 'laboratorium izin penelitian',
          'riset': 'penelitian izin data',
          'dosen': 'surat tugas dosen',
          'dpa': 'krs mengulang mata kuliah',
          'turnitin': 'batas turnitin etika ai skripsi'
        };

        function normalizeText(str) {
          return (str || '')
            .toLowerCase()
            .replace(/[^\w\s]/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
        }

        function calculateScore(rawQuery, item) {
          const normQ = normalizeText(rawQuery);
          if (!normQ) return 0;

          // Expand query with synonyms
          let expandedQ = normQ;
          for (const [k, v] of Object.entries(SYNONYMS)) {
            if (normQ.includes(k)) {
              expandedQ += ' ' + v;
            }
          }

          const qTokens = normQ.split(' ').filter(t => t.length > 1);
          const expTokens = expandedQ.split(' ').filter(t => t.length > 1);

          const titleNorm = normalizeText(item.title);
          const descNorm = normalizeText(item.desc);
          const catNorm = normalizeText(item.subtitle || item.category || '');
          const keywordsStr = (item.keywords || []).map(k => normalizeText(k)).join(' ');
          const combined = `${titleNorm} ${catNorm} ${keywordsStr} ${descNorm}`;

          let score = 0;

          // 1. Exact full query match in title
          if (titleNorm.includes(normQ)) score += 120;
          // 2. Exact full query in keywords
          if (keywordsStr.includes(normQ)) score += 100;
          // 3. Exact phrase in desc
          if (descNorm.includes(normQ)) score += 40;

          // 4. Token-level matching
          let matchedTokens = 0;
          qTokens.forEach(token => {
            if (combined.includes(token)) {
              matchedTokens++;
              if (titleNorm.includes(token)) score += 30;
              else if (keywordsStr.includes(token)) score += 25;
              else score += 15;
            }
          });

          // All original query tokens matched
          if (qTokens.length > 0 && matchedTokens === qTokens.length) {
            score += 60;
          }

          // 5. Synonym tokens matching
          expTokens.forEach(token => {
            if (!qTokens.includes(token) && combined.includes(token)) {
              score += 20;
            }
          });

          return score;
        }

        window.openPortalSearch = function(initialQuery) {
          openSearch();
          if (initialQuery && searchInput) {
            searchInput.value = initialQuery;
            runSearch(initialQuery);
          }
        };

        function runSearch(query) {
          const raw = (query || '').trim();
          if (!raw) {
            defaultHint?.classList.remove('hidden');
            dynamicResults?.classList.add('hidden');
            emptyState?.classList.add('hidden');
