---
import "../styles/global.css";
const { title = "Pusat Informasi Akademik", description = "Pusat informasi akademik FAPERTA INSTIPER Yogyakarta." } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800;900&family=Poppins:wght@600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title} — FAPERTA INSTIPER</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[#f7faf5]/95 backdrop-blur-md transition-all shadow-xs">
      <div class="container-shell flex min-h-[74px] items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 group" aria-label="FAPERTA INSTIPER, Beranda">
          <div class="relative grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[var(--leaf)] text-white shadow-sm ring-2 ring-[var(--gold)]/30 group-hover:ring-[var(--gold)] transition">
            <span class="text-base font-black tracking-tighter">FI</span>
            <span class="absolute -bottom-1 -right-1 h-3.5 w-3.5 rounded-full bg-[var(--gold)] border-2 border-white"></span>
          </div>
          <div class="leading-tight">
            <div class="flex items-center gap-1.5">
              <strong class="block text-sm font-black tracking-[.14em] text-[var(--leaf)]">FAPERTA</strong>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-[var(--leaf-soft)] text-[var(--leaf)]">S1</span>
            </div>
            <span class="text-[11px] font-semibold text-[var(--muted)] tracking-wider">INSTIPER YOGYAKARTA</span>
          </div>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button 
          id="menu-toggle" 
          class="touch-target inline-flex items-center justify-center rounded-xl border border-[var(--line)] bg-white p-2.5 text-sm font-bold text-[var(--ink)] shadow-xs transition hover:bg-[var(--leaf-soft)] hover:border-[var(--leaf)] md:hidden active:scale-95" 
          aria-expanded="false" 
          aria-controls="main-nav"
          aria-label="Buka navigasi menu"
        >
          <svg id="menu-icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <!-- Navigation Links -->
        <nav 
          id="main-nav" 
          class="hidden absolute left-0 right-0 top-[74px] border-b border-[var(--line)] bg-white/98 p-5 shadow-xl backdrop-blur-md md:static md:flex md:items-center md:gap-7 md:border-0 md:bg-transparent md:p-0 md:shadow-none transition-all duration-200" 
          aria-label="Navigasi utama"
        >
          <div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-6">
            <a 
              class:list={[
                "touch-target px-3 py-2 text-sm font-bold rounded-lg transition",
                currentPath === "/" 
                  ? "bg-[var(--leaf-soft)] text-[var(--leaf)] md:bg-transparent md:text-[var(--leaf)] md:border-b-2 md:border-[var(--leaf)] md:rounded-none" 
                  : "text-[var(--muted)] hover:text-[var(--leaf)] hover:bg-[var(--leaf-soft)]/50 md:hover:bg-transparent"
              ]} 
              href="/"
            >
              Beranda
            </a>
            <a 
              class:list={[
                "touch-target px-3 py-2 text-sm font-bold rounded-lg transition",
                currentPath.startsWith("/unduhan") 
                  ? "bg-[var(--leaf-soft)] text-[var(--leaf)] md:bg-transparent md:text-[var(--leaf)] md:border-b-2 md:border-[var(--leaf)] md:rounded-none" 
                  : "text-[var(--muted)] hover:text-[var(--leaf)] hover:bg-[var(--leaf-soft)]/50 md:hover:bg-transparent"
              ]} 
              href="/unduhan"
            >
              Unduhan Dokumen
            </a>
            <a 
              class:list={[
                "touch-target px-3 py-2 text-sm font-bold rounded-lg transition",
                currentPath.startsWith("/faq") 
                  ? "bg-[var(--leaf-soft)] text-[var(--leaf)] md:bg-transparent md:text-[var(--leaf)] md:border-b-2 md:border-[var(--leaf)] md:rounded-none" 
                  : "text-[var(--muted)] hover:text-[var(--leaf)] hover:bg-[var(--leaf-soft)]/50 md:hover:bg-transparent"
              ]} 
              href="/faq"
            >
              FAQ & Regulasi
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-[var(--line)] bg-[#ecf3e8]">
      <div class="container-shell py-12">
        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <div class="flex items-center gap-2.5">
              <span class="grid h-9 w-9 place-items-center rounded-lg bg-[var(--leaf)] text-xs font-black text-white">FI</span>
              <div>
                <p class="text-sm font-black tracking-wider text-[var(--ink)]">FAPERTA INSTIPER</p>
                <p class="text-[11px] text-[var(--muted)]">Fakultas Pertanian</p>
              </div>
            </div>
            <p class="mt-3 max-w-sm text-xs leading-relaxed text-[var(--muted)]">
              Portal informasi akademik resmi Fakultas Pertanian INSTIPER Yogyakarta. Memudahkan akses panduan, kurikulum, kalender, dan regulasi akademik.
            </p>
          </div>
          
          <div>
            <p class="eyebrow text-xs font-bold text-[var(--leaf)]">Program Studi</p>
            <ul class="mt-3 space-y-2 text-xs font-bold text-[var(--ink)]">
              <li>• S1 Agroteknologi (Minat Agronomi, Ilmu Tanah, HPT)</li>
              <li>• S1 Agribisnis (Manajemen & Bisnis Pertanian)</li>
            </ul>
          </div>

          <div>
            <p class="eyebrow text-xs font-bold text-[var(--leaf)]">Kampus INSTIPER Yogyakarta</p>
            <p class="mt-3 text-xs leading-relaxed text-[var(--muted)]">
              Jl. Nanggulan, Maguwoharjo, Kec. Depok, Kabupaten Sleman, D.I. Yogyakarta 55282
            </p>
            <a href="mailto:akademik@instiperjogja.ac.id" class="mt-2 inline-block text-xs font-bold text-[var(--leaf)] hover:underline">
              akademik@instiperjogja.ac.id ↗
            </a>
          </div>
        </div>

        <div class="mt-10 border-t border-[var(--line)] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--muted)]">
          <p>© 2026 Fakultas Pertanian INSTIPER Yogyakarta. Hak Cipta Dilindungi.</p>
          <p class="text-[11px]">Satu pintu informasi akademik sivitas akademika.</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('#menu-toggle');
      const nav = document.querySelector('#main-nav');
      const iconOpen = document.querySelector('#menu-icon-open');
      const iconClose = document.querySelector('#menu-icon-close');

      toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        nav?.classList.toggle('hidden', isOpen);
        iconOpen?.classList.toggle('hidden', !isOpen);
        iconClose?.classList.toggle('hidden', isOpen);
      });

      // Tutup menu otomatis saat link navigasi di-klik di mobile
      nav?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 768) {
            toggle?.setAttribute('aria-expanded', 'false');
            nav?.classList.add('hidden');
            iconOpen?.classList.remove('hidden');
            iconClose?.classList.add('hidden');
          }
        });
      });
    </script>
  </body>
</html>
