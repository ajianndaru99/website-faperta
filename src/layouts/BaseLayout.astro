                    </a>
                  </div>
                </div>
              ` : ''}

              <div class="space-y-2">
                ${pool.slice(hasTopRecommendation ? 1 : 0, 10).map(r => `
                  <a href="${r.url}" class="block p-3.5 rounded-2xl border border-[var(--line)] bg-white hover:border-[var(--leaf)] hover:bg-[var(--leaf-soft)]/40 transition group">
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-xs font-bold text-[var(--leaf)] group-hover:underline">${r.title}</span>
                      <span class="${r.badge} text-[9px] py-0.5 px-1.5 uppercase">${r.badgeLabel}</span>
                    </div>
                    <p class="text-[11px] font-semibold text-[var(--muted)] mt-0.5">${r.subtitle}</p>
                    <p class="text-xs text-[var(--ink)] mt-1.5 line-clamp-1">${r.desc}</p>
                  </a>
                `).join('')}
              </div>
            `;
          }
        }

        // 3. Update Admin Unread Badge Real-Time
        function updateAdminBadge() {
          try {
            const raw = localStorage.getItem('portal_faperta_tickets');
            let tickets = raw ? JSON.parse(raw) : null;
            if (!tickets) {
              // Hitung dari data tiket awal (ada 2 unread)
              tickets = [
                { isNewForAdmin: true },
                { isNewForAdmin: true },
                { isNewForAdmin: false },
                { isNewForAdmin: false }
              ];
            }
            const unreadCount = tickets.filter(t => t.isNewForAdmin).length;
            const headerBadge = document.getElementById('admin-unread-badge');
            const drawerBadge = document.getElementById('drawer-admin-badge');

            if (unreadCount > 0) {
              if (headerBadge) {
                headerBadge.textContent = unreadCount;
                headerBadge.classList.remove('hidden');
              }
              if (drawerBadge) {
                drawerBadge.textContent = unreadCount;
                drawerBadge.classList.remove('hidden');
              }
            } else {
              headerBadge?.classList.add('hidden');
              drawerBadge?.classList.add('hidden');
            }
          } catch (e) {}
        }

        updateAdminBadge();
      });
    </script>
  </body>
</html>
