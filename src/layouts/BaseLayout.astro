---
import "../styles/global.css";
import { PORTAL_SERVICES, PORTAL_DOCUMENTS } from "../data/portalData";
const { 
  title = "Pusat Informasi Akademik", 
  description = "Pusat informasi akademik FAPERTA INSTIPER Yogyakarta.",
  isStandaloneAdmin = false
} = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800;900&family=Poppins:wght@600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title} — FAPERTA INSTIPER</title>
  </head>
  <body class={`min-h-screen flex flex-col ${isStandaloneAdmin ? 'bg-slate-50 text-slate-900' : 'bg-[#fafcf8] text-[var(--ink)]'}`}>
    {!isStandaloneAdmin && (
      <>
        <header class="sticky top-0 z-40 border-b border-[var(--line)] bg-[#f7faf5]/95 backdrop-blur-md transition-all shadow-xs">
      <div class="container-shell flex min-h-[74px] items-center justify-between gap-3">
        
        <!-- Sisi Kiri: Tombol Hamburger Mobile + Brand Logo + Desktop Nav -->
        <div class="flex items-center gap-3 md:gap-7">
          <!-- Tombol Hamburger Mobile -->
          <button 
            id="menu-toggle" 
            class="touch-target inline-flex items-center justify-center rounded-xl border border-[var(--line)] bg-white p-2.5 text-sm font-bold text-[var(--ink)] shadow-xs transition hover:bg-[var(--leaf-soft)] hover:border-[var(--leaf)] md:hidden active:scale-95" 
            aria-expanded="false" 
            aria-controls="mobile-drawer"
            aria-label="Buka navigasi menu"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>

          <!-- Brand Logo -->
          <a href="/" class="flex items-center gap-2.5 sm:gap-3 group" aria-label="FAPERTA INSTIPER, Beranda">
            <img 
              src="/logo-instiper.webp" 
              alt="Logo INSTIPER Yogyakarta" 
              width="42" 
              height="42" 
              fetchpriority="high"
              loading="eager"
              decoding="async" 
              class="h-10 w-10 sm:h-11 sm:w-11 shrink-0 object-contain drop-shadow-xs group-hover:scale-105 transition-transform" 
            />
            <div class="flex flex-col justify-center">
              <span class="text-[14px] sm:text-base font-black tracking-[.14em] text-[var(--leaf)] leading-none">FAPERTA</span>
              <span class="text-[10px] sm:text-[11px] font-semibold text-[var(--muted)] tracking-[.15em] uppercase leading-none mt-1">INSTIPER YOGYAKARTA</span>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex md:items-center md:gap-4 lg:gap-5" aria-label="Navigasi utama">
            <a 
              class:list={[
                "touch-target px-2.5 py-2 text-sm font-bold rounded-lg transition",
                currentPath === "/" 
                  ? "text-[var(--leaf)] border-b-2 border-[var(--leaf)] rounded-none" 
                  : "text-[var(--muted)] hover:text-[var(--leaf)]"
              ]} 
              href="/"
            >
              Beranda
            </a>
            <a 
              class:list={[
                "touch-target px-2.5 py-2 text-sm font-bold rounded-lg transition flex items-center gap-1.5",
                currentPath.startsWith("/layanan") && !currentPath.includes("cek-status")
                  ? "text-[var(--leaf)] border-b-2 border-[var(--leaf)] rounded-none" 
                  : "text-[var(--muted)] hover:text-[var(--leaf)]"
              ]} 
              href="/layanan"
            >
              <span>Layanan</span>
              <span class="inline-block rounded-full bg-[var(--gold)]/25 text-[var(--leaf)] text-[10px] font-extrabold px-1.5 py-0.5">12 Menu</span>
            </a>
            <a 
              class:list={[
                "touch-target px-2.5 py-2 text-sm font-bold rounded-lg transition",
                currentPath.startsWith("/unduhan") 
                  ? "text-[var(--leaf)] border-b-2 border-[var(--leaf)] rounded-none" 
                  : "text-[var(--muted)] hover:text-[var(--leaf)]"
              ]} 
              href="/unduhan"
            >
              Unduhan
            </a>
            <a 
              class:list={[
                "touch-target px-2.5 py-2 text-sm font-bold rounded-lg transition",
                currentPath.startsWith("/faq") 
                  ? "text-[var(--leaf)] border-b-2 border-[var(--leaf)] rounded-none" 
                  : "text-[var(--muted)] hover:text-[var(--leaf)]"
              ]} 
              href="/faq"
            >
              FAQ
            </a>
          </nav>
        </div>

        <!-- Sisi Kanan: Search + Lacak NIM -->
        <div class="flex items-center gap-2 sm:gap-2.5">
          <!-- Tombol Global Live Search -->
          <button 
            id="global-search-btn" 
            type="button"
            class="touch-target inline-flex items-center gap-2 rounded-xl border border-[var(--line)] bg-white px-3 py-1.5 text-xs font-bold text-[var(--muted)] shadow-xs hover:border-[var(--leaf)] hover:text-[var(--leaf)] transition active:scale-95"
            aria-label="Cari layanan, dokumen, aturan"
            title="Cari Cepat (Tekan Ctrl + K)"
          >
            <svg class="h-4 w-4 text-[var(--leaf)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="hidden sm:inline">Cari...</span>
            <kbd class="hidden md:inline-block rounded bg-[var(--paper)] px-1.5 py-0.5 text-[10px] font-mono text-[var(--muted)] border border-[var(--line)]">Ctrl K</kbd>
          </button>

          <!-- Shortcut Deteksi NIM / Cek Status -->
          <a 
            href="/layanan/cek-status" 
            class:list={[
              "touch-target inline-flex items-center gap-1.5 rounded-xl border px-3.5 py-1.5 text-xs font-bold shadow-xs transition",
              currentPath.startsWith("/layanan/cek-status")
                ? "border-[var(--leaf)] bg-[var(--leaf-soft)] text-[var(--leaf)]"
                : "border-[var(--line)] bg-white text-[var(--leaf)] hover:border-[var(--leaf)] hover:bg-[var(--leaf-soft)]"
            ]}
            title="Lacak Progres Surat Berdasarkan NIM atau Nomor Tiket"
          >
            <span class="text-sm">📑</span>
            <span class="hidden sm:inline">Lacak NIM</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Global Live Search Modal (Command Palette) -->
    <div id="search-modal-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden transition-opacity duration-200 opacity-0" aria-hidden="true"></div>
    <div 
      id="search-modal" 
      class="fixed inset-x-4 top-16 sm:inset-x-auto sm:left-1/2 sm:-translate-x-1/2 sm:w-full sm:max-w-2xl bg-white z-50 rounded-3xl shadow-2xl border border-[var(--line)] hidden transform scale-95 transition-all duration-200 overflow-hidden"
      role="dialog" 
      aria-modal="true"
      aria-label="Pencarian Cepat Portal FAPERTA"
    >
      <!-- Input Search Box -->
      <div class="p-4 sm:p-5 border-b border-[var(--line)] flex items-center gap-3 bg-[#fbfdfa]">
        <svg class="h-5 w-5 text-[var(--leaf)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input 
          type="text" 
          id="global-search-input" 
          placeholder="Ketik kata kunci (misal: KHS, Skripsi, Ujian Khusus, Kurikulum, Presensi)..." 
          class="w-full bg-transparent text-base sm:text-lg font-medium text-[var(--ink)] placeholder:text-gray-400 outline-none border-none"
          autocomplete="off"
        />
        <button id="search-modal-close" class="rounded-lg p-1.5 text-gray-400 hover:text-[var(--ink)] hover:bg-gray-100 transition" aria-label="Tutup pencarian">
          <kbd class="text-xs font-mono bg-gray-100 border border-gray-200 px-1.5 py-0.5 rounded">ESC</kbd>
        </button>
      </div>

      <!-- Quick Filter Chips -->
      <div class="px-5 py-2.5 bg-gray-50 border-b border-[var(--line)] flex items-center gap-2 overflow-x-auto text-xs">
        <span class="text-[var(--muted)] font-semibold shrink-0">Filter Cepat:</span>
        <button type="button" data-filter="all" class="search-chip px-2.5 py-1 rounded-lg bg-[var(--leaf)] text-white font-bold shrink-0">Semua</button>
        <button type="button" data-filter="layanan" class="search-chip px-2.5 py-1 rounded-lg bg-white border border-[var(--line)] text-[var(--ink)] hover:border-[var(--leaf)] shrink-0 font-medium">📋 Layanan</button>
        <button type="button" data-filter="dokumen" class="search-chip px-2.5 py-1 rounded-lg bg-white border border-[var(--line)] text-[var(--ink)] hover:border-[var(--leaf)] shrink-0 font-medium">📥 Unduhan</button>
        <button type="button" data-filter="faq" class="search-chip px-2.5 py-1 rounded-lg bg-white border border-[var(--line)] text-[var(--ink)] hover:border-[var(--leaf)] shrink-0 font-medium">💡 FAQ</button>
      </div>

      <!-- Search Results Area -->
      <div id="search-results-list" class="max-h-[60vh] overflow-y-auto p-4 sm:p-5 space-y-2">
        <!-- Default State / Rekomendasi -->
        <div id="search-default-hint" class="text-xs text-[var(--muted)] py-2">
          <p class="font-bold text-[var(--leaf)] mb-2 uppercase tracking-wider text-[11px]">Paling Sering Dicari:</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <a href="/layanan/permohonan-khs" class="p-3 rounded-2xl border border-[var(--line)] hover:border-[var(--leaf)] hover:bg-[var(--leaf-soft)]/50 transition flex items-center gap-3">
              <span class="text-lg">📄</span>
              <div>
                <p class="font-bold text-[var(--ink)]">Permohonan KHS Online</p>
                <p class="text-[11px] text-[var(--muted)]">Estimasi 1–2 hari kerja</p>
              </div>
            </a>
            <a href="/layanan/ujian-khusus" class="p-3 rounded-2xl border border-[var(--line)] hover:border-[var(--leaf)] hover:bg-[var(--leaf-soft)]/50 transition flex items-center gap-3">
              <span class="text-lg">📝</span>
              <div>
                <p class="font-bold text-[var(--ink)]">Pengajuan Ujian Khusus</p>
                <p class="text-[11px] text-[var(--muted)]">Khusus mahasiswa tingkat akhir</p>
              </div>
            </a>
            <a href="/layanan/cek-status" class="p-3 rounded-2xl border border-[var(--line)] hover:border-[var(--leaf)] hover:bg-[var(--leaf-soft)]/50 transition flex items-center gap-3">
              <span class="text-lg">🔍</span>
              <div>
                <p class="font-bold text-[var(--ink)]">Pendeteksi & Lacak NIM</p>
                <p class="text-[11px] text-[var(--muted)]">Cek progres semua surat Anda</p>
              </div>
            </a>
            <a href="/unduhan" class="p-3 rounded-2xl border border-[var(--line)] hover:border-[var(--leaf)] hover:bg-[var(--leaf-soft)]/50 transition flex items-center gap-3">
              <span class="text-lg">📥</span>
              <div>
                <p class="font-bold text-[var(--ink)]">Buku Panduan & Template</p>
                <p class="text-[11px] text-[var(--muted)]">Format skripsi & kurikulum</p>
              </div>
            </a>
          </div>
        </div>

        <!-- Dynamic Results Container -->
        <div id="search-dynamic-results" class="space-y-2 hidden"></div>

        <!-- No Results -->
        <div id="search-empty-state" class="hidden py-8 text-center text-xs text-[var(--muted)]">
          <span class="text-3xl">🔎</span>
          <p class="mt-2 text-sm font-bold text-[var(--ink)]">Tidak ada hasil yang cocok</p>
          <p class="mt-1">Coba gunakan kata kunci lain atau pilih dari menu layanan.</p>
        </div>
      </div>
    </div>

    <!-- Drawer Mobile -->
    <div id="drawer-backdrop" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 hidden transition-opacity duration-300 opacity-0 md:hidden" aria-hidden="true"></div>
    <aside 
      id="mobile-drawer" 
      class="fixed inset-y-0 left-0 w-72 sm:w-80 bg-white z-50 shadow-2xl flex flex-col justify-between transform -translate-x-full transition-transform duration-300 ease-out md:hidden"
      aria-label="Menu navigasi samping kiri"
    >
      <div class="p-6 overflow-y-auto">
        <!-- Header Drawer -->
        <div class="flex items-center justify-between border-b border-[var(--line)] pb-5">
          <div class="flex items-center gap-2.5">
            <img 
              src="/logo-instiper.webp" 
              alt="Logo INSTIPER" 
              width="36" 
              height="36" 
              loading="eager" 
              decoding="async" 
              class="h-9 w-9 shrink-0 object-contain drop-shadow-xs" 
            />
            <div class="flex flex-col justify-center">
              <span class="text-sm font-black tracking-[.14em] text-[var(--leaf)] leading-none">FAPERTA</span>
              <span class="text-[10px] font-semibold text-[var(--muted)] tracking-[.15em] uppercase leading-none mt-1">INSTIPER YOGYAKARTA</span>
            </div>
          </div>
          <button id="drawer-close" class="rounded-lg p-2 text-gray-400 hover:text-[var(--leaf)] hover:bg-[var(--leaf-soft)] transition" aria-label="Tutup menu">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Menu Utama -->
        <nav class="mt-6 space-y-1.5" aria-label="Tautan drawer navigasi">
          <a 
            class:list={[
              "flex items-center gap-3 px-3.5 py-3 text-sm font-bold rounded-xl transition",
              currentPath === "/" 
                ? "bg-[var(--leaf-soft)] text-[var(--leaf)] font-black" 
                : "text-[var(--ink)] hover:bg-[var(--leaf-soft)]/60 hover:text-[var(--leaf)]"
            ]} 
            href="/"
          >
            <span class="text-base">🏠</span>
            <span>Beranda</span>
          </a>

          <a 
            class:list={[
              "flex items-center justify-between px-3.5 py-3 text-sm font-bold rounded-xl transition",
              currentPath.startsWith("/layanan") && !currentPath.includes("cek-status")
                ? "bg-[var(--leaf-soft)] text-[var(--leaf)] font-black" 
                : "text-[var(--ink)] hover:bg-[var(--leaf-soft)]/60 hover:text-[var(--leaf)]"
            ]} 
            href="/layanan"
          >
            <div class="flex items-center gap-3">
              <span class="text-base">📋</span>
              <span>12 Layanan Akademik</span>
            </div>
            <span class="badge-online text-[9px] py-0.5 px-1.5">Lengkap</span>
          </a>

          <a 
            class:list={[
              "flex items-center justify-between px-3.5 py-3 text-sm font-bold rounded-xl transition",
              currentPath.startsWith("/layanan/cek-status")
                ? "bg-[var(--leaf-soft)] text-[var(--leaf)] font-black" 
                : "text-[var(--ink)] hover:bg-[var(--leaf-soft)]/60 hover:text-[var(--leaf)]"
            ]} 
            href="/layanan/cek-status"
          >
            <div class="flex items-center gap-3">
              <span class="text-base">🔍</span>
              <span>Lacak Progres NIM</span>
            </div>
          </a>

          <a 
            class:list={[
              "flex items-center gap-3 px-3.5 py-3 text-sm font-bold rounded-xl transition",
              currentPath.startsWith("/unduhan") 
                ? "bg-[var(--leaf-soft)] text-[var(--leaf)] font-black" 
                : "text-[var(--ink)] hover:bg-[var(--leaf-soft)]/60 hover:text-[var(--leaf)]"
            ]} 
            href="/unduhan"
          >
            <span class="text-base">📥</span>
            <span>Unduhan Dokumen</span>
          </a>

          <a 
            class:list={[
              "flex items-center gap-3 px-3.5 py-3 text-sm font-bold rounded-xl transition",
              currentPath.startsWith("/faq") 
                ? "bg-[var(--leaf-soft)] text-[var(--leaf)] font-black" 
                : "text-[var(--ink)] hover:bg-[var(--leaf-soft)]/60 hover:text-[var(--leaf)]"
            ]} 
            href="/faq"
          >
            <span class="text-base">💡</span>
            <span>FAQ & Regulasi</span>
          </a>
        </nav>
      </div>

      <!-- Footer Drawer -->
      <div class="p-6 border-t border-[var(--line)] bg-[#f7faf5]">
        <p class="text-[11px] font-bold text-[var(--leaf)]">Fakultas Pertanian INSTIPER</p>
        <p class="text-[10px] text-[var(--muted)] mt-0.5">YOGYAKARTA</p>
      </div>
    </aside>
      </>
    )}

    <main class="flex-1">
      <slot />
    </main>

    {!isStandaloneAdmin && (
    <footer class="mt-20 border-t border-[var(--line)] bg-[#ecf3e8]">
      <div class="container-shell py-12">
        <div class="grid gap-8 md:grid-cols-4">
          <!-- Kolom 1: Logo & Teks Footer Sesuai Permintaan (FAPERTA INSTIPER / YOGYAKARTA) -->
          <div>
            <div class="flex items-center gap-2.5">
              <img 
                src="/logo-instiper.webp" 
                alt="Logo INSTIPER" 
                width="36" 
                height="36" 
                loading="lazy" 
                decoding="async" 
                class="h-9 w-9 shrink-0 object-contain drop-shadow-xs" 
              />
              <div class="flex flex-col justify-center">
                <span class="text-sm font-black tracking-[.12em] text-[var(--ink)] leading-none">FAPERTA INSTIPER</span>
                <span class="text-[10px] font-semibold text-[var(--muted)] tracking-[.14em] uppercase leading-none mt-1">YOGYAKARTA</span>
              </div>
            </div>
            <p class="mt-3 max-w-sm text-xs leading-relaxed text-[var(--muted)]">
              Portal informasi akademik dan layanan mandiri resmi Fakultas Pertanian INSTIPER Yogyakarta.
            </p>
          </div>
          
          <div>
            <p class="eyebrow text-xs font-bold text-[var(--leaf)]">Layanan Pokok</p>
            <ul class="mt-3 space-y-2 text-xs font-medium text-[var(--ink)]">
              <li><a href="/layanan/permohonan-khs" class="hover:text-[var(--leaf)] hover:underline font-bold text-[var(--leaf)]">• Permohonan KHS Online</a></li>
              <li><a href="/layanan/komplain-nilai" class="hover:text-[var(--leaf)] hover:underline">• Verifikasi & Komplain Nilai</a></li>
              <li><a href="/layanan/ujian-khusus" class="hover:text-[var(--leaf)] hover:underline">• Pengajuan Ujian Khusus</a></li>
              <li><a href="/layanan/cek-status" class="hover:text-[var(--leaf)] hover:underline font-bold text-[var(--leaf)]">• Pendeteksi NIM & Cek Status Tiket</a></li>
            </ul>
          </div>

          <div>
            <p class="eyebrow text-xs font-bold text-[var(--leaf)]">Program Studi</p>
            <ul class="mt-3 space-y-2 text-xs font-bold text-[var(--ink)]">
              <li>• S1 Agroteknologi</li>
              <li>• S1 Agribisnis</li>
            </ul>
          </div>

          <div>
            <p class="eyebrow text-xs font-bold text-[var(--leaf)]">Kampus INSTIPER</p>
            <p class="mt-3 text-xs leading-relaxed text-[var(--muted)]">
              Jl. Nanggulan, Maguwoharjo, Kec. Depok, Sleman, D.I. Yogyakarta 55282
            </p>
            <a href="mailto:akademik@instiperjogja.ac.id" class="mt-2 inline-block text-xs font-bold text-[var(--leaf)] hover:underline">
              akademik@instiperjogja.ac.id ↗
            </a>
          </div>
        </div>

        <div class="mt-10 border-t border-[var(--line)] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--muted)]">
          <p>© 2026 Fakultas Pertanian INSTIPER Yogyakarta. Hak Cipta Dilindungi.</p>
          <div class="flex items-center gap-3 text-[11px]">
            <span>Satu pintu informasi akademik sivitas akademika.</span>
            <span>·</span>
            <a href="/admin" class="text-gray-400 hover:text-[var(--leaf)] transition hover:underline flex items-center gap-1" title="Akses Masuk Staf Administrasi">
              <span>🔒</span> Akses Staf
            </a>
          </div>
        </div>
      </div>
    </footer>
    )}

    <!-- Container Khusus Cetak Tiket & Tanda Terima Resmi Mahasiswa -->
    <div id="printable-ticket-container" class="hidden"></div>

    <!-- Global Client Script (Search Palette + Unread Admin Counter + Drawer + Official Ticket Printing) -->
    <script is:inline define:vars={{ searchServices: PORTAL_SERVICES, searchDocuments: PORTAL_DOCUMENTS }}>
      // ==========================================
      // SISTEM CETAK RESMI TIKET & TANDA TERIMA MAHASISWA
      // Fokus eksklusif hanya pada lembar tiket resmi (tanpa halaman web)
      // ==========================================
      window.printOfficialTicket = function(ticketOrCode) {
        let ticket = null;

        if (typeof ticketOrCode === 'string') {
          try {
            const raw = localStorage.getItem('portal_faperta_tickets');
            const allTickets = raw ? JSON.parse(raw) : [];
            ticket = allTickets.find(t => t.kode && t.kode.toUpperCase() === ticketOrCode.toUpperCase());
          } catch (e) {}

          if (!ticket) {
            ticket = {
              kode: ticketOrCode,
              nama: 'Mahasiswa Pemohon',
              nim: '-',
              prodi: 'Fakultas Pertanian INSTIPER',
              layananNama: 'Layanan Administrasi Akademik',
              keperluan: 'Keperluan Administrasi',
              status: 'Tercatat di Sistem',
              tanggal: new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })
            };
          }
        } else if (typeof ticketOrCode === 'object' && ticketOrCode !== null) {
          ticket = ticketOrCode;
        }

        if (!ticket) return;

        const printContainer = document.getElementById('printable-ticket-container');
        if (!printContainer) return;

        // Tentukan status badge & warna
        const isDone = ticket.status === 'Selesai (Siap Diambil)' || ticket.status === 'Selesai' || ticket.statusStep === 3;
        const isRejected = ticket.status === 'Ditolak' || ticket.statusStep === -1;
        const isProcess = ticket.status === 'Proses Verifikasi' || ticket.statusStep === 2;

        let statusBg = '#fef3c7';
        let statusColor = '#92400e';
        let statusBorder = '#fde68a';
        let statusLabel = ticket.status || 'Antrean Loket';

        if (isDone) {
          statusBg = '#ecfdf5';
          statusColor = '#065f46';
          statusBorder = '#a7f3d0';
          statusLabel = '✓ Selesai (Siap Diambil di Loket 1)';
        } else if (isRejected) {
          statusBg = '#fff1f2';
          statusColor = '#9f1239';
