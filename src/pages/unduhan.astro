---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PORTAL_DOCUMENTS } from "../data/portalData";
---
<BaseLayout title="Unduhan Dokumen Resmi" description="Koleksi buku panduan, kalender akademik, denah kampus, dan template skripsi FAPERTA INSTIPER Yogyakarta.">
  <!-- Banner Header -->
  <section class="grid-paper border-b border-[var(--line)]">
    <div class="container-shell py-12 sm:py-16">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--leaf)]/20 bg-[var(--leaf-soft)] px-3 py-1 text-xs font-bold text-[var(--leaf)]">
          <span class="h-2 w-2 rounded-full bg-[var(--gold)]"></span>
          Perpustakaan Berkas Digital FAPERTA
        </div>
        <h1 class="display-title mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--leaf)] leading-tight">
          Dokumen & Template Akademik Resmi
        </h1>
        <p class="mt-3 text-sm sm:text-base leading-relaxed text-[var(--ink)]">
          Unduh buku panduan akademik, kurikulum program studi, kalender perkuliahan, denah kampus, serta format baku naskah proposal & skripsi untuk mahasiswa FAPERTA.
        </p>
      </div>

      <!-- Quick Search Bar -->
      <div class="mt-8 max-w-lg">
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-gray-400 text-sm">
            🔍
          </span>
          <input 
            type="text" 
            id="doc-search-input" 
            placeholder="Cari berkas (misal: panduan, skripsi, kurikulum, denah)..." 
            class="w-full rounded-2xl border-2 border-[var(--line)] bg-white pl-10 pr-4 py-3 text-xs sm:text-sm font-medium text-[var(--ink)] placeholder:text-gray-400 focus:border-[var(--leaf)] focus:outline-none transition shadow-xs"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Documents Grid Section -->
  <section id="koleksi-berkas" class="container-shell py-12">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-[var(--line)] text-xs text-[var(--muted)]">
      <div>
        Menampilkan <strong id="doc-counter" class="text-[var(--leaf)]">{PORTAL_DOCUMENTS.length}</strong> dokumen resmi
      </div>
      <div class="text-right">
        Format: PDF · DOCX · JPG · Google Drive
      </div>
    </div>

    <div id="documents-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {PORTAL_DOCUMENTS.map((doc) => (
        <div 
          class="doc-card rounded-3xl border-2 border-[var(--line)] bg-white p-6 shadow-xs hover:border-[var(--leaf)] hover:shadow-md transition flex flex-col justify-between"
          data-title={doc.title.toLowerCase()}
          data-category={doc.category.toLowerCase()}
          data-desc={doc.desc.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-[var(--line)] pb-4">
              <span class="text-xs font-bold text-[var(--muted)] uppercase tracking-wider">
                {doc.category}
              </span>
              <span class:list={[
                "inline-block rounded-md px-2 py-0.5 text-[10px] font-black",
                doc.isExternal ? "bg-amber-100 text-amber-900 border border-amber-300" : "bg-[var(--leaf-soft)] text-[var(--leaf)]"
              ]}>
                {doc.format}
              </span>
            </div>

            <div class="mt-4 flex items-start gap-3.5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-[var(--paper)] text-lg text-[var(--leaf)] border border-[var(--line)]">
                {doc.icon}
              </span>
              <div>
                <h2 class="text-base font-black text-[var(--ink)] leading-snug">
                  {doc.title}
                </h2>
                <p class="text-[11px] font-semibold text-[var(--leaf)] mt-0.5">
                  {doc.meta}
                </p>
              </div>
            </div>

            <p class="mt-3 text-xs leading-relaxed text-[var(--muted)]">
              {doc.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[var(--line)]">
            {doc.isExternal ? (
              <a 
                href={doc.file} 
                target="_blank"
                rel="noopener noreferrer"
                class="w-full btn-cta text-xs py-2.5 px-4 bg-[#1b3d2b] hover:bg-[#132c1f] text-white flex items-center justify-center gap-2 font-bold shadow-xs"
              >
                <span>Buka di Google Drive</span>
                <span aria-hidden="true">↗</span>
              </a>
            ) : doc.format === 'JPG' ? (
              <div class="grid grid-cols-2 gap-2">
                <a 
                  href={doc.file} 
                  target="_blank"
                  class="btn-secondary text-xs py-2 px-2 bg-white hover:bg-[var(--leaf-soft)] flex items-center justify-center gap-1 font-bold"
                >
                  <span>Lihat Denah</span>
                  <span aria-hidden="true">👁️</span>
                </a>
                <a 
                  href={doc.file} 
                  download="Denah-Kampus-INSTIPER-Yogyakarta.jpg"
                  class="btn-cta text-xs py-2 px-2 flex items-center justify-center gap-1 font-bold shadow-xs"
                >
                  <span>Unduh JPG</span>
                  <span aria-hidden="true">↓</span>
                </a>
              </div>
            ) : (
              <a 
                href={doc.file} 
                download 
                class="w-full btn-secondary text-xs py-2.5 px-4 bg-white hover:bg-[var(--leaf-soft)] hover:border-[var(--leaf)] flex items-center justify-center gap-2 font-bold"
              >
                <span>Unduh Berkas {doc.format}</span>
                <span aria-hidden="true">↓</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-doc-alert" class="hidden rounded-3xl border border-dashed border-gray-300 bg-white p-12 text-center my-8">
      <span class="text-3xl">📂</span>
      <h3 class="mt-3 text-base font-bold text-[var(--ink)]">Dokumen Tidak Ditemukan</h3>
      <p class="mt-1 text-xs text-[var(--muted)]">
        Tidak ada berkas yang sesuai dengan kata kunci Anda.
      </p>
    </div>
  </section>

  <!-- Client Script for Live Filtering -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('doc-search-input');
      const cards = document.querySelectorAll('.doc-card');
      const counter = document.getElementById('doc-counter');
      const emptyAlert = document.getElementById('empty-doc-alert');

      searchInput?.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        let count = 0;

        cards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const category = card.getAttribute('data-category') || '';
          const desc = card.getAttribute('data-desc') || '';

          if (!q || title.includes(q) || category.includes(q) || desc.includes(q)) {
            card.classList.remove('hidden');
            count++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (counter) counter.textContent = count;
        if (count === 0) {
          emptyAlert?.classList.remove('hidden');
        } else {
          emptyAlert?.classList.add('hidden');
        }
      });
    });
  </script>
</BaseLayout>
