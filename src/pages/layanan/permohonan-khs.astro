---
import BaseLayout from "../../layouts/BaseLayout.astro";

const semesterList = Array.from({ length: 12 }, (_, i) => `Semester ${i + 1}`);
---
<BaseLayout title="Formulir Permohonan KHS" description="Layanan pengajuan penerbitan salinan Kartu Hasil Studi (KHS) dan transkrip nilai resmi FAPERTA INSTIPER Yogyakarta.">
  <!-- Header Banner -->
  <section class="grid-paper border-b border-[var(--line)]">
    <div class="container-shell py-8 sm:py-12">
      <nav class="flex items-center gap-2 text-xs font-semibold text-[var(--muted)] mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--leaf)]">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-[var(--leaf)]">Layanan Akademik</a>
        <span>/</span>
        <span class="text-[var(--leaf)] font-bold">Permohonan KHS (Poin 2)</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-[var(--leaf)]/20 bg-[var(--leaf-soft)] px-3 py-1 text-xs font-bold text-[var(--leaf)]">
            <span class="h-2 w-2 rounded-full bg-[var(--gold)]"></span>
            Layanan Mandiri Mahasiswa
          </div>
          <h1 class="display-title mt-3 text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--leaf)] leading-tight">
            Permohonan Salinan KHS
          </h1>
          <p class="mt-3 text-sm sm:text-base leading-relaxed text-[var(--ink)]">
            Pengajuan resmi penerbitan salinan <strong>Kartu Hasil Studi (KHS)</strong> atau transkrip nilai akademik sementara untuk keperluan Ujian Khusus, Aktif Kembali, beasiswa, maupun arsip kedinasan.
          </p>
        </div>

        <!-- Shortcut Status -->
        <div class="rounded-2xl border border-[var(--line)] bg-white p-4 shadow-xs flex items-center gap-4">
          <div class="grid h-10 w-10 place-items-center rounded-xl bg-[var(--leaf-soft)] text-lg text-[var(--leaf)] font-bold">
            🔍
          </div>
          <div>
            <p class="text-xs font-bold text-[var(--ink)]">Sudah pernah mengajukan?</p>
            <a href="/layanan/cek-status" class="text-xs font-black text-[var(--leaf)] hover:underline inline-flex items-center gap-1">
              Cek Status Tiket Anda →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Notice Banner: Pemisahan KHS & Ujian Khusus -->
  <div class="bg-[var(--leaf-soft)]/50 border-b border-[var(--leaf)]/20 py-3">
    <div class="container-shell flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
      <p class="text-[var(--ink)]">
        💡 <strong>Catatan Akademik:</strong> Formulir ini murni untuk menerbitkan dokumen <strong>KHS</strong>. Jika KHS sudah Anda miliki dan ingin mendaftar Ujian Khusus, silakan buka:
      </p>
      <a href="/layanan/ujian-khusus" class="font-black text-[var(--leaf)] hover:underline shrink-0">
        Formulir Pengajuan Ujian Khusus →
      </a>
    </div>
  </div>

  <!-- Main Content Form Section -->
  <section class="container-shell py-12">
    <div class="grid lg:grid-cols-[1fr_360px] gap-10 items-start">
      
      <!-- Kolom Kiri: Formulir Interaktif Gaya Google Form -->
      <div>
        <div id="form-wrapper" class="rounded-3xl border border-[var(--line)] bg-white p-6 sm:p-9 shadow-sm border-t-8 border-t-[var(--leaf)]">
          <form id="khs-form" class="space-y-8">
            
            <!-- BLOK 1: Data Mahasiswa -->
            <div>
              <div class="flex items-center gap-2 border-b border-[var(--line)] pb-3">
                <span class="grid h-7 w-7 place-items-center rounded-lg bg-[var(--leaf)] text-xs font-black text-white">1</span>
                <h2 class="text-lg font-black text-[var(--leaf)]">Identitas Mahasiswa Pemohon</h2>
              </div>

              <div class="mt-5 grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="nama_lengkap" class="form-label">Nama Lengkap Mahasiswa *</label>
                  <input type="text" id="nama_lengkap" name="nama_lengkap" required placeholder="Contoh: Budi Santoso" class="form-input" />
                </div>

                <div>
                  <label for="nim" class="form-label">Nomor Induk Mahasiswa (NIM) *</label>
                  <input type="text" id="nim" name="nim" required placeholder="Contoh: 21/23456/SP/12345" class="form-input" />
                </div>

                <div>
                  <label for="prodi" class="form-label">Program Studi *</label>
                  <select id="prodi" name="prodi" required class="form-select">
                    <option value="">-- Pilih Program Studi --</option>
                    <option value="S1 Agroteknologi">S1 Agroteknologi</option>
                    <option value="S1 Agribisnis">S1 Agribisnis</option>
                  </select>
                </div>

                <div>
                  <label for="semester" class="form-label">Semester Mahasiswa Saat Ini *</label>
                  <select id="semester" name="semester" required class="form-select">
                    <option value="">-- Pilih Semester (1 - 12) --</option>
                    {semesterList.map((smt) => (
                      <option value={smt}>{smt}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label for="whatsapp" class="form-label">Nomor WhatsApp *</label>
                  <input type="tel" id="whatsapp" name="whatsapp" required placeholder="0812xxxxxxxx" class="form-input" />
                </div>

                <div>
                  <label for="email" class="form-label">Alamat Email *</label>
                  <input type="email" id="email" name="email" required placeholder="nama@instiperjogja.ac.id" class="form-input" />
                </div>
              </div>
            </div>

            <!-- BLOK 2: Rincian Dokumen KHS yang Dimohonkan -->
            <div>
              <div class="flex items-center gap-2 border-b border-[var(--line)] pb-3">
                <span class="grid h-7 w-7 place-items-center rounded-lg bg-[var(--leaf)] text-xs font-black text-white">2</span>
                <h2 class="text-lg font-black text-[var(--leaf)]">Cakupan KHS & Keperluan</h2>
              </div>

              <div class="mt-5 space-y-4">
                <div>
                  <label class="form-label">Cakupan Semester KHS yang Dimohonkan *</label>
                  
                  <!-- Pilihan Mode Cakupan KHS -->
                  <div class="mt-2 grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
                    <label class="flex items-center gap-2 p-3 rounded-xl border-2 border-[var(--leaf)] bg-[var(--leaf-soft)] cursor-pointer transition mode-cakupan-card" id="card-mode-range">
                      <input type="radio" name="mode_cakupan" value="range" checked class="accent-[var(--leaf)]" />
                      <span class="font-bold text-[var(--leaf)]">Rentang Semester (1-3, 2-4)</span>
                    </label>
                    <label class="flex items-center gap-2 p-3 rounded-xl border border-[var(--line)] bg-white cursor-pointer hover:border-[var(--leaf)] transition mode-cakupan-card" id="card-mode-all">
                      <input type="radio" name="mode_cakupan" value="all" class="accent-[var(--leaf)]" />
                      <span class="font-bold text-[var(--ink)]">Seluruh Semester (Kumulatif)</span>
                    </label>
                    <label class="flex items-center gap-2 p-3 rounded-xl border border-[var(--line)] bg-white cursor-pointer hover:border-[var(--leaf)] transition mode-cakupan-card" id="card-mode-single">
                      <input type="radio" name="mode_cakupan" value="single" class="accent-[var(--leaf)]" />
                      <span class="font-bold text-[var(--ink)]">Satu Semester Saja</span>
                    </label>
                  </div>

                  <!-- KOTAK 1: Rentang Semester (Default) -->
                  <div id="box-range" class="mt-4 p-4 rounded-2xl bg-[#f7faf5] border border-[var(--leaf)]/30 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <div>
                        <label for="smt_dari" class="text-xs font-bold text-[var(--ink)] block mb-1">Dari Semester:</label>
                        <select id="smt_dari" class="form-select text-sm font-medium bg-white">
                          {semesterList.map((smt, idx) => (
                            <option value={idx + 1} selected={idx === 0}>{smt}</option>
                          ))}
                        </select>
                      </div>
                      <div>
                        <label for="smt_sampai" class="text-xs font-bold text-[var(--ink)] block mb-1">Sampai Semester:</label>
                        <select id="smt_sampai" class="form-select text-sm font-medium bg-white">
                          {semesterList.map((smt, idx) => (
                            <option value={idx + 1} selected={idx === 2}>{smt}</option>
                          ))}
                        </select>
                      </div>
                    </div>

                    <!-- Preset Rentang Cepat (1-3, 2-4, dll) -->
                    <div class="pt-2 border-t border-[var(--leaf)]/20 flex flex-wrap items-center gap-1.5 text-xs">
                      <span class="text-[var(--muted)] font-bold mr-1">Contoh Cepat:</span>
                      <button type="button" class="btn-range-preset px-2.5 py-1 rounded-lg bg-white border border-[var(--leaf)]/40 font-bold text-[var(--leaf)] hover:bg-[var(--leaf)] hover:text-white transition shadow-2xs" data-from="1" data-to="3">
                        Semester 1 – 3
                      </button>
                      <button type="button" class="btn-range-preset px-2.5 py-1 rounded-lg bg-white border border-[var(--leaf)]/40 font-bold text-[var(--leaf)] hover:bg-[var(--leaf)] hover:text-white transition shadow-2xs" data-from="2" data-to="4">
                        Semester 2 – 4
                      </button>
                      <button type="button" class="btn-range-preset px-2.5 py-1 rounded-lg bg-white border border-[var(--leaf)]/40 font-bold text-[var(--leaf)] hover:bg-[var(--leaf)] hover:text-white transition shadow-2xs" data-from="1" data-to="4">
                        Semester 1 – 4
                      </button>
                      <button type="button" class="btn-range-preset px-2.5 py-1 rounded-lg bg-white border border-[var(--leaf)]/40 font-bold text-[var(--leaf)] hover:bg-[var(--leaf)] hover:text-white transition shadow-2xs" data-from="1" data-to="7">
                        Semester 1 – 7
                      </button>
                      <button type="button" class="btn-range-preset px-2.5 py-1 rounded-lg bg-white border border-[var(--leaf)]/40 font-bold text-[var(--leaf)] hover:bg-[var(--leaf)] hover:text-white transition shadow-2xs" data-from="1" data-to="8">
                        Semester 1 – 8
                      </button>
                      <button type="button" class="btn-range-preset px-2.5 py-1 rounded-lg bg-white border border-[var(--leaf)]/40 font-bold text-[var(--leaf)] hover:bg-[var(--leaf)] hover:text-white transition shadow-2xs" data-from="1" data-to="12">
                        Semester 1 – 12
                      </button>
                    </div>

                    <!-- Ringkasan Cakupan Real-time -->
                    <div class="p-2.5 rounded-xl bg-white border border-[var(--line)] flex items-center justify-between text-xs">
                      <span class="text-[var(--muted)] font-medium">Rentang Dokumen yang Dimohon:</span>
                      <strong id="range-preview-badge" class="text-[var(--leaf)] font-mono font-bold bg-[var(--leaf-soft)] px-2.5 py-1 rounded-md">
                        Semester 1 s/d 3
                      </strong>
                    </div>
                  </div>

                  <!-- KOTAK 2: Seluruh Semester (Kumulatif) -->
                  <div id="box-all" class="hidden mt-4 p-4 rounded-2xl bg-amber-50/70 border border-amber-200 text-xs text-amber-950">
                    <div class="flex items-center gap-2.5">
                      <span class="text-xl">📋</span>
                      <div>
                        <strong class="text-amber-900 block font-bold">Transkrip KHS Kumulatif Seluruh Semester</strong>
                        <p class="text-amber-800 mt-0.5 leading-relaxed">
                          Mencakup seluruh daftar nilai mata kuliah dari Semester 1 hingga semester yang telah Anda tempuh.
                        </p>
                      </div>
                    </div>
                  </div>

                  <!-- KOTAK 3: Satu Semester Spesifik -->
                  <div id="box-single" class="hidden mt-4 p-4 rounded-2xl bg-[#f7faf5] border border-[var(--leaf)]/30 space-y-2 text-xs">
                    <label for="smt_single" class="font-bold text-[var(--ink)] block">Pilih Satu Semester Tertentu:</label>
                    <select id="smt_single" class="form-select text-sm font-medium bg-white">
                      {semesterList.map((smt) => (
                        <option value={smt}>Hanya KHS {smt}</option>
                      ))}
                    </select>
                  </div>

                  <!-- Hidden Input untuk dikirim ke Form -->
                  <input type="hidden" id="semester_dimohon" name="semester_dimohon" value="Semester 1 s/d 3" />
                </div>

                <div>
                  <label class="form-label">Tujuan / Keperluan Permohonan KHS *</label>
                  <div class="mt-2 space-y-2 text-xs text-[var(--ink)]">
                    <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--line)] hover:bg-[var(--leaf-soft)]/50 cursor-pointer">
                      <input type="radio" name="keperluan" value="Prasyarat Pendaftaran Ujian Khusus" checked class="accent-[var(--leaf)]" />
                      <div>
                        <strong>a. Prasyarat Pendaftaran Ujian Khusus</strong>
                        <span class="block text-[11px] text-[var(--muted)]">Dilampirkan saat mendaftar Ujian Khusus tingkat akhir (maksimal 2 matkul).</span>
                      </div>
                    </label>

                    <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--line)] hover:bg-[var(--leaf-soft)]/50 cursor-pointer">
                      <input type="radio" name="keperluan" value="Prasyarat Aktif Kembali Pasca Cuti / Non-Aktif" class="accent-[var(--leaf)]" />
                      <div>
                        <strong>b. Prasyarat Aktif Kembali</strong>
                        <span class="block text-[11px] text-[var(--muted)]">Validasi sisa masa studi (maksimal 14 semester) setelah masa cuti akademik.</span>
                      </div>
                    </label>

                    <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--line)] hover:bg-[var(--leaf-soft)]/50 cursor-pointer">
                      <input type="radio" name="keperluan" value="Pendaftaran Beasiswa" class="accent-[var(--leaf)]" />
                      <div>
                        <strong>c. Pendaftaran Beasiswa</strong>
                        <span class="block text-[11px] text-[var(--muted)]">Persyaratan administrasi beasiswa internal atau eksternal.</span>
                      </div>
                    </label>

                    <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--line)] hover:bg-[var(--leaf-soft)]/50 cursor-pointer">
                      <input type="radio" name="keperluan" value="Keperluan Lainnya / Arsip Kedinasan" class="accent-[var(--leaf)]" />
                      <div>
                        <strong>d. Keperluan Lainnya / Arsip Kedinasan</strong>
                        <span class="block text-[11px] text-[var(--muted)]">Tunjangan instansi orang tua, magang, atau arsip pribadi.</span>
                      </div>
                    </label>
                  </div>
                </div>

                <div>
                  <label for="catatan_tambahan" class="form-label">Catatan Tambahan (Opsional)</label>
                  <input type="text" id="catatan_tambahan" name="catatan_tambahan" placeholder="Contoh: Butuh legalisir basah 2 lembar" class="form-input" />
                </div>
              </div>
            </div>

            <!-- BLOK 3: Ketentuan Pengambilan Dokumen Fisik di Loket Kampus -->
            <div>
              <div class="flex items-center gap-2 border-b border-[var(--line)] pb-3">
                <span class="grid h-7 w-7 place-items-center rounded-lg bg-[var(--leaf)] text-xs font-black text-white">3</span>
                <h2 class="text-lg font-black text-[var(--leaf)]">Pengambilan Dokumen Fisik</h2>
              </div>

              <div class="mt-5 rounded-2xl border-2 border-[var(--leaf)]/20 bg-[#f7faf5] p-5 text-xs text-[var(--ink)]">
                <div class="flex items-start gap-3">
                  <span class="text-2xl shrink-0">🏢</span>
                  <div>
                    <h3 class="font-black text-[var(--leaf)] text-sm">Cetak Fisik Resmi Berstempel Basah di Loket Kampus</h3>
                    <p class="text-[var(--muted)] mt-1 leading-relaxed">
                      Sistem saat ini adalah sistem pelacakan alur berkas (belum tahap unggah/unduh dokumen digital). Salinan resmi KHS diterbitkan dalam bentuk cetak fisik berstempel basah Dekanat FAPERTA INSTIPER Yogyakarta.
                    </p>
                    <div class="mt-3 grid sm:grid-cols-2 gap-2 pt-3 border-t border-[var(--leaf)]/20">
                      <p>📍 <strong>Lokasi Pengambilan:</strong> Loket 1 Administrasi FAPERTA (Gedung A, Lt. 1)</p>
                      <p>🪪 <strong>Syarat Pengambilan:</strong> Wajib membawa KTM Asli & Kode Tiket</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Checkbox Persetujuan & Tombol Submit -->
            <div class="pt-4 border-t border-[var(--line)]">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" id="persetujuan" required class="mt-1 h-4 w-4 rounded accent-[var(--leaf)]" />
                <span class="text-xs leading-relaxed text-[var(--ink)]">
                  Saya menyatakan bahwa data yang saya isikan adalah benar sesuai data akademik saya di Fakultas Pertanian INSTIPER Yogyakarta.
                </span>
              </label>

              <div class="mt-6 flex flex-col sm:flex-row items-center gap-4">
                <button type="submit" id="btn-submit" class="btn-cta w-full sm:w-auto text-sm px-8 py-3.5">
                  Kirim Permohonan KHS Sekarang →
                </button>
                <span class="text-xs text-[var(--muted)]">Proses penerbitan berkas: 1-2 hari kerja</span>
              </div>
            </div>
          </form>
        </div>

        <!-- SUCCESS CONTAINER (Gaya Google Form Receipt Tanpa WhatsApp) -->
        <div id="success-wrapper" class="hidden rounded-3xl border border-[var(--line)] bg-white p-7 sm:p-10 shadow-lg border-t-8 border-t-[var(--leaf)] animate-fade-in">
          <div class="flex items-center gap-3">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[#e8f5e9] text-2xl text-[var(--leaf)] font-bold">
              ✓
            </span>
            <div>
              <span class="badge-online text-xs">Tanggapan Anda Telah Direkam</span>
              <h3 class="text-2xl font-black text-[var(--leaf)] mt-1">
                Tiket Permohonan KHS Diterbitkan!
              </h3>
            </div>
          </div>

          <!-- Ticket Box -->
          <div class="mt-6 rounded-2xl bg-[var(--leaf-soft)] p-6 border border-[var(--leaf)]/30">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--leaf)]/20 pb-4">
              <div>
                <p class="text-xs font-bold text-[var(--muted)] uppercase tracking-wider">Nomor Tiket Anda:</p>
                <p id="ticket-number" class="text-2xl sm:text-3xl font-black text-[var(--leaf)] font-mono tracking-wide mt-1">
                  KHS-2026-XXXX
                </p>
              </div>
              <button id="btn-copy-ticket" type="button" class="btn-secondary text-xs px-4 py-2 bg-white">
                📋 Salin Kode Tiket
              </button>
            </div>

            <div class="mt-4 grid sm:grid-cols-2 gap-3 text-xs text-[var(--ink)]">
              <div>
                <span class="text-[var(--muted)]">Nama Pemohon:</span>
                <p id="summary-nama" class="font-bold">-</p>
              </div>
              <div>
                <span class="text-[var(--muted)]">NIM:</span>
                <p id="summary-nim" class="font-bold">-</p>
              </div>
              <div>
                <span class="text-[var(--muted)]">Semester Mahasiswa:</span>
                <p id="summary-semester" class="font-bold">-</p>
              </div>
              <div>
                <span class="text-[var(--muted)]">Cakupan Dokumen:</span>
                <p id="summary-cakupan" class="font-bold text-[var(--leaf)]">-</p>
              </div>
              <div>
                <span class="text-[var(--muted)]">Keperluan:</span>
                <p id="summary-keperluan" class="font-bold">-</p>
              </div>
              <div>
                <span class="text-[var(--muted)]">Format Dokumen:</span>
                <p id="summary-format" class="font-bold">-</p>
              </div>
            </div>
          </div>

          <!-- Panduan Pengambilan di Loket -->
          <div class="mt-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-xs text-amber-950">
            <div class="flex items-start gap-2.5">
              <span class="text-base shrink-0">📍</span>
              <div>
                <strong>Pengambilan Dokumen Fisik di Kampus:</strong>
                <p class="text-amber-900 mt-0.5 leading-relaxed">
                  Setelah status permohonan Anda diverifikasi dan berstatus <strong>Selesai (Siap Diambil)</strong> di sistem, silakan datang ke <strong>Loket 1 Administrasi FAPERTA (Gedung A, Lt. 1)</strong> dengan membawa <strong>KTM Asli</strong> dan menyebutkan Nomor Tiket Anda.
                </p>
              </div>
            </div>
          </div>

          <!-- Tindak Lanjut -->
          <div class="mt-6 space-y-3">
            <h4 class="text-sm font-black text-[var(--ink)]">Tindak Lanjut Permohonan:</h4>
            <div class="grid sm:grid-cols-2 gap-3">
              <button id="btn-print-receipt" type="button" class="rounded-2xl bg-[var(--leaf)] text-white p-4 font-bold text-xs flex items-center justify-center gap-2 hover:bg-[var(--leaf-dark)] transition shadow-sm">
                <span>🖨️</span> Cetak Bukti Tiket untuk Loket
              </button>
              <a href="/layanan/cek-status" class="rounded-2xl border-2 border-[var(--leaf)] bg-white text-[var(--leaf)] p-4 font-bold text-xs flex items-center justify-center gap-2 hover:bg-[var(--leaf-soft)] transition">
                <span>🔍</span> Pantau Status Verifikasi Berkas
              </a>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-[var(--line)] flex items-center justify-between">
            <button id="btn-reset-form" type="button" class="text-xs font-bold text-[var(--muted)] hover:text-[var(--leaf)] hover:underline">
              ← Isi Formulir Baru
            </button>
            <a href="/layanan" class="text-xs font-bold text-[var(--leaf)] hover:underline">
              Kembali ke Hub Layanan →
            </a>
          </div>
        </div>
      </div>

      <!-- Kolom Kanan: Sidebar Informasi KHS -->
      <aside class="space-y-6">
        <!-- Card Info Ujian Khusus -->
        <div class="rounded-3xl border border-[var(--line)] bg-white p-6 shadow-xs border-l-4 border-l-[var(--gold)]">
          <div class="flex items-center gap-2">
            <span class="grid h-8 w-8 place-items-center rounded-xl bg-[#fff8e1] text-[var(--gold)] font-black text-sm">
              ★
            </span>
            <h4 class="text-sm font-black text-[var(--leaf)]">Untuk Syarat Ujian Khusus?</h4>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-[var(--muted)]">
            KHS yang diterbitkan dari form ini akan menjadi berkas lampiran utama saat Anda mendaftar Ujian Khusus.
          </p>
          <div class="mt-4 pt-3 border-t border-[var(--line)]">
            <a href="/layanan/ujian-khusus" class="text-xs font-bold text-[var(--leaf)] hover:underline inline-flex items-center gap-1">
              Buka Form Pengajuan Ujian Khusus →
            </a>
          </div>
        </div>

        <!-- Card Prasyarat Aktif Kembali -->
        <div class="rounded-3xl border border-[var(--line)] bg-white p-6 shadow-xs">
          <div class="flex items-center gap-2">
            <span class="grid h-8 w-8 place-items-center rounded-xl bg-[var(--leaf-soft)] text-[var(--leaf)] font-black text-sm">
              🔄
            </span>
            <h4 class="text-sm font-black text-[var(--leaf)]">Ketentuan Masa Studi (1 - 12 Semester)</h4>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-[var(--muted)]">
            Mengacu pada Buku Pedoman Akademik INSTIPER:
          </p>
          <ul class="mt-3 space-y-2 text-xs text-[var(--ink)]">
            <li class="flex items-start gap-2">
              <span class="text-[var(--leaf)] font-bold">•</span>
              <span>Beban normal sarjana S1 ditempuh dalam <strong>8 semester</strong> (minimal 144 SKS).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[var(--leaf)] font-bold">•</span>
              <span>Batas maksimal masa studi berjalan yang diakomodir sistem adalah <strong>Semester 12</strong>.</span>
            </li>
          </ul>
        </div>

        <!-- Card Kontak Layanan Akademik -->
        <div class="rounded-3xl bg-[var(--leaf-dark)] p-6 text-white shadow-md">
          <h4 class="text-sm font-black !text-white flex items-center gap-2">
            <span>☎</span> Front Desk FAPERTA
          </h4>
          <p class="mt-2 text-xs leading-relaxed !text-white/80">
            Jam operasional loket layanan:
            <br />Senin - Jumat: 08.00 - 15.30 WIB
            <br />Gedung Fakultas Pertanian INSTIPER Lt. 1
          </p>
          <div class="mt-4 pt-3 border-t border-white/20">
            <span class="text-[11px] !text-white/70 block">Email Resmi:</span>
            <a href="mailto:akademik@instiperjogja.ac.id" class="text-xs font-bold !text-[var(--gold)] hover:underline">
              akademik@instiperjogja.ac.id
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Modal Pop-Up Peringatan Permohonan Aktif (Anti-Duplikasi) -->
  <div id="duplicate-warning-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="relative w-full max-w-lg rounded-3xl bg-white border-2 border-amber-300 p-6 sm:p-8 shadow-2xl animate-fade-in text-left">
      <!-- Close button -->
      <button type="button" id="btn-close-dup-modal" class="absolute top-5 right-5 text-gray-400 hover:text-gray-700 text-xl font-bold p-1">
        ✕
      </button>

      <!-- Header Modal -->
      <div class="flex items-start gap-4">
        <div class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-amber-100 text-amber-900 border border-amber-300 text-2xl font-bold">
          ⏳
        </div>
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300 text-[10px] font-black uppercase tracking-wider">
            Permohonan Masih Berjalan
          </span>
          <h3 class="text-xl font-black text-[var(--ink)] mt-1 leading-snug">
            Surat KHS Anda Sedang Diproses
          </h3>
          <p class="text-xs text-[var(--muted)] mt-0.5">
            Sistem mendeteksi adanya permohonan KHS aktif untuk NIM yang Anda masukkan.
          </p>
        </div>
      </div>

      <!-- Active Ticket Info Card -->
      <div class="mt-5 rounded-2xl bg-amber-50/70 border border-amber-200 p-4 text-xs space-y-2.5 text-amber-950">
        <div class="flex items-center justify-between border-b border-amber-200/80 pb-2">
          <span class="text-amber-800 font-medium">Nomor Tiket Aktif:</span>
          <strong id="dup-ticket-code" class="font-mono text-sm font-black text-[var(--leaf)] bg-white px-2 py-0.5 rounded border border-amber-200">
            KHS-2026-XXXX
          </strong>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-amber-800 font-medium">Cakupan Dokumen:</span>
          <strong id="dup-service-name" class="text-[var(--ink)] font-bold text-right">-</strong>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-amber-800 font-medium">Status Terkini:</span>
          <span id="dup-status-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-blue-100 text-blue-900 border border-blue-300">
            🔍 Proses Verifikasi
          </span>
        </div>
        <div class="flex items-start justify-between gap-2">
          <span class="text-amber-800 font-medium shrink-0">Posisi Berkas Fisik:</span>
          <span id="dup-posisi" class="text-right font-semibold text-amber-900">-</span>
        </div>
        <div class="flex items-center justify-between text-[11px] pt-1 border-t border-amber-200/60">
          <span class="text-amber-700">Tanggal Diajukan:</span>
          <span id="dup-tanggal" class="text-amber-900 font-medium">-</span>
        </div>
      </div>

      <!-- Aturan SOP Penjelasan -->
      <div class="mt-4 p-3.5 rounded-xl bg-gray-50 border border-[var(--line)] text-xs text-[var(--muted)] leading-relaxed">
        💡 <strong>Aturan Loket Administrasi FAPERTA:</strong>
        <p class="mt-1">
          Mahasiswa tidak dapat mengajukan permohonan ganda selagi berkas KHS sebelumnya masih berstatus <strong>Belum Diproses</strong> atau <strong>Proses Verifikasi</strong>. Anda baru dapat mengajukan kembali apabila berkas sebelumnya telah <strong>Selesai (Siap Diambil di Loket)</strong> atau berstatus <strong>Ditolak</strong>.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-end gap-2.5">
        <button 
          type="button" 
          id="btn-close-dup-modal-2"
          class="w-full sm:w-auto btn-secondary text-xs py-2.5 px-4 bg-white border border-[var(--line)] font-bold"
        >
          Tutup Peringatan
        </button>
        <a 
          id="dup-track-link"
          href="/layanan/cek-status"
          class="w-full sm:w-auto btn-cta text-xs py-2.5 px-5 flex items-center justify-center gap-2 shadow-xs font-bold"
        >
          <span>🔍 Lacak Tiket Ini Sekarang</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Client-side Logic Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const khsForm = document.getElementById('khs-form');
      const formWrapper = document.getElementById('form-wrapper');
      const successWrapper = document.getElementById('success-wrapper');
      const btnCopyTicket = document.getElementById('btn-copy-ticket');
      const btnReset = document.getElementById('btn-reset-form');
      const btnPrint = document.getElementById('btn-print-receipt');

      // Modal Elements
      const dupModal = document.getElementById('duplicate-warning-modal');
      const btnCloseDup1 = document.getElementById('btn-close-dup-modal');
      const btnCloseDup2 = document.getElementById('btn-close-dup-modal-2');

      function closeDupModal() {
        dupModal?.classList.add('hidden');
      }

      btnCloseDup1?.addEventListener('click', closeDupModal);
      btnCloseDup2?.addEventListener('click', closeDupModal);
      dupModal?.addEventListener('click', (e) => {
        if (e.target === dupModal) closeDupModal();
      });

      // Fungsi Cek Duplikasi Permohonan Aktif
      function findActiveDuplicate(nimQuery, serviceType) {
        try {
          const raw = localStorage.getItem('portal_faperta_tickets');
          const tickets = raw ? JSON.parse(raw) : [];
          const cleanNim = (nimQuery || '').toUpperCase().replace(/\s+/g, '');
          if (!cleanNim) return null;

          return tickets.find(t => {
            const tNim = (t.nim || '').toUpperCase().replace(/\s+/g, '');
            if (tNim !== cleanNim) return false;

            const id = (t.layananId || '').toLowerCase();
            const code = (t.kode || '').toUpperCase();
            const name = (t.layananNama || '').toLowerCase();

            let matchType = false;
            if (serviceType === 'khs') {
              matchType = id === 'khs' || code.startsWith('KHS') || name.includes('khs');
            } else if (serviceType === 'komplain-nilai') {
              matchType = id === 'komplain-nilai' || code.startsWith('KMP') || name.includes('komplain') || name.includes('nilai');
            } else if (serviceType === 'ujian-khusus') {
              matchType = id === 'ujian-khusus' || code.startsWith('UKH') || code.startsWith('UJK') || name.includes('ujian khusus');
            }

            if (!matchType) return false;

            const status = t.status || '';
            const step = t.statusStep;
            // Aktif jika masih dalam antrean atau verifikasi
            const isActive = status === 'Belum Diproses' || 
                             status === 'Proses Verifikasi' || 
                             status === 'Diajukan' || 
                             status === 'Verifikasi Berkas' ||
                             step === 1 || 
                             step === 2;

            return isActive;
          });
        } catch (e) {
          return null;
        }
      }

      // 1. Logika Pilihan Rentang Semester (1-3, 2-4, dll.)
      const modeRadios = document.querySelectorAll('input[name="mode_cakupan"]');
      const boxRange = document.getElementById('box-range');
      const boxAll = document.getElementById('box-all');
      const boxSingle = document.getElementById('box-single');
      const smtDari = document.getElementById('smt_dari');
      const smtSampai = document.getElementById('smt_sampai');
      const smtSingle = document.getElementById('smt_single');
      const hiddenCakupan = document.getElementById('semester_dimohon');
      const rangePreviewBadge = document.getElementById('range-preview-badge');
      const presetBtns = document.querySelectorAll('.btn-range-preset');

      function updateCakupanValue() {
        const activeMode = document.querySelector('input[name="mode_cakupan"]:checked')?.value || 'range';

        // Update card styles
        document.querySelectorAll('.mode-cakupan-card').forEach(card => {
          card.classList.remove('border-2', 'border-[var(--leaf)]', 'bg-[var(--leaf-soft)]');
          card.classList.add('border-[var(--line)]', 'bg-white');
          const span = card.querySelector('span');
          if (span) {
            span.classList.remove('text-[var(--leaf)]');
            span.classList.add('text-[var(--ink)]');
          }
        });
        const activeCard = document.getElementById(`card-mode-${activeMode}`);
        if (activeCard) {
          activeCard.classList.add('border-2', 'border-[var(--leaf)]', 'bg-[var(--leaf-soft)]');
          activeCard.classList.remove('border-[var(--line)]', 'bg-white');
          const span = activeCard.querySelector('span');
          if (span) {
            span.classList.add('text-[var(--leaf)]');
            span.classList.remove('text-[var(--ink)]');
          }
        }

        // Show/hide boxes
        boxRange?.classList.toggle('hidden', activeMode !== 'range');
        boxAll?.classList.toggle('hidden', activeMode !== 'all');
        boxSingle?.classList.toggle('hidden', activeMode !== 'single');

        if (activeMode === 'range') {
          let fromVal = parseInt(smtDari?.value || '1', 10);
          let toVal = parseInt(smtSampai?.value || '3', 10);

          if (toVal < fromVal) {
            toVal = fromVal;
            if (smtSampai) smtSampai.value = toVal.toString();
          }

          const rangeStr = `Semester ${fromVal} s/d ${toVal}`;
          if (rangePreviewBadge) rangePreviewBadge.textContent = rangeStr;
          if (hiddenCakupan) hiddenCakupan.value = rangeStr;
        } else if (activeMode === 'all') {
          if (hiddenCakupan) hiddenCakupan.value = 'Seluruh Semester (Transkrip Kumulatif)';
        } else if (activeMode === 'single') {
          const singleVal = smtSingle?.value || 'Semester 1';
          if (hiddenCakupan) hiddenCakupan.value = `Hanya KHS ${singleVal}`;
        }
      }

      modeRadios.forEach(r => r.addEventListener('change', updateCakupanValue));
      smtDari?.addEventListener('change', updateCakupanValue);
      smtSampai?.addEventListener('change', updateCakupanValue);
      smtSingle?.addEventListener('change', updateCakupanValue);

      presetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const from = btn.getAttribute('data-from');
          const to = btn.getAttribute('data-to');
          if (smtDari && from) smtDari.value = from;
          if (smtSampai && to) smtSampai.value = to;

          const radioRange = document.querySelector('input[name="mode_cakupan"][value="range"]');
          if (radioRange) radioRange.checked = true;

          updateCakupanValue();
        });
      });

      // Inisialisasi awal
      updateCakupanValue();

      khsForm?.addEventListener('submit', (e) => {
        e.preventDefault();

        const formData = new FormData(khsForm);
        const nama = formData.get('nama_lengkap');
        const nim = formData.get('nim');
        const prodi = formData.get('prodi');
        const semester = formData.get('semester');
        const semesterDimohon = formData.get('semester_dimohon');
        const keperluan = formData.get('keperluan');
        const formatOutput = formData.get('format_output');
        const catatan = formData.get('catatan_tambahan') || '-';

        // 1. Cek Duplikasi: Apakah mahasiswa ini masih memiliki permohonan KHS aktif?
        const activeDup = findActiveDuplicate(nim, 'khs');
        if (activeDup) {
          const dupCode = document.getElementById('dup-ticket-code');
          const dupName = document.getElementById('dup-service-name');
          const dupStatus = document.getElementById('dup-status-badge');
          const dupPos = document.getElementById('dup-posisi');
          const dupDate = document.getElementById('dup-tanggal');
          const dupLink = document.getElementById('dup-track-link');

          if (dupCode) dupCode.textContent = activeDup.kode;
          if (dupName) dupName.textContent = activeDup.layananNama;
          if (dupStatus) {
            dupStatus.textContent = activeDup.status;
            dupStatus.className = activeDup.status === 'Proses Verifikasi' 
              ? 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-blue-100 text-blue-900 border border-blue-300' 
              : 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-amber-100 text-amber-900 border border-amber-300';
          }
          if (dupPos) dupPos.textContent = activeDup.posisiBerkas || 'Pemeriksaan Administrasi Loket';
          if (dupDate) dupDate.textContent = activeDup.tanggal || 'Baru Saja';
          if (dupLink) dupLink.href = `/layanan/cek-status?q=${encodeURIComponent(activeDup.kode)}`;

          dupModal?.classList.remove('hidden');
          return; // Hentikan pengajuan, jangan terbitkan tiket baru!
        }

        const randomNum = Math.floor(1000 + Math.random() * 9000);
        const ticketCode = `KHS-2026-${randomNum}`;
        const tanggalPengajuan = new Date().toLocaleDateString('id-ID', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });

        const newTicket = {
          kode: ticketCode,
          nama,
          nim,
          prodi,
          semester,
          layananId: 'khs',
          layananNama: `Permohonan KHS (${semesterDimohon})`,
          keperluan: `Permohonan KHS (${semesterDimohon})`,
          detailTambahan: `Tujuan: ${keperluan} | Catatan: ${catatan}`,
          format: 'Cetak Fisik Berstempel Basah (Ambil di Loket)',
          status: 'Belum Diproses',
          statusStep: 1,
          posisiBerkas: 'Antrean Masuk Loket Administrasi FAPERTA',
          estimasiSelesai: '1–2 Hari Kerja',
          catatanAdmin: 'Permohonan baru masuk antrean loket. Menunggu verifikasi petugas.',
          tanggal: tanggalPengajuan,
          isNewForAdmin: true
        };

        // Simpan ke localStorage (terpadu portal_faperta_tickets & portal_khs_tickets)
        try {
          const mainStore = JSON.parse(localStorage.getItem('portal_faperta_tickets') || '[]');
          mainStore.unshift(newTicket);
          localStorage.setItem('portal_faperta_tickets', JSON.stringify(mainStore));

          const legacyTickets = JSON.parse(localStorage.getItem('portal_khs_tickets') || '[]');
          legacyTickets.unshift(newTicket);
          localStorage.setItem('portal_khs_tickets', JSON.stringify(legacyTickets));
          localStorage.setItem('portal_khs_last_ticket', JSON.stringify(newTicket));
        } catch (err) {
          console.error(err);
        }

        // Tampilkan Ringkasan di Halaman Sukses
        document.getElementById('ticket-number').textContent = ticketCode;
        document.getElementById('summary-nama').textContent = nama;
        document.getElementById('summary-nim').textContent = nim;
        document.getElementById('summary-semester').textContent = semester;
        document.getElementById('summary-cakupan').textContent = semesterDimohon;
        document.getElementById('summary-keperluan').textContent = keperluan;
        document.getElementById('summary-format').textContent = newTicket.format;

        // Switch View
        formWrapper?.classList.add('hidden');
        successWrapper?.classList.remove('hidden');
        window.scrollTo({ top: successWrapper.offsetTop - 80, behavior: 'smooth' });
      });

      btnPrint?.addEventListener('click', () => {
        window.print();
      });

      btnCopyTicket?.addEventListener('click', () => {
        const ticketCode = document.getElementById('ticket-number')?.textContent || '';
        navigator.clipboard.writeText(ticketCode).then(() => {
          btnCopyTicket.textContent = '✓ Kode Disalin!';
          setTimeout(() => { btnCopyTicket.textContent = '📋 Salin Kode Tiket'; }, 2000);
        });
      });

      btnReset?.addEventListener('click', () => {
        khsForm?.reset();
        updateCakupanValue();
        successWrapper?.classList.add('hidden');
        formWrapper?.classList.remove('hidden');
        window.scrollTo({ top: formWrapper.offsetTop - 80, behavior: 'smooth' });
      });
    });
  </script>
</BaseLayout>
