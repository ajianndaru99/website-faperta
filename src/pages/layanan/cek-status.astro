---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { INITIAL_PORTAL_TICKETS } from "../../data/portalData";
---

<BaseLayout 
  title="Pusat Pelacakan Berkas & Status Surat" 
  description="Lacak riwayat pengajuan surat akademik mahasiswa FAPERTA INSTIPER, pantau tahapan proses dan posisi berkas fisik di loket."
>
  <!-- Hero Section -->
  <section id="hero-status-section" class="border-b border-[var(--line)] bg-gradient-to-b from-[#f4f9f4] to-white pt-8 pb-5 sm:py-10 hero-noise">
    <div class="container-shell">
      <nav class="flex items-center gap-2 text-xs font-semibold text-[var(--muted)] mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--leaf)]">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-[var(--leaf)]">Layanan Akademik</a>
        <span>/</span>
        <span class="text-[var(--leaf)] font-bold">Pelacakan Status Berkas</span>
      </nav>

      <div id="hero-title-box" class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--leaf)]/20 bg-[var(--leaf-soft)] px-3.5 py-1.5 text-xs font-bold text-[var(--leaf)]">
          <span class="h-2 w-2 rounded-full bg-[var(--gold)]"></span>
          <span>Pelacakan Status Administrasi Mahasiswa</span>
        </div>
        <h1 class="display-title mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--leaf)] leading-tight">
          Lacak Status Permohonan Berkas
        </h1>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-600">
          Masukkan <strong>NIM</strong> Anda untuk menampilkan seluruh permohonan surat yang pernah diajukan, atau masukkan <strong>Nomor Tiket</strong> spesifik untuk memantau posisi berkas fisik loket secara langsung.
        </p>
      </div>

      <!-- Jam Layanan Loket Banner -->
      <div id="hero-loket-banner" class="mt-6 sm:mt-8 p-4 sm:p-5 rounded-2xl bg-white border border-[var(--line)] shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="h-11 w-11 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xl font-bold flex items-center justify-center shrink-0">
            🏛️
          </div>
          <div>
            <h3 class="text-sm font-bold text-slate-900">Loket Pelayanan Administrasi FAPERTA</h3>
            <p class="text-xs text-slate-500 mt-0.5">Loket Admin FAPERTA • Buka Senin – Jumat, Pukul 08.00 – 15.00 WIB</p>
          </div>
        </div>
        <div class="text-xs font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 px-3.5 py-1.5 rounded-xl self-start sm:self-center">
          Pengambilan Dokumen Fisik Wajib Membawa KTM Asli
        </div>
      </div>
    </div>
  </section>

  <!-- Search & Tracking Section -->
  <section class="container-shell pt-4 pb-6 sm:pb-8">
    <div class="max-w-4xl mx-auto space-y-4 sm:space-y-5">
      
      <!-- Search Box Card -->
      <div id="search-box-card" class="rounded-3xl border border-[var(--line)] bg-white p-5 sm:p-8 shadow-sm">
        <form id="search-form" action="javascript:void(0);" onsubmit="return false;" class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1 flex items-center rounded-2xl border-2 border-[var(--line)] bg-white px-4 py-2.5 focus-within:border-[var(--leaf)] focus-within:ring-3 focus-within:ring-[var(--leaf)]/15 transition shadow-xs">
            <span class="text-gray-400 text-xl shrink-0 select-none mr-3" aria-hidden="true">🔍</span>
            <input 
              type="text" 
              id="search-input" 
              required
              placeholder="Masukkan NIM (contoh: 21/12345/SP) atau Nomor Tiket..." 
              class="w-full bg-transparent py-1.5 text-base sm:text-lg text-[var(--ink)] placeholder:text-gray-400 outline-none border-none font-medium"
            />
          </div>
          <button 
            type="submit" 
            class="btn-cta text-sm px-8 py-4 shrink-0 flex items-center justify-center gap-2 shadow-sm font-bold rounded-2xl cursor-pointer"
          >
            <span>Cari Berkas</span>
            <span>→</span>
          </button>
        </form>

        <p class="mt-3 text-xs text-slate-400">
          💡 Tips: Cukup masukkan NIM Anda untuk mendeteksi seluruh berkas surat yang terdaftar di loket.
        </p>
      </div>

      <!-- Applicant Profile Card (Symmetric, Rapi & Mobile Friendly - Poin 1) -->
      <div id="applicant-profile-card" class="hidden rounded-3xl border border-emerald-200/90 bg-white p-5 sm:p-6 shadow-sm text-center">
        <!-- Icon & Badge Centered Symmetrical -->
        <div class="flex flex-col items-center justify-center">
          <div class="h-12 w-12 sm:h-14 sm:w-14 rounded-2xl bg-emerald-700 text-white text-2xl font-bold flex items-center justify-center shadow-xs mb-2.5">
            🎓
          </div>
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-extrabold bg-emerald-100 text-emerald-900 border border-emerald-300">
            Data Mahasiswa Terdaftar
          </span>
        </div>

        <!-- Nama Mahasiswa Symmetrical -->
        <div class="mt-3">
          <h2 id="prof-nama" class="text-xl sm:text-2xl md:text-3xl font-black text-slate-900 tracking-tight capitalize leading-tight">-</h2>
          <p class="text-xs sm:text-sm text-slate-600 font-medium mt-1">
            NIM: <strong id="prof-nim" class="font-mono text-emerald-800 font-bold text-sm sm:text-base">-</strong>
            <span class="mx-1.5 text-slate-300">•</span>
            <span id="prof-prodi" class="text-slate-700 font-semibold">-</span>
          </p>
        </div>

        <!-- Total Pengajuan (Symmetric Center Pill) -->
        <div class="mt-4 pt-3.5 border-t border-slate-100 flex items-center justify-center">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-xl bg-slate-50 border border-slate-200 text-xs font-bold text-slate-600 shadow-2xs">
            <span>Total Pengajuan Surat:</span>
            <span id="prof-total" class="font-mono font-black text-emerald-800 text-sm">0 Berkas</span>
          </div>
        </div>
      </div>

      <!-- Multi-Ticket Cards Container -->
      <div id="tickets-container" class="space-y-4 sm:space-y-5"></div>

      <!-- Not Found Card -->
      <div id="not-found-card" class="hidden rounded-3xl border-2 border-dashed border-slate-200 bg-white p-12 text-center">
        <div class="text-4xl">🔎</div>
        <h3 class="mt-3 text-lg font-bold text-slate-800">Tidak Ditemukan Berkas untuk Pencarian Ini</h3>
        <p class="mt-2 text-sm text-slate-500 max-w-md mx-auto leading-relaxed">
          NIM atau Nomor Tiket tidak ditemukan dalam sistem loket. Pastikan penulisan NIM atau Tiket sudah sesuai.
        </p>
      </div>

    </div>
  </section>

  <!-- Script Deteksi Berkas & Realtime URL State Handler -->
  <script is:inline define:vars={{ initialPortalTickets: INITIAL_PORTAL_TICKETS }}>
    function initCekStatus() {
      const searchForm = document.getElementById('search-form');
      const searchInput = document.getElementById('search-input');
      const heroStatusSection = document.getElementById('hero-status-section');
      const searchBoxCard = document.getElementById('search-box-card');
      const profileCard = document.getElementById('applicant-profile-card');
      const ticketsContainer = document.getElementById('tickets-container');
      const notFoundCard = document.getElementById('not-found-card');

      // 1. Ambil Data Berkas Terbaru dari Storage
      function getAllTickets() {
        try {
          const raw = localStorage.getItem('portal_faperta_tickets');
          if (raw) {
            return JSON.parse(raw);
          }
          localStorage.setItem('portal_faperta_tickets', JSON.stringify(initialPortalTickets));
          return initialPortalTickets;
        } catch (e) {
          return initialPortalTickets;
        }
      }

      // 2. Render Daftar Berkas Mahasiswa (Desain Bersih, Ringkas, & Ada Arsip Riwayat > 12 Jam)
      let currentSubTab = 'aktif'; // 'aktif' atau 'arsip'

      function isTicketArchived(t) {
        // Hanya berkas yang sudah selesai atau sudah diambil yang dapat diarsipkan
        const isFinished = t.sudahDiambil || t.status === 'Selesai (Siap Diambil)' || t.status === 'Selesai';
        if (!isFinished) return false;

        // Cek timestamp saat dikonfirmasi diambil / selesai
        let takenTimestamp = t.sudahDiambilAt;
        if (!takenTimestamp && t.tanggalDiambil) {
          const p = Date.parse(t.tanggalDiambil);
          if (!isNaN(p)) takenTimestamp = p;
        }
        if (!takenTimestamp && t.tanggal) {
          const p = Date.parse(t.tanggal);
          if (!isNaN(p)) takenTimestamp = p;
        }

        if (!takenTimestamp) return !!t.sudahDiambil;

        // Terarsip jika lebih dari 12 jam setelah konfirmasi diambil
        const twelveHoursInMs = 12 * 60 * 60 * 1000;
        return (Date.now() - takenTimestamp) >= twelveHoursInMs;
      }

      function renderTickets(ticketsList, searchedNim = '') {
        notFoundCard?.classList.add('hidden');
        if (!ticketsContainer) return;
        ticketsContainer.innerHTML = '';

        if (!ticketsList || ticketsList.length === 0) {
          heroStatusSection?.classList.remove('hidden');
          searchBoxCard?.classList.remove('hidden');
          profileCard?.classList.add('hidden');
          notFoundCard?.classList.remove('hidden');
          window.getActiveTicketForPrint = () => null;
          return;
        }

        window.getActiveTicketForPrint = () => ticketsList && ticketsList.length > 0 ? ticketsList[0] : null;

        const activeList = ticketsList.filter(t => !isTicketArchived(t));
        const archivedList = ticketsList.filter(t => isTicketArchived(t));

        // Sesuai Permintaan User: Sembunyikan Judul Hero, Informasi Loket, dan Input Cari Berkas
        // Cukup tampilkan Data Mahasiswa Terdaftar di bagian paling atas
        heroStatusSection?.classList.add('hidden');
        searchBoxCard?.classList.add('hidden');

        const first = ticketsList[0];
        document.getElementById('prof-nama').textContent = first.nama;
        document.getElementById('prof-nim').textContent = first.nim;
        document.getElementById('prof-prodi').textContent = first.prodi;
        document.getElementById('prof-total').textContent = `${ticketsList.length} Berkas (${activeList.length} Aktif, ${archivedList.length} Arsip)`;
        profileCard?.classList.remove('hidden');

        // Tentukan default tab jika tidak ada berkas aktif
        if (activeList.length === 0 && archivedList.length > 0) {
          currentSubTab = 'arsip';
        } else if (activeList.length > 0 && currentSubTab !== 'arsip') {
          currentSubTab = 'aktif';
        }

        // Toolbar Sub-Tab Mahasiswa: Pengajuan Aktif vs Arsip Riwayat (Simpel & Mobile-Friendly)
        const tabToolbar = document.createElement('div');
        tabToolbar.className = 'flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 bg-slate-50 border border-slate-200 rounded-2xl shadow-2xs';
        tabToolbar.innerHTML = `
          <div class="inline-flex p-1 bg-white rounded-xl border border-slate-200 shadow-2xs w-full sm:w-auto">
            <button 
              type="button" 
              id="btn-subtab-aktif" 
              class="flex-1 sm:flex-initial px-4 py-2 rounded-lg text-xs font-black transition flex items-center justify-center gap-1.5 cursor-pointer ${currentSubTab === 'aktif' ? 'bg-emerald-700 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900'}"
            >
              <span>📂</span>
              <span>Pengajuan Aktif</span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold ${currentSubTab === 'aktif' ? 'bg-white/25 text-white' : 'bg-slate-100 text-slate-700'}">${activeList.length}</span>
            </button>
            <button 
              type="button" 
              id="btn-subtab-arsip" 
              class="flex-1 sm:flex-initial px-4 py-2 rounded-lg text-xs font-black transition flex items-center justify-center gap-1.5 cursor-pointer ${currentSubTab === 'arsip' ? 'bg-emerald-700 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900'}"
            >
              <span>📦</span>
              <span>Arsip Riwayat</span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold ${currentSubTab === 'arsip' ? 'bg-white/25 text-white' : 'bg-slate-100 text-slate-700'}">${archivedList.length}</span>
            </button>
          </div>
          <p class="text-[11px] text-slate-500 font-medium">
            💡 Berkas otomatis terarsip jika lebih dari 12 jam setelah konfirmasi diambil.
          </p>
        `;
        ticketsContainer.appendChild(tabToolbar);

        tabToolbar.querySelector('#btn-subtab-aktif')?.addEventListener('click', () => {
          currentSubTab = 'aktif';
          renderTickets(ticketsList, searchedNim);
        });
        tabToolbar.querySelector('#btn-subtab-arsip')?.addEventListener('click', () => {
          currentSubTab = 'arsip';
          renderTickets(ticketsList, searchedNim);
        });

        const displayList = currentSubTab === 'aktif' ? activeList : archivedList;

        if (displayList.length === 0) {
          const emptyBox = document.createElement('div');
          emptyBox.className = 'rounded-3xl border-2 border-dashed border-slate-200 bg-white p-8 text-center';
          if (currentSubTab === 'aktif') {
            emptyBox.innerHTML = `
              <span class="text-3xl">🎉</span>
              <h4 class="text-sm font-bold text-slate-800 mt-2">Tidak Ada Pengajuan Aktif</h4>
              <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
                Seluruh berkas Anda telah selesai diproses dan tersimpan di tab Arsip Riwayat (diambil lebih dari 12 jam yang lalu).
              </p>
              <button type="button" id="btn-switch-to-arsip" class="mt-4 px-4 py-2 rounded-xl bg-emerald-700 text-white text-xs font-bold hover:bg-emerald-800 transition cursor-pointer">
                Lihat Arsip Riwayat (${archivedList.length}) →
              </button>
            `;
            emptyBox.querySelector('#btn-switch-to-arsip')?.addEventListener('click', () => {
              currentSubTab = 'arsip';
              renderTickets(ticketsList, searchedNim);
            });
          } else {
            emptyBox.innerHTML = `
              <span class="text-3xl">📦</span>
              <h4 class="text-sm font-bold text-slate-800 mt-2">Arsip Riwayat Masih Kosong</h4>
              <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
                Berkas layanan akan otomatis masuk ke tab arsip setelah lebih dari 12 jam dikonfirmasi diambil oleh mahasiswa.
              </p>
            `;
          }
          ticketsContainer.appendChild(emptyBox);
          return;
        }

        // Render setiap kartu berkas
        displayList.forEach((ticket, idx) => {
          const isRejected = ticket.status === 'Ditolak' || ticket.statusStep === -1;
          const isDone = ticket.status === 'Selesai (Siap Diambil)' || ticket.status === 'Selesai' || ticket.statusStep === 4;
          const isKomplain = (ticket.layananId || '').toLowerCase().includes('komplain') 
            || (ticket.layananNama || '').toLowerCase().includes('komplain') 
            || (ticket.kode || '').toUpperCase().startsWith('KMP');
          const isArchived = isTicketArchived(ticket);
          
          let step = 1;
          if (ticket.status === 'Selesai (Siap Diambil)' || ticket.status === 'Selesai' || ticket.statusStep === 4) {
            step = 4;
          } else if (ticket.status === 'Verifikasi Dosen / Kaprodi / Dekanat' || ticket.status === 'Verifikasi Dosen / Kaprodi' || (ticket.status && ticket.status.includes('Dosen')) || ticket.statusStep === 3) {
            step = 3;
          } else if (ticket.status === 'Verifikasi Admin Loket' || ticket.status === 'Proses Verifikasi' || ticket.statusStep === 2) {
            step = 2;
          } else {
            step = 1;
          }

          let displayStatus = ticket.status;
          if (displayStatus.includes('Dosen') || displayStatus.includes('Dekanat')) {
            displayStatus = 'Verifikasi Dosen / Kaprodi / Dekanat';
          }

          let displayPosisi = ticket.posisiBerkas || (isKomplain ? 'Proses Rekonsiliasi Nilai SIAKAD' : 'Loket Admin FAPERTA');
          if (displayPosisi.includes('Dosen') || displayPosisi.includes('Dekanat')) {
            displayPosisi = 'Ruang Dosen / Kaprodi / Dekanat';
          }

          const statusColors = {
            'Belum Diproses': { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200', icon: '⏳' },
            'Verifikasi Admin Loket': { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-200', icon: '🔍' },
            'Proses Verifikasi': { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-200', icon: '🔍' },
            'Verifikasi Dosen / Kaprodi / Dekanat': { bg: 'bg-indigo-50', text: 'text-indigo-800', border: 'border-indigo-200', icon: '👨‍🏫' },
            'Verifikasi Dosen / Kaprodi': { bg: 'bg-indigo-50', text: 'text-indigo-800', border: 'border-indigo-200', icon: '👨‍🏫' },
            'Selesai (Siap Diambil)': { bg: 'bg-emerald-50', text: 'text-emerald-800', border: 'border-emerald-200', icon: '📦' },
            'Ditolak': { bg: 'bg-rose-50', text: 'text-rose-800', border: 'border-rose-200', icon: '❌' }
          };
          const badge = statusColors[displayStatus] || statusColors[ticket.status] || { bg: 'bg-slate-50', text: 'text-slate-700', border: 'border-slate-200', icon: '📄' };

          const dynamicPhases = {
            1: {
              badge: 'Tahap 1 dari 4 • Masuk Antrean Loket',
              title: 'Berkas Baru Masuk Antrean Loket',
              percent: 25,
              icon: '⏳',
              themeBg: 'bg-amber-50/80 border-amber-300',
              badgeClass: 'bg-amber-100 text-amber-900 border-amber-300',
              titleColor: 'text-amber-950',
              barColor: 'bg-amber-500',
              defaultNote: 'Permohonan baru masuk antrean loket. Menunggu pemeriksaan data petugas loket.'
            },
            2: {
              badge: 'Tahap 2 dari 4 • Proses Verifikasi Admin Loket',
              title: 'Sedang Diverifikasi Petugas Loket',
              percent: 50,
              icon: '🔍',
              themeBg: 'bg-blue-50/80 border-blue-300',
              badgeClass: 'bg-blue-100 text-blue-900 border-blue-300',
              titleColor: 'text-blue-950',
              barColor: 'bg-blue-600',
              defaultNote: 'Petugas loket sedang memverifikasi data dan kelengkapan berkas pada sistem akademik kampus.'
            },
            3: {
              badge: 'Tahap 3 dari 4 • Verifikasi Dosen / Kaprodi / Dekanat',
              title: 'Sedang Diverifikasi Dosen / Kaprodi / Dekanat',
              percent: 75,
              icon: '👨‍🏫',
              themeBg: 'bg-indigo-50/80 border-indigo-300',
              badgeClass: 'bg-indigo-100 text-indigo-900 border-indigo-300',
              titleColor: 'text-indigo-950',
              barColor: 'bg-indigo-600',
              defaultNote: isKomplain ? 'Sedang dalam telaah rekonsiliasi nilai oleh Dosen Pengampu mata kuliah.' : 'Berkas fisik sedang dalam telaah persetujuan dan tanda tangan Dosen / Kaprodi / Dekanat.'
            },
            4: {
              badge: isKomplain ? 'Tahap 4 dari 4 • Selesai Diproses (Online)' : 'Tahap 4 dari 4 • Selesai (Siap Diambil)',
              title: isKomplain ? 'Komplain Nilai Selesai Diproses (Online)' : 'Dokumen Fisik Resmi Siap Diambil di Loket',
              percent: 100,
              icon: isKomplain ? '✅' : '📦',
              themeBg: 'bg-emerald-50/90 border-emerald-400',
              badgeClass: 'bg-emerald-100 text-emerald-900 border-emerald-300',
              titleColor: 'text-emerald-950',
              barColor: 'bg-emerald-600',
              defaultNote: isKomplain ? 'Klarifikasi nilai telah selesai disesuaikan di sistem SIAKAD. Mahasiswa tidak perlu hadir ke loket.' : 'Dokumen fisik resmi berstempel basah telah selesai diterbitkan dan siap diambil langsung di Loket Admin FAPERTA membawa KTM asli.'
            }
          };
          const curPhase = dynamicPhases[step] || dynamicPhases[1];

          const card = document.createElement('div');
          card.className = `rounded-3xl border ${isRejected ? 'border-rose-200 bg-rose-50/20' : isArchived ? 'border-purple-200 bg-purple-50/15' : isDone ? 'border-emerald-200 bg-white' : 'border-slate-200 bg-white'} p-5 sm:p-7 shadow-xs space-y-5`;

          card.innerHTML = `
            <!-- Header Kartu Berkas -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold ${badge.bg} ${badge.text} border ${badge.border}">
                    <span>${badge.icon}</span>
                    <span>${displayStatus}</span>
                  </span>
                  ${isArchived ? `
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-100 text-purple-900 border border-purple-300">
                      <span>📦</span>
                      <span>Arsip Riwayat (&gt;12 Jam)</span>
                    </span>
                  ` : ''}
                  <span class="text-xs font-medium text-slate-400">Berkas #${idx + 1}</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-black text-slate-900 mt-2 font-mono tracking-tight">
                  ${ticket.kode}
                </h3>
                <p class="text-sm sm:text-base font-bold text-emerald-800 mt-0.5">${ticket.layananNama}</p>
              </div>
              <div class="text-left sm:text-right text-xs">
                <p class="text-slate-400 font-medium">Tanggal Pengajuan:</p>
                <p class="text-sm font-bold text-slate-800 mt-0.5">${ticket.tanggal}</p>
                ${ticket.tanggalDiambil ? `
                  <p class="text-purple-900 font-bold mt-1">Diambil: <strong>${ticket.tanggalDiambil}</strong></p>
                ` : isKomplain ? `
                  <p class="text-emerald-700 font-bold mt-1">Pengambilan: <strong>Proses Online (SIAKAD)</strong></p>
                ` : `
                  <p class="text-slate-500 mt-1">Pengambilan: <strong>Loket Admin FAPERTA</strong></p>
                `}
              </div>
            </div>

            <!-- Posisi Berkas Fisik & Estimasi Selesai Banner -->
            <div class="grid sm:grid-cols-2 gap-3 p-4 rounded-2xl ${isRejected ? 'bg-rose-50 border border-rose-200' : 'bg-slate-50 border border-slate-200'} text-xs sm:text-sm">
              <div class="flex items-start gap-2.5">
                <span class="text-base shrink-0">${isRejected ? '❌' : isKomplain ? '🌐' : '📍'}</span>
                <div>
                  <span class="font-bold text-slate-600 block text-[11px] uppercase tracking-wider">Posisi Berkas:</span>
                  <p class="${isRejected ? 'text-rose-900' : 'text-slate-900'} font-bold mt-0.5">${displayPosisi}</p>
                </div>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-base shrink-0">${isRejected ? '⚠️' : '⏱️'}</span>
                <div>
                  <span class="font-bold text-slate-600 block text-[11px] uppercase tracking-wider">Estimasi Selesai:</span>
                  <p class="${isRejected ? 'text-rose-700' : 'text-emerald-800'} font-extrabold mt-0.5">${(ticket.estimasiSelesai && ticket.estimasiSelesai !== '-') ? ticket.estimasiSelesai : '-'}</p>
                </div>
              </div>
            </div>

            <!-- JIKA DITOLAK: INFORMASI PERBAIKAN -->
            ${isRejected ? `
              <div class="rounded-2xl bg-rose-50 border border-rose-200 p-5 text-xs sm:text-sm text-rose-950 space-y-3">
                <h4 class="font-black text-rose-900 text-sm sm:text-base flex items-center gap-2">
                  <span>❌</span>
                  <span>Permohonan Ditolak / Perlu Perbaikan</span>
                </h4>
                <div class="p-3.5 rounded-xl bg-white border border-rose-200">
                  <strong class="text-rose-900 block font-bold text-xs mb-1">Catatan Petugas Administrasi:</strong>
                  <p class="text-slate-800 italic text-xs sm:text-sm leading-relaxed">${ticket.catatanAdmin || 'Persyaratan belum lengkap.'}</p>
                </div>
                <p class="text-xs text-rose-800 font-medium">
                  💡 <strong>Tindakan Mahasiswa:</strong> ${isKomplain ? 'Silakan perbaiki data atau hubungi admin loket.' : 'Silakan datang langsung ke <strong>Loket Admin FAPERTA</strong> dengan membawa berkas perbaikan.'}
                </p>
              </div>
            ` : `
              <!-- KOTAK PROSES DINAMIS (LANGSUNG CATATAN PETUGAS DI BAWAH JUDUL - Requirement #1) -->
              <div class="rounded-2xl border-2 ${curPhase.themeBg} p-4 sm:p-5 shadow-xs space-y-3">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black border ${curPhase.badgeClass} self-start shadow-2xs">
                    <span>${curPhase.icon}</span>
                    <span>${curPhase.badge}</span>
                  </div>
                  <div class="flex items-center gap-2 text-xs font-bold text-slate-500">
                    <span>Progres:</span>
                    <span class="font-mono text-slate-800 font-extrabold text-sm">${curPhase.percent}%</span>
                  </div>
                </div>

                <!-- Progress Bar Indikator Kompak -->
                <div class="w-full bg-slate-200/80 h-2.5 rounded-full overflow-hidden">
                  <div class="${curPhase.barColor} h-full rounded-full transition-all duration-700 ease-out" style="width: ${curPhase.percent}%"></div>
                </div>

                <!-- Judul Progres & Langsung Catatan Petugas Administrasi -->
                <div class="space-y-2 pt-1">
                  <h4 class="text-sm sm:text-base font-black ${curPhase.titleColor} flex items-center gap-2">
                    <span>${curPhase.icon}</span>
                    <span>${curPhase.title}</span>
                  </h4>
                  
                  <!-- Catatan Petugas Administrasi Langsung di Bawah Judul -->
                  <div class="p-3.5 rounded-xl bg-white/95 border border-slate-200/90 shadow-2xs">
                    <span class="font-bold text-slate-700 block text-xs mb-1 flex items-center gap-1.5">
                      <span>💬</span>
                      <span>Catatan Petugas Administrasi:</span>
                    </span>
                    <p class="text-slate-900 font-medium italic text-xs sm:text-sm leading-relaxed">
                      "${ticket.catatanAdmin || curPhase.defaultNote}"
                    </p>
                  </div>
                </div>
              </div>
            `}

            <!-- JIKA STATUS SELESAI: PANDUAN PENGAMBILAN (DIPERTAHANKAN SESUAI PERMINTAAN USER) -->
            ${isDone ? (isKomplain ? `
              <div class="rounded-2xl bg-emerald-50/90 border-2 border-emerald-300 p-5 text-xs sm:text-sm text-emerald-950 space-y-3">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <h4 class="text-sm sm:text-base font-black text-emerald-900 flex items-center gap-2">
                    <span>✅</span>
                    <span>Hasil Komplain Nilai Selesai Diproses (Online)</span>
                  </h4>
                  <span class="px-2.5 py-0.5 rounded-full bg-emerald-200 text-emerald-900 text-xs font-bold self-start">
                    Selesai Online • Tanpa Perlu ke Loket
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed">
                  Perbaikan nilai telah disesuaikan oleh Dosen Pengampu di SIAKAD. Mahasiswa tidak perlu datang ke loket fisik, silakan langsung login ke portal SIAKAD Anda untuk melihat pembaruan nilai.
                </p>
              </div>
            ` : `
              <div class="rounded-2xl bg-emerald-50/80 border-2 border-emerald-300 p-5 text-xs sm:text-sm text-emerald-950 space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <h4 class="text-sm sm:text-base font-black text-emerald-900 flex items-center gap-2">
                    <span>🏢</span>
                    <span>Dokumen Fisik Sudah Siap Diambil di Loket!</span>
                  </h4>
                  <span class="px-2.5 py-0.5 rounded-full bg-emerald-200 text-emerald-900 text-xs font-bold">
                    Stempel Basah Selesai
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed">
                  Salinan fisik resmi telah selesai diverifikasi dan dibubuhi cap stempel basah Fakultas Pertanian INSTIPER. Silakan ambil langsung di loket:
                </p>
                <div class="grid sm:grid-cols-3 gap-2.5 p-3.5 rounded-xl bg-white border border-emerald-200 text-xs">
                  <div>
                    <span class="text-slate-400 font-bold block text-[10px]">📍 Lokasi Loket:</span>
                    <strong class="text-emerald-950">Loket Admin FAPERTA</strong>
                  </div>
                  <div>
                    <span class="text-slate-400 font-bold block text-[10px]">🕒 Jam Pelayanan:</span>
                    <strong class="text-emerald-950">Senin – Jumat, 08.00 – 15.00 WIB</strong>
                  </div>
                  <div>
                    <span class="text-slate-400 font-bold block text-[10px]">🪪 Syarat Pengambilan:</span>
                    <strong class="text-emerald-950">Membawa KTM Asli & Kode ${ticket.kode}</strong>
                  </div>
                </div>
                ${ticket.sudahDiambil ? `
                  <div class="p-2.5 rounded-xl bg-purple-100 text-purple-900 border border-purple-300 text-xs font-bold flex items-center gap-2">
                    <span>✓</span>
                    <span>Dokumen fisik telah diambil di loket pada ${ticket.tanggalDiambil || '-'}.</span>
                  </div>
                ` : ''}
              </div>
            `) : ''}

            <!-- Footer Bukti Pengambilan & Cetak Struk Mahasiswa (Symmetric, Rapi & Mobile Friendly) -->
            <div class="pt-3.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-600">
              <span class="text-slate-700">Keperluan: <strong class="text-slate-900 font-semibold">${ticket.detailTambahan || ticket.keperluan}</strong></span>
              <button 
                type="button" 
                onclick="window.printOfficialTicket('${ticket.kode}')" 
                class="no-print w-full sm:w-auto px-4 py-2.5 rounded-xl border border-emerald-600 bg-emerald-50 text-emerald-800 hover:bg-emerald-100 font-bold text-xs transition flex items-center justify-center gap-2 cursor-pointer shadow-2xs shrink-0"
              >
                <span>🖨️</span>
                <span>Cetak Tanda Terima Mahasiswa</span>
              </button>
            </div>
          `;

          ticketsContainer.appendChild(card);
        });

        profileCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // 3. Eksekusi Pencarian & Persist URL State (Requirement #4)
      function executeSearch(query, updateUrl = true) {
        if (!query) return;

        // Simpan ke URL agar ketika di-refresh (F5), halaman tetap stay dan me-refresh data terkini
        if (updateUrl) {
          const newUrl = new URL(window.location.href);
          newUrl.searchParams.set('nim', query);
          window.history.replaceState({ nim: query }, '', newUrl.toString());
          try {
            sessionStorage.setItem('portal_faperta_last_nim', query);
          } catch (e) {}
        }

        const all = getAllTickets();

        // Cek jika query cocok dengan NIM
        const matchByNim = all.filter(t => t.nim && t.nim.toUpperCase().replace(/\s+/g, '') === query.replace(/\s+/g, ''));
        if (matchByNim.length > 0) {
          renderTickets(matchByNim, query);
          return;
        }

        // Cek jika query cocok dengan Kode Tiket
        const matchByCode = all.filter(t => t.kode && t.kode.toUpperCase() === query);
        if (matchByCode.length > 0) {
          renderTickets(matchByCode, '');
          return;
        }

        // Cek fuzzy (NIM / Nama / Kode)
        const matchFuzzy = all.filter(t => 
          (t.nim && t.nim.toUpperCase().includes(query)) ||
          (t.nama && t.nama.toUpperCase().includes(query)) ||
          (t.kode && t.kode.toUpperCase().includes(query))
        );

        if (matchFuzzy.length > 0) {
          renderTickets(matchFuzzy, query);
        } else {
          renderTickets([], query);
        }
      }

      // 4. Form Submit Listener
      searchForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = (searchInput?.value || '').trim().toUpperCase();
        if (!query) return;
        executeSearch(query, true);
      });

      // 5. Inisialisasi Otomatis Saat Halaman Dimuat / Direfresh (F5)
      // Mahasiswa akan stay di halaman hasil mereka dan otomatis refresh status perubahan progress surat
      const urlParams = new URLSearchParams(window.location.search);
      const initialQuery = urlParams.get('nim') || urlParams.get('q') || sessionStorage.getItem('portal_faperta_last_nim');
      
      if (initialQuery && searchInput) {
        searchInput.value = initialQuery;
        executeSearch(initialQuery.toUpperCase(), false);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCekStatus);
    } else {
      initCekStatus();
    }
  </script>
</BaseLayout>
