---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { INITIAL_DEMO_TICKETS } from "../../data/portalData";
---
<BaseLayout title="Pendeteksi NIM & Lacak Status Surat" description="Deteksi riwayat pengajuan surat akademik mahasiswa FAPERTA INSTIPER, pantau tahapan proses dan estimasi tanggal selesai.">
  <!-- Header Banner -->
  <section class="grid-paper border-b border-[var(--line)]">
    <div class="container-shell py-8 sm:py-12">
      <nav class="flex items-center gap-2 text-xs font-semibold text-[var(--muted)] mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--leaf)]">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-[var(--leaf)]">Layanan Akademik</a>
        <span>/</span>
        <span class="text-[var(--leaf)] font-bold">Pendeteksi NIM & Lacak Surat</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-[var(--leaf)]/20 bg-[var(--leaf-soft)] px-3 py-1 text-xs font-bold text-[var(--leaf)]">
            <span class="h-2 w-2 rounded-full bg-[var(--gold)]"></span>
            Pelacakan Real-Time Multi-Surat
          </div>
          <h1 class="display-title mt-3 text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--leaf)] leading-tight">
            Pendeteksi NIM & Status Surat
          </h1>
          <p class="mt-3 text-sm sm:text-base leading-relaxed text-[var(--ink)]">
            Masukkan <strong>NIM</strong> Anda untuk mendeteksi seluruh surat permohonan yang pernah diajukan, atau masukkan <strong>Nomor Tiket</strong> spesifik untuk melihat posisi berkas dan estimasi tanggal selesai.
          </p>
        </div>

        <!-- Info SLA -->
        <div class="rounded-2xl border border-[var(--line)] bg-white p-4 shadow-xs flex items-center gap-4 text-xs">
          <div class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-amber-50 text-amber-800 text-lg font-bold border border-amber-200">
            ⏱️
          </div>
          <div>
            <p class="font-bold text-[var(--ink)]">Estimasi Proses Berkas (SLA)</p>
            <p class="text-[var(--muted)] mt-0.5">KHS: 1-2 Hari | Komplain: 2-3 Hari | Ujian: 3-5 Hari</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Physical Loket Pickup Notice Banner -->
  <section class="bg-amber-50/70 border-b border-amber-200/80 py-3 text-xs text-amber-950">
    <div class="container-shell flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-start gap-2.5">
        <span class="text-lg shrink-0">🏢</span>
        <div>
          <strong>Pengambilan Dokumen Fisik di Kampus:</strong>
          <span class="text-amber-900">
            Sistem ini berfungsi untuk memantau tahapan verifikasi berkas. Seluruh dokumen resmi berstempel basah (KHS, surat pengantar, rekomendasi) <strong>wajib diambil langsung oleh mahasiswa di Loket 1 Administrasi FAPERTA (Gedung A Lantai 1)</strong> setelah berstatus <strong>Selesai (Siap Diambil)</strong>.
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Search & Tracking Section -->
  <section class="container-shell py-10">
    <div class="max-w-4xl mx-auto">
      <!-- Search Box Card -->
      <div class="rounded-3xl border-2 border-[var(--line)] bg-white p-6 sm:p-8 shadow-sm">
        <form id="search-form" class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1 flex items-center rounded-2xl border-2 border-[var(--line)] bg-white px-4 py-2 focus-within:border-[var(--leaf)] focus-within:ring-3 focus-within:ring-[var(--leaf)]/15 transition shadow-xs">
            <span class="text-gray-400 text-lg shrink-0 select-none mr-3" aria-hidden="true">🔍</span>
            <input 
              type="text" 
              id="search-input" 
              required
              placeholder="Masukkan NIM (misal: 21/12345/SP) atau Nomor Tiket..." 
              class="w-full bg-transparent py-1.5 text-base sm:text-lg text-[var(--ink)] placeholder:text-gray-400 outline-none border-none font-medium"
            />
          </div>
          <button type="submit" class="btn-cta text-sm px-8 py-3.5 shrink-0 flex items-center justify-center gap-2 shadow-sm">
            <span>Deteksi Berkas</span>
            <span>→</span>
          </button>
        </form>

        <!-- Demo NIM Quick Buttons -->
        <div class="mt-5 pt-4 border-t border-[var(--line)] flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-1.5 text-[var(--muted)]">
            <span class="font-bold text-[var(--leaf)]">Contoh Coba Langsung:</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="demo-nim-btn px-3 py-1.5 rounded-xl bg-[var(--leaf-soft)] text-[var(--leaf)] hover:bg-[var(--leaf)] hover:text-white font-bold transition flex items-center gap-1.5" data-query="21/12345/SP">
              <span>👤 21/12345/SP</span>
              <span class="text-[10px] opacity-75">(Budi - 2 Surat)</span>
            </button>
            <button type="button" class="demo-nim-btn px-3 py-1.5 rounded-xl bg-amber-50 text-amber-900 border border-amber-200 hover:bg-amber-100 font-bold transition flex items-center gap-1.5" data-query="22/67890/SP">
              <span>👤 22/67890/SP</span>
              <span class="text-[10px] opacity-75">(Siti - 1 Surat)</span>
            </button>
            <button type="button" class="demo-nim-btn px-3 py-1.5 rounded-xl bg-blue-50 text-blue-900 border border-blue-200 hover:bg-blue-100 font-bold transition flex items-center gap-1.5" data-query="20/45678/SP">
              <span>👤 20/45678/SP</span>
              <span class="text-[10px] opacity-75">(Ahmad - Selesai)</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Applicant Profile Card (Appears on NIM Search) -->
      <div id="applicant-profile-card" class="hidden mt-8 rounded-3xl border border-[var(--line)] bg-[#f7faf5] p-6 sm:p-7 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="grid h-14 w-14 place-items-center rounded-2xl bg-[var(--leaf)] text-white text-2xl font-bold shadow-xs">
              🎓
            </div>
            <div>
              <span class="badge-online text-[10px]">Data Mahasiswa Terverifikasi</span>
              <h2 id="prof-nama" class="text-xl font-extrabold text-[var(--ink)] mt-0.5">-</h2>
              <p class="text-xs text-[var(--muted)] font-mono">
                NIM: <strong id="prof-nim" class="text-[var(--leaf)] font-bold">-</strong> · <span id="prof-prodi">-</span>
              </p>
            </div>
          </div>
          <div class="sm:text-right border-t sm:border-t-0 pt-3 sm:pt-0 border-[var(--line)]">
            <p class="text-xs text-[var(--muted)]">Total Pengajuan Surat:</p>
            <p id="prof-total" class="text-2xl font-black text-[var(--leaf)]">0 Berkas</p>
          </div>
        </div>
      </div>

      <!-- Multi-Ticket Cards Container -->
      <div id="tickets-container" class="mt-8 space-y-6"></div>

      <!-- Not Found Card -->
      <div id="not-found-card" class="hidden mt-8 rounded-3xl border border-dashed border-gray-300 bg-white p-10 text-center">
        <div class="text-4xl">🔎</div>
        <h3 class="mt-3 text-lg font-bold text-[var(--ink)]">Tidak Ditemukan Berkas untuk Kata Kunci Tersebut</h3>
        <p class="mt-1 text-xs text-[var(--muted)] max-w-md mx-auto leading-relaxed">
          NIM atau Nomor Tiket tidak ditemukan dalam basis data sistem. Pastikan format penulisan NIM atau Tiket sudah benar, atau klik salah satu tombol contoh di atas.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href="/layanan/permohonan-khs" class="btn-cta text-xs py-2.5 px-5">
            Ajukan Permohonan KHS Online
          </a>
          <a href="/layanan" class="btn-secondary text-xs py-2.5 px-5">
            Buka Daftar Layanan
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Script for Unified NIM / Ticket Lookup -->
  <script is:inline define:vars={{ initialDemoTickets: INITIAL_DEMO_TICKETS }}>
    document.addEventListener('DOMContentLoaded', () => {
      const searchForm = document.getElementById('search-form');
      const searchInput = document.getElementById('search-input');
      const profileCard = document.getElementById('applicant-profile-card');
      const ticketsContainer = document.getElementById('tickets-container');
      const notFoundCard = document.getElementById('not-found-card');
      const demoBtns = document.querySelectorAll('.demo-nim-btn');

      // 1. Inisialisasi Database Tiket Terpadu (localStorage)
      function getAllTickets() {
        try {
          const stored = localStorage.getItem('portal_faperta_tickets');
          if (stored) {
            return JSON.parse(stored);
          }
          // Ambil dari portal_khs_tickets jika ada
          const legacy = localStorage.getItem('portal_khs_tickets');
          let combined = [...initialDemoTickets];
          if (legacy) {
            const legacyItems = JSON.parse(legacy);
            legacyItems.forEach(item => {
              if (!combined.some(c => c.kode === item.kode)) {
                combined.unshift({
                  kode: item.kode,
                  nim: item.nim,
                  nama: item.nama,
                  prodi: item.prodi || 'S1 Pertanian',
                  layananNama: item.keperluan || 'Permohonan Dokumen',
                  keperluan: item.keperluan || '-',
                  detailTambahan: item.detailTambahan || '-',
                  format: 'Cetak Fisik Berstempel Basah',
                  status: 'Belum Diproses',
                  statusStep: 1,
                  posisiBerkas: 'Antrean Masuk Loket Administrasi FAPERTA',
                  estimasiSelesai: '1–2 Hari Kerja',
                  slaDays: 2,
                  catatanAdmin: 'Permohonan baru masuk antrean loket. Menunggu pemeriksaan petugas.',
                  tanggal: item.tanggal || 'Hari Ini',
                  isNewForAdmin: true
                });
              }
            });
          }
          localStorage.setItem('portal_faperta_tickets', JSON.stringify(combined));
          return combined;
        } catch (e) {
          return initialDemoTickets;
        }
      }

      // 2. Render Daftar Tiket & Tahapan Progress
      function renderTickets(ticketsList, searchedNim = '') {
        notFoundCard?.classList.add('hidden');
        ticketsContainer.innerHTML = '';

        if (!ticketsList || ticketsList.length === 0) {
          profileCard?.classList.add('hidden');
          notFoundCard?.classList.remove('hidden');
          return;
        }

        // Tampilkan profil jika pencarian berbasis NIM
        if (searchedNim && ticketsList.length > 0) {
          const first = ticketsList[0];
          document.getElementById('prof-nama').textContent = first.nama;
          document.getElementById('prof-nim').textContent = first.nim;
          document.getElementById('prof-prodi').textContent = first.prodi;
          document.getElementById('prof-total').textContent = `${ticketsList.length} Berkas Surat`;
          profileCard?.classList.remove('hidden');
        } else {
          profileCard?.classList.add('hidden');
        }

        // Render setiap kartu surat
        ticketsList.forEach((ticket, idx) => {
          const isRejected = ticket.status === 'Ditolak' || ticket.statusStep === -1;
          const isDone = ticket.status === 'Selesai (Siap Diambil)' || ticket.status === 'Selesai' || ticket.statusStep === 3;
          const step = ticket.statusStep || (ticket.status === 'Selesai (Siap Diambil)' ? 3 : ticket.status === 'Proses Verifikasi' ? 2 : 1);

          const statusColors = {
            'Belum Diproses': { bg: 'bg-amber-100', text: 'text-amber-900', border: 'border-amber-300', icon: '⏳' },
            'Proses Verifikasi': { bg: 'bg-blue-100', text: 'text-blue-900', border: 'border-blue-300', icon: '🔍' },
            'Selesai (Siap Diambil)': { bg: 'bg-emerald-100', text: 'text-emerald-900', border: 'border-emerald-300', icon: '📦' },
            'Ditolak': { bg: 'bg-rose-100', text: 'text-rose-900', border: 'border-rose-300', icon: '❌' },
            // Fallback backward compatibility
            'Diajukan': { bg: 'bg-amber-100', text: 'text-amber-900', border: 'border-amber-300', icon: '⏳' },
            'Verifikasi Berkas': { bg: 'bg-blue-100', text: 'text-blue-900', border: 'border-blue-300', icon: '🔍' },
            'Persetujuan': { bg: 'bg-blue-100', text: 'text-blue-900', border: 'border-blue-300', icon: '🔍' },
            'Selesai': { bg: 'bg-emerald-100', text: 'text-emerald-900', border: 'border-emerald-300', icon: '📦' },
            'Perlu Revisi': { bg: 'bg-rose-100', text: 'text-rose-900', border: 'border-rose-300', icon: '❌' }
          };
          const badge = statusColors[ticket.status] || { bg: 'bg-gray-100', text: 'text-gray-800', border: 'border-gray-200', icon: '📄' };

          const cardHtml = `
            <div class="rounded-3xl border-2 ${isRejected ? 'border-rose-300 bg-rose-50/20' : isDone ? 'border-emerald-300 bg-white' : 'border-[var(--line)] bg-white'} p-6 sm:p-8 shadow-md transition hover:border-[var(--leaf)]">
              <!-- Header Surat -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--line)] pb-5">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase ${badge.bg} ${badge.text} border ${badge.border}">
                      <span>${badge.icon}</span>
                      <span>${ticket.status}</span>
                    </span>
                    <span class="text-xs font-semibold text-[var(--muted)]">Surat #${idx + 1}</span>
                  </div>
                  <h3 class="text-xl sm:text-2xl font-black text-[var(--leaf)] mt-2 font-mono">
                    ${ticket.kode}
                  </h3>
                  <p class="text-sm font-bold text-[var(--ink)] mt-0.5">${ticket.layananNama}</p>
                </div>
                <div class="text-left sm:text-right">
                  <p class="text-xs text-[var(--muted)]">Tanggal Pengajuan:</p>
                  <p class="text-xs font-bold text-[var(--ink)] mt-0.5">${ticket.tanggal}</p>
                  <p class="text-[11px] text-[var(--muted)] mt-1">Pengambilan: <strong class="text-[var(--ink)]">Fisik di Loket 1</strong></p>
                </div>
              </div>

              <!-- Posisi Berkas & Estimasi Jadi (SLA) Banner -->
              <div class="mt-6 grid sm:grid-cols-2 gap-3 p-4 rounded-2xl ${isRejected ? 'bg-rose-50 border border-rose-200' : 'bg-amber-50/70 border border-amber-200'} text-xs">
                <div class="flex items-start gap-2.5">
                  <span class="text-base shrink-0">${isRejected ? '❌' : '📍'}</span>
                  <div>
                    <span class="font-bold ${isRejected ? 'text-rose-900' : 'text-amber-900'}">Posisi Berkas Terkini:</span>
                    <p class="${isRejected ? 'text-rose-950 font-bold' : 'text-amber-950 font-semibold'} mt-0.5">${ticket.posisiBerkas || 'Pemeriksaan Administrasi Loket'}</p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5">
                  <span class="text-base shrink-0">${isRejected ? '⚠️' : '⏱️'}</span>
                  <div>
                    <span class="font-bold ${isRejected ? 'text-rose-900' : 'text-amber-900'}">Estimasi Selesai (SLA):</span>
                    <p class="${isRejected ? 'text-rose-800' : 'text-emerald-800'} font-extrabold mt-0.5">${ticket.estimasiSelesai || '1–2 Hari Kerja'}</p>
                  </div>
                </div>
              </div>

              <!-- JIKA STATUS DITOLAK: TAMPILKAN BANNER KHUSUS PENOLAKAN -->
              ${isRejected ? `
                <div class="mt-6 rounded-2xl bg-rose-100/70 border-2 border-rose-300 p-5 text-xs text-rose-950">
                  <div class="flex items-start gap-3">
                    <span class="text-2xl shrink-0">❌</span>
                    <div>
                      <h4 class="text-sm font-black text-rose-900">Permohonan Berkas Ditolak oleh Petugas</h4>
                      <p class="mt-1 text-rose-900 leading-relaxed">
                        Permohonan ini tidak dapat diproses lebih lanjut karena terdapat ketidaksesuaian berkas atau persyaratan belum lengkap.
                      </p>
                      <div class="mt-3 p-3 rounded-xl bg-white border border-rose-200">
                        <strong class="text-rose-900 block font-bold mb-0.5">Catatan / Alasan Penolakan dari Admin:</strong>
                        <p class="italic text-gray-800 font-medium">${ticket.catatanAdmin || 'Berkas persyaratan belum lengkap atau tidak valid.'}</p>
                      </div>
                      <p class="mt-3 text-[11px] text-rose-800 font-medium">
                        💡 <strong>Tindakan Mahasiswa:</strong> Silakan datang langsung ke <strong>Loket 1 Administrasi FAPERTA (Gedung A Lantai 1)</strong> membawa berkas perbaikan untuk berkonsultasi dengan petugas.
                      </p>
                    </div>
                  </div>
                </div>
              ` : `
                <!-- 3-STEP VISUAL PROGRESS BAR UNTUK ALUR NORMAL -->
                <div class="mt-8">
                  <p class="text-xs font-black uppercase tracking-wider text-[var(--leaf)] mb-4">
                    Tahapan Alur Berkas di Kampus:
                  </p>
                  <div class="grid grid-cols-3 gap-2 text-center relative">
                    <!-- Step 1: Belum Diproses / Antrean -->
                    <div class="flex flex-col items-center">
                      <div class="grid h-10 w-10 place-items-center rounded-full text-sm font-bold shadow-xs ${step >= 1 ? 'bg-[var(--leaf)] text-white' : 'bg-gray-200 text-gray-400'}">
                        ${step > 1 ? '✓' : '1'}
                      </div>
                      <span class="text-xs font-bold mt-2 ${step >= 1 ? 'text-[var(--leaf)]' : 'text-gray-400'}">1. Belum Diproses</span>
                      <span class="text-[10px] text-[var(--muted)] hidden sm:block">Antrean Masuk Loket</span>
                    </div>

                    <!-- Step 2: Proses Verifikasi -->
                    <div class="flex flex-col items-center">
                      <div class="grid h-10 w-10 place-items-center rounded-full text-sm font-bold shadow-xs ${step > 2 ? 'bg-[var(--leaf)] text-white' : step === 2 ? 'bg-[var(--gold)] text-[var(--leaf)] ring-4 ring-[var(--gold)]/25' : 'bg-gray-200 text-gray-400'}">
                        ${step > 2 ? '✓' : '2'}
                      </div>
                      <span class="text-xs font-bold mt-2 ${step >= 2 ? 'text-[var(--leaf)]' : 'text-gray-400'}">2. Verifikasi</span>
                      <span class="text-[10px] text-[var(--muted)] hidden sm:block">Cek Berkas & SIAKAD</span>
                    </div>

                    <!-- Step 3: Selesai Siap Diambil di Loket -->
                    <div class="flex flex-col items-center">
                      <div class="grid h-10 w-10 place-items-center rounded-full text-sm font-bold shadow-xs ${step === 3 ? 'bg-emerald-600 text-white ring-4 ring-emerald-200 animate-pulse' : 'bg-gray-200 text-gray-400'}">
                        ${step === 3 ? '✓' : '3'}
                      </div>
                      <span class="text-xs font-bold mt-2 ${step === 3 ? 'text-emerald-700 font-black' : 'text-gray-400'}">3. Siap Diambil</span>
                      <span class="text-[10px] text-[var(--muted)] hidden sm:block">Loket 1 Gedung A Lt. 1</span>
                    </div>
                  </div>
                </div>
              `}

              <!-- JIKA SELESAI: PANDUAN PENGAMBILAN BERKAS FISIK DI LOKET -->
              ${isDone ? `
                <div class="mt-6 rounded-2xl bg-emerald-50 border-2 border-emerald-300 p-5 text-xs text-emerald-950 shadow-xs">
                  <div class="flex items-start gap-3">
                    <span class="text-2xl shrink-0">🏢</span>
                    <div class="w-full">
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <h4 class="text-sm font-black text-emerald-900">Dokumen Fisik Resmi Sudah Siap Diambil di Loket!</h4>
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-200 text-emerald-900 text-[10px] font-black uppercase tracking-wider">Stempel Basah Siap</span>
                      </div>
                      <p class="mt-1 text-emerald-900 leading-relaxed">
                        Salinan dokumen resmi Anda telah selesai dicetak dan dibubuhi stempel basah resmi Fakultas Pertanian INSTIPER. Silakan langsung mengambil dokumen fisik di loket:
                      </p>
                      <div class="mt-3 grid sm:grid-cols-3 gap-2.5 p-3.5 rounded-xl bg-white border border-emerald-200 text-[11px]">
                        <div>
                          <span class="text-gray-500 font-bold block">📍 Lokasi Pengambilan:</span>
                          <strong class="text-emerald-950">Loket 1 Adm. FAPERTA (Gedung A Lantai 1)</strong>
                        </div>
                        <div>
                          <span class="text-gray-500 font-bold block">🕒 Jam Layanan Loket:</span>
                          <strong class="text-emerald-950">Senin – Jumat, 08.00 – 15.00 WIB</strong>
                        </div>
                        <div>
                          <span class="text-gray-500 font-bold block">🪪 Syarat Pengambilan:</span>
                          <strong class="text-emerald-950">Membawa KTM Asli & Kode Tiket: ${ticket.kode}</strong>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ` : ''}

              <!-- Catatan Resmi Petugas Admin (Jika Bukan Ditolak) -->
              ${!isRejected && ticket.catatanAdmin ? `
                <div class="mt-6 rounded-2xl bg-gray-50 border border-[var(--line)] p-4 text-xs">
                  <span class="font-bold text-[var(--leaf)] flex items-center gap-1">
                    <span>💬 Catatan Petugas Administrasi:</span>
                  </span>
                  <p class="mt-1 text-[var(--ink)] leading-relaxed italic">
                    "${ticket.catatanAdmin}"
                  </p>
                </div>
              ` : ''}

              <!-- Detail Tambahan & Tombol Cetak Bukti Loket -->
              <div class="mt-5 text-xs text-[var(--muted)] flex flex-wrap items-center justify-between gap-2 border-t border-[var(--line)] pt-4">
                <span>Keterangan: <strong class="text-[var(--ink)]">${ticket.detailTambahan || ticket.keperluan}</strong></span>
                <button type="button" onclick="window.print()" class="text-[var(--leaf)] font-bold hover:underline flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--line)] bg-white hover:bg-[var(--leaf-soft)] transition">
                  <span>🖨️</span>
                  <span>Cetak Bukti Pengambilan / Tiket Loket</span>
                </button>
              </div>
            </div>
          `;
          ticketsContainer.insertAdjacentHTML('beforeend', cardHtml);
        });

        ticketsContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // 3. Form Search Handler (Deteksi NIM atau Tiket)
      searchForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = (searchInput?.value || '').trim().toUpperCase();
        if (!query) return;

        executeSearch(query);
      });

      function executeSearch(query) {
        const all = getAllTickets();

        // Cek jika query cocok dengan NIM (bisa ada beberapa tiket)
        const matchByNim = all.filter(t => t.nim && t.nim.toUpperCase().replace(/\s+/g, '') === query.replace(/\s+/g, ''));
        
        if (matchByNim.length > 0) {
          renderTickets(matchByNim, query);
          return;
        }

        // Cek jika query cocok dengan Kode Tiket
        const matchByCode = all.filter(t => t.kode && t.kode.toUpperCase() === query);
        if (matchByCode.length > 0) {
          renderTickets(matchByCode, '');
          return;
        }

        // Cek jika query sebagian (fuzzy NIM atau Nama)
        const matchFuzzy = all.filter(t => 
          (t.nim && t.nim.toUpperCase().includes(query)) ||
          (t.nama && t.nama.toUpperCase().includes(query)) ||
          (t.kode && t.kode.toUpperCase().includes(query))
        );

        if (matchFuzzy.length > 0) {
          renderTickets(matchFuzzy, query);
        } else {
          renderTickets([], query);
        }
      }

      // 4. Demo NIM Click Handlers
      demoBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const q = btn.getAttribute('data-query');
          if (searchInput && q) {
            searchInput.value = q;
            executeSearch(q);
          }
        });
      });

      // Auto check url param ?q=
      const urlParams = new URLSearchParams(window.location.search);
      const urlQuery = urlParams.get('q');
      if (urlQuery && searchInput) {
        searchInput.value = urlQuery;
        executeSearch(urlQuery.toUpperCase());
      }
    });
  </script>
</BaseLayout>
