---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Cek Status Tiket Layanan" description="Lacak progres permohonan KHS dan layanan akademik FAPERTA INSTIPER secara real-time.">
  <!-- Header -->
  <section class="grid-paper border-b border-[var(--line)]">
    <div class="container-shell py-8 sm:py-12">
      <nav class="flex items-center gap-2 text-xs font-semibold text-[var(--muted)] mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--leaf)]">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-[var(--leaf)]">Layanan Akademik</a>
        <span>/</span>
        <span class="text-[var(--leaf)] font-bold">Lacak Status Pengajuan</span>
      </nav>

      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--leaf)]/20 bg-[var(--leaf-soft)] px-3 py-1 text-xs font-bold text-[var(--leaf)]">
          <span class="h-2 w-2 rounded-full bg-[var(--gold)]"></span>
          Pelacakan Real-Time Berkas
        </div>
        <h1 class="display-title mt-3 text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--leaf)] leading-tight">
          Cek Status Pengajuan
        </h1>
        <p class="mt-3 text-sm sm:text-base leading-relaxed text-[var(--ink)]">
          Masukkan Nomor Tiket (misal: <code>KHS-2026-1234</code>) atau NIM Anda untuk memantau tahapan verifikasi dan penyelesaian dokumen akademik Anda.
        </p>
      </div>
    </div>
  </section>

  <!-- Search & Tracking Section -->
  <section class="container-shell py-12">
    <div class="max-w-3xl mx-auto">
      <!-- Search Box Card -->
      <div class="rounded-3xl border border-[var(--line)] bg-white p-6 sm:p-8 shadow-sm">
        <form id="search-form" class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1 flex items-center rounded-2xl border-2 border-[var(--line)] bg-white px-4 py-1.5 focus-within:border-[var(--leaf)] focus-within:ring-3 focus-within:ring-[var(--leaf)]/15 transition shadow-xs">
            <span class="text-gray-400 text-lg shrink-0 select-none mr-3" aria-hidden="true">🔍</span>
            <input 
              type="text" 
              id="search-input" 
              required
              placeholder="Masukkan Nomor Tiket atau NIM Anda..." 
              class="w-full bg-transparent py-2 text-base text-[var(--ink)] placeholder:text-gray-400 outline-none border-none"
            />
          </div>
          <button type="submit" class="btn-cta text-sm px-7 py-3 shrink-0">
            Lacak Berkas →
          </button>
        </form>

        <!-- Shortcut Recent Local Ticket -->
        <div id="quick-ticket-box" class="hidden mt-4 pt-4 border-t border-[var(--line)] flex items-center justify-between gap-3 text-xs">
          <span class="text-[var(--muted)]">Tiket pengajuan terakhir Anda:</span>
          <button id="btn-use-last-ticket" class="font-bold text-[var(--leaf)] hover:underline flex items-center gap-1 bg-[var(--leaf-soft)] px-2.5 py-1 rounded-lg">
            <span id="last-ticket-code">-</span> ↗
          </button>
        </div>
      </div>

      <!-- Result Card Container -->
      <div id="result-container" class="hidden mt-8 rounded-3xl border-2 border-[var(--leaf)] bg-white p-6 sm:p-9 shadow-md animate-fade-in">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--line)] pb-5">
          <div>
            <span id="res-badge" class="badge-online text-xs">Sedang Diproses</span>
            <h3 id="res-ticket" class="text-2xl font-black text-[var(--leaf)] font-mono mt-1">
              KHS-2026-XXXX
            </h3>
            <p id="res-tanggal" class="text-xs text-[var(--muted)] mt-0.5">Diajukan pada: -</p>
          </div>
          <div class="text-left sm:text-right">
            <p class="text-xs text-[var(--muted)]">Pemohon:</p>
            <p id="res-nama" class="font-bold text-sm text-[var(--ink)]">-</p>
            <p id="res-nim" class="text-xs text-[var(--muted)] font-mono">-</p>
          </div>
        </div>

        <!-- 3-Step Tracker Visualization -->
        <div class="mt-8">
          <p class="text-xs font-black text-[var(--leaf)] uppercase tracking-wider mb-4">
            Tahapan Verifikasi & Proses Berkas:
          </p>
          
          <div class="grid grid-cols-3 gap-2 relative">
            <!-- Step 1 -->
            <div class="flex flex-col items-center text-center">
              <div id="step-node-1" class="grid h-10 w-10 place-items-center rounded-full bg-[var(--leaf)] text-white text-sm font-bold shadow-xs">
                ✓
              </div>
              <span class="text-xs font-bold text-[var(--ink)] mt-2">1. Diajukan</span>
              <span class="text-[10px] text-[var(--muted)] hidden sm:block">Data tersimpan</span>
            </div>

            <!-- Step 2 -->
            <div class="flex flex-col items-center text-center">
              <div id="step-node-2" class="grid h-10 w-10 place-items-center rounded-full bg-[var(--gold)] text-[var(--leaf)] text-sm font-bold shadow-xs ring-4 ring-[var(--gold-soft)]">
                2
              </div>
              <span class="text-xs font-bold text-[var(--leaf)] mt-2">2. Verifikasi SIAKAD</span>
              <span class="text-[10px] text-[var(--muted)] hidden sm:block">Pemeriksaan staf</span>
            </div>

            <!-- Step 3 -->
            <div class="flex flex-col items-center text-center">
              <div id="step-node-3" class="grid h-10 w-10 place-items-center rounded-full bg-gray-200 text-gray-500 text-sm font-bold">
                3
              </div>
              <span class="text-xs font-bold text-gray-400 mt-2">3. Selesai</span>
              <span class="text-[10px] text-[var(--muted)] hidden sm:block">Siap unduh / ambil</span>
            </div>
          </div>
        </div>

        <!-- Detail Information Box -->
        <div class="mt-8 rounded-2xl bg-[var(--paper)] border border-[var(--line)] p-5 grid sm:grid-cols-2 gap-3 text-xs">
          <div>
            <span class="text-[var(--muted)]">Program Studi:</span>
            <p id="res-prodi" class="font-bold text-[var(--ink)] mt-0.5">-</p>
          </div>
          <div>
            <span class="text-[var(--muted)]">Keperluan KHS:</span>
            <p id="res-keperluan" class="font-bold text-[var(--leaf)] mt-0.5">-</p>
          </div>
          <div>
            <span class="text-[var(--muted)]">Format Dokumen:</span>
            <p id="res-format" class="font-bold text-[var(--ink)] mt-0.5">-</p>
          </div>
          <div>
            <span class="text-[var(--muted)]">Detail Khusus:</span>
            <p id="res-detail" class="font-bold text-[var(--ink)] mt-0.5">-</p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-8 pt-5 border-t border-[var(--line)] flex flex-col sm:flex-row items-center justify-between gap-4">
          <button id="btn-print-status" type="button" class="w-full sm:w-auto btn-cta text-xs py-2.5 px-5 flex items-center justify-center gap-1.5">
            <span>🖨️</span> Cetak / Simpan Status Tiket
          </button>
          <div class="flex items-center gap-4 text-xs font-bold text-[var(--leaf)]">
            <a href="/layanan/permohonan-khs" class="hover:underline">+ Permohonan KHS</a>
            <span>•</span>
            <a href="/layanan/komplain-nilai" class="hover:underline">+ Komplain Nilai</a>
          </div>
        </div>
      </div>

      <!-- Empty State / Not Found -->
      <div id="not-found-card" class="hidden mt-8 rounded-3xl border border-dashed border-gray-300 bg-white p-8 text-center">
        <div class="text-3xl">🔎</div>
        <h4 class="mt-3 text-base font-bold text-[var(--ink)]">Data Tiket Tidak Ditemukan</h4>
        <p class="mt-1 text-xs text-[var(--muted)] max-w-md mx-auto leading-relaxed">
          Pastikan Nomor Tiket atau NIM yang Anda masukkan sudah benar. Jika Anda baru saja mengajukan di loket fisik, silakan konfirmasi langsung ke Bagian Akademik.
        </p>
        <div class="mt-5">
          <a href="/layanan/permohonan-khs" class="btn-secondary text-xs">
            Isi Formulir Permohonan KHS Online
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Script for Ticket Lookup -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchForm = document.getElementById('search-form');
      const searchInput = document.getElementById('search-input');
      const resultContainer = document.getElementById('result-container');
      const notFoundCard = document.getElementById('not-found-card');
      const quickTicketBox = document.getElementById('quick-ticket-box');
      const lastTicketCode = document.getElementById('last-ticket-code');
      const btnUseLastTicket = document.getElementById('btn-use-last-ticket');

      // Ambil tiket terakhir dari localStorage
      let tickets = [];
      try {
        tickets = JSON.parse(localStorage.getItem('portal_khs_tickets') || '[]');
      } catch (e) {}

      if (tickets.length > 0) {
        const last = tickets[0];
        if (quickTicketBox && lastTicketCode) {
          quickTicketBox.classList.remove('hidden');
          lastTicketCode.textContent = `${last.kode} (${last.nama})`;
          btnUseLastTicket?.addEventListener('click', () => {
            searchInput.value = last.kode;
            renderTicket(last);
          });
        }
      }

      function renderTicket(ticket) {
        notFoundCard?.classList.add('hidden');
        resultContainer?.classList.remove('hidden');

        document.getElementById('res-ticket').textContent = ticket.kode;
        document.getElementById('res-nama').textContent = ticket.nama;
        document.getElementById('res-nim').textContent = `NIM: ${ticket.nim}`;
        document.getElementById('res-tanggal').textContent = `Diajukan pada: ${ticket.tanggal || 'Hari ini'}`;
        document.getElementById('res-prodi').textContent = ticket.prodi;
        document.getElementById('res-keperluan').textContent = ticket.keperluan;
        document.getElementById('res-format').textContent = ticket.format;
        document.getElementById('res-detail').textContent = ticket.detailTambahan || '-';

        resultContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      const btnPrintStatus = document.getElementById('btn-print-status');
      btnPrintStatus?.addEventListener('click', () => {
        window.print();
      });

      searchForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = searchInput.value.trim().toUpperCase();
        if (!query) return;

        // Cari di local tickets
        const found = tickets.find(t => 
          (t.kode && t.kode.toUpperCase() === query) || 
          (t.nim && t.nim.toUpperCase() === query)
        );

        if (found) {
          renderTicket(found);
        } else if (query.startsWith('KHS-')) {
          // Dummy demo ticket if code matches KHS pattern
          const demoTicket = {
            kode: query,
            nama: 'Mahasiswa FAPERTA',
            nim: '21/xxxxx/SP/xxxxx',
            prodi: 'S1 Agroteknologi',
            keperluan: 'Ujian Khusus (Tingkat Akhir)',
            format: 'PDF Digital (WhatsApp & Email)',
            detailTambahan: 'Rancangan Percobaan (3 SKS)',
            tanggal: 'Hari ini'
          };
          renderTicket(demoTicket);
        } else {
          resultContainer?.classList.add('hidden');
          notFoundCard?.classList.remove('hidden');
        }
      });
    });
  </script>
</BaseLayout>
