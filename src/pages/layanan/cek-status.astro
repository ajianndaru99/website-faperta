---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { INITIAL_PORTAL_TICKETS } from "../../data/portalData";
---

<BaseLayout 
  title="Pusat Pelacakan Berkas & Status Surat" 
  description="Lacak riwayat pengajuan surat akademik mahasiswa FAPERTA INSTIPER, pantau tahapan proses dan posisi berkas fisik di loket."
>
  <!-- Header Banner -->
  <section class="grid-paper border-b border-[var(--line)]">
    <div class="container-shell py-10 sm:py-14">
      <nav class="flex items-center gap-2 text-xs font-semibold text-[var(--muted)] mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--leaf)]">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-[var(--leaf)]">Layanan Akademik</a>
        <span>/</span>
        <span class="text-[var(--leaf)] font-bold">Pelacakan Status Berkas</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--leaf)]/20 bg-[var(--leaf-soft)] px-3.5 py-1.5 text-xs font-bold text-[var(--leaf)]">
          <span class="h-2 w-2 rounded-full bg-[var(--gold)]"></span>
          <span>Pelacakan Status Administrasi Mahasiswa</span>
        </div>
        <h1 class="display-title mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--leaf)] leading-tight">
          Lacak Status Permohonan Berkas
        </h1>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-600">
          Masukkan <strong>NIM</strong> Anda untuk menampilkan seluruh permohonan surat yang pernah diajukan, atau masukkan <strong>Nomor Tiket</strong> spesifik untuk memantau posisi berkas fisik loket secara langsung.
        </p>
      </div>

      <!-- Jam Layanan Loket Banner -->
      <div class="mt-8 p-4 sm:p-5 rounded-2xl bg-white border border-[var(--line)] shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="h-11 w-11 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xl font-bold flex items-center justify-center shrink-0">
            🏛️
          </div>
          <div>
            <h3 class="text-sm font-bold text-slate-900">Loket Pelayanan Administrasi FAPERTA</h3>
            <p class="text-xs text-slate-500 mt-0.5">Gedung A Lantai 1 • Buka Senin – Jumat, Pukul 08.00 – 15.00 WIB</p>
          </div>
        </div>
        <div class="text-xs font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 px-3.5 py-1.5 rounded-xl self-start sm:self-center">
          Pengambilan Dokumen Fisik Wajib Membawa KTM Asli
        </div>
      </div>
    </div>
  </section>

  <!-- Search & Tracking Section -->
  <section class="container-shell py-12">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Search Box Card -->
      <div class="rounded-3xl border border-[var(--line)] bg-white p-6 sm:p-8 shadow-sm">
        <form id="search-form" class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1 flex items-center rounded-2xl border-2 border-[var(--line)] bg-white px-4 py-2.5 focus-within:border-[var(--leaf)] focus-within:ring-3 focus-within:ring-[var(--leaf)]/15 transition shadow-xs">
            <span class="text-gray-400 text-xl shrink-0 select-none mr-3" aria-hidden="true">🔍</span>
            <input 
              type="text" 
              id="search-input" 
              required
              placeholder="Masukkan NIM (contoh: 21/12345/SP) atau Nomor Tiket..." 
              class="w-full bg-transparent py-1.5 text-base sm:text-lg text-[var(--ink)] placeholder:text-gray-400 outline-none border-none font-medium"
            />
          </div>
          <button 
            type="submit" 
            class="btn-cta text-sm px-8 py-4 shrink-0 flex items-center justify-center gap-2 shadow-sm font-bold rounded-2xl cursor-pointer"
          >
            <span>Cari Berkas</span>
            <span>→</span>
          </button>
        </form>

        <p class="mt-3 text-xs text-slate-400">
          💡 Tips: Cukup masukkan NIM Anda untuk mendeteksi seluruh berkas surat yang terdaftar di loket.
        </p>
      </div>

      <!-- Applicant Profile Card (Muncul Saat Pencarian NIM) -->
      <div id="applicant-profile-card" class="hidden rounded-3xl border border-slate-200 bg-slate-50/70 p-6 sm:p-8 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div class="flex items-start sm:items-center gap-4">
            <div class="h-14 w-14 rounded-2xl bg-emerald-700 text-white text-2xl font-bold flex items-center justify-center shrink-0 shadow-xs">
              🎓
            </div>
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                Data Mahasiswa Terdaftar
              </span>
              <h2 id="prof-nama" class="text-xl sm:text-2xl font-extrabold text-slate-900 mt-1">-</h2>
              <p class="text-xs sm:text-sm text-slate-500 font-mono mt-1">
                NIM: <strong id="prof-nim" class="text-emerald-800 font-bold">-</strong> · <span id="prof-prodi">-</span>
              </p>
            </div>
          </div>
          <div class="sm:text-right border-t sm:border-t-0 pt-4 sm:pt-0 border-slate-200">
            <p class="text-xs text-slate-500 font-medium">Total Pengajuan Surat:</p>
            <p id="prof-total" class="text-2xl font-black text-emerald-800 mt-0.5">0 Berkas</p>
          </div>
        </div>
      </div>

      <!-- Multi-Ticket Cards Container -->
      <div id="tickets-container" class="space-y-8"></div>

      <!-- Not Found Card -->
      <div id="not-found-card" class="hidden rounded-3xl border-2 border-dashed border-slate-200 bg-white p-12 text-center">
        <div class="text-4xl">🔎</div>
        <h3 class="mt-3 text-lg font-bold text-slate-800">Tidak Ditemukan Berkas untuk Pencarian Ini</h3>
        <p class="mt-2 text-sm text-slate-500 max-w-md mx-auto leading-relaxed">
          NIM atau Nomor Tiket tidak ditemukan dalam sistem loket. Pastikan penulisan NIM atau Tiket sudah sesuai.
        </p>
      </div>

    </div>
  </section>

  <!-- Script Deteksi Berkas & Realtime URL State Handler -->
  <script is:inline define:vars={{ initialPortalTickets: INITIAL_PORTAL_TICKETS }}>
    document.addEventListener('DOMContentLoaded', () => {
      const searchForm = document.getElementById('search-form');
      const searchInput = document.getElementById('search-input');
      const profileCard = document.getElementById('applicant-profile-card');
      const ticketsContainer = document.getElementById('tickets-container');
      const notFoundCard = document.getElementById('not-found-card');

      // 1. Ambil Data Berkas Terbaru dari Storage
      function getAllTickets() {
        try {
          const raw = localStorage.getItem('portal_faperta_tickets');
          if (raw) {
            return JSON.parse(raw);
          }
          localStorage.setItem('portal_faperta_tickets', JSON.stringify(initialPortalTickets));
          return initialPortalTickets;
        } catch (e) {
          return initialPortalTickets;
        }
      }

      // 2. Render Daftar Berkas Mahasiswa (Desain Bersih & Jarak Nyaman)
      function renderTickets(ticketsList, searchedNim = '') {
        notFoundCard?.classList.add('hidden');
        if (!ticketsContainer) return;
        ticketsContainer.innerHTML = '';

        if (!ticketsList || ticketsList.length === 0) {
          profileCard?.classList.add('hidden');
          notFoundCard?.classList.remove('hidden');
          window.getActiveTicketForPrint = () => null;
          return;
        }

        window.getActiveTicketForPrint = () => ticketsList && ticketsList.length > 0 ? ticketsList[0] : null;

        // Tampilkan profil jika pencarian berbasis NIM
        if (searchedNim && ticketsList.length > 0) {
          const first = ticketsList[0];
          document.getElementById('prof-nama').textContent = first.nama;
          document.getElementById('prof-nim').textContent = first.nim;
          document.getElementById('prof-prodi').textContent = first.prodi;
          document.getElementById('prof-total').textContent = `${ticketsList.length} Berkas Surat`;
          profileCard?.classList.remove('hidden');
        } else {
          profileCard?.classList.add('hidden');
        }

        // Render setiap kartu berkas
        ticketsList.forEach((ticket, idx) => {
          const isRejected = ticket.status === 'Ditolak' || ticket.statusStep === -1;
          const isDone = ticket.status === 'Selesai (Siap Diambil)' || ticket.status === 'Selesai' || ticket.statusStep === 4;
          const isKomplain = (ticket.layananId || '').toLowerCase().includes('komplain') 
            || (ticket.layananNama || '').toLowerCase().includes('komplain') 
            || (ticket.kode || '').toUpperCase().startsWith('KMP');
          
          let step = 1;
          if (ticket.status === 'Selesai (Siap Diambil)' || ticket.status === 'Selesai' || ticket.statusStep === 4) {
            step = 4;
          } else if (ticket.status === 'Verifikasi Dosen / Kaprodi' || ticket.statusStep === 3) {
            step = 3;
          } else if (ticket.status === 'Verifikasi Admin Loket' || ticket.status === 'Proses Verifikasi' || ticket.statusStep === 2) {
            step = 2;
          } else {
            step = 1;
          }

          const statusColors = {
            'Belum Diproses': { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200', icon: '⏳' },
            'Verifikasi Admin Loket': { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-200', icon: '🔍' },
            'Proses Verifikasi': { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-200', icon: '🔍' },
            'Verifikasi Dosen / Kaprodi': { bg: 'bg-indigo-50', text: 'text-indigo-800', border: 'border-indigo-200', icon: '👨‍🏫' },
            'Selesai (Siap Diambil)': { bg: 'bg-emerald-50', text: 'text-emerald-800', border: 'border-emerald-200', icon: '📦' },
            'Ditolak': { bg: 'bg-rose-50', text: 'text-rose-800', border: 'border-rose-200', icon: '❌' }
          };
          const badge = statusColors[ticket.status] || { bg: 'bg-slate-50', text: 'text-slate-700', border: 'border-slate-200', icon: '📄' };

          const dynamicPhases = {
            1: {
              badge: 'Tahap 1 dari 4 • Masuk Antrean Loket',
              title: 'Berkas Baru Masuk Antrean Loket',
              desc: 'Permohonan berkas Anda telah berhasil masuk sistem dan sedang menunggu giliran pemeriksaan kelengkapan syarat oleh petugas loket.',
              next: 'Pemeriksaan kelengkapan berkas & pencocokan data SIAKAD oleh Admin Loket',
              percent: 25,
              icon: '⏳',
              themeBg: 'bg-amber-50/80 border-amber-300',
              badgeClass: 'bg-amber-100 text-amber-900 border-amber-300',
              titleColor: 'text-amber-950',
              barColor: 'bg-amber-500'
            },
            2: {
              badge: 'Tahap 2 dari 4 • Proses Verifikasi Admin Loket',
              title: 'Sedang Diverifikasi Petugas Loket',
              desc: 'Petugas administrasi loket sedang mencocokkan data nilai/administrasi pada SIAKAD kampus dan memverifikasi kelayakan berkas.',
              next: 'Verifikasi & persetujuan akademik oleh Dosen Pengampu / Dekanat',
              percent: 50,
              icon: '🔍',
              themeBg: 'bg-blue-50/80 border-blue-300',
              badgeClass: 'bg-blue-100 text-blue-900 border-blue-300',
              titleColor: 'text-blue-950',
              barColor: 'bg-blue-600'
            },
            3: {
              badge: 'Tahap 3 dari 4 • Verifikasi Dosen / Dekanat',
              title: 'Sedang Diverifikasi Dosen / Dekanat',
              desc: 'Berkas Anda sedang dalam telaah persetujuan akademik, tanda tangan, atau disposisi oleh Dosen Pengampu, Kaprodi, atau Dekanat FAPERTA.',
              next: isKomplain ? 'Penyelesaian rekonsiliasi & pembaruan nilai di sistem SIAKAD' : 'Pencetakan salinan resmi & pembubuhan stempel basah Fakultas di Loket Admin FAPERTA',
              percent: 75,
              icon: '👨‍🏫',
              themeBg: 'bg-indigo-50/80 border-indigo-300',
              badgeClass: 'bg-indigo-100 text-indigo-900 border-indigo-300',
              titleColor: 'text-indigo-950',
              barColor: 'bg-indigo-600'
            },
            4: {
              badge: isKomplain ? 'Tahap 4 dari 4 • Selesai Diproses (Online)' : 'Tahap 4 dari 4 • Selesai (Siap Diambil)',
              title: isKomplain ? 'Komplain Nilai Selesai Diproses (Online)' : 'Dokumen Fisik Resmi Siap Diambil di Loket',
              desc: isKomplain 
                ? 'Klarifikasi dan rekonsiliasi nilai telah selesai diproses oleh Dosen Pengampu & Bagian Akademik. Pembaruan nilai dapat dicek langsung di portal SIAKAD. Mahasiswa tidak perlu hadir ke loket admin.'
                : 'Seluruh tahapan verifikasi telah disetujui. Dokumen resmi berstempel basah telah diterbitkan dan siap diambil langsung di Loket Admin FAPERTA.',
              next: isKomplain ? 'Periksa pembaruan nilai pada akun portal SIAKAD Anda' : 'Kunjungi Loket Admin FAPERTA membawa KTM Asli & Kode Tiket',
              percent: 100,
              icon: isKomplain ? '✅' : '📦',
              themeBg: 'bg-emerald-50/90 border-emerald-400',
              badgeClass: 'bg-emerald-100 text-emerald-900 border-emerald-300',
              titleColor: 'text-emerald-950',
              barColor: 'bg-emerald-600'
            }
          };
          const curPhase = dynamicPhases[step] || dynamicPhases[1];

          const card = document.createElement('div');
          card.className = `rounded-3xl border ${isRejected ? 'border-rose-200 bg-rose-50/20' : isDone ? 'border-emerald-200 bg-white' : 'border-slate-200 bg-white'} p-6 sm:p-8 shadow-sm space-y-6`;

          card.innerHTML = `
            <!-- Header Kartu Berkas -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-5">
              <div>
                <div class="flex items-center gap-2.5">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold ${badge.bg} ${badge.text} border ${badge.border}">
                    <span>${badge.icon}</span>
                    <span>${ticket.status}</span>
                  </span>
                  <span class="text-xs font-medium text-slate-400">Berkas #${idx + 1}</span>
                </div>
                <h3 class="text-2xl font-black text-slate-900 mt-2 font-mono tracking-tight">
                  ${ticket.kode}
                </h3>
                <p class="text-base font-bold text-emerald-800 mt-0.5">${ticket.layananNama}</p>
              </div>
              <div class="text-left sm:text-right">
                <p class="text-xs text-slate-400 font-medium">Tanggal Pengajuan:</p>
                <p class="text-sm font-bold text-slate-800 mt-0.5">${ticket.tanggal}</p>
                ${isKomplain ? `
                  <p class="text-xs text-emerald-700 font-bold mt-1">Pengambilan: <strong class="text-emerald-950">Proses Online (Tidak Perlu ke Loket)</strong></p>
                ` : `
                  <p class="text-xs text-slate-500 mt-1">Pengambilan: <strong class="text-slate-800">Loket Admin FAPERTA</strong></p>
                `}
              </div>
            </div>

            <!-- Posisi Berkas Fisik & Estimasi Selesai Banner -->
            <div class="grid sm:grid-cols-2 gap-4 p-5 rounded-2xl ${isRejected ? 'bg-rose-50 border border-rose-200' : 'bg-slate-50 border border-slate-200'} text-sm">
              <div class="flex items-start gap-3">
                <span class="text-lg shrink-0">${isRejected ? '❌' : isKomplain ? '🌐' : '📍'}</span>
                <div>
                  <span class="font-bold text-slate-700 block text-xs uppercase tracking-wider">Posisi Berkas Terkini:</span>
                  <p class="${isRejected ? 'text-rose-900 font-bold' : 'text-slate-900 font-bold'} mt-1">${ticket.posisiBerkas || (isKomplain ? 'Proses Rekonsiliasi Nilai SIAKAD' : 'Loket Admin FAPERTA')}</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-lg shrink-0">${isRejected ? '⚠️' : '⏱️'}</span>
                <div>
                  <span class="font-bold text-slate-700 block text-xs uppercase tracking-wider">Estimasi Selesai:</span>
                  <p class="${isRejected ? 'text-rose-700' : 'text-emerald-800'} font-extrabold mt-1">${ticket.estimasiSelesai || '1–2 Hari Kerja'}</p>
                </div>
              </div>
            </div>

            <!-- JIKA DITOLAK: BANNER INFORMASI PERBAIKAN -->
            ${isRejected ? `
              <div class="rounded-2xl bg-rose-50 border border-rose-200 p-6 text-sm text-rose-950 space-y-3">
                <h4 class="font-black text-rose-900 text-base flex items-center gap-2">
                  <span>❌</span>
                  <span>Permohonan Ditolak / Perlu Perbaikan</span>
                </h4>
                <p class="text-rose-900 leading-relaxed text-xs sm:text-sm">
                  Permohonan berkas belum dapat dilanjutkan karena terdapat kekurangan data atau keterangan perbaikan yang harus dipenuhi.
                </p>
                <div class="p-4 rounded-xl bg-white border border-rose-200">
                  <strong class="text-rose-900 block font-bold text-xs mb-1">Catatan / Alasan Petugas:</strong>
                  <p class="text-slate-800 italic">${ticket.catatanAdmin || 'Persyaratan belum lengkap.'}</p>
                </div>
                <p class="text-xs text-rose-800 font-medium">
                  💡 <strong>Tindakan Mahasiswa:</strong> ${isKomplain ? 'Silakan hubungi admin atau ajukan permohonan ulang dengan melampirkan bukti yang sesuai.' : 'Silakan datang langsung ke <strong>Loket Admin FAPERTA</strong> dengan membawa berkas perbaikan.'}
                </p>
              </div>
            ` : `
              <!-- KOTAK PROSES DINAMIS (MOBILE-FIRST DYNAMIC STATUS BOX) -->
              <div class="rounded-2xl border-2 ${curPhase.themeBg} p-5 sm:p-6 shadow-xs space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                  <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-black border ${curPhase.badgeClass} self-start shadow-2xs">
                    <span>${curPhase.icon}</span>
                    <span>${curPhase.badge}</span>
                  </div>
                  <div class="flex items-center gap-2 text-xs font-bold text-slate-500">
                    <span>Progres:</span>
                    <span class="font-mono text-slate-800 font-extrabold text-sm">${curPhase.percent}%</span>
                  </div>
                </div>

                <!-- Progress Bar Indikator Kompak -->
                <div class="w-full bg-slate-200/80 h-2.5 rounded-full overflow-hidden">
                  <div class="${curPhase.barColor} h-full rounded-full transition-all duration-700 ease-out" style="width: ${curPhase.percent}%"></div>
                </div>

                <div>
                  <h4 class="text-base sm:text-lg font-black ${curPhase.titleColor} flex items-center gap-2">
                    <span>${curPhase.icon}</span>
                    <span>${curPhase.title}</span>
                  </h4>
                  <p class="text-xs sm:text-sm text-slate-700 leading-relaxed mt-1">
                    ${curPhase.desc}
                  </p>
                </div>

                <!-- Bar Langkah Selanjutnya (Efisien di Mobile) -->
                <div class="pt-3 border-t border-slate-200/60 flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-2 text-xs text-slate-600">
                  <span class="font-black text-slate-800 shrink-0 flex items-center gap-1">
                    <span>👉</span>
                    <span>Langkah Selanjutnya:</span>
                  </span>
                  <span class="text-slate-700 font-medium">${curPhase.next}</span>
                </div>
              </div>
            `}

            <!-- JIKA STATUS SELESAI: PANDUAN PENGAMBILAN / KETERANGAN HASIL -->
            ${isDone ? (isKomplain ? `
              <div class="rounded-2xl bg-emerald-50/90 border-2 border-emerald-300 p-6 text-sm text-emerald-950 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <h4 class="text-base font-black text-emerald-900 flex items-center gap-2">
                    <span>✅</span>
                    <span>Hasil Komplain Nilai Telah Selesai Diproses (Online)</span>
                  </h4>
                  <span class="px-3 py-1 rounded-full bg-emerald-200 text-emerald-900 text-xs font-bold self-start">
                    Selesai Online • Tanpa ke Loket
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed">
                  Permohonan klarifikasi dan rekonsiliasi nilai telah selesai diproses oleh Dosen Pengampu serta Bagian Administrasi Akademik. <strong>Mahasiswa tidak perlu hadir ke loket admin</strong>, cukup periksa keterangan di bawah ini dan pantau nilai pada portal SIAKAD.
                </p>
                <div class="p-4 rounded-xl bg-white border border-emerald-300 shadow-2xs space-y-1">
                  <span class="text-slate-500 font-bold block text-xs">📝 Keterangan / Hasil dari Dosen & Admin:</span>
                  <p class="text-slate-900 font-medium italic text-xs sm:text-sm">
                    "${ticket.catatanAdmin || 'Nilai telah diverifikasi dan disesuaikan di sistem SIAKAD. Silakan cek KHS pada portal mahasiswa Anda.'}"
                  </p>
                </div>
                <div class="p-3.5 rounded-xl bg-emerald-100/80 border border-emerald-200 text-xs text-emerald-900 flex items-center gap-2 font-medium">
                  <span>💡</span>
                  <span>Silakan login ke portal SIAKAD INSTIPER untuk melihat perubahan nilai pada transkrip atau KHS Anda.</span>
                </div>
              </div>
            ` : `
              <div class="rounded-2xl bg-emerald-50/80 border-2 border-emerald-300 p-6 text-sm text-emerald-950 space-y-4">
                <div class="flex items-center justify-between gap-2">
                  <h4 class="text-base font-black text-emerald-900 flex items-center gap-2">
                    <span>🏢</span>
                    <span>Dokumen Fisik Sudah Siap Diambil di Loket!</span>
                  </h4>
                  <span class="px-3 py-1 rounded-full bg-emerald-200 text-emerald-900 text-xs font-bold">
                    Stempel Basah Selesai
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed">
                  Salinan fisik resmi telah selesai diverifikasi dan dibubuhi cap stempel basah Fakultas Pertanian INSTIPER. Silakan ambil langsung di loket:
                </p>
                <div class="grid sm:grid-cols-3 gap-3 p-4 rounded-xl bg-white border border-emerald-200 text-xs sm:text-sm">
                  <div>
                    <span class="text-slate-400 font-bold block text-[11px]">📍 Lokasi Loket:</span>
                    <strong class="text-emerald-950">Loket Admin FAPERTA</strong>
                  </div>
                  <div>
                    <span class="text-slate-400 font-bold block text-[11px]">🕒 Jam Pelayanan:</span>
                    <strong class="text-emerald-950">Senin – Jumat, 08.00 – 15.00 WIB</strong>
                  </div>
                  <div>
                    <span class="text-slate-400 font-bold block text-[11px]">🪪 Syarat Pengambilan:</span>
                    <strong class="text-emerald-950">Membawa KTM Asli & Kode ${ticket.kode}</strong>
                  </div>
                </div>
              </div>
            `) : ''}

            <!-- Catatan Petugas Loket -->
            ${ticket.catatanAdmin && !isRejected ? `
              <div class="rounded-2xl bg-slate-50 border border-slate-200 p-5 text-xs sm:text-sm text-slate-800">
                <span class="font-bold text-emerald-800 block mb-1">💬 Catatan Petugas Administrasi:</span>
                <p class="leading-relaxed italic">"${ticket.catatanAdmin}"</p>
              </div>
            ` : ''}

            <!-- Footer Bukti Pengambilan & Cetak Struk Mahasiswa -->
            <div class="pt-5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4 text-xs sm:text-sm text-slate-600">
              <span>Keperluan: <strong class="text-slate-900">${ticket.detailTambahan || ticket.keperluan}</strong></span>
              <button 
                type="button" 
                onclick="window.printOfficialTicket('${ticket.kode}')" 
                class="no-print px-4 py-2.5 rounded-xl border border-emerald-600 bg-emerald-50 text-emerald-800 hover:bg-emerald-100 font-bold text-xs sm:text-sm transition flex items-center gap-2 cursor-pointer shadow-2xs"
              >
                <span>🖨️</span>
                <span>Cetak Tanda Terima Mahasiswa</span>
              </button>
            </div>
          `;

          ticketsContainer.appendChild(card);
        });

        ticketsContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // 3. Eksekusi Pencarian & Persist URL State (Requirement #4)
      function executeSearch(query, updateUrl = true) {
        if (!query) return;

        // Simpan ke URL agar ketika di-refresh (F5), halaman tetap stay dan me-refresh data terkini
        if (updateUrl) {
          const newUrl = new URL(window.location.href);
          newUrl.searchParams.set('nim', query);
          window.history.replaceState({ nim: query }, '', newUrl.toString());
          try {
            sessionStorage.setItem('portal_faperta_last_nim', query);
          } catch (e) {}
        }

        const all = getAllTickets();

        // Cek jika query cocok dengan NIM
        const matchByNim = all.filter(t => t.nim && t.nim.toUpperCase().replace(/\s+/g, '') === query.replace(/\s+/g, ''));
        if (matchByNim.length > 0) {
          renderTickets(matchByNim, query);
          return;
        }

        // Cek jika query cocok dengan Kode Tiket
        const matchByCode = all.filter(t => t.kode && t.kode.toUpperCase() === query);
        if (matchByCode.length > 0) {
          renderTickets(matchByCode, '');
          return;
        }

        // Cek fuzzy (NIM / Nama / Kode)
        const matchFuzzy = all.filter(t => 
          (t.nim && t.nim.toUpperCase().includes(query)) ||
          (t.nama && t.nama.toUpperCase().includes(query)) ||
          (t.kode && t.kode.toUpperCase().includes(query))
        );

        if (matchFuzzy.length > 0) {
          renderTickets(matchFuzzy, query);
        } else {
          renderTickets([], query);
        }
      }

      // 4. Form Submit Listener
      searchForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = (searchInput?.value || '').trim().toUpperCase();
        if (!query) return;
        executeSearch(query, true);
      });

      // 5. Inisialisasi Otomatis Saat Halaman Dimuat / Direfresh (F5)
      // Mahasiswa akan stay di halaman hasil mereka dan otomatis refresh status perubahan progress surat
      const urlParams = new URLSearchParams(window.location.search);
      const initialQuery = urlParams.get('nim') || urlParams.get('q') || sessionStorage.getItem('portal_faperta_last_nim');
      
      if (initialQuery && searchInput) {
        searchInput.value = initialQuery;
        executeSearch(initialQuery.toUpperCase(), false);
      }
    });
  </script>
</BaseLayout>
