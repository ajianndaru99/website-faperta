    category: "Mahasiswa",
    type: "hybrid",
    typeLabel: "Pendataan Hybrid",
    badgeClass: "badge-hybrid",
    desc: "Layanan inventarisasi dan verifikasi beban SKS mahasiswa yang mengulang mata kuliah wajib maupun pilihan untuk optimalisasi penjadwalan kelas dan kuota KRS.",
    actionUrl: "/faq#tanya-jawab",
    actionLabel: "Cek Ketentuan Mengulang",
