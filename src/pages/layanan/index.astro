  },
  {
    id: "ujian-khusus",
    number: "03",
    title: "Pengajuan Ujian Khusus",
    subtitle: "Tingkat Akhir (Maks. 2 Matkul)",
    category: "Mahasiswa",
    type: "hybrid",
    typeLabel: "Formulir Mandiri",
    badgeClass: "badge-hybrid",
    desc: "Pendaftaran ujian khusus bagi mahasiswa tingkat akhir yang telah menempuh seluruh SKS teori dan sedang menyusun skripsi (sisa maksimal 2 mata kuliah). Melampirkan KHS dan persetujuan DPA.",
    actionUrl: "/layanan/ujian-khusus",
    actionLabel: "Isi Formulir Ujian Khusus",
    isPrimary: false,
    steps: ["Ambil KHS (Poin 2)", "Isi Form Ujian Khusus", "Verifikasi Kaprodi & Penguji"]
  },
  {
    id: "judul-penelitian",
