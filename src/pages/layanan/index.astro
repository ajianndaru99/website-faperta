---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PORTAL_SERVICES } from "../../data/portalData";

const categories = [
  "Semua",
  "Dokumen Akademik",
  "Nilai & Perkuliahan",
  "Ujian",
  "Penelitian & Skripsi",
  "Surat & Dokumen",
  "Fasilitas & Dosen"
];
---
<BaseLayout title="12 Layanan Akademik" description="Portal resmi 12 layanan akademik mandiri Fakultas Pertanian INSTIPER Yogyakarta dengan estimasi SLA proses berkas.">
  <!-- Header Banner -->
  <section class="grid-paper border-b border-[var(--line)]">
    <div class="container-shell py-10 sm:py-14">
      <nav class="flex items-center gap-2 text-xs font-semibold text-[var(--muted)] mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--leaf)]">Beranda</a>
        <span>/</span>
        <span class="text-[var(--leaf)] font-bold">Layanan Akademik</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-[var(--leaf)]/20 bg-[var(--leaf-soft)] px-3 py-1 text-xs font-bold text-[var(--leaf)]">
            <span class="h-2 w-2 rounded-full bg-[var(--gold)]"></span>
            12 Menu Layanan Resmi FAPERTA
          </div>
          <h1 class="display-title mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--leaf)] leading-tight">
            Layanan Akademik & Berkas Mahasiswa
          </h1>
          <p class="mt-3 text-sm sm:text-base leading-relaxed text-[var(--ink)]">
            Akses permohonan salinan KHS online, pengajuan ujian khusus, verifikasi nilai, hingga surat izin penelitian dengan kepastian tahapan dan <strong>estimasi waktu proses (SLA)</strong> yang transparan.
          </p>
        </div>

        <!-- Quick Action Box -->
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a href="/layanan/cek-status" class="btn-cta text-xs py-3 px-5 flex items-center gap-2 shadow-sm">
            <span>🔍</span>
            <span>Pendeteksi & Lacak NIM</span>
          </a>
          <a href="/layanan/permohonan-khs" class="btn-secondary text-xs py-3 px-5 bg-white border border-[var(--line)] flex items-center gap-1.5">
            <span class="text-[var(--gold)]">✦</span>
            <span>Formulir KHS Mandiri</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Search & Category Filter Section -->
  <section class="border-b border-[var(--line)] bg-white py-5 sticky top-[74px] z-30 shadow-2xs">
    <div class="container-shell flex flex-col md:flex-row md:items-center justify-between gap-4">
      <!-- Live Search Input -->
      <div class="relative flex-1 max-w-md">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-gray-400 text-sm">
          🔍
        </span>
        <input 
          type="text" 
          id="service-search-input" 
          placeholder="Cari layanan (misal: KHS, nilai, skripsi, ujian, ruang)..." 
          class="w-full rounded-2xl border-2 border-[var(--line)] bg-[#fafcf8] pl-10 pr-4 py-2.5 text-xs sm:text-sm font-medium text-[var(--ink)] placeholder:text-gray-400 focus:border-[var(--leaf)] focus:bg-white focus:outline-none transition shadow-2xs"
        />
        <button 
          id="clear-service-search" 
          type="button" 
          class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-xs text-gray-400 hover:text-[var(--ink)]"
        >
          ✕
        </button>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 scrollbar-none text-xs">
        {categories.map((cat, idx) => (
          <button 
            type="button"
            data-category={cat}
            class:list={[
              "service-category-btn px-3 py-2 rounded-xl font-bold whitespace-nowrap transition",
              idx === 0 
                ? "bg-[var(--leaf)] text-white shadow-2xs" 
                : "bg-gray-100 text-[var(--muted)] hover:bg-[var(--leaf-soft)] hover:text-[var(--leaf)]"
            ]}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="container-shell py-12">
    <!-- Search Status Counter -->
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-[var(--line)] text-xs text-[var(--muted)]">
      <div>
        Menampilkan <strong id="service-count" class="text-[var(--leaf)]">{PORTAL_SERVICES.length}</strong> layanan akademik FAPERTA
      </div>
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-emerald-500"></span> Online Penuh</span>
        <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-amber-500"></span> Verifikasi Hybrid</span>
      </div>
    </div>

    <!-- The 12 Cards Grid -->
    <div id="services-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {PORTAL_SERVICES.map((item) => (
        <article 
          class="service-card rounded-3xl border-2 border-[var(--line)] bg-white p-6 shadow-xs hover:border-[var(--leaf)] hover:shadow-md transition flex flex-col justify-between"
          data-title={item.title.toLowerCase()}
          data-category={item.category.toLowerCase()}
          data-desc={item.desc.toLowerCase()}
          data-type={item.type}
        >
          <div>
            <!-- Top Header Card -->
            <div class="flex items-center justify-between gap-2 border-b border-[var(--line)] pb-4">
              <div class="flex items-center gap-2.5">
                <span class="grid h-8 w-8 place-items-center rounded-xl bg-[var(--leaf-soft)] font-mono text-xs font-black text-[var(--leaf)]">
                  {item.number}
                </span>
                <span class="text-[11px] font-bold text-[var(--muted)] uppercase tracking-wider">
                  {item.category}
                </span>
              </div>
              <span class:list={[item.badgeClass, "text-[10px] px-2 py-0.5 font-bold uppercase"]}>
                {item.typeLabel}
              </span>
            </div>

            <!-- Title & SLA -->
            <div class="mt-4">
              <h2 class="text-lg font-black text-[var(--ink)] leading-snug group-hover:text-[var(--leaf)] transition">
                {item.title}
              </h2>
              <p class="text-xs font-semibold text-[var(--leaf)] mt-0.5">
                {item.subtitle}
              </p>

              <!-- SLA Process Time Badge -->
              <div class="mt-2.5 inline-flex items-center gap-1.5 rounded-lg bg-amber-50 border border-amber-200/80 px-2.5 py-1 text-[11px] font-bold text-amber-900">
                <span>⏱️ Estimasi Jadi:</span>
                <span class="text-emerald-800 font-extrabold">{item.sla}</span>
              </div>

              <!-- Description -->
              <p class="mt-3 text-xs leading-relaxed text-[var(--muted)]">
                {item.desc}
              </p>
            </div>

            <!-- 3-Step Preview Flow -->
            <div class="mt-5 rounded-2xl bg-[#fbfdf9] border border-[var(--line)] p-3.5">
              <p class="text-[10px] font-black uppercase tracking-wider text-[var(--leaf)] mb-2">
                Alur Pengajuan Berkas:
              </p>
              <ol class="space-y-1 text-[11px] text-[var(--ink)]">
                {item.steps.map((st, sIdx) => (
                  <li class="flex items-center gap-1.5">
                    <span class="grid h-4 w-4 shrink-0 place-items-center rounded-full bg-[var(--leaf-soft)] text-[9px] font-bold text-[var(--leaf)]">
                      {sIdx + 1}
                    </span>
                    <span class="truncate">{st}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <!-- Bottom Action Button -->
          <div class="mt-6 pt-4 border-t border-[var(--line)] flex items-center justify-between gap-3">
            <a 
              href={item.actionUrl}
              class:list={[
                "w-full text-center py-2.5 px-4 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5",
                item.isPrimary
                  ? "btn-cta text-xs"
                  : "bg-gray-100 text-[var(--ink)] hover:bg-[var(--leaf-soft)] hover:text-[var(--leaf)] border border-[var(--line)]"
              ]}
            >
              <span>{item.actionLabel}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty Filter State -->
    <div id="empty-services-alert" class="hidden rounded-3xl border border-dashed border-gray-300 bg-white p-12 text-center my-8">
      <span class="text-4xl">🔎</span>
      <h3 class="mt-3 text-base font-bold text-[var(--ink)]">Tidak ada layanan yang sesuai</h3>
      <p class="mt-1 text-xs text-[var(--muted)] max-w-md mx-auto">
        Kueri pencarian Anda tidak cocok dengan layanan manapun. Coba gunakan kata kunci umum seperti "nilai", "skripsi", "khs", atau "surat".
      </p>
      <button id="btn-reset-filters" type="button" class="btn-secondary text-xs mt-4">
        Reset Filter & Pencarian
      </button>
    </div>
  </section>

  <!-- Client-side Interactive Filter Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('service-search-input');
      const clearBtn = document.getElementById('clear-service-search');
      const categoryBtns = document.querySelectorAll('.service-category-btn');
      const cards = document.querySelectorAll('.service-card');
      const countEl = document.getElementById('service-count');
      const emptyAlert = document.getElementById('empty-services-alert');
      const resetBtn = document.getElementById('btn-reset-filters');

      let currentCat = 'Semua';
      let currentQuery = '';

      function filterServices() {
        let visibleCount = 0;

        cards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const category = card.getAttribute('data-category') || '';
          const desc = card.getAttribute('data-desc') || '';

          const matchQuery = !currentQuery || 
                             title.includes(currentQuery) || 
                             category.includes(currentQuery) || 
                             desc.includes(currentQuery);

          let matchCategory = true;
          if (currentCat !== 'Semua') {
            if (currentCat === 'Fasilitas & Dosen') {
              matchCategory = category.includes('fasilitas') || category.includes('dosen');
            } else {
              matchCategory = category.includes(currentCat.toLowerCase());
            }
          }

          if (matchQuery && matchCategory) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countEl) countEl.textContent = visibleCount;

        if (visibleCount === 0) {
          emptyAlert?.classList.remove('hidden');
        } else {
          emptyAlert?.classList.add('hidden');
        }
      }

      searchInput?.addEventListener('input', (e) => {
        currentQuery = e.target.value.trim().toLowerCase();
        if (currentQuery) {
          clearBtn?.classList.remove('hidden');
        } else {
          clearBtn?.classList.add('hidden');
        }
        filterServices();
      });

      clearBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        clearBtn?.classList.add('hidden');
        filterServices();
      });

      categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          categoryBtns.forEach(b => {
            b.classList.remove('bg-[var(--leaf)]', 'text-white', 'shadow-2xs');
            b.classList.add('bg-gray-100', 'text-[var(--muted)]');
          });
          btn.classList.add('bg-[var(--leaf)]', 'text-white', 'shadow-2xs');
          btn.classList.remove('bg-gray-100', 'text-[var(--muted)]');

          currentCat = btn.getAttribute('data-category') || 'Semua';
          filterServices();
        });
      });

      resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        clearBtn?.classList.add('hidden');
        currentCat = 'Semua';
        categoryBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add('bg-[var(--leaf)]', 'text-white', 'shadow-2xs');
            b.classList.remove('bg-gray-100', 'text-[var(--muted)]');
          } else {
            b.classList.remove('bg-[var(--leaf)]', 'text-white', 'shadow-2xs');
            b.classList.add('bg-gray-100', 'text-[var(--muted)]');
          }
        });
        filterServices();
      });
    });
  </script>
</BaseLayout>
