---
import BaseLayout from "../../layouts/BaseLayout.astro";

const services = [
  {
    id: "khs",
    number: "02",
    title: "Permohonan KHS (Kartu Hasil Studi)",
    subtitle: "Semester 1 - 14",
    category: "Mahasiswa",
    type: "online",
    typeLabel: "Layanan Mandiri",
    badgeClass: "badge-online",
    desc: "Permohonan penerbitan salinan KHS resmi / transkrip nilai sementara untuk prasyarat pendaftaran Ujian Khusus, beasiswa, maupun pengaktifan kembali status mahasiswa pasca cuti.",
    actionUrl: "/layanan/permohonan-khs",
    actionLabel: "Isi Formulir KHS Online",
