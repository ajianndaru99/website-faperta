---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout 
  title="Layanan / Dokumen Dalam Proses" 
  description="Pemberitahuan resmi layanan dan berkas akademik yang sedang dalam proses persiapan dan finalisasi Dekanat FAPERTA INSTIPER Yogyakarta."
>
  <!-- Header Banner -->
  <section class="grid-paper border-b border-[var(--line)]">
    <div class="container-shell py-12 sm:py-16">
      <nav class="flex items-center gap-2 text-xs font-semibold text-[var(--muted)] mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--leaf)]">Beranda</a>
        <span>/</span>
        <a href="/layanan" class="hover:text-[var(--leaf)]">Layanan</a>
        <span>/</span>
        <span class="text-[var(--leaf)] font-bold">Dalam Proses</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-bold text-amber-900">
          <span class="h-2 w-2 rounded-full bg-amber-500 animate-ping"></span>
          Tahap Pengembangan & Sinkronisasi
        </div>
        <h1 class="display-title mt-4 text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--leaf)] leading-tight">
          Layanan / Dokumen Dalam Proses
        </h1>
        <p class="mt-3 text-sm sm:text-base leading-relaxed text-[var(--ink)]">
          Fitur formulir atau berkas yang Anda tuju sedang dalam tahap integrasi, penyusunan naskah resmi, atau sinkronisasi data kurikulum bersama pimpinan Dekanat FAPERTA INSTIPER.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Notice Content Section -->
  <section class="container-shell py-12 sm:py-16">
    <div class="max-w-3xl mx-auto">
      <!-- Highlight Card of the Requested Item -->
      <div class="rounded-3xl border-2 border-amber-200 bg-amber-50/50 p-6 sm:p-8 shadow-sm">
        <div class="flex items-start gap-4">
          <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-amber-100 border border-amber-300 text-3xl">
            🚧
          </span>
          <div class="flex-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-amber-900">
              Informasi Status Sistem:
            </span>
            <h2 id="target-item-title" class="text-xl sm:text-2xl font-black text-[var(--ink)] mt-1">
              Layanan / Dokumen Akademik
            </h2>
            <p id="target-item-desc" class="text-xs sm:text-sm text-amber-950 mt-2 leading-relaxed">
              Berkas atau modul permohonan ini sedang dalam proses finalisasi administratif di tingkat Fakultas Pertanian INSTIPER Yogyakarta.
            </p>
          </div>
        </div>
      </div>

      <!-- Panduan Layanan Fisik / Darurat di Kampus -->
      <div class="mt-8 rounded-3xl border-2 border-[var(--line)] bg-white p-6 sm:p-8 shadow-xs">
        <h3 class="text-base sm:text-lg font-black text-[var(--leaf)] flex items-center gap-2">
          <span>🏢</span>
          <span>Butuh Layanan Ini Segera? Kunjungi Loket Kampus:</span>
        </h3>
        <p class="mt-2 text-xs sm:text-sm leading-relaxed text-[var(--muted)]">
          Bagi mahasiswa yang membutuhkan berkas atau pengajuan tersebut untuk keperluan mendesak (persyaratan beasiswa, dispensasi perkuliahan, atau administrasi wisuda), Anda dapat langsung dilayani secara manual oleh petugas loket:
        </p>

        <div class="mt-5 grid sm:grid-cols-2 gap-3.5 text-xs">
          <div class="p-4 rounded-2xl bg-[#f7faf5] border border-[var(--line)]">
            <span class="text-[var(--leaf)] font-bold text-sm block mb-1">📍 Lokasi Loket Fisik:</span>
            <strong class="text-[var(--ink)] text-sm">Loket 1 Administrasi FAPERTA</strong>
            <p class="text-[var(--muted)] mt-0.5">Gedung A Dekanat Lantai 1, Kampus INSTIPER Yogyakarta</p>
          </div>

          <div class="p-4 rounded-2xl bg-[#f7faf5] border border-[var(--line)]">
            <span class="text-[var(--leaf)] font-bold text-sm block mb-1">🕒 Jam Operasional Layanan:</span>
            <strong class="text-[var(--ink)] text-sm">Senin – Jumat: 08.00 – 15.00 WIB</strong>
            <p class="text-[var(--muted)] mt-0.5">Istirahat: 12.00 – 13.00 WIB (Sabtu/Minggu/Hari Libur Tutup)</p>
          </div>

          <div class="p-4 rounded-2xl bg-[#f7faf5] border border-[var(--line)]">
            <span class="text-[var(--leaf)] font-bold text-sm block mb-1">🪪 Syarat Kedatangan:</span>
            <strong class="text-[var(--ink)]">Wajib Membawa KTM Asli</strong>
            <p class="text-[var(--muted)] mt-0.5">Serta berkas pendukung terkait (bila ada)</p>
          </div>

          <div class="p-4 rounded-2xl bg-[#f7faf5] border border-[var(--line)]">
            <span class="text-[var(--leaf)] font-bold text-sm block mb-1">📞 Layanan Bantuan / Hotline:</span>
            <strong class="text-[var(--ink)]">Kantor Dekanat FAPERTA</strong>
            <p class="text-[var(--muted)] mt-0.5">Telp: (0274) 885563 / 885564</p>
          </div>
        </div>
      </div>

      <!-- Layanan & Fitur yang Sudah Aktif & Siap Digunakan -->
      <div class="mt-8 rounded-3xl border border-[var(--line)] bg-[#fcfefb] p-6 sm:p-7">
        <h3 class="text-sm font-black uppercase tracking-wider text-[var(--leaf)] mb-4">
          ✦ Fitur & Layanan yang Sudah Aktif & Siap Digunakan:
        </h3>
        <div class="grid sm:grid-cols-2 gap-3">
          <a href="/layanan/permohonan-khs" class="p-4 rounded-2xl border border-[var(--line)] bg-white hover:border-[var(--leaf)] hover:shadow-xs transition flex items-center justify-between group">
            <div>
              <p class="text-xs font-black text-[var(--ink)] group-hover:text-[var(--leaf)] transition">Permohonan KHS Online</p>
              <p class="text-[11px] text-[var(--muted)]">Semester 1-12 (Rentang 1-3, 2-4, dll)</p>
            </div>
            <span class="text-[var(--leaf)] font-bold text-sm">→</span>
          </a>

          <a href="/layanan/cek-status" class="p-4 rounded-2xl border border-[var(--line)] bg-white hover:border-[var(--leaf)] hover:shadow-xs transition flex items-center justify-between group">
            <div>
              <p class="text-xs font-black text-[var(--ink)] group-hover:text-[var(--leaf)] transition">Pendeteksi NIM & Lacak Berkas</p>
              <p class="text-[11px] text-[var(--muted)]">Pantau alur verifikasi loket kampus</p>
            </div>
            <span class="text-[var(--leaf)] font-bold text-sm">→</span>
          </a>

          <a href="/layanan/komplain-nilai" class="p-4 rounded-2xl border border-[var(--line)] bg-white hover:border-[var(--leaf)] hover:shadow-xs transition flex items-center justify-between group">
            <div>
              <p class="text-xs font-black text-[var(--ink)] group-hover:text-[var(--leaf)] transition">Komplain & Rekonsiliasi Nilai</p>
              <p class="text-[11px] text-[var(--muted)]">Klarifikasi nilai dosen & prodi</p>
            </div>
            <span class="text-[var(--leaf)] font-bold text-sm">→</span>
          </a>

          <a href="/unduhan" class="p-4 rounded-2xl border border-[var(--line)] bg-white hover:border-[var(--leaf)] hover:shadow-xs transition flex items-center justify-between group">
            <div>
              <p class="text-xs font-black text-[var(--ink)] group-hover:text-[var(--leaf)] transition">Buku Panduan 2026-2027 & Denah</p>
              <p class="text-[11px] text-[var(--muted)]">Unduh PDF resmi & folder panduan skripsi</p>
            </div>
            <span class="text-[var(--leaf)] font-bold text-sm">→</span>
          </a>
        </div>
      </div>

      <!-- Action Navigation Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <button 
          type="button" 
          onclick="window.history.length > 1 ? window.history.back() : window.location.href='/layanan'"
          class="btn-secondary text-xs py-3 px-6 bg-white border border-[var(--line)] flex items-center gap-2 font-bold"
        >
          <span>←</span>
          <span>Kembali ke Halaman Sebelumnya</span>
        </button>
        <a href="/" class="btn-cta text-xs py-3 px-6 flex items-center gap-2 font-bold shadow-xs">
          <span>Ke Beranda FAPERTA</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Client-side Script to Read URL Params -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const item = urlParams.get('item');
      const tipe = urlParams.get('tipe');

      const titleEl = document.getElementById('target-item-title');
      const descEl = document.getElementById('target-item-desc');

      if (item && titleEl) {
        titleEl.textContent = decodeURIComponent(item);
        if (descEl) {
          if (tipe === 'unduhan') {
            descEl.innerHTML = `Berkas unduhan <strong>"${decodeURIComponent(item)}"</strong> sedang dalam penyusunan dan sinkronisasi berkas oleh Dekanat FAPERTA. Mohon menunggu rilis versi resmi atau hubungi Loket 1 Kampus.`;
          } else {
            descEl.innerHTML = `Layanan permohonan <strong>"${decodeURIComponent(item)}"</strong> saat ini masih diproses secara manual di loket fisik kampus selagi sistem formulir online sedang dalam tahap finalisasi teknis.`;
          }
        }
      }
    });
  </script>
</BaseLayout>
