---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqs = [
  {
    id: "presensi",
    code: "01",
    category: "Kehadiran",
    categoryKey: "kehadiran",
    title: "Presensi Minimal Kuliah",
    highlight: "Minimal 75% Tatap Muka (Praktikum 100%)",
    highlightBadge: "Syarat Mutlak UAS",
    highlightColor: "text-[var(--gold)]",
    summary: "Mahasiswa wajib hadir minimal 75% dari total perkuliahan per mata kuliah untuk berhak mengikuti Ujian Akhir Semester (UAS). Presensi praktikum laboratorium dan kebun wajib 100%. Presensi di bawah 75% tanpa keterangan dokter/izin sah otomatis dinyatakan tidak lulus (nilai K/E)."
  },
  {
    id: "masa-studi",
    code: "02",
    category: "Kurikulum",
    categoryKey: "studi",
    title: "Masa Studi & Beban SKS Sarjana S1",
    highlight: "Normal 8 Semester (144 SKS) · Maksimal 14 Semester",
    highlightBadge: "Agroteknologi & Agribisnis",
    highlightColor: "text-[var(--leaf)]",
    summary: "Beban total kelulusan sarjana S1 Pertanian minimal 144 SKS. Mahasiswa berprestasi dengan IPK ≥ 3.00 dapat menuntaskan kuliah dalam 7 semester. Batas maksimal masa tempuh studi adalah 14 semester (7 tahun) sebelum terkena evaluasi batas waktu studi."
  },
  {
    id: "cumlaude",
    code: "03",
    category: "Kelulusan",
    categoryKey: "kelulusan",
    title: "Kriteria Kelulusan Predikat Cumlaude",
    highlight: "IPK 3.51 - 4.00 · Tepat Waktu 8 Semester",
    highlightBadge: "Dengan Pujian",
    highlightColor: "text-[var(--gold)]",
    summary: "Syarat Cumlaude: (1) IPK minimal 3.51, (2) Masa studi maksimal 8 semester tanpa pernah cuti akademik, (3) Tidak pernah mengulang mata kuliah untuk perbaikan nilai, (4) Tidak memiliki nilai di bawah B, dan (5) Bebas pelanggaran tata tertib akademik."
  },
  {
    id: "turnitin-ai",
    code: "04",
    category: "Integritas",
    categoryKey: "skripsi",
    title: "Batas Turnitin & Etika AI Skripsi",
    highlight: "Similarity Maksimal 20% - 25% · AI Hanya Asistensi",
    highlightBadge: "Surat Edaran 2025",
    highlightColor: "text-[var(--leaf)]",
    summary: "Naskah proposal dan skripsi wajib lolos uji Turnitin dengan batas maksimal kesamaan 20% - 25%. Penggunaan Generative AI (ChatGPT, Claude, dsb.) hanya diperbolehkan sebatas pengecekan tata bahasa/literatur, bukan untuk analisis data percobaan atau penarikan kesimpulan mandiri."
  },
  {
    id: "ujian-susulan",
    code: "05",
    category: "Ujian",
    categoryKey: "kehadiran",
    title: "Syarat Mengajukan Ujian Susulan",
    highlight: "Pengajuan Maksimal 3 Hari Kerja Pasca Ujian",
    highlightBadge: "Alasan Sah & Tertulis",
    highlightColor: "text-[var(--gold)]",
    summary: "Ujian susulan hanya disetujui jika berhalangan karena alasan sah: (1) Sakit rawat inap dengan surat dokter berizin, (2) Duka cita keluarga inti dengan surat kematian, atau (3) Tugas resmi universitas. Wajib melapor ke Bagian Akademik dalam 3 hari kerja."
  },
  {
    id: "remidi",
    code: "06",
    category: "Perbaikan",
    categoryKey: "studi",
    title: "Ketentuan Ujian Remidi Semester",
    highlight: "Nilai Maksimal Hasil Remidi adalah B",
    highlightBadge: "Nilai Awal: C / D / E",
    highlightColor: "text-[var(--leaf)]",
    summary: "Diperuntukkan bagi mahasiswa dengan presensi awal ≥ 75% yang memperoleh nilai C, D, atau E. Pelaksanaan dilakukan di akhir semester sesuai kalender akademik, dan nilai akhir tertinggi yang dapat dibukukan adalah B."
  },
  {
    id: "ujian-khusus",
    code: "07",
    category: "Tingkat Akhir",
    categoryKey: "kelulusan",
    title: "Ketentuan Ujian Khusus Tingkat Akhir",
    highlight: "Sisa Maksimal 2 Mata Kuliah Belum Lulus",
    highlightBadge: "SKS Teori Tuntas + Sedang Skripsi",
    highlightColor: "text-[var(--gold)]",
    summary: "Jalur evaluasi khusus untuk mahasiswa tingkat akhir yang telah menuntaskan seluruh beban SKS teori dan sedang/telah menyusun skripsi, namun masih menyisakan maksimal 2 mata kuliah (D/E). Wajib melampirkan KHS resmi dan persetujuan DPA serta Kaprodi."
  }
];

const regulasiList = [
  {
    type: "SK Rektor",
    year: "2025",
    title: "Pedoman Pokok Akademik INSTIPER",
    desc: "Keputusan resmi tentang tata kelola, hak, kewajiban, dan standar pembelajaran.",
    file: "/dokumen/sk-pedoman-akademik.pdf"
  },
  {
    type: "Surat Edaran",
    year: "2025",
    title: "Ketentuan Tugas Akhir & Skripsi",
    desc: "Panduan alur pengajuan judul, seminar proposal, penelitian, dan sidang pendadaran.",
    file: "/dokumen/se-tugas-akhir.pdf"
  },
  {
    type: "Surat Edaran",
    year: "2025",
    title: "Etika Penggunaan Kecerdasan Buatan (AI)",
    desc: "Pedoman integritas ilmiah dan batasan penggunaan AI dalam penulisan tugas dan skripsi.",
    file: "/dokumen/se-etika-ai.pdf"
  }
];
---
<BaseLayout title="FAQ & Regulasi Ringkas" description="Ringkasan aturan akademik pokok FAPERTA INSTIPER Yogyakarta: Presensi, Turnitin, Cumlaude, Ujian Susulan, dan Ujian Khusus tanpa klik berbelit.">
  <!-- Header Banner Ringkas -->
  <section class="grid-paper border-b border-[var(--line)]">
    <div class="container-shell py-8 sm:py-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-[var(--leaf)]/20 bg-[var(--leaf-soft)] px-3 py-1 text-xs font-bold text-[var(--leaf)]">
            <span class="h-2 w-2 rounded-full bg-[var(--gold)]"></span>
            Ringkasan Cepat · Bebas Klik Berbelit
          </div>
          <h1 class="display-title mt-3 text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--leaf)] leading-tight">
            Aturan & Regulasi Akademik
          </h1>
          <p class="mt-2 text-sm sm:text-base leading-relaxed text-[var(--ink)]">
            Seluruh poin penting presensi, batas Turnitin, kriteria cumlaude, dan ujian dapat langsung Anda baca di bawah ini tanpa perlu membuka-tutup menu akordeon.
          </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
          <a href="/layanan" class="btn-cta text-xs py-2.5 px-5">
            📋 Butuh Formulir Layanan? →
          </a>
        </div>
      </div>

      <!-- Quick Filter & Live Search Bar (Ultra Praktis & Efisien) -->
      <div class="mt-8 pt-6 border-t border-[var(--line)] flex flex-col sm:flex-row items-center gap-3">
        <!-- Live Search Input -->
        <div class="flex items-center rounded-full border border-[var(--line)] bg-white px-3.5 py-1.5 focus-within:border-[var(--leaf)] focus-within:ring-2 focus-within:ring-[var(--leaf)]/15 transition w-full sm:w-80">
          <span class="text-gray-400 text-xs shrink-0 select-none mr-2" aria-hidden="true">🔍</span>
          <input 
            type="text" 
            id="faq-search" 
            placeholder="Cari kata kunci (contoh: 75%, cumlaude, AI)..." 
            class="w-full bg-transparent py-1 text-xs text-[var(--ink)] placeholder:text-gray-400 outline-none border-none"
          />
        </div>

        <!-- Category Pills -->
        <div class="flex flex-wrap items-center gap-1.5 w-full sm:w-auto" id="filter-pills">
          <button class="filter-btn active touch-target px-3 py-1 rounded-full text-xs font-bold transition bg-[var(--leaf)] text-white" data-cat="all">
            Semua (7)
          </button>
          <button class="filter-btn touch-target px-3 py-1 rounded-full text-xs font-bold transition bg-white border border-[var(--line)] text-[var(--ink)] hover:bg-[var(--leaf-soft)]" data-cat="kehadiran">
            Presensi & Ujian
          </button>
          <button class="filter-btn touch-target px-3 py-1 rounded-full text-xs font-bold transition bg-white border border-[var(--line)] text-[var(--ink)] hover:bg-[var(--leaf-soft)]" data-cat="kelulusan">
            Cumlaude & Ujian Khusus
          </button>
          <button class="filter-btn touch-target px-3 py-1 rounded-full text-xs font-bold transition bg-white border border-[var(--line)] text-[var(--ink)] hover:bg-[var(--leaf-soft)]" data-cat="skripsi">
            Turnitin & AI
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 01: Daftar Card Aturan (Langsung Terbaca / Zero Clicks) -->
  <section class="container-shell py-10 sm:py-14">
    <div id="faq-cards-grid" class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {faqs.map((faq) => (
        <article class="faq-card rounded-3xl border border-[var(--line)] bg-white p-6 shadow-xs hover:border-[var(--leaf)] transition flex flex-col justify-between" data-cat={faq.categoryKey} data-text={`${faq.title} ${faq.highlight} ${faq.summary} ${faq.category}`.toLowerCase()}>
          <div>
            <!-- Top Tag -->
            <div class="flex items-center justify-between gap-2 border-b border-[var(--line)] pb-3">
              <span class="text-[10px] font-black uppercase tracking-wider text-[var(--muted)]">
                POIN {faq.code} · {faq.category}
              </span>
              <span class="badge-online text-[10px] py-0.5 px-2">
                {faq.highlightBadge}
              </span>
            </div>

            <!-- Title -->
            <h2 class="mt-4 text-lg font-black text-[var(--leaf)] leading-snug">
              {faq.title}
            </h2>

            <!-- Key Takeaway Callout (Highlight Langsung) -->
            <div class="mt-3 rounded-xl bg-[var(--paper)] border border-[var(--line)] p-3">
              <p class="text-xs font-black text-[var(--ink)]">
                📌 <span class={faq.highlightColor}>{faq.highlight}</span>
              </p>
            </div>

            <!-- Description (Langsung Tampil Tanpa Klik) -->
            <p class="mt-3 text-xs leading-relaxed text-[var(--muted)]">
              {faq.summary}
            </p>
          </div>

          <!-- Quick Action Footer -->
          <div class="mt-5 pt-3 border-t border-[var(--line)] flex items-center justify-between text-[11px]">
            <span class="text-[var(--muted)] font-medium">FAPERTA INSTIPER</span>
            {faq.id === "ujian-khusus" && (
              <a href="/layanan/permohonan-khs" class="font-bold text-[var(--leaf)] hover:underline inline-flex items-center gap-1">
                Ajukan KHS Ujian Khusus →
              </a>
            )}
            {faq.id === "presensi" && (
              <a href="/unduhan" class="font-bold text-[var(--leaf)] hover:underline inline-flex items-center gap-1">
                Buku Panduan PDF →
              </a>
            )}
            {faq.id === "turnitin-ai" && (
              <a href="/dokumen/se-etika-ai.pdf" download class="font-bold text-[var(--leaf)] hover:underline inline-flex items-center gap-1">
                Unduh SE AI ↗
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State saat pencarian tidak ditemukan -->
    <div id="faq-empty" class="hidden rounded-3xl border border-dashed border-gray-300 bg-white p-8 text-center mt-6">
      <p class="text-2xl">🔍</p>
      <h3 class="text-sm font-bold text-[var(--ink)] mt-2">Tidak ada aturan yang cocok dengan kata kunci pencarian.</h3>
      <p class="text-xs text-[var(--muted)] mt-1">Coba gunakan kata kunci lain seperti "presensi", "cumlaude", "AI", atau "remidi".</p>
    </div>
  </section>

  <!-- Section 02: SK dan Surat Edaran Resmi (Langsung Unduh 1-Klik) -->
  <section id="regulasi-sk" class="bg-[#edf4eb] border-t border-[var(--line)] py-12 sm:py-16">
    <div class="container-shell">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[var(--line)] pb-5">
        <div>
          <p class="eyebrow">Dokumen Hukum Resmi</p>
          <h2 class="text-2xl sm:text-3xl font-black text-[var(--leaf)]">Surat Keputusan & Surat Edaran</h2>
        </div>
        <p class="text-xs text-[var(--muted)]">Unduh langsung dokumen PDF berkas regulasi resmi.</p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {regulasiList.map((item) => (
          <div class="rounded-2xl border border-[var(--line)] bg-white p-5 shadow-xs flex flex-col justify-between hover:border-[var(--leaf)] transition">
            <div>
              <div class="flex items-center justify-between text-[11px] font-bold">
                <span class="text-[var(--gold)]">{item.type}</span>
                <span class="text-[var(--muted)]">{item.year}</span>
              </div>
              <h3 class="mt-3 text-base font-black text-[var(--ink)] leading-snug">
                {item.title}
              </h3>
              <p class="mt-2 text-xs text-[var(--muted)] leading-relaxed">
                {item.desc}
              </p>
            </div>

            <div class="mt-5 pt-3 border-t border-[var(--line)]">
              <a 
                href={item.file} 
                download
                class="w-full text-center py-2 px-3 rounded-xl bg-[var(--leaf-soft)] text-[var(--leaf)] text-xs font-bold hover:bg-[var(--leaf)] hover:text-white transition inline-flex items-center justify-center gap-1.5"
              >
                <span>Unduh PDF Langsung</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client-side Fast Live Search & Category Filter Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('faq-search');
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.faq-card');
      const emptyState = document.getElementById('faq-empty');

      let currentCat = 'all';
      let searchQuery = '';

      function filterCards() {
        let visibleCount = 0;

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-cat');
          const cardText = card.getAttribute('data-text') || '';

          const matchCat = currentCat === 'all' || cardCat === currentCat;
          const matchSearch = searchQuery === '' || cardText.includes(searchQuery);

          if (matchCat && matchSearch) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCount === 0) {
          emptyState?.classList.remove('hidden');
        } else {
          emptyState?.classList.add('hidden');
        }
      }

      // Live search input handler
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterCards();
      });

      // Category buttons handler
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('bg-[var(--leaf)]', 'text-white', 'active');
            b.classList.add('bg-white', 'border', 'border-[var(--line)]', 'text-[var(--ink)]');
          });

          btn.classList.remove('bg-white', 'border', 'border-[var(--line)]', 'text-[var(--ink)]');
          btn.classList.add('bg-[var(--leaf)]', 'text-white', 'active');

          currentCat = btn.getAttribute('data-cat') || 'all';
          filterCards();
        });
      });
    });
  </script>
</BaseLayout>
