                if (target) openAccountModal('edit', target);
              });
            });
          }
        }
      }

      // 9. Modal Tambah & Edit Akun (Khusus Super Admin)
      const accountModal = document.getElementById('admin-account-modal');
      const accountModalBackdrop = document.getElementById('account-modal-backdrop');
      const btnCloseAccountModal = document.getElementById('btn-close-account-modal');
      const btnCancelAccountModal = document.getElementById('btn-cancel-account-modal');
      const accountManageForm = document.getElementById('account-manage-form');
      const accountModalTitle = document.getElementById('account-modal-title');
      const accFormMode = document.getElementById('acc-form-mode');
      const accFormId = document.getElementById('acc-form-id');
      const accNama = document.getElementById('acc-nama');
      const accUsername = document.getElementById('acc-username');
      const accPassword = document.getElementById('acc-password');
      const accRole = document.getElementById('acc-role');
      const accStatus = document.getElementById('acc-status');
      const accLoket = document.getElementById('acc-loket');
      const btnAddAccountEl = document.getElementById('btn-add-account');

      function openAccountModal(mode, accData = null) {
        if (!accountModal) return;
        if (accFormMode) accFormMode.value = mode;
        if (mode === 'edit' && accData) {
          if (accountModalTitle) accountModalTitle.textContent = `Edit Akun: ${accData.nama}`;
          if (accFormId) accFormId.value = accData.id;
          if (accNama) accNama.value = accData.nama;
          if (accUsername) accUsername.value = accData.username;
          if (accPassword) accPassword.value = accData.password || '';
          if (accRole) accRole.value = accData.role;
          if (accStatus) accStatus.value = accData.status || 'Aktif';
          if (accLoket) accLoket.value = accData.loket || accData.bagian || '';
        } else {
          if (accountModalTitle) accountModalTitle.textContent = 'Tambah Akun Pengguna Baru';
          if (accFormId) accFormId.value = '';
          accountManageForm?.reset();
          if (accRole) accRole.value = 'Petugas Loket';
          if (accStatus) accStatus.value = 'Aktif';
        }
        accountModal.classList.remove('hidden');
      }

      function closeAccountModal() {
        accountModal?.classList.add('hidden');
      }

      btnAddAccountEl?.addEventListener('click', () => openAccountModal('add'));
      btnCloseAccountModal?.addEventListener('click', closeAccountModal);
      btnCancelAccountModal?.addEventListener('click', closeAccountModal);
      accountModalBackdrop?.addEventListener('click', closeAccountModal);

      accountManageForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const mode = accFormMode?.value;
        const id = accFormId?.value;
        const allAdmins = loadAdminAccounts();

        if (mode === 'edit') {
          const target = allAdmins.find(x => x.id === id);
          if (target) {
            target.nama = (accNama?.value || '').trim();
            target.username = (accUsername?.value || '').trim().toLowerCase();
            target.password = (accPassword?.value || '').trim();
            target.role = accRole?.value || 'Petugas Loket';
            target.status = accStatus?.value || 'Aktif';
            target.loket = (accLoket?.value || '').trim();
            target.terakhirAkses = 'Baru saja diubah';
          }
        } else {
          const newId = `ADM-0${allAdmins.length + 1}`;
          const newAcc = {
            id: newId,
            nama: (accNama?.value || '').trim(),
            username: (accUsername?.value || '').trim().toLowerCase(),
            password: (accPassword?.value || '').trim(),
            role: accRole?.value || 'Petugas Loket',
            status: accStatus?.value || 'Aktif',
            loket: (accLoket?.value || '').trim(),
            terakhirAkses: 'Baru dibuat'
          };
          allAdmins.push(newAcc);
        }

        saveAdminAccounts(allAdmins);
        closeAccountModal();
        renderDatabaseTables();
      });

      // 10. Quick Search Berkas & Aksi Terbaca
      const searchInput = document.getElementById('admin-search-input');
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        renderTicketsList();
      });

      const btnMarkAll = document.getElementById('btn-mark-all-read');
      btnMarkAll?.addEventListener('click', () => {
        const all = loadTickets();
        all.forEach(t => { t.isNewForAdmin = false; });
        saveTickets(all);
        renderTicketsList();
      });

      // 11. Ekspor Excel Resmi (.xls) & CSV Rekap Data
      function downloadExcelBlob(htmlContent, filename) {
        const blob = new Blob(['\uFEFF' + htmlContent], {
          type: 'application/vnd.ms-excel;charset=utf-8;'
        });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }

      function generateExcelReport(type = 'layanan') {
        const allTickets = loadTickets();
        const now = new Date();
        const tglStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
        const jamStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';
        const currentAdmin = sessionStorage.getItem('portal_admin_nama') || 'Admin Utama Sistem Loket';
        const currentRole = sessionStorage.getItem('portal_admin_role') || 'Super Admin';

        if (type === 'mahasiswa') {
          const mhsList = loadMasterMahasiswa();
          let rowsHtml = '';
          mhsList.forEach((m, idx) => {
            const cleanMhsNim = String(m.nim).trim().toLowerCase();
            const studentTickets = allTickets.filter(t => String(t.nim).trim().toLowerCase() === cleanMhsNim);
            const ticketCodes = studentTickets.map(t => t.kode).join(', ') || '-';
            rowsHtml += `
              <tr>
                <td style="text-align: center;">${idx + 1}</td>
                <td style="mso-number-format:'\\@'; font-weight: bold; text-align: center;">${m.nim}</td>
                <td style="font-weight: bold;">${m.nama}</td>
                <td>${m.prodi}</td>
                <td>${m.minat || '-'}</td>
                <td style="text-align: center;">${m.angkatan || '-'}</td>
                <td style="text-align: center;">${m.semester || '-'}</td>
                <td style="mso-number-format:'\\@'; text-align: center;">${m.whatsapp || '-'}</td>
                <td>${m.email || '-'}</td>
                <td>${m.dpa || '-'}</td>
                <td style="text-align: center; font-weight: bold;">${m.statusAkademik || 'Aktif'}</td>
                <td style="text-align: center;">${studentTickets.length} Berkas</td>
                <td>${ticketCodes}</td>
              </tr>
            `;
          });

          const tableHtml = `
            <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
            <head>
              <meta charset="utf-8">
              <!--[if gte mso 9]>
              <xml>
                <x:ExcelWorkbook>
                  <x:ExcelWorksheets>
                    <x:ExcelWorksheet>
                      <x:Name>Master Mahasiswa</x:Name>
                      <x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>
                    </x:ExcelWorksheet>
                  </x:ExcelWorksheets>
                </x:ExcelWorkbook>
              </xml>
              <![endif]-->
              <style>
                body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; }
                table { border-collapse: collapse; width: 100%; }
                th { background-color: #065f46; color: #ffffff; font-weight: bold; border: 1px solid #047857; padding: 8px 10px; text-align: left; }
                td { border: 1px solid #cbd5e1; padding: 6px 8px; vertical-align: middle; }
              </style>
            </head>
            <body>
              <table>
                <tr><td colspan="13" style="font-size: 15pt; font-weight: bold; color: #065f46; text-align: center;">DATA MASTER INDUK & MAHASISWA PEMOHON LAYANAN</td></tr>
                <tr><td colspan="13" style="font-size: 11pt; font-weight: bold; color: #334155; text-align: center;">FAKULTAS PERTANIAN - INSTITUT PERTANIAN STIPER (INSTIPER) YOGYAKARTA</td></tr>
                <tr><td colspan="13" style="font-size: 9pt; color: #64748b; text-align: center;">Tanggal Ekspor: ${tglStr}, ${jamStr} | Dicetak oleh: ${currentAdmin} (${currentRole}) | Total Mahasiswa: ${mhsList.length} Orang</td></tr>
                <tr><td colspan="13"></td></tr>
                <thead>
                  <tr>
                    <th style="text-align: center; width: 40px;">No</th>
                    <th style="text-align: center; width: 120px;">NIM</th>
                    <th style="width: 180px;">Nama Mahasiswa</th>
                    <th style="width: 140px;">Program Studi</th>
                    <th style="width: 140px;">Minat Studi</th>
                    <th style="text-align: center; width: 80px;">Angkatan</th>
                    <th style="text-align: center; width: 90px;">Semester</th>
                    <th style="text-align: center; width: 120px;">No. WhatsApp</th>
                    <th style="width: 180px;">Email</th>
                    <th style="width: 180px;">DPA (Dosen Pembimbing)</th>
                    <th style="text-align: center; width: 100px;">Status Akademik</th>
                    <th style="text-align: center; width: 100px;">Total Permohonan</th>
                    <th style="width: 200px;">Riwayat Kode Tiket</th>
                  </tr>
                </thead>
                <tbody>${rowsHtml}</tbody>
              </table>
            </body>
            </html>
          `;
          downloadExcelBlob(tableHtml, `master-mahasiswa-faperta-${now.toISOString().slice(0, 10)}.xls`);
          return;
        }

        // Default: Export Layanan / Rekap
        const mhsList = loadMasterMahasiswa();
        let rowsHtml = '';
        allTickets.forEach((t, idx) => {
          const dInfo = getTicketDateInfo(t);
          const mhs = mhsList.find(m => String(m.nim).trim().toLowerCase() === String(t.nim).trim().toLowerCase());
          const waNum = t.whatsapp || (mhs && mhs.whatsapp) || '-';
          const emailAddr = t.email || (mhs && mhs.email) || '-';
          const tglDiambil = t.tanggalDiambil || (t.sudahDiambil ? 'Sudah diserahkan' : '-');
          const petPenyerah = t.petugasPenyerah || (t.sudahDiambil ? 'Admin Loket FAPERTA' : '-');

          let statusBg = '#fef3c7'; let statusColor = '#92400e';
          if (t.status === 'Selesai (Siap Diambil)' || t.status === 'Sudah Diambil') {
            statusBg = '#d1fae5'; statusColor = '#065f46';
          } else if (t.status.includes('Verifikasi') || t.status.includes('Proses')) {
            statusBg = '#dbeafe'; statusColor = '#1e40af';
          } else if (t.status === 'Ditolak') {
            statusBg = '#ffe4e6'; statusColor = '#9f1239';
          }

          rowsHtml += `
            <tr>
              <td style="text-align: center;">${idx + 1}</td>
              <td style="mso-number-format:'\\@'; font-weight: bold; text-align: center;">${t.kode}</td>
              <td style="text-align: center;">${dInfo.displayDate}</td>
              <td style="text-align: center;">${dInfo.timeStr}</td>
              <td style="mso-number-format:'\\@'; font-weight: bold; text-align: center;">${t.nim}</td>
              <td style="font-weight: bold;">${t.nama}</td>
              <td>${t.prodi || '-'}</td>
              <td style="text-align: center;">${t.semester || '-'}</td>
              <td style="mso-number-format:'\\@'; text-align: center;">${waNum}</td>
              <td>${emailAddr}</td>
              <td>${t.layananNama || '-'}</td>
              <td>${t.keperluan || '-'} ${t.detailTambahan ? `(${t.detailTambahan})` : ''}</td>
              <td>${t.posisiBerkas || 'Loket Admin FAPERTA'}</td>
              <td style="text-align: center; font-weight: bold; background-color: ${statusBg}; color: ${statusColor};">${t.status}</td>
              <td style="text-align: center;">${t.sudahDiambil ? 'SUDAH' : 'BELUM'}</td>
              <td>${tglDiambil} (${petPenyerah})</td>
              <td>${t.catatanAdmin || '-'}</td>
            </tr>
          `;
        });

        const tableHtml = `
          <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
          <head>
            <meta charset="utf-8">
            <!--[if gte mso 9]>
            <xml>
              <x:ExcelWorkbook>
                <x:ExcelWorksheets>
                  <x:ExcelWorksheet>
                    <x:Name>Rekap Layanan</x:Name>
                    <x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>
                  </x:ExcelWorksheet>
                </x:ExcelWorksheets>
              </xml>
              <![endif]-->
            <style>
              body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; }
              table { border-collapse: collapse; width: 100%; }
              th { background-color: #065f46; color: #ffffff; font-weight: bold; border: 1px solid #047857; padding: 8px 10px; text-align: left; }
              td { border: 1px solid #cbd5e1; padding: 6px 8px; vertical-align: middle; }
            </style>
          </head>
          <body>
            <table>
              <tr><td colspan="17" style="font-size: 15pt; font-weight: bold; color: #065f46; text-align: center;">REKAPITULASI ADMINISTRASI & PELAYANAN LOKET AKADEMIK</td></tr>
              <tr><td colspan="17" style="font-size: 11pt; font-weight: bold; color: #334155; text-align: center;">FAKULTAS PERTANIAN - INSTITUT PERTANIAN STIPER (INSTIPER) YOGYAKARTA</td></tr>
              <tr><td colspan="17" style="font-size: 9pt; color: #64748b; text-align: center;">Tanggal Ekspor: ${tglStr}, ${jamStr} | Petugas: ${currentAdmin} (${currentRole}) | Total Transaksi: ${allTickets.length} Berkas</td></tr>
              <tr><td colspan="17"></td></tr>
              <thead>
                <tr>
                  <th style="text-align: center; width: 40px;">No</th>
                  <th style="text-align: center; width: 120px;">Kode Tiket</th>
                  <th style="text-align: center; width: 110px;">Tanggal Pengajuan</th>
                  <th style="text-align: center; width: 80px;">Jam</th>
                  <th style="text-align: center; width: 110px;">NIM</th>
                  <th style="width: 180px;">Nama Mahasiswa</th>
                  <th style="width: 140px;">Program Studi</th>
                  <th style="text-align: center; width: 90px;">Semester</th>
                  <th style="text-align: center; width: 120px;">No. WhatsApp</th>
                  <th style="width: 180px;">Email</th>
                  <th style="width: 200px;">Jenis / Skenario Layanan</th>
                  <th style="width: 220px;">Keperluan & Detail</th>
                  <th style="width: 180px;">Posisi Berkas Fisik</th>
                  <th style="text-align: center; width: 140px;">Status Berkas</th>
                  <th style="text-align: center; width: 110px;">Pengambilan</th>
                  <th style="width: 180px;">Waktu & Petugas Penyerahan</th>
                  <th style="width: 250px;">Catatan Loket / Disposisi</th>
                </tr>
              </thead>
              <tbody>${rowsHtml}</tbody>
            </table>
          </body>
          </html>
        `;
        downloadExcelBlob(tableHtml, `rekap-administrasi-faperta-${now.toISOString().slice(0, 10)}.xls`);
      }

      function triggerExportCSV() {
        const all = loadTickets();
        const headers = ['Kode Tiket', 'NIM', 'Nama Mahasiswa', 'Program Studi', 'Layanan', 'Status', 'Posisi Berkas Fisik', 'Tanggal Pengajuan'];
        const rows = all.map(t => [
          `"${t.kode}"`,
          `"${t.nim}"`,
          `"${t.nama}"`,
          `"${t.prodi || ''}"`,
          `"${t.layananNama || ''}"`,
          `"${t.status}"`,
          `"${t.posisiBerkas || ''}"`,
          `"${t.tanggal || ''}"`
        ]);
        const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', `rekap-administrasi-faperta-${new Date().toISOString().slice(0,10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }

      document.getElementById('btn-rekap-download-excel')?.addEventListener('click', () => generateExcelReport('layanan'));
      document.getElementById('btn-quick-export-excel')?.addEventListener('click', () => generateExcelReport('layanan'));
      document.getElementById('btn-export-mahasiswa-excel')?.addEventListener('click', () => generateExcelReport('mahasiswa'));
      document.getElementById('btn-rekap-download-csv')?.addEventListener('click', triggerExportCSV);

      function updateRekapStats() {
        const all = loadTickets();
        const cntPending = all.filter(t => t.status === 'Belum Diproses').length;
        const cntProcess = all.filter(t => t.status === 'Proses Verifikasi' || t.status === 'Verifikasi Admin Loket' || t.status === 'Verifikasi Dosen / Kaprodi' || t.status === 'Verifikasi Dosen / Kaprodi / Dekanat' || (t.status && t.status.includes('Dosen'))).length;
        const cntDone = all.filter(t => t.status === 'Selesai (Siap Diambil)').length;

        const elTot = document.getElementById('rekap-total');
        const elPen = document.getElementById('rekap-pending');
        const elPro = document.getElementById('rekap-process');
        const elDon = document.getElementById('rekap-done');

        if (elTot) elTot.textContent = all.length;
        if (elPen) elPen.textContent = cntPending;
        if (elPro) elPro.textContent = cntProcess;
        if (elDon) elDon.textContent = cntDone;
      }

      // Jalankan cek status auth awal
      checkAuth();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAdminSystem);
    } else {
      initAdminSystem();
    }
  </script>
</BaseLayout>
