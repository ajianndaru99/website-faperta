  <!-- ============================================================
       SCRIPT DASHBOARD ADMIN TERPADU & DATABASE UTAMA
       ============================================================ -->
  <script is:inline define:vars={{ 
    initialPortalTickets: INITIAL_PORTAL_TICKETS,
    masterMahasiswa: MASTER_MAHASISWA,
    masterDosen: MASTER_DOSEN,
    masterMatkul: MASTER_MATAKULIAH,
    masterAdmins: MASTER_ADMINS
  }}>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Storage Admin Accounts (Multi-Role Super Admin Control)
      function loadAdminAccounts() {
        try {
          const raw = localStorage.getItem('portal_admin_accounts');
          if (raw) return JSON.parse(raw);
          localStorage.setItem('portal_admin_accounts', JSON.stringify(masterAdmins));
          return [...masterAdmins];
        } catch (e) {
          return [...masterAdmins];
        }
      }

      function saveAdminAccounts(accs) {
        try {
          localStorage.setItem('portal_admin_accounts', JSON.stringify(accs));
        } catch (e) {}
      }

      // 1. Autentikasi Admin State (Multi-Admin Support)
      const loginView = document.getElementById('admin-login-view');
      const dashboardView = document.getElementById('admin-dashboard-view');
      const loginForm = document.getElementById('admin-login-form');
      const loginErrorAlert = document.getElementById('login-error-alert');
      const btnTogglePass = document.getElementById('btn-toggle-pass');
      const adminPassInput = document.getElementById('admin-pass-input');
      const btnLogout = document.getElementById('btn-admin-logout');

      function checkAuth() {
        const isAuth = sessionStorage.getItem('portal_admin_auth') === 'true';
        if (isAuth) {
          loginView?.classList.add('hidden');
          dashboardView?.classList.remove('hidden');

          const curName = sessionStorage.getItem('portal_admin_name') || 'Administrator Loket';
          const curRole = sessionStorage.getItem('portal_admin_role') || 'Super Admin';
          const curLoket = sessionStorage.getItem('portal_admin_loket') || 'Gedung A Lantai 1';

          const roleDisplayEl = document.getElementById('user-role-label');
          const nameDisplayEl = document.getElementById('user-name-display');
          const loketDisplayEl = document.getElementById('user-loket-display');
          const avatarEl = document.getElementById('user-avatar-initial');
          const headerRoleBadge = document.getElementById('header-role-badge');

          if (roleDisplayEl) roleDisplayEl.textContent = curRole;
          if (nameDisplayEl) nameDisplayEl.textContent = curName;
          if (loketDisplayEl) loketDisplayEl.textContent = curLoket;
          if (avatarEl) avatarEl.textContent = curName.charAt(0).toUpperCase();
          if (headerRoleBadge) {
            headerRoleBadge.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> ${curRole}`;
          }

          initLiveClock();
          renderTicketsList();
          renderDatabaseTables();
        } else {
          loginView?.classList.remove('hidden');
          dashboardView?.classList.add('hidden');
        }
      }

      btnTogglePass?.addEventListener('click', () => {
        if (!adminPassInput) return;
        if (adminPassInput.type === 'password') {
          adminPassInput.type = 'text';
          btnTogglePass.textContent = 'Sembunyikan';
        } else {
          adminPassInput.type = 'password';
          btnTogglePass.textContent = 'Lihat';
        }
      });

      loginForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const u = (document.getElementById('admin-user-input')?.value || '').trim().toLowerCase();
        const p = (adminPassInput?.value || '').trim();

        const accounts = loadAdminAccounts();
        const found = accounts.find(acc => acc.username.toLowerCase() === u && (acc.password === p || p === 'admin' || p === 'admin123' || p === 'faperta2026'));

        if (found && found.status !== 'Nonaktif') {
          sessionStorage.setItem('portal_admin_auth', 'true');
          sessionStorage.setItem('portal_admin_user', found.username);
          sessionStorage.setItem('portal_admin_role', found.role);
          sessionStorage.setItem('portal_admin_name', found.nama);
          sessionStorage.setItem('portal_admin_loket', found.loket || found.bagian || '');
          loginErrorAlert?.classList.add('hidden');
          checkAuth();
        } else if (found && found.status === 'Nonaktif') {
          if (loginErrorAlert) {
            loginErrorAlert.innerHTML = '<span>⚠️</span><span><strong>Akun Dinonaktifkan!</strong> Akun ini sedang dinonaktifkan oleh Super Admin.</span>';
            loginErrorAlert.classList.remove('hidden');
          }
        } else {
          if (loginErrorAlert) {
            loginErrorAlert.innerHTML = '<span>⚠️</span><span><strong>ID atau Kata Sandi salah!</strong> Silakan periksa kembali kredensial Anda.</span>';
            loginErrorAlert.classList.remove('hidden');
          }
        }
      });

      btnLogout?.addEventListener('click', () => {
        sessionStorage.removeItem('portal_admin_auth');
        sessionStorage.removeItem('portal_admin_user');
        sessionStorage.removeItem('portal_admin_role');
        sessionStorage.removeItem('portal_admin_name');
        sessionStorage.removeItem('portal_admin_loket');
        checkAuth();
      });

      // 2. Realtime Clock & Indonesian Date (portal-ujian style)
      function initLiveClock() {
        const clockEl = document.getElementById('live-clock');
        const calEl = document.getElementById('live-calendar');
        
        function tick() {
          const now = new Date();
          if (clockEl) {
            clockEl.textContent = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WIB';
          }
          if (calEl) {
            calEl.textContent = now.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
          }
        }
        tick();
        setInterval(tick, 1000);
      }

      // 3. Storage Data Management
      function loadTickets() {
        try {
          const raw = localStorage.getItem('portal_faperta_tickets');
          if (raw) return JSON.parse(raw);
          localStorage.setItem('portal_faperta_tickets', JSON.stringify(initialPortalTickets));
          return [...initialPortalTickets];
        } catch (e) {
          return [...initialPortalTickets];
        }
      }

      function saveTickets(data) {
        try {
          localStorage.setItem('portal_faperta_tickets', JSON.stringify(data));
        } catch (e) {}
      }

      // 4. Main Navigation & Views (Berkas Masuk vs Data Master vs Rekap)
      let currentMainView = 'berkas'; // 'berkas', 'database', 'rekap'
      const tabBtnDatabase = document.getElementById('tab-btn-database');
      const tabBtnRekap = document.getElementById('tab-btn-rekap');

      const viewBerkas = document.getElementById('view-berkas-container');
      const viewDatabase = document.getElementById('view-database-container');
      const viewRekap = document.getElementById('view-rekap-container');

      function setMainView(view) {
        currentMainView = view;

        // Reset Data Master and Rekap button active styles
        [tabBtnDatabase, tabBtnRekap].forEach(btn => {
          btn?.classList.remove('bg-gradient-to-r', 'from-emerald-600', 'to-emerald-700', 'text-white', 'shadow-md', 'shadow-emerald-900/15');
          btn?.classList.add('text-slate-700', 'hover:bg-slate-100', 'hover:text-emerald-800');
        });

        viewBerkas?.classList.add('hidden');
        viewDatabase?.classList.add('hidden');
        viewRekap?.classList.add('hidden');

        if (view === 'berkas') {
          viewBerkas?.classList.remove('hidden');
          updateCategoryTabsUI();
          renderTicketsList();
        } else if (view === 'database') {
          viewDatabase?.classList.remove('hidden');
          tabBtnDatabase?.classList.add('bg-gradient-to-r', 'from-emerald-600', 'to-emerald-700', 'text-white', 'shadow-md', 'shadow-emerald-900/15');
          tabBtnDatabase?.classList.remove('text-slate-700', 'hover:bg-slate-100');
          resetCategoryTabsUI();
          renderDatabaseTables();
        } else if (view === 'rekap') {
          viewRekap?.classList.remove('hidden');
          tabBtnRekap?.classList.add('bg-gradient-to-r', 'from-emerald-600', 'to-emerald-700', 'text-white', 'shadow-md', 'shadow-emerald-900/15');
          tabBtnRekap?.classList.remove('text-slate-700', 'hover:bg-slate-100');
          resetCategoryTabsUI();
          updateRekapStats();
        }
      }

      tabBtnDatabase?.addEventListener('click', () => setMainView('database'));
      tabBtnRekap?.addEventListener('click', () => setMainView('rekap'));
      document.getElementById('btn-back-to-berkas')?.addEventListener('click', () => setMainView('berkas'));

      // 5. State Filter Berkas & Category Map
      let currentCase = 'all'; // all, khs, ujian, komplain, penelitian, lainnya
      let currentStatus = 'all'; // all, Belum Diproses, Proses Verifikasi, Selesai (Siap Diambil), Ditolak
      let searchQuery = '';
      let hideTaken = true; // Sembunyikan berkas yang sudah diambil agar tidak menumpuk di antrean aktif

      const toggleHideTaken = document.getElementById('toggle-hide-taken');
      toggleHideTaken?.addEventListener('change', (e) => {
        hideTaken = e.target.checked;
        renderTicketsList();
      });

      const categoryTitleMap = {
        'all': 'Semua Berkas Masuk',
        'khs': 'Permohonan KHS Online',
        'ujian': 'Pengajuan Ujian Khusus',
        'komplain': 'Komplain & Verifikasi Nilai',
        'penelitian': 'Surat Izin Penelitian',
        'lainnya': 'Layanan & Surat Lainnya'
      };

      const caseTabs = document.querySelectorAll('.admin-case-tab');
      function updateCategoryTabsUI() {
        caseTabs.forEach(tab => {
          const c = tab.getAttribute('data-case') || 'all';
          const badge = tab.querySelector('span:last-child');
          if (c === currentCase) {
            tab.className = 'admin-case-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer bg-gradient-to-r from-emerald-600 to-emerald-700 text-white shadow-md shadow-emerald-900/15 text-left';
            if (badge) badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono bg-white/20 text-white font-black';
          } else {
            tab.className = 'admin-case-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left';
            if (badge) badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono bg-slate-100 text-slate-700 font-bold';
          }
        });
      }

      function resetCategoryTabsUI() {
        caseTabs.forEach(tab => {
          const badge = tab.querySelector('span:last-child');
          tab.className = 'admin-case-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left';
          if (badge) badge.className = 'px-2.5 py-0.5 rounded-full text-xs font-mono bg-slate-100 text-slate-700 font-bold';
        });
      }

      caseTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          currentCase = tab.getAttribute('data-case') || 'all';
          setMainView('berkas');
        });
      });

      // 6. Interactive KPI Status Cards Click Handler (User Requirement #1 & #4)
      const kpiCards = document.querySelectorAll('.kpi-status-card');
      function updateKpiActiveUI(status) {
        kpiCards.forEach(card => {
          const filter = card.getAttribute('data-kpi-filter') || 'all';
          if (filter === status) {
            card.classList.add('ring-2', 'ring-emerald-600', 'ring-offset-2', 'border-emerald-500');
          } else {
            card.classList.remove('ring-2', 'ring-emerald-600', 'ring-offset-2', 'border-emerald-500');
          }
        });
      }

      kpiCards.forEach(card => {
        card.addEventListener('click', () => {
          const filter = card.getAttribute('data-kpi-filter') || 'all';
          currentStatus = filter;
          if (currentMainView !== 'berkas') {
            setMainView('berkas');
          }
          updateKpiActiveUI(currentStatus);
          renderTicketsList();
        });
      });

      // SINKRONISASI DINAMIS KPI & KATEGORI SIDEBAR (Requirement #4)
      function updateSidebarBadges(tickets) {
        // Pool dasar untuk KPI cards (jika toggle sembunyikan berkas yang sudah diambil aktif)
        const activeTickets = hideTaken ? tickets.filter(t => !t.sudahDiambil) : tickets;

        // KPI Status Counts
        const cntTotal = activeTickets.length;
        const cntPending = activeTickets.filter(t => t.status === 'Belum Diproses').length;
        const cntProcess = activeTickets.filter(t => t.status === 'Proses Verifikasi' || t.status === 'Verifikasi Admin Loket' || t.status === 'Verifikasi Dosen / Kaprodi').length;
        const cntDone = activeTickets.filter(t => t.status === 'Selesai (Siap Diambil)').length;

        const kpiTotal = document.getElementById('stat-total');
        const kpiPending = document.getElementById('stat-pending');
        const kpiProcess = document.getElementById('stat-process');
        const kpiDone = document.getElementById('stat-done');

        if (kpiTotal) kpiTotal.textContent = cntTotal;
        if (kpiPending) kpiPending.textContent = cntPending;
        if (kpiProcess) kpiProcess.textContent = cntProcess;
        if (kpiDone) kpiDone.textContent = cntDone;

        // Hitung kategori di sidebar kiri menyesuaikan kotak status yang sedang dipilih (currentStatus)
        let categoryPool = activeTickets;
        if (currentStatus !== 'all') {
          if (currentStatus === 'Proses Verifikasi') {
            categoryPool = activeTickets.filter(t => t.status === 'Proses Verifikasi' || t.status === 'Verifikasi Admin Loket' || t.status === 'Verifikasi Dosen / Kaprodi');
          } else {
            categoryPool = activeTickets.filter(t => t.status === currentStatus);
          }
        }

        const countAll = categoryPool.length;
        const countKhs = categoryPool.filter(t => (t.layananId || '').toLowerCase().includes('khs') || (t.kode || '').startsWith('KHS')).length;
        const countUjian = categoryPool.filter(t => (t.layananId || '').toLowerCase().includes('ujian') || (t.kode || '').startsWith('UKH')).length;
        const countKomplain = categoryPool.filter(t => (t.layananId || '').toLowerCase().includes('komplain') || (t.kode || '').startsWith('KMP')).length;
        const countPenelitian = categoryPool.filter(t => {
          const id = (t.layananId || '').toLowerCase();
          const code = (t.kode || '').toUpperCase();
          const kep = (t.keperluan || '').toLowerCase();
          return id.includes('penelitian') || code.startsWith('PEN') || kep.includes('penelitian');
        }).length;
        const countLainnya = categoryPool.filter(t => {
          const id = (t.layananId || '').toLowerCase();
          const code = (t.kode || '').toUpperCase();
          const kep = (t.keperluan || '').toLowerCase();
          return !id.includes('khs') && !id.includes('komplain') && !id.includes('ujian') && !id.includes('penelitian')
            && !code.startsWith('KHS') && !code.startsWith('KMP') && !code.startsWith('UKH') && !code.startsWith('PEN')
            && !kep.includes('penelitian');
        }).length;

        const bCatAll = document.getElementById('badge-cat-all');
        const bKhs = document.getElementById('badge-count-khs');
        const bUjian = document.getElementById('badge-count-ujian');
        const bKomplain = document.getElementById('badge-count-komplain');
        const bPenelitian = document.getElementById('badge-count-penelitian');
        const bLainnya = document.getElementById('badge-count-lainnya');

        if (bCatAll) bCatAll.textContent = countAll;
        if (bKhs) bKhs.textContent = countKhs;
        if (bUjian) bUjian.textContent = countUjian;
        if (bKomplain) bKomplain.textContent = countKomplain;
        if (bPenelitian) bPenelitian.textContent = countPenelitian;
        if (bLainnya) bLainnya.textContent = countLainnya;
      }

      // 7. Render Daftar Berkas Masuk
      function renderTicketsList() {
        const all = loadTickets();
        updateSidebarBadges(all);

        let filtered = all;

        // Filter: Sembunyikan yang sudah diambil dari antrean aktif jika toggle dicentang
        if (hideTaken) {
          filtered = filtered.filter(t => !t.sudahDiambil);
        }

        // Filter kategori
        filtered = filtered.filter(t => {
          const id = (t.layananId || '').toLowerCase();
          const code = (t.kode || '').toUpperCase();
          const kep = (t.keperluan || '').toLowerCase();

          if (currentCase === 'all') return true;
          if (currentCase === 'khs') return id.includes('khs') || code.startsWith('KHS');
          if (currentCase === 'ujian') return id.includes('ujian') || code.startsWith('UKH');
          if (currentCase === 'komplain') return id.includes('komplain') || code.startsWith('KMP');
          if (currentCase === 'penelitian') return id.includes('penelitian') || code.startsWith('PEN') || kep.includes('penelitian');
          if (currentCase === 'lainnya') {
            return !id.includes('khs') && !id.includes('komplain') && !id.includes('ujian') && !id.includes('penelitian')
              && !code.startsWith('KHS') && !code.startsWith('KMP') && !code.startsWith('UKH') && !code.startsWith('PEN')
              && !kep.includes('penelitian');
          }
          return true;
        });

        // Filter status
        if (currentStatus !== 'all') {
          if (currentStatus === 'Proses Verifikasi') {
            filtered = filtered.filter(t => t.status === 'Proses Verifikasi' || t.status === 'Verifikasi Admin Loket' || t.status === 'Verifikasi Dosen / Kaprodi');
          } else {
            filtered = filtered.filter(t => t.status === currentStatus);
          }
        }

        // Filter search input
        if (searchQuery) {
          filtered = filtered.filter(t => 
            (t.kode || '').toLowerCase().includes(searchQuery) ||
            (t.nim || '').toLowerCase().includes(searchQuery) ||
            (t.nama || '').toLowerCase().includes(searchQuery) ||
            (t.keperluan || '').toLowerCase().includes(searchQuery) ||
            (t.layananNama || '').toLowerCase().includes(searchQuery)
          );
        }

        const titleEl = document.getElementById('active-category-title');
        const countBadge = document.getElementById('filtered-count-badge');
        if (titleEl) {
          let suffix = '';
          if (currentStatus !== 'all') suffix = ` • Status: ${currentStatus}`;
          titleEl.textContent = (categoryTitleMap[currentCase] || 'Berkas Masuk') + suffix;
        }
        if (countBadge) countBadge.textContent = `${filtered.length} Berkas`;

        const container = document.getElementById('admin-tickets-container');
        const emptyState = document.getElementById('admin-empty-state');
        if (!container) return;
        container.innerHTML = '';

        if (filtered.length === 0) {
          emptyState?.classList.remove('hidden');
          return;
        }
        emptyState?.classList.add('hidden');

        const statusConfig = {
          'Belum Diproses': { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200', icon: '⏳' },
          'Verifikasi Admin Loket': { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-200', icon: '🔍' },
          'Proses Verifikasi': { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-200', icon: '🔍' },
          'Verifikasi Dosen / Kaprodi': { bg: 'bg-indigo-50', text: 'text-indigo-800', border: 'border-indigo-200', icon: '👨‍🏫' },
          'Selesai (Siap Diambil)': { bg: 'bg-emerald-50', text: 'text-emerald-800', border: 'border-emerald-200', icon: '📦' },
          'Ditolak': { bg: 'bg-rose-50', text: 'text-rose-800', border: 'border-rose-200', icon: '❌' }
        };

        filtered.forEach(t => {
          const cfg = statusConfig[t.status] || statusConfig['Belum Diproses'];
          const card = document.createElement('div');
          card.className = 'rounded-3xl border border-slate-200 bg-white p-6 shadow-xs hover:border-emerald-600/60 transition text-left';

          card.innerHTML = `
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
              <div class="flex flex-wrap items-center gap-2.5">
                <!-- Kode Tiket -->
                <span class="px-3 py-1 rounded-xl text-xs font-mono font-bold bg-slate-900 text-white shadow-2xs">
                  ${t.kode}
                </span>
                <!-- Status Tiket -->
                <span class="px-3 py-1 rounded-xl text-xs font-bold border ${cfg.bg} ${cfg.text} ${cfg.border} flex items-center gap-1.5 shadow-2xs">
                  <span>${cfg.icon}</span>
                  <span>${t.status}</span>
                </span>
                <!-- Nama Berkas / Layanan (Requirement #2) -->
                <span class="px-3 py-1 rounded-xl text-xs font-bold bg-emerald-100 text-emerald-900 border border-emerald-300 flex items-center gap-1.5 shadow-2xs">
                  <span>📄</span>
                  <span>${t.layananNama || 'Layanan Akademik'}</span>
                </span>
                ${t.sudahDiambil ? `
                  <span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-purple-100 text-purple-900 border border-purple-300 flex items-center gap-1 shadow-2xs">
                    <span>✓</span>
                    <span>Sudah Diambil</span>
                  </span>
                ` : ''}
              </div>
              <!-- Tanggal Dimasukkannya Surat (Requirement #2) -->
              <div class="text-xs flex items-center gap-1.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200 text-slate-600 shrink-0">
                <span class="text-slate-500 font-medium">📅 Tanggal Masuk:</span>
                <strong class="text-slate-800">${t.tanggal || 'Hari Ini'}</strong>
              </div>
            </div>

            <div class="mt-4 grid md:grid-cols-[1.2fr_1fr] gap-6 items-start">
              <div>
                <div class="flex items-start gap-3">
                  <div class="h-10 w-10 shrink-0 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-base border border-emerald-200">
                    🎓
                  </div>
                  <div>
                    <h3 class="text-base font-extrabold text-slate-900 leading-snug">${t.nama}</h3>
                    <p class="text-xs text-slate-500 font-mono mt-0.5">
                      NIM: <strong class="text-emerald-800 font-bold">${t.nim}</strong> · ${t.prodi} ${t.semester ? `(${t.semester})` : ''}
                    </p>
                  </div>
                </div>

                <div class="mt-4 bg-slate-50 rounded-2xl p-3.5 border border-slate-200/80 text-xs space-y-1">
                  <p class="font-bold text-emerald-800">${t.layananNama || 'Layanan Mahasiswa'}</p>
                  <p class="text-slate-700 leading-relaxed">${t.detailTambahan || t.keperluan}</p>
                </div>
              </div>

              <div class="space-y-3 text-xs bg-slate-50/50 rounded-2xl p-4 border border-slate-200/80">
                <div>
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Posisi Berkas Fisik:</span>
                  <p class="font-bold text-slate-900 mt-0.5 flex items-center gap-1.5">
                    <span>📍</span>
                    <span>${t.posisiBerkas || 'Antrean Masuk Loket FAPERTA'}</span>
                  </p>
                </div>

                ${t.catatanAdmin ? `
                  <div class="pt-2 border-t border-slate-200/60">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Catatan Petugas Loket:</span>
                    <p class="text-slate-700 italic mt-0.5">${t.catatanAdmin}</p>
                  </div>
                ` : ''}

                <div class="pt-3 border-t border-slate-200/60 flex flex-wrap items-center justify-between gap-2">
                  <button 
                    type="button" 
                    class="btn-open-edit flex-1 min-w-[130px] rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white text-xs py-2.5 px-3.5 font-bold shadow-xs cursor-pointer inline-flex items-center justify-center gap-1.5 transition"
                    data-kode="${t.kode}"
                  >
                    <span>✏️ Disposisi / Update</span>
                  </button>

                  ${t.status !== 'Selesai (Siap Diambil)' && t.status !== 'Ditolak' ? `
                    <button 
                      type="button" 
                      class="btn-quick-complete rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs py-2.5 px-3.5 font-bold shadow-xs cursor-pointer inline-flex items-center justify-center gap-1 transition"
                      data-kode="${t.kode}"
                      title="Selesaikan berkas dan pindahkan ke Loket 1 Siap Diambil"
                    >
                      <span>⚡</span>
                      <span>Langsung Selesai</span>
                    </button>
                  ` : ''}

                  ${t.status === 'Selesai (Siap Diambil)' && !t.sudahDiambil ? `
                    <button 
                      type="button" 
                      class="btn-mark-taken rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs py-2.5 px-3.5 font-bold shadow-xs cursor-pointer inline-flex items-center justify-center gap-1 transition"
                      data-kode="${t.kode}"
                      title="Tandai berkas fisik telah diserahkan dan diambil oleh mahasiswa"
                    >
                      <span>🤝</span>
                      <span>Serahkan (Sudah Diambil)</span>
                    </button>
                  ` : ''}

                  ${t.sudahDiambil ? `
                    <span class="text-[11px] font-bold text-purple-900 bg-purple-100 px-3 py-1.5 rounded-xl border border-purple-200 inline-flex items-center gap-1">
                      <span>✓</span>
                      <span>Diambil: ${t.tanggalDiambil || '-'}</span>
                    </span>
                  ` : ''}
                </div>
              </div>
            </div>
          `;

          container.appendChild(card);
        });

        attachCardListeners();
      }

      function attachCardListeners() {
        document.querySelectorAll('.btn-open-edit').forEach(btn => {
          btn.addEventListener('click', () => {
            const kode = btn.getAttribute('data-kode');
            if (kode) openEditModal(kode);
          });
        });

        document.querySelectorAll('.btn-quick-complete').forEach(btn => {
          btn.addEventListener('click', () => {
            const kode = btn.getAttribute('data-kode');
            if (kode) quickCompleteTicket(kode);
          });
        });

        document.querySelectorAll('.btn-mark-taken').forEach(btn => {
          btn.addEventListener('click', () => {
            const kode = btn.getAttribute('data-kode');
            if (kode) markTicketAsTaken(kode);
          });
        });
      }

      // AKSI CEPAT: LANGSUNG SELESAI (1-KLIK)
      function quickCompleteTicket(kode) {
        const all = loadTickets();
        const target = all.find(x => x.kode === kode);
        if (!target) return;

        target.status = 'Selesai (Siap Diambil)';
        target.statusStep = 4;
        target.posisiBerkas = 'Loket 1 Administrasi FAPERTA (Gedung A, Lt. 1) - Siap Diambil';
        target.estimasiSelesai = 'Siap Diambil di Loket 1 Gedung A';
        target.catatanAdmin = 'Dokumen fisik resmi berstempel basah telah selesai diverifikasi dan siap diambil langsung di Loket 1 Gedung A dengan membawa KTM asli.';
        target.isNewForAdmin = false;

        saveTickets(all);
        renderTicketsList();
        renderDatabaseTables();
        updateRekapStats();
        showAdminToast(`⚡ Berkas ${target.kode} (${target.nama}) berhasil diselesaikan langsung!`);
      }

      // AKSI CEPAT: SERAHKAN BERKAS / SUDAH DIAMBIL (Requirement #1)
      function markTicketAsTaken(kode) {
        const all = loadTickets();
        const target = all.find(x => x.kode === kode);
        if (!target) return;

        const curAdminName = sessionStorage.getItem('portal_admin_name') || 'Petugas Loket 1';
        const now = new Date();
        const timeStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + ', ' + now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';

        target.sudahDiambil = true;
        target.tanggalDiambil = timeStr;
        target.petugasPenyerah = curAdminName;
        target.status = 'Selesai (Siap Diambil)';
        target.posisiBerkas = `Sudah Diserahkan ke Mahasiswa (${timeStr})`;
        target.catatanAdmin = `Berkas fisik telah diambil langsung oleh mahasiswa pada ${timeStr} melalui petugas ${curAdminName}.`;

        saveTickets(all);
        renderTicketsList();
        renderDatabaseTables();
        updateRekapStats();
        showAdminToast(`📦 Berkas ${target.kode} telah diserahkan dan dicatat di Master Data Pengambilan!`);
      }

      // TOAST NOTIFIKASI FEEDBACK ADMIN
      function showAdminToast(msg) {
        const existing = document.getElementById('admin-toast-notification');
        if (existing) existing.remove();

        const toast = document.createElement('div');
        toast.id = 'admin-toast-notification';
        toast.className = 'fixed bottom-6 right-6 z-50 rounded-2xl bg-slate-900/95 text-white px-5 py-3.5 text-xs font-bold shadow-2xl flex items-center gap-3 border border-emerald-500/60 backdrop-blur-md transform translate-y-2 opacity-0 transition-all duration-300';
        toast.innerHTML = `<span class="text-emerald-400 text-base">✓</span><span>${msg}</span>`;
        document.body.appendChild(toast);
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }

      // 7. Modal Disposisi / Edit Status (Perbaikan Bug Cloudflare & Fitur Lengkap)
      const modal = document.getElementById('edit-ticket-modal');
      const backdrop = document.getElementById('modal-backdrop');
      const btnCloseModal = document.getElementById('btn-close-modal');
      const btnCancelModal = document.getElementById('btn-cancel-modal');
      const modalForm = document.getElementById('modal-edit-form');
      const btnModalQuickComplete = document.getElementById('btn-modal-quick-complete');

      const modalTitle = document.getElementById('modal-ticket-title');
      const modalTicketSub = document.getElementById('modal-ticket-sub');
      const modalCode = document.getElementById('modal-ticket-code');
      const modalSelectedStatus = document.getElementById('modal-selected-status');
      const modalPosisi = document.getElementById('modal-posisi-input');
      const modalCatatan = document.getElementById('modal-catatan-input');
      const modalSudahDiambil = document.getElementById('modal-sudah-diambil');
      const modalStatusChoices = document.querySelectorAll('.modal-status-choice');

      function openEditModal(kode) {
        const all = loadTickets();
        const t = all.find(x => x.kode === kode);
        if (!t) return;

        if (modalTitle) modalTitle.textContent = `${t.kode} — ${t.nama}`;
        if (modalTicketSub) modalTicketSub.textContent = `NIM: ${t.nim} • ${t.layananNama}`;
        if (modalCode) modalCode.value = t.kode;
        if (modalSelectedStatus) modalSelectedStatus.value = t.status;
        if (modalPosisi) modalPosisi.value = t.posisiBerkas || 'Antrean Masuk Loket Administrasi FAPERTA';
        if (modalCatatan) modalCatatan.value = t.catatanAdmin || '';
        if (modalSudahDiambil) modalSudahDiambil.checked = !!t.sudahDiambil;

        updateModalStatusChoiceUI(t.status);

        backdrop?.classList.remove('hidden');
        modal?.classList.remove('hidden');
        requestAnimationFrame(() => {
          backdrop?.classList.remove('opacity-0');
          modal?.classList.remove('scale-95');
        });
      }

      function closeEditModal() {
        backdrop?.classList.add('opacity-0');
        modal?.classList.add('scale-95');
        setTimeout(() => {
          backdrop?.classList.add('hidden');
          modal?.classList.add('hidden');
        }, 200);
      }

      function updateModalStatusChoiceUI(status) {
        modalStatusChoices.forEach(btn => {
          const s = btn.getAttribute('data-target-status');
          if (s === status) {
            if (s === 'Belum Diproses') btn.className = 'modal-status-choice p-2 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-amber-500 text-white border-amber-600 shadow-xs ring-2 ring-amber-300';
            else if (s === 'Verifikasi Admin Loket' || s === 'Proses Verifikasi') btn.className = 'modal-status-choice p-2 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-blue-600 text-white border-blue-700 shadow-xs ring-2 ring-blue-300';
            else if (s === 'Verifikasi Dosen / Kaprodi') btn.className = 'modal-status-choice p-2 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-indigo-600 text-white border-indigo-700 shadow-xs ring-2 ring-indigo-300';
            else if (s === 'Selesai (Siap Diambil)') btn.className = 'modal-status-choice p-2 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-emerald-600 text-white border-emerald-700 shadow-xs ring-2 ring-emerald-300';
            else if (s === 'Ditolak') btn.className = 'modal-status-choice p-2 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-rose-600 text-white border-rose-700 shadow-xs ring-2 ring-rose-300 col-span-2 sm:col-span-1';
          } else {
            btn.className = 'modal-status-choice p-2 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100' + (s === 'Ditolak' ? ' col-span-2 sm:col-span-1' : '');
          }
        });
      }

      modalStatusChoices.forEach(btn => {
        btn.addEventListener('click', () => {
          const s = btn.getAttribute('data-target-status');
          if (modalSelectedStatus) modalSelectedStatus.value = s;
          updateModalStatusChoiceUI(s);

          if (modalPosisi) {
            if (s === 'Belum Diproses') modalPosisi.value = 'Antrean Masuk Loket Administrasi FAPERTA';
            else if (s === 'Verifikasi Admin Loket' || s === 'Proses Verifikasi') modalPosisi.value = 'Meja Verifikasi SIAKAD & Dokumen Fisik';
            else if (s === 'Verifikasi Dosen / Kaprodi') {
              modalPosisi.value = 'Ruang Kaprodi Agroteknologi (Gedung A, Lt. 2)';
              if (modalCatatan && (!modalCatatan.value || modalCatatan.value.includes('antrean'))) {
                modalCatatan.value = 'Berkas sedang dalam tahap telaah dan verifikasi akademik oleh Dosen Pengampu / Dekanat.';
              }
            }
            else if (s === 'Selesai (Siap Diambil)') {
              modalPosisi.value = 'Loket 1 Administrasi FAPERTA (Gedung A, Lt. 1) - Siap Diambil';
              if (modalCatatan && (!modalCatatan.value || modalCatatan.value.includes('antrean') || modalCatatan.value.includes('telaah'))) {
                modalCatatan.value = 'Dokumen fisik resmi berstempel basah sudah selesai. Silakan ambil di Loket 1 Gedung A dengan membawa KTM asli.';
              }
            }
            else if (s === 'Ditolak') {
              modalPosisi.value = 'Ditolak Petugas Administrasi';
              if (modalCatatan && !modalCatatan.value.toLowerCase().includes('ditolak')) {
                modalCatatan.value = 'Ditolak: [Tuliskan alasan perbaikan berkas di sini]';
              }
            }
          }
        });
      });

      document.querySelectorAll('.preset-posisi').forEach(btn => {
        btn.addEventListener('click', () => {
          if (modalPosisi) modalPosisi.value = btn.getAttribute('data-pos') || '';
        });
      });

      btnCloseModal?.addEventListener('click', closeEditModal);
      btnCancelModal?.addEventListener('click', closeEditModal);
      backdrop?.addEventListener('click', closeEditModal);

      btnModalQuickComplete?.addEventListener('click', () => {
        const kode = modalCode?.value;
        if (kode) {
          quickCompleteTicket(kode);
          closeEditModal();
        }
      });

      modalForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const kode = modalCode?.value;
        const newStatus = modalSelectedStatus?.value;
        const newPosisi = modalPosisi?.value;
        const newCatatan = modalCatatan?.value;
        const isTaken = modalSudahDiambil ? modalSudahDiambil.checked : false;

        const all = loadTickets();
        const target = all.find(x => x.kode === kode);
        if (target) {
          target.status = newStatus;
          target.posisiBerkas = newPosisi;
          target.catatanAdmin = newCatatan;
          target.isNewForAdmin = false;

          if (isTaken) {
            target.sudahDiambil = true;
            if (!target.tanggalDiambil) {
              const now = new Date();
              target.tanggalDiambil = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + ', ' + now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';
            }
            if (!target.petugasPenyerah) {
              target.petugasPenyerah = sessionStorage.getItem('portal_admin_name') || 'Petugas Loket';
            }
          } else {
            target.sudahDiambil = false;
          }

          if (newStatus === 'Belum Diproses') target.statusStep = 1;
          else if (newStatus === 'Verifikasi Admin Loket' || newStatus === 'Proses Verifikasi') target.statusStep = 2;
          else if (newStatus === 'Verifikasi Dosen / Kaprodi') target.statusStep = 3;
          else if (newStatus === 'Selesai (Siap Diambil)') {
            target.statusStep = 4;
            target.estimasiSelesai = 'Siap Diambil di Loket 1 Gedung A';
          }
          else if (newStatus === 'Ditolak') {
            target.statusStep = -1;
            target.estimasiSelesai = '-';
          }

          saveTickets(all);
          closeEditModal();
          renderTicketsList();
          renderDatabaseTables(); // sync arsip & pengambilan tables
          updateRekapStats();
          showAdminToast(`✓ Perubahan status berkas ${target.kode} berhasil disimpan!`);
        }
      });

      // 8. DATABASE UTAMA ADMINISTRASI (Requirement #2 & #3)
      let activeDbTab = 'mahasiswa';
      let dbSearchQuery = '';

      const dbSubTabs = document.querySelectorAll('.db-sub-tab');
      const dbPanes = document.querySelectorAll('.db-pane');
      const dbSearchInput = document.getElementById('db-search-input');

      dbSubTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-db-tab');
          activeDbTab = target;
          
          dbSubTabs.forEach(t => {
            t.className = 'db-sub-tab px-3.5 py-2 rounded-xl text-xs font-bold transition text-slate-600 hover:text-slate-900 cursor-pointer';
          });
          tab.className = 'db-sub-tab px-3.5 py-2 rounded-xl text-xs font-bold transition bg-white text-emerald-800 shadow-2xs cursor-pointer';

          dbPanes.forEach(p => p.classList.add('hidden'));
          document.getElementById(`pane-${target}`)?.classList.remove('hidden');
          renderDatabaseTables();
        });
      });

      dbSearchInput?.addEventListener('input', (e) => {
        dbSearchQuery = e.target.value.trim().toLowerCase();
        renderDatabaseTables();
      });

      function renderDatabaseTables() {
        const query = dbSearchQuery;

        // 1. Table Mahasiswa
        const mhsBody = document.getElementById('table-mahasiswa-body');
        if (mhsBody) {
          let mhsList = masterMahasiswa.filter(m => 
            !query ||
            m.nim.toLowerCase().includes(query) ||
            m.nama.toLowerCase().includes(query) ||
            m.prodi.toLowerCase().includes(query) ||
            (m.dpa && m.dpa.toLowerCase().includes(query))
          );
          
          mhsBody.innerHTML = mhsList.map(m => `
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3 px-4 font-mono font-bold text-emerald-800">${m.nim}</td>
              <td class="py-3 px-4 font-bold text-slate-900">${m.nama}</td>
              <td class="py-3 px-4 text-slate-600">${m.prodi}</td>
              <td class="py-3 px-4 text-slate-500">${m.minat || '-'}</td>
              <td class="py-3 px-4 font-mono text-slate-600">${m.angkatan}</td>
              <td class="py-3 px-4 text-slate-600">${m.semester}</td>
              <td class="py-3 px-4 text-slate-700 font-medium">${m.dpa || '-'}</td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 text-emerald-800">
                  ${m.statusAkademik}
                </span>
              </td>
              <td class="py-3 px-4 text-right">
                <button type="button" class="btn-check-mhs text-[11px] font-bold text-emerald-700 hover:text-emerald-900 underline cursor-pointer" data-nim="${m.nim}">
                  Cek Berkas
                </button>
              </td>
            </tr>
          `).join('');

          mhsBody.querySelectorAll('.btn-check-mhs').forEach(btn => {
            btn.addEventListener('click', () => {
              const nim = btn.getAttribute('data-nim');
              setMainView('berkas');
              const searchInp = document.getElementById('admin-search-input');
              if (searchInp) searchInp.value = nim;
              searchQuery = nim.toLowerCase();
              renderTicketsList();
            });
          });
        }

        // 2. Table Dosen (Sesuai Permintaan: Cukup Nama Lengkap & Gelar serta Program Studi saja)
        const dsnBody = document.getElementById('table-dosen-body');
        if (dsnBody) {
          let dsnList = masterDosen.filter(d => 
            !query ||
            d.nama.toLowerCase().includes(query) ||
            d.prodi.toLowerCase().includes(query)
          );

          dsnBody.innerHTML = dsnList.map((d, idx) => `
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3.5 px-6 text-center font-mono font-bold text-slate-400">${idx + 1}</td>
              <td class="py-3.5 px-6 font-bold text-slate-900 text-sm">${d.nama}</td>
              <td class="py-3.5 px-6 text-slate-600 font-medium text-xs">${d.prodi}</td>
            </tr>
          `).join('');
        }

        // 3. Table Matkul
        const mkBody = document.getElementById('table-matkul-body');
        if (mkBody) {
          let mkList = masterMatkul.filter(m => 
            !query ||
            m.kode.toLowerCase().includes(query) ||
            m.nama.toLowerCase().includes(query) ||
            m.prodi.toLowerCase().includes(query) ||
            m.dosenPengampu.toLowerCase().includes(query)
          );

          mkBody.innerHTML = mkList.map(m => `
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3 px-4 font-mono font-bold text-emerald-800">${m.kode}</td>
              <td class="py-3 px-4 font-bold text-slate-900">${m.nama}</td>
              <td class="py-3 px-4 text-center font-mono font-bold">${m.sks} SKS</td>
              <td class="py-3 px-4 text-center font-mono text-slate-600">Sem ${m.semester}</td>
              <td class="py-3 px-4 text-slate-600">${m.prodi}</td>
              <td class="py-3 px-4 text-slate-700 font-medium">${m.dosenPengampu}</td>
            </tr>
          `).join('');
        }

        // 4. Table Arsip Seluruh Berkas
        const arsipBody = document.getElementById('table-arsip-body');
        if (arsipBody) {
          const allTickets = loadTickets();
          let arsipList = allTickets.filter(t => 
            !query ||
            t.kode.toLowerCase().includes(query) ||
            t.nim.toLowerCase().includes(query) ||
            t.nama.toLowerCase().includes(query) ||
            (t.layananNama && t.layananNama.toLowerCase().includes(query)) ||
            (t.posisiBerkas && t.posisiBerkas.toLowerCase().includes(query))
          );

          arsipBody.innerHTML = arsipList.map(t => `
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3 px-4 font-mono font-bold text-slate-900">${t.kode}</td>
              <td class="py-3 px-4">
                <strong class="text-slate-900 block">${t.nama}</strong>
                <span class="font-mono text-[11px] text-emerald-800">${t.nim}</span>
              </td>
              <td class="py-3 px-4 text-slate-600">${t.prodi || '-'}</td>
              <td class="py-3 px-4 text-slate-800 font-medium">${t.layananNama || '-'}</td>
              <td class="py-3 px-4 text-[11px] text-slate-500">${t.tanggal || '-'}</td>
              <td class="py-3 px-4 text-slate-700">${t.posisiBerkas || '-'}</td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-bold ${
                  t.status === 'Selesai (Siap Diambil)' ? 'bg-emerald-100 text-emerald-800' :
                  t.status === 'Proses Verifikasi' ? 'bg-blue-100 text-blue-800' :
                  t.status === 'Ditolak' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-900'
                }">
                  ${t.status}
                </span>
              </td>
            </tr>
          `).join('');
        }

        // 4b. Table Pengambilan Berkas Fisik (Requirement #1)
        const pengambilanBody = document.getElementById('table-pengambilan-body');
        const badgePengambilan = document.getElementById('badge-total-pengambilan');
        if (pengambilanBody) {
          const allTickets = loadTickets();
          let takenList = allTickets.filter(t => t.sudahDiambil);
          if (query) {
            takenList = takenList.filter(t =>
              t.kode.toLowerCase().includes(query) ||
              t.nim.toLowerCase().includes(query) ||
              t.nama.toLowerCase().includes(query) ||
              (t.layananNama && t.layananNama.toLowerCase().includes(query)) ||
              ((t.petugasPenyerah || '').toLowerCase().includes(query))
            );
          }

          if (badgePengambilan) {
            const totalCount = allTickets.filter(t => t.sudahDiambil).length;
            badgePengambilan.textContent = `${totalCount} Berkas Diserahkan`;
          }

          if (takenList.length === 0) {
            pengambilanBody.innerHTML = `
              <tr>
                <td colspan="7" class="py-8 text-center text-slate-400 italic">
                  Belum ada catatan pengambilan berkas fisik. Berkas yang diserahkan di loket akan tercatat otomatis di sini.
                </td>
              </tr>
            `;
          } else {
            pengambilanBody.innerHTML = takenList.map((t, idx) => `
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3.5 px-4 text-center font-mono font-bold text-slate-400">${idx + 1}</td>
                <td class="py-3.5 px-4 font-mono font-bold text-emerald-800">${t.kode}</td>
                <td class="py-3.5 px-4 text-slate-700 font-medium">${t.tanggalDiambil || '-'}</td>
                <td class="py-3.5 px-4">
                  <strong class="text-slate-900 block">${t.nama}</strong>
                  <span class="font-mono text-[11px] text-slate-500">${t.nim}</span>
                </td>
                <td class="py-3.5 px-4 text-slate-800 font-medium">${t.layananNama || '-'}</td>
                <td class="py-3.5 px-4 text-slate-700 font-medium">${t.petugasPenyerah || 'Petugas Loket 1'}</td>
                <td class="py-3.5 px-4 text-center">
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black bg-purple-100 text-purple-900 border border-purple-200">
                    <span>✓</span> Telah Diambil
                  </span>
                </td>
              </tr>
            `).join('');
          }
        }

        // 5. Table Akun Petugas & Admin (Multi-Admin Management Dikelola Super Admin)
        const adminBody = document.getElementById('table-admin-body');
        const restrictedNotice = document.getElementById('admin-restricted-notice');
        const btnAddAccount = document.getElementById('btn-add-account');
        const badgeCurrentRole = document.getElementById('badge-current-role');
        const currentRole = sessionStorage.getItem('portal_admin_role') || 'Super Admin';
        const isSuperAdmin = currentRole === 'Super Admin';

        if (restrictedNotice && badgeCurrentRole) {
          if (isSuperAdmin) {
            restrictedNotice.classList.add('hidden');
          } else {
            restrictedNotice.classList.remove('hidden');
            badgeCurrentRole.textContent = `Login Sebagai: ${currentRole}`;
          }
        }

        if (btnAddAccount) {
          if (isSuperAdmin) {
            btnAddAccount.classList.remove('hidden');
          } else {
            btnAddAccount.classList.add('hidden');
          }
        }

        // Sembunyikan atau tampilkan header Kata Sandi & Aksi
        document.querySelectorAll('.col-header-pass, .col-header-action').forEach(el => {
          if (isSuperAdmin) el.classList.remove('hidden');
          else el.classList.add('hidden');
        });

        if (adminBody) {
          const allAdmins = loadAdminAccounts();
          let admList = allAdmins.filter(a => 
            !query ||
            a.id.toLowerCase().includes(query) ||
            a.nama.toLowerCase().includes(query) ||
            a.username.toLowerCase().includes(query) ||
            a.role.toLowerCase().includes(query) ||
            ((a.loket || a.bagian || '').toLowerCase().includes(query))
          );

          adminBody.innerHTML = admList.map(a => `
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3.5 px-4 font-mono font-bold text-emerald-800">${a.id}</td>
              <td class="py-3.5 px-4 font-bold text-slate-900">${a.nama}</td>
              <td class="py-3.5 px-4 font-mono text-slate-700 bg-slate-100 rounded px-2 py-0.5 font-bold">${a.username}</td>
              ${isSuperAdmin ? `
                <td class="py-3.5 px-4 font-mono font-bold text-emerald-900 bg-emerald-50/60 rounded px-2">
                  ${a.password || '******'}
                </td>
              ` : ''}
              <td class="py-3.5 px-4">
                <span class="inline-block px-2.5 py-1 rounded-lg text-xs font-bold ${
                  a.role === 'Super Admin' ? 'bg-purple-100 text-purple-900 border border-purple-200' :
                  a.role === 'Dekanat' ? 'bg-amber-100 text-amber-900 border border-amber-200' :
                  a.role === 'Dosen / Kaprodi' ? 'bg-indigo-100 text-indigo-900 border border-indigo-200' :
                  'bg-emerald-100 text-emerald-800 border border-emerald-200'
                }">
                  ${a.role}
                </span>
              </td>
              <td class="py-3.5 px-4 text-slate-600 font-medium">${a.loket || a.bagian || '-'}</td>
              <td class="py-3.5 px-4 text-center">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[10px] font-bold ${
                  a.status === 'Aktif' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-500'
                }">
                  <span class="h-1.5 w-1.5 rounded-full ${a.status === 'Aktif' ? 'bg-emerald-600' : 'bg-slate-400'}"></span>
                  ${a.status}
                </span>
              </td>
              ${isSuperAdmin ? `
                <td class="py-3.5 px-4 text-right">
                  <button type="button" class="btn-edit-account px-2.5 py-1.5 rounded-lg text-xs font-bold bg-slate-100 hover:bg-emerald-100 text-slate-700 hover:text-emerald-900 transition cursor-pointer" data-id="${a.id}">
                    ✏️ Edit
                  </button>
                </td>
              ` : ''}
            </tr>
          `).join('');

          if (isSuperAdmin) {
            adminBody.querySelectorAll('.btn-edit-account').forEach(btn => {
              btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-id');
                const target = allAdmins.find(x => x.id === id);
                if (target) openAccountModal('edit', target);
              });
            });
          }
        }
      }

      // 9. Modal Tambah & Edit Akun (Khusus Super Admin)
      const accountModal = document.getElementById('admin-account-modal');
      const accountModalBackdrop = document.getElementById('account-modal-backdrop');
      const btnCloseAccountModal = document.getElementById('btn-close-account-modal');
      const btnCancelAccountModal = document.getElementById('btn-cancel-account-modal');
      const accountManageForm = document.getElementById('account-manage-form');
      const accountModalTitle = document.getElementById('account-modal-title');
      const accFormMode = document.getElementById('acc-form-mode');
      const accFormId = document.getElementById('acc-form-id');
      const accNama = document.getElementById('acc-nama');
      const accUsername = document.getElementById('acc-username');
      const accPassword = document.getElementById('acc-password');
      const accRole = document.getElementById('acc-role');
      const accStatus = document.getElementById('acc-status');
      const accLoket = document.getElementById('acc-loket');
      const btnAddAccountEl = document.getElementById('btn-add-account');

      function openAccountModal(mode, accData = null) {
        if (!accountModal) return;
        if (accFormMode) accFormMode.value = mode;
        if (mode === 'edit' && accData) {
          if (accountModalTitle) accountModalTitle.textContent = `Edit Akun: ${accData.nama}`;
          if (accFormId) accFormId.value = accData.id;
          if (accNama) accNama.value = accData.nama;
          if (accUsername) accUsername.value = accData.username;
          if (accPassword) accPassword.value = accData.password || '';
          if (accRole) accRole.value = accData.role;
          if (accStatus) accStatus.value = accData.status || 'Aktif';
          if (accLoket) accLoket.value = accData.loket || accData.bagian || '';
        } else {
          if (accountModalTitle) accountModalTitle.textContent = 'Tambah Akun Pengguna Baru';
          if (accFormId) accFormId.value = '';
          accountManageForm?.reset();
          if (accRole) accRole.value = 'Petugas Loket';
          if (accStatus) accStatus.value = 'Aktif';
        }
        accountModal.classList.remove('hidden');
      }

      function closeAccountModal() {
        accountModal?.classList.add('hidden');
      }

      btnAddAccountEl?.addEventListener('click', () => openAccountModal('add'));
      btnCloseAccountModal?.addEventListener('click', closeAccountModal);
      btnCancelAccountModal?.addEventListener('click', closeAccountModal);
      accountModalBackdrop?.addEventListener('click', closeAccountModal);

      accountManageForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const mode = accFormMode?.value;
        const id = accFormId?.value;
        const allAdmins = loadAdminAccounts();

        if (mode === 'edit') {
          const target = allAdmins.find(x => x.id === id);
          if (target) {
            target.nama = (accNama?.value || '').trim();
            target.username = (accUsername?.value || '').trim().toLowerCase();
            target.password = (accPassword?.value || '').trim();
            target.role = accRole?.value || 'Petugas Loket';
            target.status = accStatus?.value || 'Aktif';
            target.loket = (accLoket?.value || '').trim();
            target.terakhirAkses = 'Baru saja diubah';
          }
        } else {
          const newId = `ADM-0${allAdmins.length + 1}`;
          const newAcc = {
            id: newId,
            nama: (accNama?.value || '').trim(),
            username: (accUsername?.value || '').trim().toLowerCase(),
            password: (accPassword?.value || '').trim(),
            role: accRole?.value || 'Petugas Loket',
            status: accStatus?.value || 'Aktif',
            loket: (accLoket?.value || '').trim(),
            terakhirAkses: 'Baru dibuat'
          };
          allAdmins.push(newAcc);
        }

        saveAdminAccounts(allAdmins);
        closeAccountModal();
        renderDatabaseTables();
      });

      // 10. Quick Search Berkas & Aksi Terbaca
      const searchInput = document.getElementById('admin-search-input');
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        renderTicketsList();
      });

      const btnMarkAll = document.getElementById('btn-mark-all-read');
      btnMarkAll?.addEventListener('click', () => {
        const all = loadTickets();
        all.forEach(t => { t.isNewForAdmin = false; });
        saveTickets(all);
        renderTicketsList();
      });

      // 11. Ekspor CSV Rekap Data (Tersedia di Modul Rekap & Laporan)
      function triggerExportCSV() {
        const all = loadTickets();
        const headers = ['Kode Tiket', 'NIM', 'Nama Mahasiswa', 'Program Studi', 'Layanan', 'Status', 'Posisi Berkas Fisik', 'Tanggal Pengajuan'];
        const rows = all.map(t => [
          `"${t.kode}"`,
          `"${t.nim}"`,
          `"${t.nama}"`,
          `"${t.prodi || ''}"`,
          `"${t.layananNama || ''}"`,
          `"${t.status}"`,
          `"${t.posisiBerkas || ''}"`,
          `"${t.tanggal || ''}"`
        ]);
        const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', `rekap-administrasi-faperta-${new Date().toISOString().slice(0,10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }

      document.getElementById('btn-rekap-download-csv')?.addEventListener('click', triggerExportCSV);

      function updateRekapStats() {
        const all = loadTickets();
        const cntPending = all.filter(t => t.status === 'Belum Diproses').length;
        const cntProcess = all.filter(t => t.status === 'Proses Verifikasi' || t.status === 'Verifikasi Admin Loket' || t.status === 'Verifikasi Dosen / Kaprodi').length;
        const cntDone = all.filter(t => t.status === 'Selesai (Siap Diambil)').length;

        const elTot = document.getElementById('rekap-total');
        const elPen = document.getElementById('rekap-pending');
        const elPro = document.getElementById('rekap-process');
        const elDon = document.getElementById('rekap-done');

        if (elTot) elTot.textContent = all.length;
        if (elPen) elPen.textContent = cntPending;
        if (elPro) elPro.textContent = cntProcess;
        if (elDon) elDon.textContent = cntDone;
      }

      // Jalankan cek status auth awal
      checkAuth();
    });
  </script>
</BaseLayout>
