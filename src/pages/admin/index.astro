---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { 
  INITIAL_PORTAL_TICKETS, 
  MASTER_MAHASISWA, 
  MASTER_DOSEN, 
  MASTER_MATAKULIAH,
  MASTER_ADMINS
} from "../../data/portalData";
---

<BaseLayout 
  title="Portal Admin & Database Administrasi" 
  description="Dashboard petugas loket dan sistem database utama administrasi Fakultas Pertanian INSTIPER Yogyakarta."
  isStandaloneAdmin={true}
>
  
  <!-- ============================================================
       1. TAMPILAN LOGIN KHUSUS ADMIN (Simple & Professional)
       ============================================================ -->
  <section id="admin-login-view" class="min-h-screen flex items-center justify-center p-6 bg-slate-50">
    <div class="w-full max-w-md rounded-3xl border border-slate-200/90 bg-white p-8 sm:p-10 shadow-xl relative overflow-hidden">
      <!-- Decorative top emerald strip -->
      <div class="absolute top-0 inset-x-0 h-2 bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700"></div>

      <div class="text-center">
        <!-- Logo Murni INSTIPER Tanpa Kotak/Lingkaran Putih -->
        <a href="/" class="mx-auto inline-flex flex-col items-center justify-center group cursor-pointer" title="Kembali ke Beranda FAPERTA">
          <img 
            src="/logo-instiper.webp" 
            alt="Logo INSTIPER" 
            width="64" 
            height="64" 
            class="h-16 w-16 object-contain group-hover:scale-105 transition-transform" 
          />
          <h1 class="mt-3 text-2xl font-black text-slate-900 tracking-tight group-hover:text-emerald-700 transition-colors">
            FAPERTA INSTIPER
          </h1>
        </a>
        <div class="mt-2.5 inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800 border border-emerald-200">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Portal Administrasi Terpadu</span>
        </div>
        <p class="text-xs text-slate-500 mt-2 leading-relaxed">
          Pusat kontrol loket berkas akademik dan database administrasi terpadu Fakultas Pertanian.
        </p>
      </div>

      <!-- Form Login Admin -->
      <form id="admin-login-form" class="mt-8 space-y-4 text-left">
        <!-- Error Alert -->
        <div id="login-error-alert" class="hidden p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 font-medium flex items-center gap-2">
          <span>⚠️</span>
          <span><strong>ID atau Kata Sandi salah!</strong> Silakan periksa kembali kredensial Anda.</span>
        </div>

        <div>
          <label for="admin-user-input" class="block text-xs font-bold text-slate-700 mb-1.5">
            ID Petugas Administrasi:
          </label>
          <div class="flex items-center rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 focus-within:border-emerald-600 focus-within:bg-white focus-within:ring-2 focus-within:ring-emerald-600/20 transition">
            <span class="text-slate-400 mr-2.5 text-sm">👤</span>
            <input 
              type="text" 
              id="admin-user-input" 
              required
              placeholder="Contoh: agrotek" 
              class="w-full bg-transparent text-sm text-slate-900 placeholder:text-slate-400 outline-none border-none font-medium"
              autocomplete="username"
            />
          </div>
        </div>

        <div>
          <label for="admin-pass-input" class="block text-xs font-bold text-slate-700 mb-1.5">
            Kata Sandi:
          </label>
          <div class="flex items-center rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 focus-within:border-emerald-600 focus-within:bg-white focus-within:ring-2 focus-within:ring-emerald-600/20 transition">
            <span class="text-slate-400 mr-2.5 text-sm">🔑</span>
            <input 
              type="password" 
              id="admin-pass-input" 
              required
              placeholder="••••••••" 
              class="w-full bg-transparent text-sm text-slate-900 placeholder:text-slate-400 outline-none border-none font-medium"
              autocomplete="current-password"
            />
            <button 
              type="button" 
              id="btn-toggle-pass" 
              class="text-xs text-slate-400 hover:text-emerald-700 font-bold ml-2 select-none cursor-pointer"
            >
              Lihat
            </button>
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-bold text-sm py-3 flex items-center justify-center gap-2 mt-4 shadow-md shadow-emerald-900/15 transition cursor-pointer"
        >
          <span>Masuk Sistem Administrasi</span>
          <span>→</span>
        </button>
      </form>

      <!-- Footer Keamanan & Akses Resmi -->
      <div class="mt-6 pt-5 border-t border-slate-100 text-center text-xs text-slate-400">
        <p class="font-medium text-slate-500">Sistem Informasi Layanan & Loket Akademik Terpadu</p>
        <p class="text-[11px] text-slate-400 mt-0.5">Fakultas Pertanian • INSTIPER Yogyakarta</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. TAMPILAN DASHBOARD & DATABASE ADMIN (Desktop Fit & Pro)
       ============================================================ -->
  <div id="admin-dashboard-view" class="hidden flex-1 bg-slate-50 min-h-screen border-b border-slate-200">
    
    <!-- Top System Header Bar (Logo INSTIPER disesuaikan, Live Clock & Status Loket) -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-2xs">
      <div class="max-w-[1720px] 2xl:max-w-[1920px] mx-auto px-6 lg:px-10 py-3.5 flex flex-wrap items-center justify-between gap-4">
        
        <!-- Left: Logo INSTIPER Disesuaikan & Title (Klik kembali ke Beranda) -->
        <a href="/" class="flex items-center gap-3.5 group cursor-pointer hover:opacity-95 transition" title="Kembali ke Beranda FAPERTA">
          <img 
            src="/logo-instiper.webp" 
            alt="Logo INSTIPER" 
            width="40" 
            height="40" 
            class="h-10 w-10 object-contain shrink-0 drop-shadow-xs group-hover:scale-105 transition-transform" 
          />
          <div class="flex flex-col text-left">
            <div class="flex items-center gap-2">
              <h1 class="text-base font-black text-slate-900 tracking-tight leading-none group-hover:text-emerald-700 transition-colors">
                FAPERTA INSTIPER
              </h1>
              <span id="header-role-badge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Portal Administrasi Loket
              </span>
            </div>
            <p class="text-[11px] text-slate-500 font-medium mt-1">
              Fakultas Pertanian • Loket Admin FAPERTA
            </p>
          </div>
        </a>

        <!-- Right: Real-time Live Clock & Date Widget -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2.5 bg-slate-50 px-3.5 py-2 rounded-xl border border-slate-200 text-xs text-slate-700">
            <span class="text-slate-400">📅</span>
            <span id="live-calendar" class="font-medium">Jumat, 4 September 2026</span>
            <span class="text-slate-300">|</span>
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="live-clock" class="font-mono font-bold text-emerald-700">--:--:-- WIB</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Container: Scalable for 22 inch to 32 inch monitors -->
    <div class="max-w-[1720px] 2xl:max-w-[1920px] mx-auto px-6 lg:px-10 py-6 sm:py-8">
      <div class="grid lg:grid-cols-[300px_1fr] xl:grid-cols-[320px_1fr] 2xl:grid-cols-[340px_1fr] gap-6 xl:gap-8 items-start">
        
        <!-- ============================================================
             SIDEBAR KIRI (Rata Kiri, Rapi, & Jarak Elemen Nyaman)
             ============================================================ -->
        <aside class="space-y-6 lg:sticky lg:top-20">
          
          <!-- Box Navigasi Utama -->
          <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs space-y-6 text-left">
            
            <!-- BAGIAN 1: KATEGORI BERKAS (Lebih Besar, Konsisten & Elegan) -->
            <div>
              <div class="flex items-center justify-between mb-3 px-1">
                <span class="text-xs font-black uppercase tracking-wider text-slate-400 block text-left">
                  Kategori Berkas
                </span>
                <span class="text-[10px] text-emerald-800 font-bold bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100">
                  Real-time
                </span>
              </div>
              <nav class="space-y-2" aria-label="Kategori Berkas Loket">
                <!-- 1. Semua Berkas -->
                <button 
                  type="button" 
                  data-case="all" 
                  class="admin-case-tab group w-full flex items-center justify-between p-3.5 sm:p-4 rounded-2xl text-sm font-bold transition-all cursor-pointer bg-gradient-to-r from-emerald-700 to-emerald-800 text-white shadow-md shadow-emerald-950/20 text-left"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-xl shrink-0">📋</span>
                    <span class="case-tab-title text-sm font-bold tracking-tight text-white">Semua Berkas</span>
                  </div>
                  <span id="badge-cat-all" class="case-tab-badge min-w-[24px] h-6 px-2 rounded-full text-xs font-bold flex items-center justify-center bg-white/25 text-white">0</span>
                </button>

                <!-- 2. KHS -->
                <button 
                  type="button" 
                  data-case="khs" 
                  class="admin-case-tab group w-full flex items-center justify-between p-3.5 sm:p-4 rounded-2xl text-sm font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-xl shrink-0">📄</span>
                    <span class="case-tab-title text-sm font-bold tracking-tight text-slate-800 group-hover:text-emerald-900">KHS</span>
                  </div>
                  <span id="badge-count-khs" class="case-tab-badge min-w-[24px] h-6 px-2 rounded-full text-xs font-bold flex items-center justify-center bg-slate-100 text-slate-600 group-hover:bg-emerald-100 group-hover:text-emerald-800">0</span>
                </button>

                <!-- 3. Ujian Khusus -->
                <button 
                  type="button" 
                  data-case="ujian" 
                  class="admin-case-tab group w-full flex items-center justify-between p-3.5 sm:p-4 rounded-2xl text-sm font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-xl shrink-0">🎓</span>
                    <span class="case-tab-title text-sm font-bold tracking-tight text-slate-800 group-hover:text-emerald-900">Ujian Khusus</span>
                  </div>
                  <span id="badge-count-ujian" class="case-tab-badge min-w-[24px] h-6 px-2 rounded-full text-xs font-bold flex items-center justify-center bg-slate-100 text-slate-600 group-hover:bg-emerald-100 group-hover:text-emerald-800">0</span>
                </button>

                <!-- 4. Komplain Nilai -->
                <button 
                  type="button" 
                  data-case="komplain" 
                  class="admin-case-tab group w-full flex items-center justify-between p-3.5 sm:p-4 rounded-2xl text-sm font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-xl shrink-0">⚖️</span>
                    <span class="case-tab-title text-sm font-bold tracking-tight text-slate-800 group-hover:text-emerald-900">Komplain Nilai</span>
                  </div>
                  <span id="badge-count-komplain" class="case-tab-badge min-w-[24px] h-6 px-2 rounded-full text-xs font-bold flex items-center justify-center bg-slate-100 text-slate-600 group-hover:bg-emerald-100 group-hover:text-emerald-800">0</span>
                </button>

                <!-- 5. Izin Penelitian -->
                <button 
                  type="button" 
                  data-case="penelitian" 
                  class="admin-case-tab group w-full flex items-center justify-between p-3.5 sm:p-4 rounded-2xl text-sm font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-xl shrink-0">📑</span>
                    <span class="case-tab-title text-sm font-bold tracking-tight text-slate-800 group-hover:text-emerald-900">Izin Penelitian</span>
                  </div>
                  <span id="badge-count-penelitian" class="case-tab-badge min-w-[24px] h-6 px-2 rounded-full text-xs font-bold flex items-center justify-center bg-slate-100 text-slate-600 group-hover:bg-emerald-100 group-hover:text-emerald-800">0</span>
                </button>

                <!-- 6. Lainnya -->
                <button 
                  type="button" 
                  data-case="lainnya" 
                  class="admin-case-tab group w-full flex items-center justify-between p-3.5 sm:p-4 rounded-2xl text-sm font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-xl shrink-0">📁</span>
                    <span class="case-tab-title text-sm font-bold tracking-tight text-slate-800 group-hover:text-emerald-900">Lainnya</span>
                  </div>
                  <span id="badge-count-lainnya" class="case-tab-badge min-w-[24px] h-6 px-2 rounded-full text-xs font-bold flex items-center justify-center bg-slate-100 text-slate-600 group-hover:bg-emerald-100 group-hover:text-emerald-800">0</span>
                </button>
              </nav>
            </div>

            <!-- BAGIAN 2: DATA MASTER & ARSIP (Foto 1: Dipindahkan ke Navigasi Tab Kiri) -->
            <div class="border-t border-slate-100 pt-4">
              <span class="text-[11px] font-black uppercase tracking-wider text-slate-400 block mb-2.5 px-1 text-left">
                Database Master & Arsip
              </span>
              <nav class="space-y-1.5" aria-label="Menu Database Master dan Rekap">
                <!-- 1. Buku Besar Layanan -->
                <button 
                  type="button" 
                  data-sidebar-dbtab="master-layanan" 
                  class="admin-db-nav group w-full flex items-center justify-between p-3 rounded-2xl text-xs font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-base shrink-0">📋</span>
                    <span class="db-nav-title font-bold text-slate-800 group-hover:text-emerald-900 truncate">Buku Besar Layanan</span>
                  </div>
                  <span id="badge-nav-layanan" class="db-nav-badge min-w-[22px] h-5 px-1.5 rounded-full text-[10px] font-bold flex items-center justify-center bg-slate-100 text-slate-600 group-hover:bg-emerald-100 group-hover:text-emerald-800 font-mono">0</span>
                </button>

                <!-- 2. Master Mahasiswa -->
                <button 
                  type="button" 
                  data-sidebar-dbtab="mahasiswa" 
                  class="admin-db-nav group w-full flex items-center justify-between p-3 rounded-2xl text-xs font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-base shrink-0">🎓</span>
                    <span class="db-nav-title font-bold text-slate-800 group-hover:text-emerald-900 truncate">Master Mahasiswa</span>
                  </div>
                  <span id="badge-nav-mahasiswa" class="db-nav-badge min-w-[22px] h-5 px-1.5 rounded-full text-[10px] font-bold flex items-center justify-center bg-slate-100 text-slate-600 group-hover:bg-emerald-100 group-hover:text-emerald-800 font-mono">0</span>
                </button>

                <!-- 3. Pengambilan Berkas -->
                <button 
                  type="button" 
                  data-sidebar-dbtab="pengambilan" 
                  class="admin-db-nav group w-full flex items-center justify-between p-3 rounded-2xl text-xs font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-base shrink-0">📦</span>
                    <span class="db-nav-title font-bold text-slate-800 group-hover:text-emerald-900 truncate">Pengambilan Berkas</span>
                  </div>
                  <span id="badge-nav-pengambilan" class="db-nav-badge min-w-[22px] h-5 px-1.5 rounded-full text-[10px] font-bold flex items-center justify-center bg-slate-100 text-slate-600 group-hover:bg-emerald-100 group-hover:text-emerald-800 font-mono">0</span>
                </button>

                <!-- 4. Akun Petugas & Admin -->
                <button 
                  type="button" 
                  data-sidebar-dbtab="admin" 
                  class="admin-db-nav group w-full flex items-center justify-between p-3 rounded-2xl text-xs font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-base shrink-0">👥</span>
                    <span class="db-nav-title font-bold text-slate-800 group-hover:text-emerald-900 truncate">Akun Petugas & Admin</span>
                  </div>
                  <span class="db-nav-badge px-2 py-0.5 rounded-md text-[9px] font-bold bg-slate-100 text-slate-600 group-hover:bg-emerald-100 group-hover:text-emerald-800">PETUGAS</span>
                </button>

                <!-- 5. Rekap dan Laporan -->
                <button 
                  type="button" 
                  id="tab-btn-rekap" 
                  class="admin-main-tab group w-full flex items-center justify-between p-3 rounded-2xl text-xs font-bold transition-all cursor-pointer text-slate-700 hover:bg-emerald-50/70 hover:text-emerald-900 text-left"
                >
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-base shrink-0">📊</span>
                    <span class="font-bold text-slate-800 group-hover:text-emerald-900 truncate">Rekap & Laporan</span>
                  </div>
                  <span class="text-slate-400 text-sm group-hover:text-emerald-800">→</span>
                </button>
              </nav>
            </div>

            <!-- SYSTEM CONTROLS (Tandai Terbaca) -->
            <div class="border-t border-slate-100 pt-4">
              <button 
                id="btn-mark-all-read" 
                type="button" 
                class="w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 hover:text-emerald-800 transition flex items-center gap-2 cursor-pointer"
              >
                <span>✓</span>
                <span>Tandai Semua Berkas Terbaca</span>
              </button>
            </div>
          </div>

          <!-- Profil Petugas Box (Bawah Sidebar: Admin) -->
          <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-xs flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div id="user-avatar-initial" class="h-10 w-10 rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white flex items-center justify-center font-black text-sm shadow-xs">
                A
              </div>
              <div class="text-left">
                <span id="user-role-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block leading-none">Petugas Loket</span>
                <strong id="user-name-display" class="text-sm font-black text-slate-900 block mt-0.5">Admin</strong>
                <span id="user-loket-display" class="text-[10px] text-emerald-700 font-bold block">Administrator Loket</span>
              </div>
            </div>
            <button 
              id="btn-admin-logout" 
              type="button" 
              class="p-2.5 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
              title="Keluar dari Portal Admin"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </button>
          </div>
        </aside>

        <!-- ============================================================
             WORKSPACE UTAMA (KANAN - FIT SCREEN & COMFORTABLE)
             ============================================================ -->
        <main class="space-y-6 text-left">
          
          <!-- ========================================================
               VIEW 1: DAFTAR BERKAS MASUK (DASHBOARD PEMROSESAN)
               ======================================================== -->
          <div id="view-berkas-container" class="space-y-6">
            
            <!-- Workspace Header Bar -->
            <div class="rounded-3xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-3">
                  <h2 id="active-category-title" class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                    Semua Berkas
                  </h2>
                  <span 
                    id="filtered-count-badge" 
                    class="inline-flex items-center justify-center px-4 py-1.5 rounded-full text-xs font-black bg-emerald-100 text-emerald-900 border border-emerald-300 shadow-2xs whitespace-nowrap min-w-[88px] text-center"
                  >
                    0 Berkas
                  </span>
                </div>
                <p id="active-category-subtitle" class="text-xs text-slate-500 font-medium">
                  Monitoring seluruh berkas KHS, ujian khusus, dan komplain nilai mahasiswa.
                </p>
              </div>

              <!-- Controls: Toggle Sembunyikan yang Sudah Diambil + Search -->
              <div class="flex flex-wrap sm:flex-nowrap items-center gap-3">
                <label class="h-10 inline-flex items-center gap-2.5 px-4 rounded-xl border border-slate-200 bg-slate-50 text-xs font-bold text-slate-700 cursor-pointer select-none hover:bg-slate-100 transition shadow-2xs shrink-0">
                  <input type="checkbox" id="toggle-hide-taken" checked class="w-4 h-4 text-emerald-600 rounded focus:ring-emerald-500 cursor-pointer" />
                  <span class="whitespace-nowrap">Sembunyikan yang Sudah Diambil</span>
                </label>

                <!-- Quick Search Input -->
                <div class="w-full sm:w-64 md:w-72">
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 text-xs">
                      🔍
                    </span>
                    <input 
                      type="text" 
                      id="admin-search-input" 
                      placeholder="Cari NIM, Nama, Kode..." 
                      class="h-10 w-full rounded-xl border border-slate-200 bg-slate-50/70 pl-9 pr-3.5 text-xs text-slate-900 placeholder:text-slate-400 focus:border-emerald-600 focus:bg-white focus:ring-2 focus:ring-emerald-600/20 outline-none font-medium transition shadow-2xs"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- Interactive KPI Status Cards (Klik untuk Langsung Filter & Lihat Berkas) -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" role="region" aria-label="Filter Cepat Status Berkas">
              <button 
                type="button" 
                data-kpi-filter="all"
