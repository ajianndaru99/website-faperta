      // 3. Storage Data Management (Tiket & Master Mahasiswa Terintegrasi)
      function loadMasterMahasiswa() {
        try {
          const raw = localStorage.getItem('portal_faperta_master_mahasiswa');
          let list = raw ? JSON.parse(raw) : [...masterMahasiswa];

          // Pastikan semua data bawaan dari portalData terdaftar
          masterMahasiswa.forEach(initM => {
            const cleanInitNim = String(initM.nim).trim().toLowerCase();
            if (!list.some(m => String(m.nim).trim().toLowerCase() === cleanInitNim)) {
              list.push(initM);
            }
          });

          // Sinkronkan seluruh pemohon dari antrean tiket
          const allTickets = loadRawTicketsOnly();
          let changed = false;

          allTickets.forEach(t => {
            if (!t.nim) return;
            const tNim = String(t.nim).trim();
            const existing = list.find(m => String(m.nim).trim().toLowerCase() === tNim.toLowerCase());

            if (!existing) {
              list.push({
                nim: tNim,
                nama: t.nama || 'Mahasiswa Pemohon',
                prodi: t.prodi || 'S1 Agroteknologi',
                minat: 'SPKS (Kelapa Sawit)',
                angkatan: 2024,
                semester: t.semester || 'Semester 3',
                statusAkademik: 'Aktif',
                dpa: 'Ir. H. Sudirman, M.P.',
                whatsapp: t.whatsapp || '',
                email: t.email || '',
                isApplicant: true
              });
              changed = true;
            } else {
              if (!existing.whatsapp && t.whatsapp) { existing.whatsapp = t.whatsapp; changed = true; }
              if (!existing.email && t.email) { existing.email = t.email; changed = true; }
              if (t.semester && existing.semester !== t.semester) { existing.semester = t.semester; changed = true; }
              if (t.prodi && existing.prodi !== t.prodi) { existing.prodi = t.prodi; changed = true; }
            }
          });

          if (!raw || changed) {
            localStorage.setItem('portal_faperta_master_mahasiswa', JSON.stringify(list));
          }
          return list;
        } catch (e) {
          return [...masterMahasiswa];
        }
