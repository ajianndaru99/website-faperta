          let data = raw ? JSON.parse(raw) : [...initialPortalTickets];
          let updated = false;

          // Pastikan tiket awal resmi (seperti tiket Ajian KHS-2026-8246) tercakup jika belum ada
          initialPortalTickets.forEach(initT => {
            if (!data.some(t => t.kode === initT.kode)) {
              data.push(initT);
