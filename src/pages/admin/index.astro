      // Helper: Apakah berkas sudah selesai atau sudah diambil
      function isTicketFinished(t) {
        if (t.sudahDiambil) return true;
        // Khusus komplain nilai: prosesnya online murni. Begitu selesai di SIAKAD (status 'Selesai (Siap Diambil)'),
        // berkas dianggap tuntas sama seperti berkas fisik yang sudah diambil oleh mahasiswa.
        const isKomplain = (t.layananId || '').toLowerCase().includes('komplain') ||
                           (t.layananNama || '').toLowerCase().includes('komplain') ||
                           (t.kode || '').toUpperCase().startsWith('KMP');
        if (isKomplain && t.status === 'Selesai (Siap Diambil)') {
          return true;
        }
        return false;
      }

      // Helper untuk memeriksa apakah tiket sesuai dengan kategori tab di sidebar
      function isTicketInCategory(t, category) {
        if (!category || category === 'all') return true;
        const id = (t.layananId || '').toLowerCase();
        const code = (t.kode || '').toUpperCase();
        const kep = (t.keperluan || '').toLowerCase();

        if (category === 'khs') return id.includes('khs') || code.startsWith('KHS');
        if (category === 'ujian') return id.includes('ujian') || code.startsWith('UKH');
        if (category === 'komplain') return id.includes('komplain') || code.startsWith('KMP');
        if (category === 'penelitian') return id.includes('penelitian') || code.startsWith('PEN') || kep.includes('penelitian');
        if (category === 'lainnya') {
          return !id.includes('khs') && !id.includes('komplain') && !id.includes('ujian') && !id.includes('penelitian')
            && !code.startsWith('KHS') && !code.startsWith('KMP') && !code.startsWith('UKH') && !code.startsWith('PEN')
            && !kep.includes('penelitian');
        }
        return true;
      }

      // SINKRONISASI DINAMIS KPI & KATEGORI SIDEBAR
      function updateSidebarBadges(tickets) {
        // Pool dasar untuk KPI cards (jika toggle sembunyikan berkas yang sudah diambil/selesai aktif)
        const activeTickets = hideTaken ? tickets.filter(t => !isTicketFinished(t)) : tickets;

        // KPI Status Counts: DIHITUNG KHUSUS UNTUK KATEGORI BERKAS YANG SEDANG DIPILIH (currentCase)
        // - Jika berada di tab "Semua Berkas" ('all'), maka menghitung seluruh berkas yang ada
        // - Jika berada di tab "KHS" ('khs'), maka kartu Total Berkas, Belum Diproses, Verifikasi, Siap Diambil hanya menghitung berkas KHS
        // - Jika berada di tab lain ("Ujian Khusus", "Komplain Nilai", dll.), kartu menghitung berkas kategori tersebut saja
        const kpiPool = activeTickets.filter(t => isTicketInCategory(t, currentCase));

        const cntTotal = kpiPool.length;
        const cntPending = kpiPool.filter(t => t.status === 'Belum Diproses').length;
        const cntProcess = kpiPool.filter(t => t.status === 'Proses Verifikasi' || t.status === 'Verifikasi Admin Loket' || t.status === 'Verifikasi Dosen / Kaprodi' || t.status === 'Verifikasi Dosen / Kaprodi / Dekanat' || (t.status && t.status.includes('Dosen'))).length;
        const cntDone = kpiPool.filter(t => t.status === 'Selesai (Siap Diambil)').length;

        const kpiTotal = document.getElementById('stat-total');
        const kpiPending = document.getElementById('stat-pending');
        const kpiProcess = document.getElementById('stat-process');
        const kpiDone = document.getElementById('stat-done');

        if (kpiTotal) kpiTotal.textContent = cntTotal;
        if (kpiPending) kpiPending.textContent = cntPending;
        if (kpiProcess) kpiProcess.textContent = cntProcess;
        if (kpiDone) kpiDone.textContent = cntDone;

        // Hitung kategori di sidebar kiri menyesuaikan kotak status yang sedang dipilih (currentStatus)
        let categoryPool = activeTickets;
        if (currentStatus !== 'all') {
          if (currentStatus === 'Proses Verifikasi') {
            categoryPool = activeTickets.filter(t => t.status === 'Proses Verifikasi' || t.status === 'Verifikasi Admin Loket' || t.status === 'Verifikasi Dosen / Kaprodi' || t.status === 'Verifikasi Dosen / Kaprodi / Dekanat' || (t.status && t.status.includes('Dosen')));
          } else {
            categoryPool = activeTickets.filter(t => t.status === currentStatus);
          }
        }

        const countAll = categoryPool.length;
        const countKhs = categoryPool.filter(t => isTicketInCategory(t, 'khs')).length;
        const countUjian = categoryPool.filter(t => isTicketInCategory(t, 'ujian')).length;
        const countKomplain = categoryPool.filter(t => isTicketInCategory(t, 'komplain')).length;
        const countPenelitian = categoryPool.filter(t => isTicketInCategory(t, 'penelitian')).length;
        const countLainnya = categoryPool.filter(t => isTicketInCategory(t, 'lainnya')).length;

        const bCatAll = document.getElementById('badge-cat-all');
        const bKhs = document.getElementById('badge-count-khs');
        const bUjian = document.getElementById('badge-count-ujian');
        const bKomplain = document.getElementById('badge-count-komplain');
        const bPenelitian = document.getElementById('badge-count-penelitian');
        const bLainnya = document.getElementById('badge-count-lainnya');

        if (bCatAll) bCatAll.textContent = countAll;
        if (bKhs) bKhs.textContent = countKhs;
        if (bUjian) bUjian.textContent = countUjian;
        if (bKomplain) bKomplain.textContent = countKomplain;
        if (bPenelitian) bPenelitian.textContent = countPenelitian;
        if (bLainnya) bLainnya.textContent = countLainnya;
      }

      function getCleanCaseName(t) {
        if (!t) return 'Berkas';
        const id = (t.layananId || '').toLowerCase();
        const code = (t.kode || '').toUpperCase();
        const name = t.layananNama || '';
        if (id.includes('khs') || code.startsWith('KHS')) {
          return name.replace(/^Permohonan\s+/i, '');
        }
        if (id.includes('ujian') || code.startsWith('UKH')) {
          return name.replace(/^Pengajuan\s+/i, '');
        }
        if (id.includes('komplain') || code.startsWith('KMP')) {
          return name.replace(/^Verifikasi\s*\/\s*/i, '');
        }
        if (id.includes('penelitian') || code.startsWith('PEN')) {
          return 'Izin Penelitian';
        }
        return name || 'Berkas Mahasiswa';
      }

      // 7. Render Daftar Berkas Masuk
      function renderTicketsList() {
        const all = loadTickets();
        updateSidebarBadges(all);

        let filtered = all;

        // Filter: Sembunyikan yang sudah diambil / selesai dari antrean aktif jika toggle dicentang
        if (hideTaken) {
          filtered = filtered.filter(t => !isTicketFinished(t));
        }

        // Filter kategori sesuai tab yang sedang aktif
        filtered = filtered.filter(t => isTicketInCategory(t, currentCase));

        // Filter status
        if (currentStatus !== 'all') {
          if (currentStatus === 'Proses Verifikasi') {
            filtered = filtered.filter(t => t.status === 'Proses Verifikasi' || t.status === 'Verifikasi Admin Loket' || t.status === 'Verifikasi Dosen / Kaprodi' || t.status === 'Verifikasi Dosen / Kaprodi / Dekanat' || (t.status && t.status.includes('Dosen')));
          } else {
            filtered = filtered.filter(t => t.status === currentStatus);
          }
        }

        // Filter search input
        if (searchQuery) {
          filtered = filtered.filter(t => 
            (t.kode || '').toLowerCase().includes(searchQuery) ||
            (t.nim || '').toLowerCase().includes(searchQuery) ||
            (t.nama || '').toLowerCase().includes(searchQuery) ||
            (t.keperluan || '').toLowerCase().includes(searchQuery) ||
            (t.layananNama || '').toLowerCase().includes(searchQuery)
          );
        }

        const titleEl = document.getElementById('active-category-title');
        const subtitleEl = document.getElementById('active-category-subtitle');
        const countBadge = document.getElementById('filtered-count-badge');
        if (titleEl) {
          let suffix = '';
          if (currentStatus !== 'all') suffix = ` • ${currentStatus}`;
          titleEl.textContent = (categoryTitleMap[currentCase] || 'Berkas Mahasiswa') + suffix;
        }
        if (subtitleEl) {
          subtitleEl.textContent = categorySubtitleMap[currentCase] || 'Monitoring berkas mahasiswa FAPERTA.';
        }
        if (countBadge) countBadge.textContent = `${filtered.length} Berkas`;

        const container = document.getElementById('admin-tickets-container');
        const emptyState = document.getElementById('admin-empty-state');
        const emptyTitle = document.getElementById('empty-state-title');
        const emptyDesc = document.getElementById('empty-state-desc');
        if (!container) return;
        container.innerHTML = '';

        if (filtered.length === 0) {
          if (emptyTitle && emptyDesc) {
            if (currentCase === 'khs') {
              emptyTitle.textContent = 'Tidak Ada Berkas KHS';
              emptyDesc.textContent = 'Belum ada permohonan KHS mahasiswa yang cocok dengan filter.';
            } else if (currentCase === 'ujian') {
              emptyTitle.textContent = 'Tidak Ada Berkas Ujian Khusus';
              emptyDesc.textContent = 'Belum ada pendaftaran ujian khusus yang cocok dengan filter.';
            } else if (currentCase === 'komplain') {
              emptyTitle.textContent = 'Tidak Ada Aduan Komplain Nilai';
              emptyDesc.textContent = 'Tidak ada laporan aduan nilai yang cocok dengan filter.';
            } else if (currentCase === 'penelitian') {
              emptyTitle.textContent = 'Tidak Ada Berkas Izin Penelitian';
              emptyDesc.textContent = 'Belum ada permohonan surat izin penelitian yang cocok dengan filter.';
            } else {
              emptyTitle.textContent = 'Tidak Ada Berkas Ditemukan';
              emptyDesc.textContent = searchQuery ? 'Tidak ada berkas yang cocok dengan kata kunci pencarian Anda.' : 'Semua berkas pada tahapan ini telah tuntas diproses.';
            }
          }
          emptyState?.classList.remove('hidden');
          return;
        }
        emptyState?.classList.add('hidden');

        const statusConfig = {
          'Belum Diproses': { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200', icon: '⏳' },
          'Verifikasi Admin Loket': { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-200', icon: '🔍' },
          'Proses Verifikasi': { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-200', icon: '🔍' },
          'Verifikasi Dosen / Kaprodi / Dekanat': { bg: 'bg-indigo-50', text: 'text-indigo-800', border: 'border-indigo-200', icon: '👨‍🏫' },
          'Verifikasi Dosen / Kaprodi': { bg: 'bg-indigo-50', text: 'text-indigo-800', border: 'border-indigo-200', icon: '👨‍🏫' },
          'Selesai (Siap Diambil)': { bg: 'bg-emerald-50', text: 'text-emerald-800', border: 'border-emerald-200', icon: '📦' },
          'Ditolak': { bg: 'bg-rose-50', text: 'text-rose-800', border: 'border-rose-200', icon: '❌' }
        };

        filtered.forEach(t => {
          const cfg = statusConfig[t.status] || statusConfig['Belum Diproses'];
          const cleanCase = getCleanCaseName(t);
          const displayDate = t.tanggal && t.tanggal !== 'Hari Ini' ? t.tanggal : '-';
          const displayEstimasi = (t.estimasiSelesai && t.estimasiSelesai !== '-') ? t.estimasiSelesai : '-';
          const mhsInfo = masterMahasiswa.find(m => m.nim === t.nim);
          const waNumber = t.whatsapp || (mhsInfo && mhsInfo.whatsapp) || '';
          const emailAddr = t.email || (mhsInfo && mhsInfo.email) || '';
          const cleanWa = waNumber.replace(/[^0-9]/g, '');
          const formattedWa = cleanWa.startsWith('0') ? ('62' + cleanWa.slice(1)) : cleanWa;

          let displayStatus = t.status;
          if (displayStatus.includes('Dosen') || displayStatus.includes('Dekanat')) {
            displayStatus = 'Verifikasi Dosen / Kaprodi / Dekanat';
          }
          let displayPosisi = t.posisiBerkas || 'Loket Admin FAPERTA';
          if (displayPosisi.includes('Dosen') || displayPosisi.includes('Dekanat')) {
            displayPosisi = 'Ruang Dosen / Kaprodi / Dekanat';
          }

          const card = document.createElement('div');
          card.className = 'rounded-3xl border border-slate-200 bg-white p-6 shadow-xs hover:border-emerald-600/60 transition text-left';

          card.innerHTML = `
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
              <div class="flex flex-wrap items-center gap-2.5">
                <!-- Kode Tiket -->
                <span class="px-3 py-1 rounded-xl text-xs font-mono font-bold bg-slate-900 text-white shadow-2xs">
                  ${t.kode}
                </span>
                <!-- Status Tiket -->
                <span class="px-3 py-1 rounded-xl text-xs font-bold border ${cfg.bg} ${cfg.text} ${cfg.border} flex items-center gap-1.5 shadow-2xs">
                  <span>${cfg.icon}</span>
                  <span>${displayStatus}</span>
                </span>
                <!-- Nama Spesifik Kasus Berkas -->
                <span class="px-3 py-1 rounded-xl text-xs font-bold bg-emerald-100 text-emerald-900 border border-emerald-300 flex items-center gap-1.5 shadow-2xs">
                  <span>📄</span>
                  <span>${cleanCase}</span>
                </span>
                ${t.sudahDiambil ? `
                  <span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-purple-100 text-purple-900 border border-purple-300 flex items-center gap-1 shadow-2xs">
                    <span>✓</span>
                    <span>Sudah Diambil</span>
                  </span>
                ` : ''}
              </div>
              <!-- Tanggal Masuk -->
              <div class="text-xs flex items-center gap-1.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200 text-slate-600 shrink-0">
                <span class="text-slate-500 font-medium">📅 Masuk:</span>
                <strong class="text-slate-800">${displayDate}</strong>
              </div>
            </div>

            <div class="mt-4 grid md:grid-cols-[1.2fr_1fr] gap-6 items-start">
              <div>
                <div class="flex items-start gap-3">
                  <div class="h-10 w-10 shrink-0 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-base border border-emerald-200">
                    🎓
                  </div>
                  <div>
                    <h3 class="text-base font-extrabold text-slate-900 leading-snug">${t.nama}</h3>
                    <p class="text-xs text-slate-500 font-mono mt-0.5">
                      NIM: <strong class="text-emerald-800 font-bold">${t.nim}</strong> · ${t.prodi} ${t.semester ? `(${t.semester})` : ''}
                    </p>
                    <!-- Kontak Lengkap Mahasiswa (WhatsApp & Email Soft Serasi) -->
                    <div class="mt-2.5 flex flex-wrap items-center gap-2 text-xs">
                      ${waNumber ? `
                        <a 
                          href="https://wa.me/${formattedWa}" 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 font-bold transition shadow-2xs cursor-pointer"
                          title="Chat WhatsApp Mahasiswa"
                        >
                          <span>💬</span>
                          <span class="font-mono text-slate-900 text-[11px]">${waNumber}</span>
                        </a>
                      ` : `
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-slate-100 text-slate-400 text-[11px]">
                          <span>💬</span> WA: -
                        </span>
                      `}
                      ${emailAddr ? `
                        <a 
                          href="mailto:${emailAddr}" 
                          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 font-medium transition shadow-2xs cursor-pointer"
                          title="Kirim Email Mahasiswa"
                        >
                          <span>✉️</span>
                          <span class="font-mono text-slate-900 text-[11px]">${emailAddr}</span>
                        </a>
                      ` : `
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-slate-100 text-slate-400 text-[11px]">
                          <span>✉️</span> Email: -
                        </span>
                      `}
                    </div>
                  </div>
                </div>

                <div class="mt-4 bg-slate-50 rounded-2xl p-3.5 border border-slate-200/80 text-xs space-y-1">
                  <p class="font-bold text-emerald-800">${cleanCase}</p>
                  <p class="text-slate-700 leading-relaxed">${t.detailTambahan || t.keperluan || '-'}</p>
                </div>
              </div>

              <div class="space-y-3 text-xs bg-slate-50/50 rounded-2xl p-4 border border-slate-200/80">
                <div>
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Posisi Berkas Fisik:</span>
                  <p class="font-bold text-slate-900 mt-0.5 flex items-center gap-1.5">
                    <span>📍</span>
                    <span>${displayPosisi}</span>
                  </p>
                </div>

                <div>
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Perkiraan Waktu Selesai:</span>
                  <p class="font-bold ${displayEstimasi !== '-' ? 'text-emerald-800' : 'text-slate-500'} mt-0.5 flex items-center gap-1.5">
                    <span>⏱️</span>
                    <span>${displayEstimasi !== '-' ? displayEstimasi : '- (Belum Diatur Admin)'}</span>
                  </p>
                </div>

                ${t.catatanAdmin ? `
                  <div class="pt-2 border-t border-slate-200/60">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Catatan Petugas:</span>
                    <p class="text-slate-700 italic mt-0.5">${t.catatanAdmin}</p>
                  </div>
                ` : ''}

                <div class="pt-3 border-t border-slate-200/60 flex flex-wrap items-center justify-between gap-2">
                  <button 
                    type="button" 
                    class="btn-open-edit flex-1 min-w-[130px] rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white text-xs py-2.5 px-3.5 font-bold shadow-xs cursor-pointer inline-flex items-center justify-center gap-1.5 transition"
                    data-kode="${t.kode}"
                  >
                    <span>✏️ Disposisi / Update</span>
                  </button>

                  ${t.status !== 'Selesai (Siap Diambil)' && t.status !== 'Ditolak' ? `
                    <button 
                      type="button" 
                      class="btn-quick-complete rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs py-2.5 px-3.5 font-bold shadow-xs cursor-pointer inline-flex items-center justify-center gap-1 transition"
                      data-kode="${t.kode}"
                      title="Selesaikan berkas secara langsung"
                    >
                      <span>⚡</span>
                      <span>Langsung Selesai</span>
                    </button>
                  ` : ''}

                  ${t.status === 'Selesai (Siap Diambil)' ? (
                    ((t.layananId || '').toLowerCase().includes('komplain') || (t.layananNama || '').toLowerCase().includes('komplain') || (t.kode || '').toUpperCase().startsWith('KMP')) ? `
                      <span class="text-[11px] font-bold text-blue-900 bg-blue-100/90 px-3 py-1.5 rounded-xl border border-blue-200 inline-flex items-center gap-1">
                        <span>🌐</span>
                        <span>Selesai Online (Tanpa Perlu ke Loket)</span>
                      </span>
                    ` : (
                      !t.sudahDiambil ? `
                        <button 
                          type="button" 
                          class="btn-mark-taken rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs py-2.5 px-3.5 font-bold shadow-xs cursor-pointer inline-flex items-center justify-center gap-1 transition"
                          data-kode="${t.kode}"
                          title="Tandai berkas fisik telah diserahkan di Loket Admin FAPERTA"
                        >
                          <span>🤝</span>
                          <span>Serahkan (Sudah Diambil)</span>
                        </button>
                      ` : `
                        <span class="text-[11px] font-bold text-purple-900 bg-purple-100 px-3 py-1.5 rounded-xl border border-purple-200 inline-flex items-center gap-1">
                          <span>✓</span>
                          <span>Diambil: ${t.tanggalDiambil || '-'}</span>
                        </span>
                      `
                    )
                  ) : ''}
                </div>
              </div>
            </div>
          `;

          container.appendChild(card);
        });

        attachCardListeners();
      }

      function attachCardListeners() {
        document.querySelectorAll('.btn-open-edit').forEach(btn => {
          btn.addEventListener('click', () => {
            const kode = btn.getAttribute('data-kode');
            if (kode) openEditModal(kode);
          });
        });

        document.querySelectorAll('.btn-quick-complete').forEach(btn => {
          btn.addEventListener('click', () => {
            const kode = btn.getAttribute('data-kode');
            if (kode) quickCompleteTicket(kode);
          });
        });

        document.querySelectorAll('.btn-mark-taken').forEach(btn => {
          btn.addEventListener('click', () => {
            const kode = btn.getAttribute('data-kode');
            if (kode) markTicketAsTaken(kode);
          });
        });
      }

      // AKSI CEPAT: LANGSUNG SELESAI (1-KLIK)
      function quickCompleteTicket(kode) {
        const all = loadTickets();
        const target = all.find(x => x.kode === kode);
        if (!target) return;

        const isKomplain = (target.layananId || '').toLowerCase().includes('komplain') 
          || (target.layananNama || '').toLowerCase().includes('komplain') 
          || (target.kode || '').toUpperCase().startsWith('KMP');

        target.status = 'Selesai (Siap Diambil)';
        target.statusStep = 4;
        target.isNewForAdmin = false;

        if (isKomplain) {
          const now = new Date();
          const timeStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + ', ' + now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';
          target.sudahDiambil = true;
          target.sudahDiambilAt = Date.now();
          target.tanggalDiambil = timeStr;
          target.posisiBerkas = 'Selesai Diproses Online (SIAKAD)';
          target.estimasiSelesai = 'Selesai Diproses Online';
          target.catatanAdmin = 'Komplain nilai telah diverifikasi oleh Dosen Pengampu dan perubahan nilai telah diproses di SIAKAD. Mahasiswa tidak perlu hadir ke loket.';
        } else {
          target.posisiBerkas = 'Loket Admin FAPERTA';
          target.estimasiSelesai = 'Siap Diambil di Loket Admin FAPERTA';
          target.catatanAdmin = 'Dokumen fisik resmi berstempel basah telah selesai diverifikasi dan siap diambil di Loket Admin FAPERTA dengan membawa KTM asli.';
        }

        saveTickets(all);
        renderTicketsList();
        renderDatabaseTables();
        updateRekapStats();
        showAdminToast(`⚡ Berkas ${target.kode} (${target.nama}) berhasil diselesaikan langsung!`);
      }

      // AKSI CEPAT: SERAHKAN BERKAS / SUDAH DIAMBIL (Requirement #1 & #7)
      function markTicketAsTaken(kode) {
        const all = loadTickets();
        const target = all.find(x => x.kode === kode);
        if (!target) return;

        const curAdminName = sessionStorage.getItem('portal_admin_name') || 'Petugas Loket';
        const now = new Date();
        const timeStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + ', ' + now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';

        target.sudahDiambil = true;
        target.sudahDiambilAt = Date.now();
        target.tanggalDiambil = timeStr;
        target.petugasPenyerah = curAdminName;
        target.status = 'Selesai (Siap Diambil)';
        target.posisiBerkas = `Diserahkan ke Mahasiswa di Loket Admin FAPERTA (${timeStr})`;
        target.catatanAdmin = `Berkas fisik telah diambil langsung oleh mahasiswa di Loket Admin FAPERTA pada ${timeStr} melalui petugas ${curAdminName}.`;

        saveTickets(all);
        renderTicketsList();
        renderDatabaseTables();
        updateRekapStats();
        showAdminToast(`📦 Berkas ${target.kode} telah diserahkan dan dicatat di Master Data Pengambilan!`);
      }

      // TOAST NOTIFIKASI FEEDBACK ADMIN
      function showAdminToast(msg) {
        const existing = document.getElementById('admin-toast-notification');
        if (existing) existing.remove();

        const toast = document.createElement('div');
        toast.id = 'admin-toast-notification';
        toast.className = 'fixed bottom-6 right-6 z-50 rounded-2xl bg-slate-900/95 text-white px-5 py-3.5 text-xs font-bold shadow-2xl flex items-center gap-3 border border-emerald-500/60 backdrop-blur-md transform translate-y-2 opacity-0 transition-all duration-300';
        toast.innerHTML = `<span class="text-emerald-400 text-base">✓</span><span>${msg}</span>`;
        document.body.appendChild(toast);
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }

      // 7. Modal Disposisi / Edit Status (Senior-Friendly, Teks Jelas Tanpa Icon, Disposisi Only)
      const modal = document.getElementById('edit-ticket-modal');
      const backdrop = document.getElementById('modal-backdrop');
      const btnCloseModal = document.getElementById('btn-close-modal');
      const btnCancelModal = document.getElementById('btn-cancel-modal');
      const modalForm = document.getElementById('modal-edit-form');
      const btnModalQuickComplete = document.getElementById('btn-modal-quick-complete');

      const modalTitle = document.getElementById('modal-ticket-title');
      const modalTicketSub = document.getElementById('modal-ticket-sub');
      const modalCode = document.getElementById('modal-ticket-code');
      const modalSelectedStatus = document.getElementById('modal-selected-status');
      const modalPosisi = document.getElementById('modal-posisi-input');
      const modalEstimasi = document.getElementById('modal-estimasi-input');
      const modalCatatan = document.getElementById('modal-catatan-input');
      const modalStatusChoices = document.querySelectorAll('.modal-status-choice');

      function openEditModal(kode) {
        const all = loadTickets();
        const t = all.find(x => x.kode === kode);
        if (!t) return;

        const mhsInfo = masterMahasiswa.find(m => m.nim === t.nim);
        const waNumber = t.whatsapp || (mhsInfo && mhsInfo.whatsapp) || '';
        const emailAddr = t.email || (mhsInfo && mhsInfo.email) || '';
        const cleanWa = waNumber.replace(/[^0-9]/g, '');
        const formattedWa = cleanWa.startsWith('0') ? ('62' + cleanWa.slice(1)) : cleanWa;

        const elTicketBadge = document.getElementById('modal-ticket-badge');
        const elNama = document.getElementById('modal-mhs-nama');
        const elNim = document.getElementById('modal-mhs-nim');
        const elProdi = document.getElementById('modal-mhs-prodi');
        const elLayananBadge = document.getElementById('modal-mhs-layanan-badge');
        const elWaWrap = document.getElementById('modal-mhs-wa-wrap');
        const elEmailWrap = document.getElementById('modal-mhs-email-wrap');

        if (elTicketBadge) elTicketBadge.textContent = t.kode;
        if (elNama) elNama.textContent = t.nama;
        if (elNim) elNim.textContent = t.nim;
        if (elProdi) elProdi.textContent = t.prodi || (mhsInfo && mhsInfo.prodi) || '-';
        if (elLayananBadge) elLayananBadge.textContent = t.layananNama || 'Berkas Mahasiswa';

        if (elWaWrap) {
          if (waNumber) {
            elWaWrap.innerHTML = `
              <a href="https://wa.me/${formattedWa}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 text-xs font-bold transition shadow-2xs cursor-pointer" title="Chat WhatsApp">
                <span class="text-xs">💬</span>
                <span class="font-mono text-slate-900">${waNumber}</span>
              </a>
            `;
          } else {
            elWaWrap.innerHTML = `<span class="text-slate-400 font-mono text-xs italic">WA: -</span>`;
          }
        }

        if (elEmailWrap) {
          if (emailAddr) {
            elEmailWrap.innerHTML = `
              <a href="mailto:${emailAddr}" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 text-xs font-bold transition shadow-2xs cursor-pointer" title="Kirim Email">
                <span class="text-xs">✉️</span>
                <span class="font-mono text-slate-900 truncate max-w-[180px]">${emailAddr}</span>
              </a>
            `;
          } else {
            elEmailWrap.innerHTML = `<span class="text-slate-400 font-mono text-xs italic">Email: -</span>`;
          }
        }

        if (modalCode) modalCode.value = t.kode;
        if (modalSelectedStatus) modalSelectedStatus.value = t.status;
        if (modalPosisi) {
          let pos = t.posisiBerkas || 'Loket Admin FAPERTA';
          if (pos.includes('Dosen') || pos.includes('Dekanat')) pos = 'Ruang Dosen / Kaprodi / Dekanat';
          modalPosisi.value = pos;
        }
        if (modalEstimasi) modalEstimasi.value = (t.estimasiSelesai && t.estimasiSelesai !== '-') ? t.estimasiSelesai : '-';
        if (modalCatatan) modalCatatan.value = t.catatanAdmin || '';

        updateModalStatusChoiceUI(t.status);

        backdrop?.classList.remove('hidden');
        modal?.classList.remove('hidden');
        requestAnimationFrame(() => {
          backdrop?.classList.remove('opacity-0');
          modal?.classList.remove('scale-95');
        });
      }

      function closeEditModal() {
        backdrop?.classList.add('opacity-0');
        modal?.classList.add('scale-95');
        setTimeout(() => {
          backdrop?.classList.add('hidden');
          modal?.classList.add('hidden');
        }, 200);
      }

      function updateModalStatusChoiceUI(status) {
        modalStatusChoices.forEach(btn => {
          const s = btn.getAttribute('data-target-status');
          const isSelected = (s === status) || (status.includes('Dosen') && s.includes('Dosen'));
          const baseClasses = 'modal-status-choice p-2 rounded-xl border-2 font-black transition flex flex-col items-center justify-center cursor-pointer min-h-[48px]' + (s === 'Ditolak' ? ' col-span-2 sm:col-span-1' : '');

          if (isSelected) {
            if (s === 'Belum Diproses') {
              btn.className = `${baseClasses} bg-amber-500 text-white border-amber-600 shadow-md ring-4 ring-amber-200`;
