      };

      const categorySubtitleMap = {
        'all': 'Monitoring berkas mahasiswa KHS, ujian khusus, dan komplain nilai.',
        'khs': 'Penerbitan salinan Kartu Hasil Studi untuk prasyarat ujian dan beasiswa.',
