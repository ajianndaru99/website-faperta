              const m = mhsList.find(mhs => String(mhs.nim).trim().toLowerCase() === String(t.nim).trim().toLowerCase());
              if (m) {
                if (!t.whatsapp && m.whatsapp) { t.whatsapp = m.whatsapp; updated = true; }
                if (!t.email && m.email) { t.email = m.email; updated = true; }
              }
            }
          });
          if (!raw || updated) {
