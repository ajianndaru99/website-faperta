              btn.className = `${baseClasses} bg-blue-600 text-white border-blue-700 shadow-md ring-4 ring-blue-200`;
            } else if (s.includes('Dosen') || s.includes('Dekanat')) {
              btn.className = `${baseClasses} bg-indigo-600 text-white border-indigo-700 shadow-md ring-4 ring-indigo-200`;
            } else if (s === 'Selesai (Siap Diambil)') {
