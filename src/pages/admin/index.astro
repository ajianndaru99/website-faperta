---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { 
  INITIAL_DEMO_TICKETS, 
  MASTER_MAHASISWA, 
  MASTER_DOSEN, 
  MASTER_MATAKULIAH 
} from "../../data/portalData";
---

<BaseLayout 
  title="Portal Admin & Database Administrasi" 
  description="Dashboard petugas loket dan sistem database utama administrasi Fakultas Pertanian INSTIPER Yogyakarta."
  isStandaloneAdmin={true}
>
  
  <!-- ============================================================
       1. TAMPILAN LOGIN KHUSUS ADMIN (Simple & Professional)
       ============================================================ -->
  <section id="admin-login-view" class="min-h-screen flex items-center justify-center p-6 bg-slate-50">
    <div class="w-full max-w-md rounded-3xl border border-slate-200/90 bg-white p-8 sm:p-10 shadow-xl relative overflow-hidden">
      <!-- Decorative top emerald strip -->
      <div class="absolute top-0 inset-x-0 h-2 bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700"></div>

      <div class="text-center">
        <div class="mx-auto h-16 w-16 rounded-2xl bg-slate-50 border border-slate-200 p-2.5 flex items-center justify-center shadow-xs">
          <img 
            src="/logo-instiper.webp" 
            alt="Logo INSTIPER" 
            width="50" 
            height="50" 
            class="h-full w-full object-contain drop-shadow-xs" 
          />
        </div>
        <div class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800 border border-emerald-200">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Portal Administrasi Terpadu</span>
        </div>
        <h1 class="mt-2.5 text-2xl font-black text-slate-900 tracking-tight">
          FAPERTA INSTIPER
        </h1>
        <p class="text-xs text-slate-500 mt-1 leading-relaxed">
          Pusat kontrol loket berkas akademik dan database administrasi terpadu Fakultas Pertanian.
        </p>
      </div>

      <!-- Form Login Admin -->
      <form id="admin-login-form" class="mt-8 space-y-4 text-left">
        <!-- Error Alert -->
        <div id="login-error-alert" class="hidden p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 font-medium flex items-center gap-2">
          <span>⚠️</span>
          <span><strong>ID atau Kata Sandi salah!</strong> Silakan periksa kembali kredensial Anda.</span>
        </div>

        <div>
          <label for="admin-user-input" class="block text-xs font-bold text-slate-700 mb-1.5">
            ID Petugas Administrasi:
          </label>
          <div class="flex items-center rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 focus-within:border-emerald-600 focus-within:bg-white focus-within:ring-2 focus-within:ring-emerald-600/20 transition">
            <span class="text-slate-400 mr-2.5 text-sm">👤</span>
            <input 
              type="text" 
              id="admin-user-input" 
              required
              placeholder="Contoh: agrotek" 
              class="w-full bg-transparent text-sm text-slate-900 placeholder:text-slate-400 outline-none border-none font-medium"
              autocomplete="username"
            />
          </div>
        </div>

        <div>
          <label for="admin-pass-input" class="block text-xs font-bold text-slate-700 mb-1.5">
            Kata Sandi:
          </label>
          <div class="flex items-center rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 focus-within:border-emerald-600 focus-within:bg-white focus-within:ring-2 focus-within:ring-emerald-600/20 transition">
            <span class="text-slate-400 mr-2.5 text-sm">🔑</span>
            <input 
              type="password" 
              id="admin-pass-input" 
              required
              placeholder="••••••••" 
              class="w-full bg-transparent text-sm text-slate-900 placeholder:text-slate-400 outline-none border-none font-medium"
              autocomplete="current-password"
            />
            <button 
              type="button" 
              id="btn-toggle-pass" 
              class="text-xs text-slate-400 hover:text-emerald-700 font-bold ml-2 select-none cursor-pointer"
            >
              Lihat
            </button>
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-bold text-sm py-3 flex items-center justify-center gap-2 mt-4 shadow-md shadow-emerald-900/15 transition cursor-pointer"
        >
          <span>Masuk Sistem Administrasi</span>
          <span>→</span>
        </button>
      </form>

      <!-- Informasi Akun Demo Staf -->
      <div class="mt-6 pt-5 border-t border-slate-100 bg-slate-50/80 p-3.5 rounded-2xl text-[11px] text-slate-600 space-y-1 text-left">
        <p class="font-bold text-emerald-800 flex items-center gap-1.5">
          <span>💡</span>
          <span>Kredensial Akses Staf Loket:</span>
        </p>
        <p>• <strong>ID Petugas:</strong> <code class="font-mono text-slate-900 bg-white px-1.5 py-0.5 rounded border border-slate-200">agrotek</code></p>
        <p>• <strong>Kata Sandi:</strong> <code class="font-mono text-slate-900 bg-white px-1.5 py-0.5 rounded border border-slate-200">agr001</code></p>
        <button 
          type="button" 
          id="btn-quick-login" 
          class="mt-2.5 w-full py-2 px-3 rounded-xl bg-emerald-100/90 hover:bg-emerald-200 text-emerald-900 font-bold text-xs transition cursor-pointer flex items-center justify-center gap-1.5 shadow-2xs"
        >
          <span>⚡</span>
          <span>Masuk Otomatis (Demo Staf Loket)</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. TAMPILAN DASHBOARD & DATABASE ADMIN (Desktop Fit & Pro)
       ============================================================ -->
  <div id="admin-dashboard-view" class="hidden flex-1 bg-slate-50 min-h-screen border-b border-slate-200">
    
    <!-- Top System Header Bar (Logo INSTIPER disesuaikan, Live Clock & Status Loket) -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-2xs">
      <div class="w-full px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-4">
        
        <!-- Left: Logo INSTIPER Disesuaikan & Title -->
        <div class="flex items-center gap-3.5">
          <img 
            src="/logo-instiper.webp" 
            alt="Logo INSTIPER" 
            width="40" 
            height="40" 
            class="h-10 w-10 object-contain shrink-0 drop-shadow-xs" 
          />
          <div class="flex flex-col text-left">
            <div class="flex items-center gap-2">
              <h1 class="text-base font-black text-slate-900 tracking-tight leading-none">
                FAPERTA INSTIPER
              </h1>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Portal Administrasi Loket
              </span>
            </div>
            <p class="text-[11px] text-slate-500 font-medium mt-1">
              Fakultas Pertanian • Gedung A Lantai 1
            </p>
          </div>
        </div>

        <!-- Right: Real-time Live Clock & Date Widget -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2.5 bg-slate-50 px-3.5 py-2 rounded-xl border border-slate-200 text-xs text-slate-700">
            <span class="text-slate-400">📅</span>
            <span id="live-calendar" class="font-medium">Jumat, 4 September 2026</span>
            <span class="text-slate-300">|</span>
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="live-clock" class="font-mono font-bold text-emerald-700">--:--:-- WIB</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Container: Full width for desktop monitors -->
    <div class="w-full px-6 lg:px-8 py-6">
      <div class="grid lg:grid-cols-[280px_1fr] gap-8 items-start">
        
        <!-- ============================================================
             SIDEBAR KIRI (Rata Kiri, Rapi, & Jarak Elemen Nyaman)
             ============================================================ -->
        <aside class="space-y-6 lg:sticky lg:top-20">
          
          <!-- Box Navigasi Utama -->
          <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs space-y-6 text-left">
            
            <!-- SECTION 1: MENU UTAMA -->
            <div>
              <span class="text-[11px] font-black uppercase tracking-wider text-slate-400 block mb-2.5 px-2 text-left">
                Menu Utama
              </span>
              <nav class="space-y-1.5" aria-label="Menu Utama Admin">
                <!-- 1. Berkas Masuk / Dashboard -->
                <button 
                  type="button" 
                  id="tab-btn-berkas" 
                  class="admin-main-tab w-full flex items-center justify-between px-4 py-3 rounded-2xl text-xs font-bold transition cursor-pointer bg-gradient-to-r from-emerald-600 to-emerald-700 text-white shadow-md shadow-emerald-900/15 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-base">📥</span>
                    <span>Daftar Berkas Masuk</span>
                  </div>
                  <span id="badge-count-all" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-white/20 text-white font-black">0</span>
                </button>

                <!-- 2. Database Utama Administrasi (NEW MASTER DB) -->
                <button 
                  type="button" 
                  id="tab-btn-database" 
                  class="admin-main-tab w-full flex items-center justify-between px-4 py-3 rounded-2xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-base">🗄️</span>
                    <span>Database Administrasi</span>
                  </div>
                  <span class="px-1.5 py-0.5 rounded-md text-[9px] font-bold bg-emerald-100 text-emerald-800">MASTER</span>
                </button>

                <!-- 3. Rekap & Laporan -->
                <button 
                  type="button" 
                  id="tab-btn-rekap" 
                  class="admin-main-tab w-full flex items-center justify-between px-4 py-3 rounded-2xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-base">📊</span>
                    <span>Rekap & Laporan</span>
                  </div>
                  <span class="text-slate-400 text-xs">→</span>
                </button>
              </nav>
            </div>

            <!-- SECTION 2: FILTER STATUS BERKAS (Aktif pada View Berkas) -->
            <div id="sidebar-filter-status-box" class="border-t border-slate-100 pt-5">
              <div class="flex items-center justify-between mb-2.5 px-2">
                <span class="text-[11px] font-black uppercase tracking-wider text-slate-400 text-left">
                  Filter Status
                </span>
                <span class="text-[10px] text-slate-400 font-mono">Real-time</span>
              </div>
              <div class="space-y-1.5">
                <button 
                  type="button" 
                  data-status="all" 
                  class="admin-status-filter w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer bg-emerald-50 text-emerald-800 text-left"
                >
                  <span>Semua Status</span>
                  <span id="stat-filter-all" class="font-mono text-[10px]">0</span>
                </button>
                <button 
                  type="button" 
                  data-status="Belum Diproses" 
                  class="admin-status-filter w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-amber-50 hover:text-amber-900 text-left"
                >
                  <span class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                    <span>Belum Diproses</span>
                  </span>
                  <span id="stat-filter-pending" class="px-2 py-0.5 rounded font-mono text-[10px] bg-amber-100 text-amber-900 font-bold">0</span>
                </button>
                <button 
                  type="button" 
                  data-status="Proses Verifikasi" 
                  class="admin-status-filter w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-blue-50 hover:text-blue-900 text-left"
                >
                  <span class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-blue-500"></span>
                    <span>Proses Verifikasi</span>
                  </span>
                  <span id="stat-filter-process" class="px-2 py-0.5 rounded font-mono text-[10px] bg-blue-100 text-blue-900 font-bold">0</span>
                </button>
                <button 
                  type="button" 
                  data-status="Selesai (Siap Diambil)" 
                  class="admin-status-filter w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-emerald-50 hover:text-emerald-900 text-left"
                >
                  <span class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                    <span>Siap Diambil</span>
                  </span>
                  <span id="stat-filter-done" class="px-2 py-0.5 rounded font-mono text-[10px] bg-emerald-100 text-emerald-900 font-bold">0</span>
                </button>
                <button 
                  type="button" 
                  data-status="Ditolak" 
                  class="admin-status-filter w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-rose-50 hover:text-rose-900 text-left"
                >
                  <span class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-rose-500"></span>
                    <span>Ditolak</span>
                  </span>
                  <span id="stat-filter-rejected" class="px-2 py-0.5 rounded font-mono text-[10px] bg-rose-100 text-rose-900 font-bold">0</span>
                </button>
              </div>
            </div>

            <!-- SECTION 3: FILTER KATEGORI LAYANAN BERKAS -->
            <div id="sidebar-filter-category-box" class="border-t border-slate-100 pt-5">
              <span class="text-[11px] font-black uppercase tracking-wider text-slate-400 block mb-2.5 px-2 text-left">
                Kategori Berkas
              </span>
              <div class="space-y-1.5">
                <button 
                  type="button" 
                  data-case="all" 
                  class="admin-case-tab w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer bg-slate-100 text-slate-900 text-left"
                >
                  <span>📋 Seluruh Dokumen</span>
                  <span id="badge-cat-all" class="font-mono text-[10px]">0</span>
                </button>
                <button 
                  type="button" 
                  data-case="khs" 
                  class="admin-case-tab w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-slate-50 text-left"
                >
                  <span>📄 Permohonan KHS</span>
                  <span id="badge-count-khs" class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 text-slate-700 font-bold">0</span>
                </button>
                <button 
                  type="button" 
                  data-case="komplain" 
                  class="admin-case-tab w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-slate-50 text-left"
                >
                  <span>⚖️ Komplain Nilai</span>
                  <span id="badge-count-komplain" class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 text-slate-700 font-bold">0</span>
                </button>
                <button 
                  type="button" 
                  data-case="ujian" 
                  class="admin-case-tab w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-slate-50 text-left"
                >
                  <span>🎓 Ujian Khusus</span>
                  <span id="badge-count-ujian" class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 text-slate-700 font-bold">0</span>
                </button>
                <button 
                  type="button" 
                  data-case="lainnya" 
                  class="admin-case-tab w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-slate-50 text-left"
                >
                  <span>📑 Surat Izin / Lainnya</span>
                  <span id="badge-count-lainnya" class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 text-slate-700 font-bold">0</span>
                </button>
              </div>
            </div>

            <!-- SECTION 4: SYSTEM CONTROLS -->
            <div class="border-t border-slate-100 pt-5 space-y-2">
              <button 
                id="btn-mark-all-read" 
                type="button" 
                class="w-full text-left px-3.5 py-2 rounded-xl text-[11px] font-bold text-slate-600 hover:bg-slate-100 hover:text-emerald-800 transition flex items-center gap-2 cursor-pointer"
              >
                <span>✓</span>
                <span>Tandai Semua Berkas Terbaca</span>
              </button>
              <button 
                id="btn-reset-demo" 
                type="button" 
                class="w-full text-left px-3.5 py-2 rounded-xl text-[11px] font-bold text-rose-600 hover:bg-rose-50 transition flex items-center gap-2 cursor-pointer"
              >
                <span>🔄</span>
                <span>Reset Data Awal Demo</span>
              </button>
            </div>
          </div>

          <!-- Profil Petugas Box (Bawah Sidebar) -->
          <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-xs flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white flex items-center justify-center font-bold text-sm shadow-xs">
                A
              </div>
              <div class="text-left">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block leading-none">Petugas Loket</span>
                <strong class="text-xs font-black text-slate-900 block mt-0.5">agrotek</strong>
                <span class="text-[10px] text-emerald-700 font-bold block">Super Admin</span>
              </div>
            </div>
            <button 
              id="btn-admin-logout" 
              type="button" 
              class="p-2.5 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
              title="Keluar dari Portal Admin"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </button>
          </div>
        </aside>

        <!-- ============================================================
             WORKSPACE UTAMA (KANAN - FIT SCREEN & COMFORTABLE)
             ============================================================ -->
        <main class="space-y-6 text-left">
          
          <!-- ========================================================
               VIEW 1: DAFTAR BERKAS MASUK (DASHBOARD PEMROSESAN)
               ======================================================== -->
          <div id="view-berkas-container" class="space-y-6">
            
            <!-- Workspace Header Bar -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2.5">
                  <h2 id="active-category-title" class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                    Semua Berkas Masuk
                  </h2>
                  <span id="filtered-count-badge" class="px-3 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-800 border border-emerald-200">
                    0 Berkas
                  </span>
                </div>
                <p class="text-xs text-slate-500 mt-1">
                  Pusat verifikasi dan disposisi posisi berkas fisik loket administrasi FAPERTA INSTIPER.
                </p>
              </div>

              <!-- Quick Search Input -->
              <div class="sm:w-80">
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 text-xs">
                    🔍
                  </span>
                  <input 
                    type="text" 
                    id="admin-search-input" 
                    placeholder="Cari NIM, Nama, atau Kode..." 
                    class="w-full rounded-2xl border border-slate-200 bg-slate-50/70 pl-9 pr-3.5 py-2.5 text-xs text-slate-900 placeholder:text-slate-400 focus:border-emerald-600 focus:bg-white focus:ring-2 focus:ring-emerald-600/20 outline-none font-medium transition"
                  />
                </div>
              </div>
            </div>

            <!-- Compact KPI Stats Strip -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs flex items-center gap-3.5">
                <div class="h-11 w-11 rounded-xl bg-slate-100 flex items-center justify-center text-xl">
                  📋
                </div>
                <div>
                  <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total Berkas</p>
                  <p id="stat-total" class="text-xl font-black text-slate-900">0</p>
                </div>
              </div>
              <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-4 shadow-2xs flex items-center gap-3.5">
                <div class="h-11 w-11 rounded-xl bg-amber-100 flex items-center justify-center text-xl">
                  ⏳
                </div>
                <div>
                  <p class="text-[10px] font-bold text-amber-800 uppercase tracking-wider">Belum Diproses</p>
                  <p id="stat-pending" class="text-xl font-black text-amber-900">0</p>
                </div>
              </div>
              <div class="rounded-2xl border border-blue-200 bg-blue-50/60 p-4 shadow-2xs flex items-center gap-3.5">
                <div class="h-11 w-11 rounded-xl bg-blue-100 flex items-center justify-center text-xl">
                  🔍
                </div>
                <div>
                  <p class="text-[10px] font-bold text-blue-800 uppercase tracking-wider">Verifikasi</p>
                  <p id="stat-process" class="text-xl font-black text-blue-900">0</p>
                </div>
              </div>
              <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 shadow-2xs flex items-center gap-3.5">
                <div class="h-11 w-11 rounded-xl bg-emerald-100 flex items-center justify-center text-xl">
                  ✅
                </div>
                <div>
                  <p class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider">Siap Diambil</p>
                  <p id="stat-done" class="text-xl font-black text-emerald-900">0</p>
                </div>
              </div>
            </div>

            <!-- Notice: Kebijakan Cetak Struk di Mahasiswa -->
            <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 flex items-center justify-between gap-3 text-xs text-emerald-900">
              <div class="flex items-center gap-2.5">
                <span class="text-base">ℹ️</span>
                <span><strong>Kebijakan Cetak Struk:</strong> Cetak tanda terima permohonan resmi dikhususkan langsung bagi <strong>Mahasiswa</strong> pada halaman Cek Status & Konfirmasi Pengajuan.</span>
              </div>
            </div>

            <!-- Daftar Berkas / Tickets Cards Container -->
            <div id="admin-tickets-container" class="space-y-4">
              <!-- Rendered by JavaScript -->
            </div>

