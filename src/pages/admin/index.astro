      const caseTabs = document.querySelectorAll('.admin-case-tab');
      function updateCategoryTabsUI() {
        caseTabs.forEach(tab => {
          const c = tab.getAttribute('data-case') || 'all';
          const title = tab.querySelector('.case-tab-title');
