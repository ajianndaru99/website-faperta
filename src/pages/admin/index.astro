---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { 
  INITIAL_PORTAL_TICKETS, 
  MASTER_MAHASISWA, 
  MASTER_DOSEN, 
  MASTER_MATAKULIAH,
  MASTER_ADMINS
} from "../../data/portalData";
---

<BaseLayout 
  title="Portal Admin & Database Administrasi" 
  description="Dashboard petugas loket dan sistem database utama administrasi Fakultas Pertanian INSTIPER Yogyakarta."
  isStandaloneAdmin={true}
>
  
  <!-- ============================================================
       1. TAMPILAN LOGIN KHUSUS ADMIN (Simple & Professional)
       ============================================================ -->
  <section id="admin-login-view" class="min-h-screen flex items-center justify-center p-6 bg-slate-50">
    <div class="w-full max-w-md rounded-3xl border border-slate-200/90 bg-white p-8 sm:p-10 shadow-xl relative overflow-hidden">
      <!-- Decorative top emerald strip -->
      <div class="absolute top-0 inset-x-0 h-2 bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700"></div>

      <div class="text-center">
        <!-- Logo Murni INSTIPER Tanpa Kotak/Lingkaran Putih -->
        <a href="/" class="mx-auto inline-flex flex-col items-center justify-center group cursor-pointer" title="Kembali ke Beranda FAPERTA">
          <img 
            src="/logo-instiper.webp" 
            alt="Logo INSTIPER" 
            width="64" 
            height="64" 
            class="h-16 w-16 object-contain group-hover:scale-105 transition-transform" 
          />
          <h1 class="mt-3 text-2xl font-black text-slate-900 tracking-tight group-hover:text-emerald-700 transition-colors">
            FAPERTA INSTIPER
          </h1>
        </a>
        <div class="mt-2.5 inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800 border border-emerald-200">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Portal Administrasi Terpadu</span>
        </div>
        <p class="text-xs text-slate-500 mt-2 leading-relaxed">
          Pusat kontrol loket berkas akademik dan database administrasi terpadu Fakultas Pertanian.
        </p>
      </div>

      <!-- Form Login Admin -->
      <form id="admin-login-form" class="mt-8 space-y-4 text-left">
        <!-- Error Alert -->
        <div id="login-error-alert" class="hidden p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 font-medium flex items-center gap-2">
          <span>⚠️</span>
          <span><strong>ID atau Kata Sandi salah!</strong> Silakan periksa kembali kredensial Anda.</span>
        </div>

        <div>
          <label for="admin-user-input" class="block text-xs font-bold text-slate-700 mb-1.5">
            ID Petugas Administrasi:
          </label>
          <div class="flex items-center rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 focus-within:border-emerald-600 focus-within:bg-white focus-within:ring-2 focus-within:ring-emerald-600/20 transition">
            <span class="text-slate-400 mr-2.5 text-sm">👤</span>
            <input 
              type="text" 
              id="admin-user-input" 
              required
              placeholder="Contoh: agrotek" 
              class="w-full bg-transparent text-sm text-slate-900 placeholder:text-slate-400 outline-none border-none font-medium"
              autocomplete="username"
            />
          </div>
        </div>

        <div>
          <label for="admin-pass-input" class="block text-xs font-bold text-slate-700 mb-1.5">
            Kata Sandi:
          </label>
          <div class="flex items-center rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 focus-within:border-emerald-600 focus-within:bg-white focus-within:ring-2 focus-within:ring-emerald-600/20 transition">
            <span class="text-slate-400 mr-2.5 text-sm">🔑</span>
            <input 
              type="password" 
              id="admin-pass-input" 
              required
              placeholder="••••••••" 
              class="w-full bg-transparent text-sm text-slate-900 placeholder:text-slate-400 outline-none border-none font-medium"
              autocomplete="current-password"
            />
            <button 
              type="button" 
              id="btn-toggle-pass" 
              class="text-xs text-slate-400 hover:text-emerald-700 font-bold ml-2 select-none cursor-pointer"
            >
              Lihat
            </button>
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-bold text-sm py-3 flex items-center justify-center gap-2 mt-4 shadow-md shadow-emerald-900/15 transition cursor-pointer"
        >
          <span>Masuk Sistem Administrasi</span>
          <span>→</span>
        </button>
      </form>

      <!-- Footer Keamanan & Akses Resmi -->
      <div class="mt-6 pt-5 border-t border-slate-100 text-center text-xs text-slate-400">
        <p class="font-medium text-slate-500">Sistem Informasi Layanan & Loket Akademik Terpadu</p>
        <p class="text-[11px] text-slate-400 mt-0.5">Fakultas Pertanian • INSTIPER Yogyakarta</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. TAMPILAN DASHBOARD & DATABASE ADMIN (Desktop Fit & Pro)
       ============================================================ -->
  <div id="admin-dashboard-view" class="hidden flex-1 bg-slate-50 min-h-screen border-b border-slate-200">
    
    <!-- Top System Header Bar (Logo INSTIPER disesuaikan, Live Clock & Status Loket) -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-2xs">
      <div class="w-full px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-4">
        
        <!-- Left: Logo INSTIPER Disesuaikan & Title (Klik kembali ke Beranda) -->
        <a href="/" class="flex items-center gap-3.5 group cursor-pointer hover:opacity-95 transition" title="Kembali ke Beranda FAPERTA">
          <img 
            src="/logo-instiper.webp" 
            alt="Logo INSTIPER" 
            width="40" 
            height="40" 
            class="h-10 w-10 object-contain shrink-0 drop-shadow-xs group-hover:scale-105 transition-transform" 
          />
          <div class="flex flex-col text-left">
            <div class="flex items-center gap-2">
              <h1 class="text-base font-black text-slate-900 tracking-tight leading-none group-hover:text-emerald-700 transition-colors">
                FAPERTA INSTIPER
              </h1>
              <span id="header-role-badge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Portal Administrasi Loket
              </span>
            </div>
            <p class="text-[11px] text-slate-500 font-medium mt-1">
              Fakultas Pertanian • Gedung A Lantai 1
            </p>
          </div>
        </a>

        <!-- Right: Real-time Live Clock & Date Widget -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2.5 bg-slate-50 px-3.5 py-2 rounded-xl border border-slate-200 text-xs text-slate-700">
            <span class="text-slate-400">📅</span>
            <span id="live-calendar" class="font-medium">Jumat, 4 September 2026</span>
            <span class="text-slate-300">|</span>
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="live-clock" class="font-mono font-bold text-emerald-700">--:--:-- WIB</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Container: Full width for desktop monitors -->
    <div class="w-full px-6 lg:px-8 py-6">
      <div class="grid lg:grid-cols-[280px_1fr] gap-8 items-start">
        
        <!-- ============================================================
             SIDEBAR KIRI (Rata Kiri, Rapi, & Jarak Elemen Nyaman)
             ============================================================ -->
        <aside class="space-y-6 lg:sticky lg:top-20">
          
          <!-- Box Navigasi Utama -->
          <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs space-y-6 text-left">
            
            <!-- BAGIAN 1: KATEGORI BERKAS (Lebih Besar & Jelas) -->
            <div>
              <div class="flex items-center justify-between mb-3 px-1">
                <span class="text-xs font-black uppercase tracking-wider text-slate-400 block text-left">
                  Kategori Berkas
                </span>
                <span class="text-[10px] text-emerald-800 font-bold bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100">
                  Real-time
                </span>
              </div>
              <nav class="space-y-2" aria-label="Kategori Berkas Loket">
                <!-- 1. Semua Dokumen Masuk -->
                <button 
                  type="button" 
                  data-case="all" 
                  class="admin-case-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer bg-gradient-to-r from-emerald-600 to-emerald-700 text-white shadow-md shadow-emerald-900/15 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-lg">📋</span>
                    <span>Semua Dokumen</span>
                  </div>
                  <span id="badge-cat-all" class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-white/20 text-white font-black">0</span>
                </button>

                <!-- 2. Permohonan KHS -->
                <button 
                  type="button" 
                  data-case="khs" 
                  class="admin-case-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-lg">📄</span>
                    <span>Permohonan KHS</span>
                  </div>
                  <span id="badge-count-khs" class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-slate-100 text-slate-700 font-bold">0</span>
                </button>

                <!-- 3. Pengajuan Ujian Khusus -->
                <button 
                  type="button" 
                  data-case="ujian" 
                  class="admin-case-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-lg">🎓</span>
                    <span>Ujian Khusus</span>
                  </div>
                  <span id="badge-count-ujian" class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-slate-100 text-slate-700 font-bold">0</span>
                </button>

                <!-- 4. Komplain Nilai -->
                <button 
                  type="button" 
                  data-case="komplain" 
                  class="admin-case-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-lg">⚖️</span>
                    <span>Komplain Nilai</span>
                  </div>
                  <span id="badge-count-komplain" class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-slate-100 text-slate-700 font-bold">0</span>
                </button>

                <!-- 5. Surat Izin Penelitian -->
                <button 
                  type="button" 
                  data-case="penelitian" 
                  class="admin-case-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-lg">📑</span>
                    <span>Izin Penelitian</span>
                  </div>
                  <span id="badge-count-penelitian" class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-slate-100 text-slate-700 font-bold">0</span>
                </button>

                <!-- 6. Layanan Lainnya -->
                <button 
                  type="button" 
                  data-case="lainnya" 
                  class="admin-case-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-lg">📁</span>
                    <span>Layanan Lainnya</span>
                  </div>
                  <span id="badge-count-lainnya" class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-slate-100 text-slate-700 font-bold">0</span>
                </button>
              </nav>
            </div>

            <!-- BAGIAN 2: DATA MASTER DAN REKAP & LAPORAN -->
            <div class="border-t border-slate-100 pt-5">
              <span class="text-xs font-black uppercase tracking-wider text-slate-400 block mb-3 px-1 text-left">
                Data Master & Rekap
              </span>
              <nav class="space-y-2" aria-label="Menu Data Master dan Rekap">
                <!-- Data Master (Database Administrasi) -->
                <button 
                  type="button" 
                  id="tab-btn-database" 
                  class="admin-main-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-lg">🗄️</span>
                    <span>Data Master</span>
                  </div>
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 text-emerald-800">MASTER</span>
                </button>

                <!-- Rekap dan Laporan -->
                <button 
                  type="button" 
                  id="tab-btn-rekap" 
                  class="admin-main-tab w-full flex items-center justify-between px-4 py-3.5 rounded-2xl text-sm font-bold transition cursor-pointer text-slate-700 hover:bg-slate-100 hover:text-emerald-800 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="text-lg">📊</span>
                    <span>Rekap & Laporan</span>
                  </div>
                  <span class="text-slate-400 text-sm">→</span>
                </button>
              </nav>
            </div>

            <!-- SYSTEM CONTROLS (Tandai Terbaca) -->
            <div class="border-t border-slate-100 pt-4">
              <button 
                id="btn-mark-all-read" 
                type="button" 
                class="w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 hover:text-emerald-800 transition flex items-center gap-2 cursor-pointer"
              >
                <span>✓</span>
                <span>Tandai Semua Berkas Terbaca</span>
              </button>
            </div>
          </div>

          <!-- Profil Petugas Box (Bawah Sidebar: Admin) -->
          <div class="rounded-3xl border border-slate-200 bg-white p-4 shadow-xs flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div id="user-avatar-initial" class="h-10 w-10 rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white flex items-center justify-center font-black text-sm shadow-xs">
                A
              </div>
              <div class="text-left">
                <span id="user-role-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block leading-none">Petugas Loket</span>
                <strong id="user-name-display" class="text-sm font-black text-slate-900 block mt-0.5">Admin</strong>
                <span id="user-loket-display" class="text-[10px] text-emerald-700 font-bold block">Administrator Loket</span>
              </div>
            </div>
            <button 
              id="btn-admin-logout" 
              type="button" 
              class="p-2.5 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer"
              title="Keluar dari Portal Admin"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </button>
          </div>
        </aside>

        <!-- ============================================================
             WORKSPACE UTAMA (KANAN - FIT SCREEN & COMFORTABLE)
             ============================================================ -->
        <main class="space-y-6 text-left">
          
          <!-- ========================================================
               VIEW 1: DAFTAR BERKAS MASUK (DASHBOARD PEMROSESAN)
               ======================================================== -->
          <div id="view-berkas-container" class="space-y-6">
            
            <!-- Workspace Header Bar -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2.5">
                  <h2 id="active-category-title" class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                    Semua Berkas Masuk
                  </h2>
                  <span id="filtered-count-badge" class="px-3 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-800 border border-emerald-200">
                    0 Berkas
                  </span>
                </div>
                <p class="text-xs text-slate-500 mt-1">
                  Pusat verifikasi dan disposisi posisi berkas fisik loket administrasi FAPERTA INSTIPER.
                </p>
              </div>

              <!-- Controls: Toggle Sembunyikan yang Sudah Diambil + Search -->
              <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <label class="inline-flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-xs font-bold text-slate-700 cursor-pointer select-none hover:bg-slate-100 transition shadow-2xs">
                  <input type="checkbox" id="toggle-hide-taken" checked class="w-4 h-4 text-emerald-600 rounded focus:ring-emerald-500" />
                  <span>Sembunyikan yang Sudah Diambil</span>
                </label>

                <!-- Quick Search Input -->
                <div class="sm:w-64">
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 text-xs">
                      🔍
                    </span>
                    <input 
                      type="text" 
                      id="admin-search-input" 
                      placeholder="Cari NIM, Nama, atau Kode..." 
                      class="w-full rounded-2xl border border-slate-200 bg-slate-50/70 pl-9 pr-3.5 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-emerald-600 focus:bg-white focus:ring-2 focus:ring-emerald-600/20 outline-none font-medium transition"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- Interactive KPI Status Cards (Klik untuk Langsung Filter & Lihat Berkas) -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" role="region" aria-label="Filter Cepat Status Berkas">
              <button 
                type="button" 
                data-kpi-filter="all"
                class="kpi-status-card group w-full text-left rounded-2xl border-2 border-slate-300 bg-white p-4 shadow-2xs hover:shadow-md hover:border-slate-500 active:scale-[0.98] transition-all cursor-pointer flex items-center gap-3.5 relative overflow-hidden ring-2 ring-emerald-600 ring-offset-2"
                title="Klik untuk melihat semua berkas"
              >
                <div class="h-11 w-11 rounded-xl bg-slate-100 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition-transform">
                  📋
                </div>
                <div>
                  <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total Berkas</p>
                  <p id="stat-total" class="text-xl font-black text-slate-900 leading-none mt-0.5">0</p>
                  <span class="text-[9px] text-slate-400 font-semibold mt-1 block">Klik untuk lihat</span>
                </div>
              </button>

              <button 
                type="button" 
                data-kpi-filter="Belum Diproses"
                class="kpi-status-card group w-full text-left rounded-2xl border-2 border-amber-200 bg-amber-50/60 p-4 shadow-2xs hover:shadow-md hover:border-amber-400 active:scale-[0.98] transition-all cursor-pointer flex items-center gap-3.5 relative overflow-hidden"
                title="Klik untuk melihat berkas belum diproses"
              >
                <div class="h-11 w-11 rounded-xl bg-amber-100 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition-transform">
                  ⏳
                </div>
                <div>
                  <p class="text-[10px] font-bold text-amber-800 uppercase tracking-wider">Belum Diproses</p>
                  <p id="stat-pending" class="text-xl font-black text-amber-900 leading-none mt-0.5">0</p>
                  <span class="text-[9px] text-amber-700/80 font-semibold mt-1 block">Klik untuk lihat</span>
                </div>
              </button>

              <button 
                type="button" 
                data-kpi-filter="Proses Verifikasi"
                class="kpi-status-card group w-full text-left rounded-2xl border-2 border-blue-200 bg-blue-50/60 p-4 shadow-2xs hover:shadow-md hover:border-blue-400 active:scale-[0.98] transition-all cursor-pointer flex items-center gap-3.5 relative overflow-hidden"
                title="Klik untuk melihat berkas proses verifikasi"
              >
                <div class="h-11 w-11 rounded-xl bg-blue-100 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition-transform">
                  🔍
                </div>
                <div>
                  <p class="text-[10px] font-bold text-blue-800 uppercase tracking-wider">Verifikasi</p>
                  <p id="stat-process" class="text-xl font-black text-blue-900 leading-none mt-0.5">0</p>
                  <span class="text-[9px] text-blue-700/80 font-semibold mt-1 block">Klik untuk lihat</span>
                </div>
              </button>

              <button 
                type="button" 
                data-kpi-filter="Selesai (Siap Diambil)"
                class="kpi-status-card group w-full text-left rounded-2xl border-2 border-emerald-200 bg-emerald-50/60 p-4 shadow-2xs hover:shadow-md hover:border-emerald-400 active:scale-[0.98] transition-all cursor-pointer flex items-center gap-3.5 relative overflow-hidden"
                title="Klik untuk melihat berkas siap diambil"
              >
                <div class="h-11 w-11 rounded-xl bg-emerald-100 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition-transform">
                  ✅
                </div>
                <div>
                  <p class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider">Siap Diambil</p>
                  <p id="stat-done" class="text-xl font-black text-emerald-900 leading-none mt-0.5">0</p>
                  <span class="text-[9px] text-emerald-700/80 font-semibold mt-1 block">Klik untuk lihat</span>
                </div>
              </button>
            </div>

            <!-- Notice: Kebijakan Cetak Struk di Mahasiswa -->
            <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 flex items-center justify-between gap-3 text-xs text-emerald-900">
              <div class="flex items-center gap-2.5">
                <span class="text-base">ℹ️</span>
                <span><strong>Kebijakan Cetak Struk:</strong> Cetak tanda terima permohonan resmi dikhususkan langsung bagi <strong>Mahasiswa</strong> pada halaman Cek Status & Konfirmasi Pengajuan.</span>
              </div>
            </div>

            <!-- Daftar Berkas / Tickets Cards Container -->
            <div id="admin-tickets-container" class="space-y-4">
              <!-- Rendered by JavaScript -->
            </div>

            <!-- Empty State -->
            <div id="admin-empty-state" class="hidden rounded-3xl border-2 border-dashed border-slate-200 bg-white p-12 text-center">
              <span class="text-4xl">📂</span>
              <h3 class="mt-3 text-base font-bold text-slate-800">Tidak Ada Berkas Ditemukan</h3>
              <p class="mt-1 text-xs text-slate-500">
