  <!-- ============================================================
       SCRIPT DASHBOARD ADMIN TERPADU & DATABASE UTAMA
       ============================================================ -->
  <script is:inline define:vars={{ 
    initialDemoTickets: INITIAL_DEMO_TICKETS,
    masterMahasiswa: MASTER_MAHASISWA,
    masterDosen: MASTER_DOSEN,
    masterMatkul: MASTER_MATAKULIAH
  }}>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Autentikasi Admin State
      const loginView = document.getElementById('admin-login-view');
      const dashboardView = document.getElementById('admin-dashboard-view');
      const loginForm = document.getElementById('admin-login-form');
      const loginErrorAlert = document.getElementById('login-error-alert');
      const btnTogglePass = document.getElementById('btn-toggle-pass');
      const adminPassInput = document.getElementById('admin-pass-input');
      const btnLogout = document.getElementById('btn-admin-logout');

      function checkAuth() {
        const isAuth = sessionStorage.getItem('portal_admin_auth') === 'true';
        if (isAuth) {
          loginView?.classList.add('hidden');
          dashboardView?.classList.remove('hidden');
          initLiveClock();
          renderTicketsList();
          renderDatabaseTables();
        } else {
          loginView?.classList.remove('hidden');
          dashboardView?.classList.add('hidden');
        }
      }

      btnTogglePass?.addEventListener('click', () => {
        if (!adminPassInput) return;
        if (adminPassInput.type === 'password') {
          adminPassInput.type = 'text';
          btnTogglePass.textContent = 'Sembunyikan';
        } else {
          adminPassInput.type = 'password';
          btnTogglePass.textContent = 'Lihat';
        }
      });

      loginForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const u = (document.getElementById('admin-user-input')?.value || '').trim().toLowerCase();
        const p = (adminPassInput?.value || '').trim();

        if ((u === 'agrotek' || u === 'admin') && (p === 'agr001' || p === 'admin123')) {
          sessionStorage.setItem('portal_admin_auth', 'true');
          loginErrorAlert?.classList.add('hidden');
          checkAuth();
        } else {
          loginErrorAlert?.classList.remove('hidden');
        }
      });

      document.getElementById('btn-quick-login')?.addEventListener('click', () => {
        sessionStorage.setItem('portal_admin_auth', 'true');
        loginErrorAlert?.classList.add('hidden');
        checkAuth();
      });

      btnLogout?.addEventListener('click', () => {
        sessionStorage.removeItem('portal_admin_auth');
        checkAuth();
      });

      // 2. Realtime Clock & Indonesian Date (portal-ujian style)
      function initLiveClock() {
        const clockEl = document.getElementById('live-clock');
        const calEl = document.getElementById('live-calendar');
        
        function tick() {
          const now = new Date();
          if (clockEl) {
            clockEl.textContent = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WIB';
          }
          if (calEl) {
            calEl.textContent = now.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
          }
        }
        tick();
        setInterval(tick, 1000);
      }

      // 3. Storage Data Management
      function loadTickets() {
        try {
          const raw = localStorage.getItem('portal_faperta_tickets');
          if (raw) return JSON.parse(raw);
          localStorage.setItem('portal_faperta_tickets', JSON.stringify(initialDemoTickets));
          return [...initialDemoTickets];
        } catch (e) {
          return [...initialDemoTickets];
        }
      }

      function saveTickets(data) {
        try {
          localStorage.setItem('portal_faperta_tickets', JSON.stringify(data));
        } catch (e) {}
      }

      // 4. Main Navigation Tabs (Berkas vs Database vs Rekap)
      let currentMainView = 'berkas'; // berkas, database, rekap
      const tabBtnBerkas = document.getElementById('tab-btn-berkas');
      const tabBtnDatabase = document.getElementById('tab-btn-database');
      const tabBtnRekap = document.getElementById('tab-btn-rekap');

      const viewBerkas = document.getElementById('view-berkas-container');
      const viewDatabase = document.getElementById('view-database-container');
      const viewRekap = document.getElementById('view-rekap-container');

      const statusFilterBox = document.getElementById('sidebar-filter-status-box');
      const categoryFilterBox = document.getElementById('sidebar-filter-category-box');

      function setMainView(view) {
        currentMainView = view;
        const allMainBtns = [tabBtnBerkas, tabBtnDatabase, tabBtnRekap];
        allMainBtns.forEach(btn => {
          btn?.classList.remove('bg-gradient-to-r', 'from-emerald-600', 'to-emerald-700', 'text-white', 'shadow-md');
          btn?.classList.add('text-slate-700', 'hover:bg-slate-100');
        });

        viewBerkas?.classList.add('hidden');
        viewDatabase?.classList.add('hidden');
        viewRekap?.classList.add('hidden');

        if (view === 'berkas') {
          tabBtnBerkas?.classList.add('bg-gradient-to-r', 'from-emerald-600', 'to-emerald-700', 'text-white', 'shadow-md');
          tabBtnBerkas?.classList.remove('text-slate-700', 'hover:bg-slate-100');
          viewBerkas?.classList.remove('hidden');
          statusFilterBox?.classList.remove('hidden');
          categoryFilterBox?.classList.remove('hidden');
          renderTicketsList();
        } else if (view === 'database') {
          tabBtnDatabase?.classList.add('bg-gradient-to-r', 'from-emerald-600', 'to-emerald-700', 'text-white', 'shadow-md');
          tabBtnDatabase?.classList.remove('text-slate-700', 'hover:bg-slate-100');
          viewDatabase?.classList.remove('hidden');
          statusFilterBox?.classList.add('hidden');
          categoryFilterBox?.classList.add('hidden');
          renderDatabaseTables();
        } else if (view === 'rekap') {
          tabBtnRekap?.classList.add('bg-gradient-to-r', 'from-emerald-600', 'to-emerald-700', 'text-white', 'shadow-md');
          tabBtnRekap?.classList.remove('text-slate-700', 'hover:bg-slate-100');
          viewRekap?.classList.remove('hidden');
          statusFilterBox?.classList.add('hidden');
          categoryFilterBox?.classList.add('hidden');
          updateRekapStats();
        }
      }

      tabBtnBerkas?.addEventListener('click', () => setMainView('berkas'));
      tabBtnDatabase?.addEventListener('click', () => setMainView('database'));
      tabBtnRekap?.addEventListener('click', () => setMainView('rekap'));
      document.getElementById('btn-back-to-berkas')?.addEventListener('click', () => setMainView('berkas'));

      // 5. State Filter Berkas
      let currentCase = 'all'; // all, khs, komplain, ujian, lainnya
      let currentStatus = 'all'; // all, Belum Diproses, Proses Verifikasi, Selesai (Siap Diambil), Ditolak
      let searchQuery = '';

      const categoryTitleMap = {
        'all': 'Semua Berkas Masuk',
        'khs': 'Permohonan KHS Online',
        'komplain': 'Komplain & Verifikasi Nilai',
        'ujian': 'Pengajuan Ujian Khusus',
        'lainnya': 'Surat Izin & Lainnya'
      };

      function updateSidebarBadges(tickets) {
        const countAll = tickets.length;
        const countKhs = tickets.filter(t => (t.layananId || '').toLowerCase().includes('khs') || (t.kode || '').startsWith('KHS')).length;
        const countKomplain = tickets.filter(t => (t.layananId || '').toLowerCase().includes('komplain') || (t.kode || '').startsWith('KMP')).length;
        const countUjian = tickets.filter(t => (t.layananId || '').toLowerCase().includes('ujian') || (t.kode || '').startsWith('UKH')).length;
        const countLainnya = tickets.filter(t => {
          const id = (t.layananId || '').toLowerCase();
          const code = (t.kode || '').toUpperCase();
          return !id.includes('khs') && !id.includes('komplain') && !id.includes('ujian') && !code.startsWith('KHS') && !code.startsWith('KMP') && !code.startsWith('UKH');
        }).length;

        const bAll = document.getElementById('badge-count-all');
        const bCatAll = document.getElementById('badge-cat-all');
        const bKhs = document.getElementById('badge-count-khs');
        const bKomplain = document.getElementById('badge-count-komplain');
        const bUjian = document.getElementById('badge-count-ujian');
        const bLainnya = document.getElementById('badge-count-lainnya');

        if (bAll) bAll.textContent = countAll;
        if (bCatAll) bCatAll.textContent = countAll;
        if (bKhs) {
          bKhs.textContent = countKhs;
          bKhs.className = 'px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 text-slate-700 font-bold';
        }
        if (bKomplain) {
          bKomplain.textContent = countKomplain;
          bKomplain.className = 'px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 text-slate-700 font-bold';
        }
        if (bUjian) {
          bUjian.textContent = countUjian;
          bUjian.className = 'px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 text-slate-700 font-bold';
        }
        if (bLainnya) bLainnya.textContent = countLainnya;

        // Status counts
        const cntPending = tickets.filter(t => t.status === 'Belum Diproses').length;
        const cntProcess = tickets.filter(t => t.status === 'Proses Verifikasi').length;
        const cntDone = tickets.filter(t => t.status === 'Selesai (Siap Diambil)').length;
        const cntRejected = tickets.filter(t => t.status === 'Ditolak').length;

        const elStatAll = document.getElementById('stat-filter-all');
        const elStatPending = document.getElementById('stat-filter-pending');
        const elStatProcess = document.getElementById('stat-filter-process');
        const elStatDone = document.getElementById('stat-filter-done');
        const elStatRejected = document.getElementById('stat-filter-rejected');

        if (elStatAll) elStatAll.textContent = countAll;
        if (elStatPending) elStatPending.textContent = cntPending;
        if (elStatProcess) elStatProcess.textContent = cntProcess;
        if (elStatDone) elStatDone.textContent = cntDone;
        if (elStatRejected) elStatRejected.textContent = cntRejected;

        // KPI chips
        const kpiTotal = document.getElementById('stat-total');
        const kpiPending = document.getElementById('stat-pending');
        const kpiProcess = document.getElementById('stat-process');
        const kpiDone = document.getElementById('stat-done');

        if (kpiTotal) kpiTotal.textContent = countAll;
        if (kpiPending) kpiPending.textContent = cntPending;
        if (kpiProcess) kpiProcess.textContent = cntProcess;
        if (kpiDone) kpiDone.textContent = cntDone;
      }

      // 6. Render Daftar Berkas Masuk
      function renderTicketsList() {
        const all = loadTickets();
        updateSidebarBadges(all);

        let filtered = all.filter(t => {
          const id = (t.layananId || '').toLowerCase();
          const code = (t.kode || '').toUpperCase();
          if (currentCase === 'all') return true;
          if (currentCase === 'khs') return id.includes('khs') || code.startsWith('KHS');
          if (currentCase === 'komplain') return id.includes('komplain') || code.startsWith('KMP');
          if (currentCase === 'ujian') return id.includes('ujian') || code.startsWith('UKH');
          if (currentCase === 'lainnya') return !id.includes('khs') && !id.includes('komplain') && !id.includes('ujian') && !code.startsWith('KHS') && !code.startsWith('KMP') && !code.startsWith('UKH');
          return true;
        });

        if (currentStatus !== 'all') {
          filtered = filtered.filter(t => t.status === currentStatus);
        }

        if (searchQuery) {
          filtered = filtered.filter(t => 
            (t.kode || '').toLowerCase().includes(searchQuery) ||
            (t.nim || '').toLowerCase().includes(searchQuery) ||
            (t.nama || '').toLowerCase().includes(searchQuery) ||
            (t.keperluan || '').toLowerCase().includes(searchQuery)
          );
        }

        const titleEl = document.getElementById('active-category-title');
        const countBadge = document.getElementById('filtered-count-badge');
        if (titleEl) titleEl.textContent = categoryTitleMap[currentCase] || 'Berkas Masuk';
        if (countBadge) countBadge.textContent = `${filtered.length} Berkas`;

        const container = document.getElementById('admin-tickets-container');
        const emptyState = document.getElementById('admin-empty-state');
        if (!container) return;
        container.innerHTML = '';

        if (filtered.length === 0) {
          emptyState?.classList.remove('hidden');
          return;
        }
        emptyState?.classList.add('hidden');

        const statusConfig = {
          'Belum Diproses': { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-200', icon: '⏳' },
          'Proses Verifikasi': { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-200', icon: '🔍' },
          'Selesai (Siap Diambil)': { bg: 'bg-emerald-50', text: 'text-emerald-800', border: 'border-emerald-200', icon: '📦' },
          'Ditolak': { bg: 'bg-rose-50', text: 'text-rose-800', border: 'border-rose-200', icon: '❌' }
        };

        filtered.forEach(t => {
          const cfg = statusConfig[t.status] || statusConfig['Belum Diproses'];
          const card = document.createElement('div');
          card.className = 'rounded-3xl border border-slate-200 bg-white p-6 shadow-xs hover:border-emerald-600/60 transition text-left';

          card.innerHTML = `
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
              <div class="flex flex-wrap items-center gap-2.5">
                <span class="px-3 py-1 rounded-xl text-xs font-mono font-bold bg-slate-900 text-white">
                  ${t.kode}
                </span>
                <span class="px-3 py-1 rounded-xl text-xs font-bold border ${cfg.bg} ${cfg.text} ${cfg.border} flex items-center gap-1.5">
                  <span>${cfg.icon}</span>
                  <span>${t.status}</span>
                </span>
              </div>
              <div class="text-xs text-slate-500 flex items-center gap-2">
                <span>🗓️ ${t.tanggal || 'Hari Ini'}</span>
              </div>
            </div>

            <div class="mt-4 grid md:grid-cols-[1.2fr_1fr] gap-6 items-start">
              <div>
                <div class="flex items-start gap-3">
                  <div class="h-10 w-10 shrink-0 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-base border border-emerald-200">
                    🎓
                  </div>
                  <div>
                    <h3 class="text-base font-extrabold text-slate-900 leading-snug">${t.nama}</h3>
                    <p class="text-xs text-slate-500 font-mono mt-0.5">
                      NIM: <strong class="text-emerald-800 font-bold">${t.nim}</strong> · ${t.prodi} ${t.semester ? `(${t.semester})` : ''}
                    </p>
                  </div>
                </div>

                <div class="mt-4 bg-slate-50 rounded-2xl p-3.5 border border-slate-200/80 text-xs space-y-1">
                  <p class="font-bold text-emerald-800">${t.layananNama || 'Layanan Mahasiswa'}</p>
                  <p class="text-slate-700 leading-relaxed">${t.detailTambahan || t.keperluan}</p>
                </div>
              </div>

              <div class="space-y-3 text-xs bg-slate-50/50 rounded-2xl p-4 border border-slate-200/80">
                <div>
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Posisi Berkas Fisik:</span>
                  <p class="font-bold text-slate-900 mt-0.5 flex items-center gap-1.5">
                    <span>📍</span>
                    <span>${t.posisiBerkas || 'Antrean Masuk Loket FAPERTA'}</span>
                  </p>
                </div>

                ${t.catatanAdmin ? `
                  <div class="pt-2 border-t border-slate-200/60">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Catatan Petugas Loket:</span>
                    <p class="text-slate-700 italic mt-0.5">${t.catatanAdmin}</p>
                  </div>
                ` : ''}

                <div class="pt-3 border-t border-slate-200/60 flex items-center justify-between gap-2">
                  <button 
                    type="button" 
                    class="btn-open-edit w-full rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white text-xs py-2.5 px-4 font-bold shadow-xs cursor-pointer inline-flex items-center justify-center gap-1.5 transition"
                    data-kode="${t.kode}"
                  >
                    <span>✏️ Disposisi / Update Status</span>
                  </button>
                </div>
              </div>
            </div>
          `;

          container.appendChild(card);
        });

        attachCardListeners();
      }

      function attachCardListeners() {
        document.querySelectorAll('.btn-open-edit').forEach(btn => {
          btn.addEventListener('click', () => {
            const kode = btn.getAttribute('data-kode');
            if (kode) openEditModal(kode);
          });
        });
      }

      // 7. Modal Disposisi / Edit Status
      const modal = document.getElementById('edit-ticket-modal');
      const backdrop = document.getElementById('modal-backdrop');
      const btnCloseModal = document.getElementById('btn-close-modal');
      const btnCancelModal = document.getElementById('btn-cancel-modal');
      const modalForm = document.getElementById('modal-edit-form');

      const modalTitle = document.getElementById('modal-ticket-title');
      const modalCode = document.getElementById('modal-ticket-code');
      const modalSelectedStatus = document.getElementById('modal-selected-status');
      const modalPosisi = document.getElementById('modal-posisi-input');
      const modalCatatan = document.getElementById('modal-catatan-input');
      const modalStatusChoices = document.querySelectorAll('.modal-status-choice');

      function openEditModal(kode) {
        const all = loadTickets();
        const t = all.find(x => x.kode === kode);
        if (!t) return;

        if (modalTitle) modalTitle.textContent = `${t.kode} — ${t.nama} (${t.nim})`;
        if (modalCode) modalCode.value = t.kode;
        if (modalSelectedStatus) modalSelectedStatus.value = t.status;
        if (modalPosisi) modalPosisi.value = t.posisiBerkas || 'Antrean Masuk Loket Administrasi FAPERTA';
        if (modalCatatan) modalCatatan.value = t.catatanAdmin || '';

        updateModalStatusChoiceUI(t.status);

        backdrop?.classList.remove('hidden');
        modal?.classList.remove('hidden');
        requestAnimationFrame(() => {
          backdrop?.classList.remove('opacity-0');
          modal?.classList.remove('scale-95');
        });
      }

      function closeEditModal() {
        backdrop?.classList.add('opacity-0');
        modal?.classList.add('scale-95');
        setTimeout(() => {
          backdrop?.classList.add('hidden');
          modal?.classList.add('hidden');
        }, 200);
      }

      function updateModalStatusChoiceUI(status) {
        modalStatusChoices.forEach(btn => {
          const s = btn.getAttribute('data-target-status');
          if (s === status) {
            if (s === 'Belum Diproses') btn.className = 'modal-status-choice p-2.5 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-amber-500 text-white border-amber-600 shadow-xs ring-2 ring-amber-300';
            else if (s === 'Proses Verifikasi') btn.className = 'modal-status-choice p-2.5 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-blue-600 text-white border-blue-700 shadow-xs ring-2 ring-blue-300';
            else if (s === 'Selesai (Siap Diambil)') btn.className = 'modal-status-choice p-2.5 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-emerald-600 text-white border-emerald-700 shadow-xs ring-2 ring-emerald-300';
            else if (s === 'Ditolak') btn.className = 'modal-status-choice p-2.5 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-rose-600 text-white border-rose-700 shadow-xs ring-2 ring-rose-300';
          } else {
            btn.className = 'modal-status-choice p-2.5 rounded-xl border text-center font-bold transition flex flex-col items-center justify-center gap-1 cursor-pointer bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100';
          }
        });
      }

      modalStatusChoices.forEach(btn => {
        btn.addEventListener('click', () => {
          const s = btn.getAttribute('data-target-status');
          if (modalSelectedStatus) modalSelectedStatus.value = s;
          updateModalStatusChoiceUI(s);

          if (modalPosisi) {
            if (s === 'Belum Diproses') modalPosisi.value = 'Antrean Masuk Loket Administrasi FAPERTA';
            else if (s === 'Proses Verifikasi') modalPosisi.value = 'Meja Petugas Loket (Pemeriksaan SIAKAD & Dokumen Fisik)';
            else if (s === 'Selesai (Siap Diambil)') {
              modalPosisi.value = 'Loket 1 Administrasi FAPERTA (Gedung A, Lt. 1) - Siap Diambil';
              if (modalCatatan && (!modalCatatan.value || modalCatatan.value.includes('antrean'))) {
                modalCatatan.value = 'Dokumen fisik resmi berstempel basah sudah selesai. Silakan ambil di Loket 1 dengan membawa KTM asli.';
              }
            }
            else if (s === 'Ditolak') {
              modalPosisi.value = 'Ditolak Petugas Loket';
              if (modalCatatan && !modalCatatan.value.toLowerCase().includes('ditolak')) {
                modalCatatan.value = 'Ditolak: [Tuliskan alasan perbaikan berkas di sini]';
              }
            }
          }
        });
      });

      document.querySelectorAll('.preset-posisi').forEach(btn => {
        btn.addEventListener('click', () => {
          if (modalPosisi) modalPosisi.value = btn.getAttribute('data-pos') || '';
        });
      });

      btnCloseModal?.addEventListener('click', closeEditModal);
      btnCancelModal?.addEventListener('click', closeEditModal);
      backdrop?.addEventListener('click', closeEditModal);

      modalForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const kode = modalCode?.value;
        const newStatus = modalSelectedStatus?.value;
        const newPosisi = modalPosisi?.value;
        const newCatatan = modalCatatan?.value;

        const all = loadTickets();
        const target = all.find(x => x.kode === kode);
        if (target) {
          target.status = newStatus;
          target.posisiBerkas = newPosisi;
          target.catatanAdmin = newCatatan;
          target.isNewForAdmin = false;

          if (newStatus === 'Belum Diproses') target.statusStep = 1;
          else if (newStatus === 'Proses Verifikasi') target.statusStep = 2;
          else if (newStatus === 'Selesai (Siap Diambil)') {
            target.statusStep = 3;
            target.estimasiSelesai = 'Selesai (Silakan Ambil di Loket)';
          }
          else if (newStatus === 'Ditolak') {
            target.statusStep = -1;
            target.estimasiSelesai = '-';
          }

          saveTickets(all);
          closeEditModal();
          renderTicketsList();
          renderDatabaseTables(); // sync arsip table
        }
      });

      // 8. DATABASE UTAMA ADMINISTRASI (Requirement #2 & #3)
      let activeDbTab = 'mahasiswa';
      let dbSearchQuery = '';

      const dbSubTabs = document.querySelectorAll('.db-sub-tab');
      const dbPanes = document.querySelectorAll('.db-pane');
      const dbSearchInput = document.getElementById('db-search-input');

      dbSubTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-db-tab');
          activeDbTab = target;
          
          dbSubTabs.forEach(t => {
            t.className = 'db-sub-tab px-3.5 py-2 rounded-xl text-xs font-bold transition text-slate-600 hover:text-slate-900 cursor-pointer';
          });
          tab.className = 'db-sub-tab px-3.5 py-2 rounded-xl text-xs font-bold transition bg-white text-emerald-800 shadow-2xs cursor-pointer';

          dbPanes.forEach(p => p.classList.add('hidden'));
          document.getElementById(`pane-${target}`)?.classList.remove('hidden');
          renderDatabaseTables();
        });
      });

      dbSearchInput?.addEventListener('input', (e) => {
        dbSearchQuery = e.target.value.trim().toLowerCase();
        renderDatabaseTables();
      });

      function renderDatabaseTables() {
        const query = dbSearchQuery;

        // 1. Table Mahasiswa
        const mhsBody = document.getElementById('table-mahasiswa-body');
        if (mhsBody) {
          let mhsList = masterMahasiswa.filter(m => 
            !query ||
            m.nim.toLowerCase().includes(query) ||
            m.nama.toLowerCase().includes(query) ||
            m.prodi.toLowerCase().includes(query) ||
            (m.dpa && m.dpa.toLowerCase().includes(query))
          );
          
          mhsBody.innerHTML = mhsList.map(m => `
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3 px-4 font-mono font-bold text-emerald-800">${m.nim}</td>
              <td class="py-3 px-4 font-bold text-slate-900">${m.nama}</td>
              <td class="py-3 px-4 text-slate-600">${m.prodi}</td>
              <td class="py-3 px-4 text-slate-500">${m.minat || '-'}</td>
              <td class="py-3 px-4 font-mono text-slate-600">${m.angkatan}</td>
              <td class="py-3 px-4 text-slate-600">${m.semester}</td>
              <td class="py-3 px-4 text-slate-700 font-medium">${m.dpa || '-'}</td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 text-emerald-800">
                  ${m.statusAkademik}
                </span>
              </td>
              <td class="py-3 px-4 text-right">
                <button type="button" class="btn-check-mhs text-[11px] font-bold text-emerald-700 hover:text-emerald-900 underline cursor-pointer" data-nim="${m.nim}">
                  Cek Berkas
                </button>
              </td>
            </tr>
          `).join('');

          mhsBody.querySelectorAll('.btn-check-mhs').forEach(btn => {
            btn.addEventListener('click', () => {
              const nim = btn.getAttribute('data-nim');
              setMainView('berkas');
              const searchInp = document.getElementById('admin-search-input');
              if (searchInp) searchInp.value = nim;
              searchQuery = nim.toLowerCase();
              renderTicketsList();
            });
          });
        }

        // 2. Table Dosen (Sesuai Permintaan: Cukup Nama Lengkap & Gelar serta Program Studi saja)
        const dsnBody = document.getElementById('table-dosen-body');
        if (dsnBody) {
          let dsnList = masterDosen.filter(d => 
            !query ||
            d.nama.toLowerCase().includes(query) ||
            d.prodi.toLowerCase().includes(query)
          );

          dsnBody.innerHTML = dsnList.map((d, idx) => `
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3.5 px-6 text-center font-mono font-bold text-slate-400">${idx + 1}</td>
              <td class="py-3.5 px-6 font-bold text-slate-900 text-sm">${d.nama}</td>
              <td class="py-3.5 px-6 text-slate-600 font-medium text-xs">${d.prodi}</td>
            </tr>
          `).join('');
        }

        // 3. Table Matkul
        const mkBody = document.getElementById('table-matkul-body');
        if (mkBody) {
          let mkList = masterMatkul.filter(m => 
            !query ||
            m.kode.toLowerCase().includes(query) ||
            m.nama.toLowerCase().includes(query) ||
            m.prodi.toLowerCase().includes(query) ||
            m.dosenPengampu.toLowerCase().includes(query)
          );

          mkBody.innerHTML = mkList.map(m => `
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3 px-4 font-mono font-bold text-emerald-800">${m.kode}</td>
              <td class="py-3 px-4 font-bold text-slate-900">${m.nama}</td>
              <td class="py-3 px-4 text-center font-mono font-bold">${m.sks} SKS</td>
              <td class="py-3 px-4 text-center font-mono text-slate-600">Sem ${m.semester}</td>
              <td class="py-3 px-4 text-slate-600">${m.prodi}</td>
              <td class="py-3 px-4 text-slate-700 font-medium">${m.dosenPengampu}</td>
            </tr>
          `).join('');
        }

        // 4. Table Arsip Seluruh Berkas
        const arsipBody = document.getElementById('table-arsip-body');
        if (arsipBody) {
          const allTickets = loadTickets();
          let arsipList = allTickets.filter(t => 
            !query ||
            t.kode.toLowerCase().includes(query) ||
            t.nim.toLowerCase().includes(query) ||
            t.nama.toLowerCase().includes(query) ||
            (t.layananNama && t.layananNama.toLowerCase().includes(query)) ||
            (t.posisiBerkas && t.posisiBerkas.toLowerCase().includes(query))
          );

          arsipBody.innerHTML = arsipList.map(t => `
            <tr class="hover:bg-slate-50/80 transition">
              <td class="py-3 px-4 font-mono font-bold text-slate-900">${t.kode}</td>
              <td class="py-3 px-4">
                <strong class="text-slate-900 block">${t.nama}</strong>
                <span class="font-mono text-[11px] text-emerald-800">${t.nim}</span>
              </td>
              <td class="py-3 px-4 text-slate-600">${t.prodi || '-'}</td>
              <td class="py-3 px-4 text-slate-800 font-medium">${t.layananNama || '-'}</td>
              <td class="py-3 px-4 text-[11px] text-slate-500">${t.tanggal || '-'}</td>
              <td class="py-3 px-4 text-slate-700">${t.posisiBerkas || '-'}</td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-bold ${
                  t.status === 'Selesai (Siap Diambil)' ? 'bg-emerald-100 text-emerald-800' :
                  t.status === 'Proses Verifikasi' ? 'bg-blue-100 text-blue-800' :
                  t.status === 'Ditolak' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-900'
                }">
                  ${t.status}
                </span>
              </td>
            </tr>
          `).join('');
        }
      }

      // 9. Event Listeners Sidebar Filter Status & Kategori
      const caseTabs = document.querySelectorAll('.admin-case-tab');
      caseTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          caseTabs.forEach(x => {
            x.className = 'admin-case-tab w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-700 hover:bg-slate-50 text-left';
          });
          tab.className = 'admin-case-tab w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition cursor-pointer bg-slate-100 text-slate-900 font-black text-left';

          currentCase = tab.getAttribute('data-case') || 'all';
          renderTicketsList();
        });
      });

      const statusFilters = document.querySelectorAll('.admin-status-filter');
      statusFilters.forEach(btn => {
        btn.addEventListener('click', () => {
          statusFilters.forEach(x => {
            x.classList.remove('bg-emerald-50', 'text-emerald-800');
          });
          btn.classList.add('bg-emerald-50', 'text-emerald-800');

          currentStatus = btn.getAttribute('data-status') || 'all';
          renderTicketsList();
        });
      });

      const searchInput = document.getElementById('admin-search-input');
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        renderTicketsList();
      });

      const btnMarkAll = document.getElementById('btn-mark-all-read');
      btnMarkAll?.addEventListener('click', () => {
        const all = loadTickets();
        all.forEach(t => { t.isNewForAdmin = false; });
        saveTickets(all);
        renderTicketsList();
      });

      // 10. Ekspor CSV Rekap Data (Tersedia di Modul Rekap & Laporan)
      function triggerExportCSV() {
        const all = loadTickets();
        const headers = ['Kode Tiket', 'NIM', 'Nama Mahasiswa', 'Program Studi', 'Layanan', 'Status', 'Posisi Berkas Fisik', 'Tanggal Pengajuan'];
        const rows = all.map(t => [
          `"${t.kode}"`,
          `"${t.nim}"`,
          `"${t.nama}"`,
          `"${t.prodi || ''}"`,
          `"${t.layananNama || ''}"`,
          `"${t.status}"`,
          `"${t.posisiBerkas || ''}"`,
          `"${t.tanggal || ''}"`
        ]);
        const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', `rekap-administrasi-faperta-${new Date().toISOString().slice(0,10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }

      document.getElementById('btn-rekap-download-csv')?.addEventListener('click', triggerExportCSV);

      function updateRekapStats() {
        const all = loadTickets();
        const cntPending = all.filter(t => t.status === 'Belum Diproses').length;
        const cntProcess = all.filter(t => t.status === 'Proses Verifikasi').length;
        const cntDone = all.filter(t => t.status === 'Selesai (Siap Diambil)').length;

        const elTot = document.getElementById('rekap-total');
        const elPen = document.getElementById('rekap-pending');
        const elPro = document.getElementById('rekap-process');
        const elDon = document.getElementById('rekap-done');

        if (elTot) elTot.textContent = all.length;
        if (elPen) elPen.textContent = cntPending;
        if (elPro) elPro.textContent = cntProcess;
        if (elDon) elDon.textContent = cntDone;
      }

      // 11. Reset Demo Data
      const btnReset = document.getElementById('btn-reset-demo');
      btnReset?.addEventListener('click', () => {
        if (confirm('Kembalikan data permohonan ke daftar contoh demo awal?')) {
          localStorage.removeItem('portal_faperta_tickets');
          renderTicketsList();
          renderDatabaseTables();
        }
      });

      // Jalankan cek status auth awal
      checkAuth();
    });
  </script>
</BaseLayout>
