      // Helper Ekstraksi Informasi Tanggal Berkas Secara Akurat
      function getTicketDateInfo(t) {
        const str = t.tanggal || '';
        const monthsMap = {
          'januari': 0, 'februari': 1, 'maret': 2, 'april': 3, 'mei': 4, 'juni': 5,
          'juli': 6, 'agustus': 7, 'september': 8, 'oktober': 9, 'november': 10, 'desember': 11
        };

        const m = str.match(/(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})/);
        if (m) {
          const day = parseInt(m[1], 10);
          const monthName = m[2];
          const year = parseInt(m[3], 10);
          const monthIndex = monthsMap[monthName.toLowerCase()] ?? 8;
          const dateObj = new Date(year, monthIndex, day);
          const dateKey = `${year}-${String(monthIndex + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          const displayDate = `${day} ${monthName} ${year}`;
          
          const timeMatch = str.match(/(\d{1,2}[:.]\d{2})/);
          const timeStr = timeMatch ? (timeMatch[1] + ' WIB') : '-';

          return {
            day, monthName, year, monthIndex,
            timestamp: dateObj.getTime(),
            dateKey, displayDate, timeStr
          };
        }

        // Fallback jika format berbeda
        let ts = Date.now();
        if (t.sudahDiambilAt) ts = t.sudahDiambilAt;
        const d = new Date(ts);
        const day = d.getDate();
        const monthName = d.toLocaleDateString('id-ID', { month: 'long' });
        const year = d.getFullYear();
        const dateKey = `${year}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const displayDate = `${day} ${monthName} ${year}`;
        const timeStr = d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';

        return {
          day, monthName, year, monthIndex: d.getMonth(),
          timestamp: ts,
          dateKey, displayDate, timeStr
        };
      }

      function renderDatabaseTables() {
        // 1. Render Master Pelayanan Berkas (Pemisah per Hari, Sort Prodi & Case)
        const masterTableBody = document.getElementById('table-master-layanan-body');
        const allTickets = loadTickets();

        // Hitung KPI Waktu (Hari Ini, Kemarin, Minggu Ini, Bulan Ini, Total)
        const now = new Date();
        const todayDateStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
        const yesterdayObj = new Date(now.getTime() - 24 * 60 * 60 * 1000);
        const yesterdayDateStr = yesterdayObj.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
        const sevenDaysAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000;
        const currentMonthName = now.toLocaleDateString('id-ID', { month: 'long' }).toLowerCase();
        const currentYear = now.getFullYear();

        let cntToday = 0;
        let cntYesterday = 0;
        let cntWeek = 0;
        let cntMonth = 0;

        allTickets.forEach(t => {
          const dInfo = getTicketDateInfo(t);
          if (dInfo.displayDate.toLowerCase() === todayDateStr.toLowerCase()) cntToday++;
          if (dInfo.displayDate.toLowerCase() === yesterdayDateStr.toLowerCase()) cntYesterday++;
          if (dInfo.timestamp && dInfo.timestamp >= sevenDaysAgo) cntWeek++;
          if (dInfo.year === currentYear && dInfo.monthName.toLowerCase() === currentMonthName) cntMonth++;
        });

        const elToday = document.getElementById('kpi-db-today');
        const elYesterday = document.getElementById('kpi-db-yesterday');
        const elWeek = document.getElementById('kpi-db-week');
        const elMonth = document.getElementById('kpi-db-month');
        const elTotal = document.getElementById('kpi-db-total');

        if (elToday) elToday.textContent = `${cntToday} Layanan`;
        if (elYesterday) elYesterday.textContent = `${cntYesterday} Layanan`;
        if (elWeek) elWeek.textContent = `${cntWeek} Layanan`;
        if (elMonth) elMonth.textContent = `${cntMonth} Layanan`;
        if (elTotal) elTotal.textContent = `${allTickets.length} Layanan`;

        // Update live counter badges in left sidebar
        const elNavLayanan = document.getElementById('badge-nav-layanan');
        const elNavMhs = document.getElementById('badge-nav-mahasiswa');
        const elNavPengambilan = document.getElementById('badge-nav-pengambilan');
        if (elNavLayanan) elNavLayanan.textContent = allTickets.length;
        if (elNavMhs) elNavMhs.textContent = loadMasterMahasiswa().length;
        if (elNavPengambilan) elNavPengambilan.textContent = allTickets.filter(t => t.sudahDiambil).length;

        if (masterTableBody) {
          // Filter tickets
          let filtered = allTickets;

          // Filter Search Query (NIM, Nama, Kode, Layanan, Posisi, Catatan, Tanggal)
          if (dbMasterSearchQuery) {
            filtered = filtered.filter(t => 
              (t.kode || '').toLowerCase().includes(dbMasterSearchQuery) ||
              (t.nim || '').toLowerCase().includes(dbMasterSearchQuery) ||
              (t.nama || '').toLowerCase().includes(dbMasterSearchQuery) ||
              (t.layananNama || '').toLowerCase().includes(dbMasterSearchQuery) ||
              (t.posisiBerkas || '').toLowerCase().includes(dbMasterSearchQuery) ||
              (t.catatanAdmin || '').toLowerCase().includes(dbMasterSearchQuery) ||
              (t.tanggal || '').toLowerCase().includes(dbMasterSearchQuery)
            );
          }

          // Filter Program Studi
          if (dbFilterProdi !== 'all') {
            filtered = filtered.filter(t => (t.prodi || '').toLowerCase() === dbFilterProdi.toLowerCase());
          }

          // Filter Case / Skenario Layanan
          if (dbFilterCase !== 'all') {
            filtered = filtered.filter(t => isTicketInCategory(t, dbFilterCase));
          }

          // Filter Status
          if (dbFilterStatus !== 'all') {
            if (dbFilterStatus === 'Proses Verifikasi') {
              filtered = filtered.filter(t => t.status === 'Proses Verifikasi' || t.status === 'Verifikasi Admin Loket' || t.status.includes('Dosen'));
            } else if (dbFilterStatus === 'Sudah Diambil') {
              filtered = filtered.filter(t => t.sudahDiambil);
            } else {
              filtered = filtered.filter(t => t.status === dbFilterStatus);
            }
          }

          // Filter Tanggal Spesifik (Poin 2: Tracking Surat Lampau)
          let isDateFilterActive = false;
          let dateFilterLabel = '';

          if (dbFilterDate) {
            isDateFilterActive = true;
            // Parse dbFilterDate (YYYY-MM-DD) into Indonesian formatted date
            const parts = dbFilterDate.split('-');
            if (parts.length === 3) {
              const y = parseInt(parts[0], 10);
              const m = parseInt(parts[1], 10) - 1;
              const d = parseInt(parts[2], 10);
              const dateObj = new Date(y, m, d);
              dateFilterLabel = dateObj.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
            } else {
              dateFilterLabel = dbFilterDate;
            }

            filtered = filtered.filter(t => {
              const dInfo = getTicketDateInfo(t);
              return dInfo.dateKey === dbFilterDate;
            });
          } else if (dbFilterPeriod === 'today') {
            isDateFilterActive = true;
            dateFilterLabel = `Hari Ini (${todayDateStr})`;
            filtered = filtered.filter(t => {
              const dInfo = getTicketDateInfo(t);
              return dInfo.displayDate.toLowerCase() === todayDateStr.toLowerCase();
            });
          } else if (dbFilterPeriod === 'yesterday') {
            isDateFilterActive = true;
            dateFilterLabel = `Kemarin (${yesterdayDateStr})`;
            filtered = filtered.filter(t => {
              const dInfo = getTicketDateInfo(t);
              return dInfo.displayDate.toLowerCase() === yesterdayDateStr.toLowerCase();
            });
          } else if (dbFilterPeriod === 'week') {
            isDateFilterActive = true;
            dateFilterLabel = '7 Hari Terakhir';
            filtered = filtered.filter(t => {
              const dInfo = getTicketDateInfo(t);
              return dInfo.timestamp && dInfo.timestamp >= sevenDaysAgo;
            });
          } else if (dbFilterPeriod === 'month') {
            isDateFilterActive = true;
            dateFilterLabel = `Bulan Ini (${now.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' })})`;
            filtered = filtered.filter(t => {
              const dInfo = getTicketDateInfo(t);
              return dInfo.year === currentYear && dInfo.monthName.toLowerCase() === currentMonthName;
            });
          }

          // Update Date Banner & Clear Button UI
          if (isDateFilterActive) {
            dateFilterIndicator?.classList.remove('hidden');
            dateFilterIndicator?.classList.add('flex');
            if (dateFilterDisplay) dateFilterDisplay.textContent = dateFilterLabel;
            btnClearDate?.classList.remove('hidden');
          } else {
            dateFilterIndicator?.classList.add('hidden');
            dateFilterIndicator?.classList.remove('flex');
            btnClearDate?.classList.add('hidden');
          }

          // Highlight active KPI card
          kpiDateBtns.forEach(btn => {
            const p = btn.getAttribute('data-kpi-date');
            if (p === dbFilterPeriod) {
              btn.classList.add('ring-2', 'ring-emerald-600', 'ring-offset-2');
            } else {
              btn.classList.remove('ring-2', 'ring-emerald-600', 'ring-offset-2');
            }
          });

          if (filtered.length === 0) {
            masterTableBody.innerHTML = `
              <tr>
                <td colspan="5" class="py-12 text-center text-slate-400 italic">
                  <div class="text-3xl mb-2">🔎</div>
                  <strong class="text-slate-700 block text-sm">Tidak Ditemukan Data Layanan</strong>
                  <p class="text-xs text-slate-400 mt-1">Coba sesuaikan filter Program Studi, Case Pelayanan, atau kata kunci pencarian.</p>
                </td>
              </tr>
            `;
          } else {
            // Kelompokkan per Hari (Group By Date)
            const groups = {};
            filtered.forEach(t => {
              const dInfo = getTicketDateInfo(t);
              const key = dInfo.dateKey;
              if (!groups[key]) {
                groups[key] = {
                  dateKey: key,
                  displayDate: dInfo.displayDate,
                  timestamp: dInfo.timestamp,
                  tickets: []
                };
              }
              groups[key].tickets.push(t);
            });

            // Urutkan kelompok hari (Hari terbaru di atas)
            const sortedDateKeys = Object.keys(groups).sort((a, b) => {
              return b.localeCompare(a); // desc (2026-09-05 sebelum 2026-09-04)
            });

            let htmlBuffer = '';

            sortedDateKeys.forEach(dateKey => {
              const group = groups[dateKey];
              let dayTickets = group.tickets;

              // Sort tiket di dalam hari tersebut
              dayTickets.sort((a, b) => {
                if (dbMasterSort === 'waktu_asc') {
                  return (a.tanggal || '').localeCompare(b.tanggal || '');
                } else if (dbMasterSort === 'prodi_asc') {
                  return (a.prodi || '').localeCompare(b.prodi || '');
                } else if (dbMasterSort === 'prodi_desc') {
                  return (b.prodi || '').localeCompare(a.prodi || '');
                } else if (dbMasterSort === 'case_asc') {
                  return (a.layananNama || '').localeCompare(b.layananNama || '');
                } else if (dbMasterSort === 'nama_asc') {
                  return (a.nama || '').localeCompare(b.nama || '');
